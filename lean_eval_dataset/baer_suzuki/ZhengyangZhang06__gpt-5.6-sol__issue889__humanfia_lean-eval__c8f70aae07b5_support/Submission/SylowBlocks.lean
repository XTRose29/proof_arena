import Submission.Helpers

open LeanEval.GroupTheory
open LeanEval.GroupTheory.Defs
open scoped Pointwise

namespace Submission.Helpers

universe u

/-- The subgroup generated by those conjugates of `x` which lie in `K`. -/
def conjugateClosureIn {G : Type*} [Group G]
    (x : G) (K : Subgroup G) : Subgroup G :=
  Subgroup.closure (Group.conjugatesOfSet ({x} : Set G) ∩ (K : Set G))

theorem conjugateClosureIn_le {G : Type*} [Group G]
    (x : G) (K : Subgroup G) :
    conjugateClosureIn x K ≤ K := by
  rw [conjugateClosureIn, Subgroup.closure_le]
  exact Set.inter_subset_right

/-- The subgroup generated by the conjugates of `x` which lie in a given
Sylow subgroup. -/
def sylowConjugateClosure {G : Type*} [Group G] {p : ℕ}
    (x : G) (P : Sylow p G) : Subgroup G :=
  Subgroup.closure (Group.conjugatesOfSet ({x} : Set G) ∩ (P : Set G))

theorem sylowConjugateClosure_le {G : Type*} [Group G] {p : ℕ}
    (x : G) (P : Sylow p G) :
    sylowConjugateClosure x P ≤ P := by
  rw [sylowConjugateClosure, Subgroup.closure_le]
  exact Set.inter_subset_right

theorem sylowConjugateClosure_isPGroup {G : Type*} [Group G] {p : ℕ}
    (x : G) (P : Sylow p G) :
    IsPGroup p (sylowConjugateClosure x P) :=
  P.isPGroup'.to_le (sylowConjugateClosure_le x P)

private theorem conjugatesOfSingleton_smul {G : Type*} [Group G]
    (x g : G) :
    (MulAut.conj g) • Group.conjugatesOfSet ({x} : Set G) =
      Group.conjugatesOfSet ({x} : Set G) := by
  apply Set.Subset.antisymm
  · rintro y ⟨z, hz, rfl⟩
    exact Group.conj_mem_conjugatesOfSet hz
  · intro y hy
    refine ⟨g⁻¹ * y * (g⁻¹)⁻¹, Group.conj_mem_conjugatesOfSet hy, ?_⟩
    simp [mul_assoc]

theorem conjugateClosureIn_smul {G : Type*} [Group G]
    (x g : G) (K : Subgroup G) :
    (MulAut.conj g) • conjugateClosureIn x K =
      conjugateClosureIn x ((MulAut.conj g) • K) := by
  rw [conjugateClosureIn, conjugateClosureIn, Subgroup.smul_closure,
    Set.smul_set_inter, conjugatesOfSingleton_smul,
    Subgroup.coe_pointwise_smul]

theorem subgroup_le_normalizer_conjugateClosureIn
    {G : Type*} [Group G] (x : G) (K : Subgroup G) :
    K ≤ Subgroup.normalizer (conjugateClosureIn x K : Set G) := by
  intro g hg
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  change (MulAut.conj g) • conjugateClosureIn x K =
    conjugateClosureIn x K
  rw [conjugateClosureIn_smul]
  congr 1
  exact Subgroup.mem_normalizer_iff_map_conj_eq.mp (K.le_normalizer hg)

theorem sylowConjugateClosure_smul {G : Type*} [Group G] {p : ℕ}
    (x g : G) (P : Sylow p G) :
    (MulAut.conj g) • sylowConjugateClosure x P =
      sylowConjugateClosure x (g • P) := by
  rw [sylowConjugateClosure, sylowConjugateClosure,
    Subgroup.smul_closure, Set.smul_set_inter, conjugatesOfSingleton_smul,
    Sylow.coe_smul]

theorem sylow_le_normalizer_sylowConjugateClosure
    {G : Type*} [Group G] {p : ℕ} (x : G) (P : Sylow p G) :
    (P : Subgroup G) ≤
      Subgroup.normalizer (sylowConjugateClosure x P : Set G) := by
  intro g hg
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  change (MulAut.conj g) • sylowConjugateClosure x P =
    sylowConjugateClosure x P
  rw [sylowConjugateClosure_smul,
    Sylow.smul_eq_iff_mem_normalizer.mpr (P.le_normalizer hg)]

theorem card_sylowConjugateClosure_eq {G : Type*} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime] (x : G) (P Q : Sylow p G) :
    Nat.card (sylowConjugateClosure x P) =
      Nat.card (sylowConjugateClosure x Q) := by
  obtain ⟨g, rfl⟩ := MulAction.exists_smul_eq G P Q
  rw [← sylowConjugateClosure_smul]
  exact Nat.card_congr
    ((MulAut.conj g).subgroupMap (sylowConjugateClosure x P)).toEquiv

theorem sylowConjugateClosure_eq_of_le {G : Type*} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime] (x : G) {P Q : Sylow p G}
    (h : sylowConjugateClosure x P ≤ Q) :
    sylowConjugateClosure x P = sylowConjugateClosure x Q := by
  apply Subgroup.eq_of_le_of_card_ge
  · rw [sylowConjugateClosure, Subgroup.closure_le]
    intro y hy
    exact Subgroup.subset_closure ⟨hy.1, h (Subgroup.subset_closure hy)⟩
  · exact (card_sylowConjugateClosure_eq x P Q).ge

private theorem singletonClosure_isPGroup_of_mem_conjugates
    {G : Type*} [Group G] {p : ℕ} [Fact p.Prime]
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    {y : G} (hy : y ∈ Group.conjugatesOfSet ({x} : Set G)) :
    IsPGroup p (Subgroup.closure ({y} : Set G)) := by
  obtain ⟨z, hz, hzy⟩ := Group.mem_conjugatesOfSet_iff.mp hy
  rw [Set.mem_singleton_iff] at hz
  subst z
  obtain ⟨g, hg⟩ := isConj_iff.mp hzy
  rw [← hg]
  apply (h g).to_le
  rw [Subgroup.closure_le]
  intro z hz
  rw [Set.mem_singleton_iff] at hz
  subst z
  exact Subgroup.subset_closure (by simp)

theorem pairwise_of_mem_conjugates
    {G : Type*} [Group G] {p : ℕ} [Fact p.Prime]
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    {y : G} (hy : y ∈ Group.conjugatesOfSet ({x} : Set G)) :
    ∀ g : G, IsPGroup p
      (Subgroup.closure ({y, g * y * g⁻¹} : Set G)) := by
  obtain ⟨z, hz, hzy⟩ := Group.mem_conjugatesOfSet_iff.mp hy
  rw [Set.mem_singleton_iff] at hz
  subst z
  obtain ⟨a, ha⟩ := isConj_iff.mp hzy
  intro g
  rw [← ha]
  have hp := conjugatePair_isPGroup_of_pairwise x h a (g * a)
  have hga : (g * a) * x * (g * a)⁻¹ =
      g * (a * x * a⁻¹) * g⁻¹ := by
    group
  rw [hga] at hp
  exact hp

theorem conjugateClosureIn_isPGroup_proper_subgroup_of_induction
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hind : ∀ {K : Type u} [Group K] [Finite K],
      Nat.card K < Nat.card G → ∀ y : K,
        y ∈ pCore p K ↔
          ∀ k : K, IsPGroup p
            (Subgroup.closure ({y, k * y * k⁻¹} : Set K)))
    (x : G) (K : Subgroup G) (hK : K < ⊤)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G))) :
    IsPGroup p (conjugateClosureIn x K) := by
  apply (pCore_isPGroup.map K.subtype).to_le
  rw [conjugateClosureIn, Subgroup.closure_le]
  intro y hy
  have hycore : (⟨y, hy.2⟩ : K) ∈ pCore p K := by
    apply (hind (subgroup_card_lt hK) (⟨y, hy.2⟩ : K)).2
    exact pairwise_restrict y K hy.2
      (pairwise_of_mem_conjugates x h hy.1)
  exact ⟨⟨y, hy.2⟩, hycore, rfl⟩

theorem sylowConjugateClosure_le_conjugateClosureIn
    {G : Type*} [Group G] {p : ℕ}
    (x : G) (P : Sylow p G) {K : Subgroup G}
    (hPK : sylowConjugateClosure x P ≤ K) :
    sylowConjugateClosure x P ≤ conjugateClosureIn x K := by
  rw [sylowConjugateClosure, conjugateClosureIn]
  apply Subgroup.closure_mono
  rintro y ⟨hyC, hyP⟩
  exact ⟨hyC, hPK (Subgroup.subset_closure ⟨hyC, hyP⟩)⟩

theorem conjugateClosureIn_le_sylowConjugateClosure
    {G : Type*} [Group G] {p : ℕ}
    (x : G) {K : Subgroup G} {Q : Sylow p G}
    (hKQ : conjugateClosureIn x K ≤ Q) :
    conjugateClosureIn x K ≤ sylowConjugateClosure x Q := by
  rw [conjugateClosureIn, sylowConjugateClosure]
  apply Subgroup.closure_mono
  rintro y ⟨hyC, hyK⟩
  exact ⟨hyC, hKQ (Subgroup.subset_closure ⟨hyC, hyK⟩)⟩

theorem le_normalizer_sylowConjugateClosure_of_proper_overgroup
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hind : ∀ {K : Type u} [Group K] [Finite K],
      Nat.card K < Nat.card G → ∀ y : K,
        y ∈ pCore p K ↔
          ∀ k : K, IsPGroup p
            (Subgroup.closure ({y, k * y * k⁻¹} : Set K)))
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    (P : Sylow p G) (K : Subgroup G)
    (hAK : sylowConjugateClosure x P ≤ K) (hK : K < ⊤) :
    K ≤ Subgroup.normalizer (sylowConjugateClosure x P : Set G) := by
  have hpK : IsPGroup p (conjugateClosureIn x K) :=
    conjugateClosureIn_isPGroup_proper_subgroup_of_induction
      hind x K hK h
  obtain ⟨Q, hQ⟩ := hpK.exists_le_sylow
  have hPA : sylowConjugateClosure x P ≤ conjugateClosureIn x K :=
    sylowConjugateClosure_le_conjugateClosureIn x P hAK
  have hKQ : conjugateClosureIn x K ≤ sylowConjugateClosure x Q :=
    conjugateClosureIn_le_sylowConjugateClosure x hQ
  have hEq : sylowConjugateClosure x P = conjugateClosureIn x K := by
    apply Subgroup.eq_of_le_of_card_ge hPA
    calc
      Nat.card (conjugateClosureIn x K) ≤
          Nat.card (sylowConjugateClosure x Q) :=
        Subgroup.card_le_of_le hKQ
      _ = Nat.card (sylowConjugateClosure x P) :=
        card_sylowConjugateClosure_eq x Q P
  rw [hEq]
  exact subgroup_le_normalizer_conjugateClosureIn x K

theorem normalizer_sylowConjugateClosure_isCoatom
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hind : ∀ {K : Type u} [Group K] [Finite K],
      Nat.card K < Nat.card G → ∀ y : K,
        y ∈ pCore p K ↔
          ∀ k : K, IsPGroup p
            (Subgroup.closure ({y, k * y * k⁻¹} : Set K)))
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    (P : Sylow p G) (hxP : x ∈ P)
    (hx : x ∉ pCore p G) :
    IsCoatom
      (Subgroup.normalizer (sylowConjugateClosure x P : Set G)) := by
  let A := sylowConjugateClosure x P
  have hxA : x ∈ A := by
    apply Subgroup.subset_closure
    exact ⟨Group.subset_conjugatesOfSet (Set.mem_singleton x), hxP⟩
  have hA : IsPGroup p A :=
    sylowConjugateClosure_isPGroup x P
  have hne : Subgroup.normalizer (A : Set G) ≠ ⊤ := by
    intro htop
    have hnormal : A.Normal :=
      Subgroup.normalizer_eq_top_iff.mp htop
    exact hx (le_pCore hnormal hA hxA)
  rw [isCoatom_iff_ge_of_le]
  refine ⟨hne, ?_⟩
  intro K hK hNK
  have hAK : A ≤ K := A.le_normalizer.trans hNK
  exact le_normalizer_sylowConjugateClosure_of_proper_overgroup
    hind x h P K hAK (lt_top_iff_ne_top.mpr hK)

theorem sup_sylowConjugateClosure_eq_top_of_ne_of_induction
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hind : ∀ {K : Type u} [Group K] [Finite K],
      Nat.card K < Nat.card G → ∀ y : K,
        y ∈ pCore p K ↔
          ∀ k : K, IsPGroup p
            (Subgroup.closure ({y, k * y * k⁻¹} : Set K)))
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    (P Q : Sylow p G)
    (hne :
      sylowConjugateClosure x P ≠ sylowConjugateClosure x Q) :
    sylowConjugateClosure x P ⊔ sylowConjugateClosure x Q = ⊤ := by
  by_contra htop
  let K :=
    sylowConjugateClosure x P ⊔ sylowConjugateClosure x Q
  have hK : K < (⊤ : Subgroup G) :=
    lt_top_iff_ne_top.mpr htop
  have hpK : IsPGroup p (conjugateClosureIn x K) :=
    conjugateClosureIn_isPGroup_proper_subgroup_of_induction
      hind x K hK h
  obtain ⟨R, hR⟩ := hpK.exists_le_sylow
  have hPR : sylowConjugateClosure x P ≤ R :=
    (sylowConjugateClosure_le_conjugateClosureIn x P le_sup_left).trans hR
  have hQR : sylowConjugateClosure x Q ≤ R :=
    (sylowConjugateClosure_le_conjugateClosureIn x Q le_sup_right).trans hR
  exact hne ((sylowConjugateClosure_eq_of_le x hPR).trans
    (sylowConjugateClosure_eq_of_le x hQR).symm)

theorem mem_pCore_of_mem_proper_normal_subgroup_of_induction
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hind : ∀ {K : Type u} [Group K] [Finite K],
      Nat.card K < Nat.card G → ∀ y : K,
        y ∈ pCore p K ↔
          ∀ k : K, IsPGroup p
            (Subgroup.closure ({y, k * y * k⁻¹} : Set K)))
    (x : G) (K : Subgroup G) (hxK : x ∈ K) (hK : K < ⊤)
    (hKN : K.Normal)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G))) :
    x ∈ pCore p G := by
  have hxcore : (⟨x, hxK⟩ : K) ∈ pCore p K :=
    mem_pCore_proper_subgroup_of_induction hind x K hxK hK h
  letI : K.Normal := hKN
  letI : (pCore p K).Characteristic := pCore_characteristic
  have hnormal : ((pCore p K).map K.subtype).Normal := inferInstance
  apply le_pCore hnormal (pCore_isPGroup.map K.subtype)
  exact ⟨⟨x, hxK⟩, hxcore, rfl⟩

theorem normalClosure_singleton_eq_top_of_not_mem_pCore
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hind : ∀ {K : Type u} [Group K] [Finite K],
      Nat.card K < Nat.card G → ∀ y : K,
        y ∈ pCore p K ↔
          ∀ k : K, IsPGroup p
            (Subgroup.closure ({y, k * y * k⁻¹} : Set K)))
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    (hx : x ∉ pCore p G) :
    Subgroup.normalClosure ({x} : Set G) = ⊤ := by
  by_contra hne
  have hlt : Subgroup.normalClosure ({x} : Set G) < ⊤ :=
    lt_top_iff_ne_top.mpr hne
  exact hx (mem_pCore_of_mem_proper_normal_subgroup_of_induction
    hind x (Subgroup.normalClosure ({x} : Set G))
    (Subgroup.subset_normalClosure (Set.mem_singleton x)) hlt
    Subgroup.normalClosure_normal h)

theorem conjugate_mem_sylowConjugateClosure_of_mem_normalizer
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    (P : Sylow p G) {y : G}
    (hyC : y ∈ Group.conjugatesOfSet ({x} : Set G))
    (hyN : y ∈
      Subgroup.normalizer (sylowConjugateClosure x P : Set G)) :
    y ∈ sylowConjugateClosure x P := by
  have hyP : IsPGroup p (Subgroup.closure ({y} : Set G)) :=
    singletonClosure_isPGroup_of_mem_conjugates x h hyC
  have hyLe : Subgroup.closure ({y} : Set G) ≤
      Subgroup.normalizer (sylowConjugateClosure x P : Set G) := by
    rw [Subgroup.closure_le]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    simpa [hz] using hyN
  have hpSup : IsPGroup p
      (((sylowConjugateClosure x P : Subgroup G) ⊔
        (Subgroup.closure ({y} : Set G) : Subgroup G)) : Subgroup G) :=
    (sylowConjugateClosure_isPGroup x P).to_sup_of_normal_left'
      hyP hyLe
  obtain ⟨Q, hQ⟩ := hpSup.exists_le_sylow
  have hPQ : sylowConjugateClosure x P ≤ Q :=
    le_sup_left.trans hQ
  rw [sylowConjugateClosure_eq_of_le x hPQ]
  apply Subgroup.subset_closure
  refine ⟨hyC, hQ ((show Subgroup.closure ({y} : Set G) ≤
      sylowConjugateClosure x P ⊔ Subgroup.closure ({y} : Set G) from
      le_sup_right) ?_)⟩
  exact Subgroup.subset_closure (Set.mem_singleton y)

theorem conjugate_mem_normalizer_iff_mem_sylowConjugateClosure
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    (P : Sylow p G) {y : G}
    (hyC : y ∈ Group.conjugatesOfSet ({x} : Set G)) :
    y ∈ Subgroup.normalizer (sylowConjugateClosure x P : Set G) ↔
      y ∈ sylowConjugateClosure x P :=
  ⟨conjugate_mem_sylowConjugateClosure_of_mem_normalizer x h P hyC,
    fun hy => (sylowConjugateClosure x P).le_normalizer hy⟩

/-- The Sylow subgroups containing the conjugacy-class closure attached to
`P`.  These sets will be the blocks in the Sylow action. -/
def sylowClosureBlock {G : Type*} [Group G] {p : ℕ}
    (x : G) (P : Sylow p G) : Set (Sylow p G) :=
  {Q | sylowConjugateClosure x P ≤ Q}

theorem mem_sylowClosureBlock_iff {G : Type*} [Group G] {p : ℕ}
    (x : G) (P Q : Sylow p G) :
    Q ∈ sylowClosureBlock x P ↔ sylowConjugateClosure x P ≤ Q :=
  Iff.rfl

theorem mem_sylowClosureBlock_iff_closure_eq
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) (P Q : Sylow p G) :
    Q ∈ sylowClosureBlock x P ↔
      sylowConjugateClosure x Q = sylowConjugateClosure x P := by
  constructor
  · intro h
    exact (sylowConjugateClosure_eq_of_le x h).symm
  · intro h
    change sylowConjugateClosure x P ≤ Q
    rw [← h]
    exact sylowConjugateClosure_le x Q

theorem sylowClosureBlock_eq_of_mem
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) {P Q : Sylow p G} (hQ : Q ∈ sylowClosureBlock x P) :
    sylowClosureBlock x P = sylowClosureBlock x Q := by
  ext R
  rw [mem_sylowClosureBlock_iff_closure_eq,
    mem_sylowClosureBlock_iff_closure_eq]
  rw [sylowConjugateClosure_eq_of_le x hQ]

theorem sylowClosureBlock_eq_iff_closure_eq
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) (P Q : Sylow p G) :
    sylowClosureBlock x P = sylowClosureBlock x Q ↔
      sylowConjugateClosure x P = sylowConjugateClosure x Q := by
  constructor
  · intro h
    have hP : P ∈ sylowClosureBlock x P :=
      sylowConjugateClosure_le x P
    have hPQ : P ∈ sylowClosureBlock x Q := by
      rw [← h]
      exact hP
    exact (sylowConjugateClosure_eq_of_le x hPQ).symm
  · intro h
    ext R
    change sylowConjugateClosure x P ≤ R ↔
      sylowConjugateClosure x Q ≤ R
    rw [h]

theorem sylowClosureBlock_smul
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x g : G) (P : Sylow p G) :
    g • sylowClosureBlock x P = sylowClosureBlock x (g • P) := by
  ext Q
  constructor
  · rintro ⟨R, hR, rfl⟩
    rw [mem_sylowClosureBlock_iff_closure_eq,
      ← sylowConjugateClosure_smul, ← sylowConjugateClosure_smul,
      sylowConjugateClosure_eq_of_le x hR]
  · intro hQ
    refine ⟨g⁻¹ • Q, ?_, by simp⟩
    change sylowConjugateClosure x P ≤ (g⁻¹ • Q : Sylow p G)
    change sylowConjugateClosure x (g • P) ≤ Q at hQ
    intro y hy
    change y ∈ (MulAut.conj g⁻¹) • (Q : Subgroup G)
    rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem]
    apply hQ
    rw [← sylowConjugateClosure_smul]
    simpa [MulAut.inv_def] using
      (Subgroup.smul_mem_pointwise_smul y (MulAut.conj g)
        (sylowConjugateClosure x P) hy)

theorem sylowClosureBlock_isBlock
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) (P : Sylow p G) :
    MulAction.IsBlock G (sylowClosureBlock x P) := by
  rw [MulAction.isBlock_iff_smul_eq_smul_of_nonempty]
  intro g₁ g₂ h
  rw [sylowClosureBlock_smul, sylowClosureBlock_smul] at h ⊢
  obtain ⟨Q, hQ₁, hQ₂⟩ := h
  exact (sylowClosureBlock_eq_of_mem x hQ₁).trans
    (sylowClosureBlock_eq_of_mem x hQ₂).symm

theorem stabilizer_sylowClosureBlock
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) (P : Sylow p G) :
    MulAction.stabilizer G (sylowClosureBlock x P) =
      Subgroup.normalizer (sylowConjugateClosure x P : Set G) := by
  ext g
  rw [MulAction.mem_stabilizer_iff, sylowClosureBlock_smul,
    sylowClosureBlock_eq_iff_closure_eq,
    Subgroup.mem_normalizer_iff_map_conj_eq]
  change sylowConjugateClosure x (g • P) =
      sylowConjugateClosure x P ↔
    (MulAut.conj g) • sylowConjugateClosure x P =
      sylowConjugateClosure x P
  rw [sylowConjugateClosure_smul]

theorem sylowConjugateClosure_eq_of_le_normalizer
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) {P Q : Sylow p G}
    (hPN : sylowConjugateClosure x P ≤
      Subgroup.normalizer (sylowConjugateClosure x Q : Set G)) :
    sylowConjugateClosure x P = sylowConjugateClosure x Q := by
  have hpSup : IsPGroup p
      (sylowConjugateClosure x P ⊔ sylowConjugateClosure x Q :
        Subgroup G) :=
    (sylowConjugateClosure_isPGroup x P).to_sup_of_normal_right'
      (sylowConjugateClosure_isPGroup x Q) hPN
  obtain ⟨R, hR⟩ := hpSup.exists_le_sylow
  exact (sylowConjugateClosure_eq_of_le x (le_sup_left.trans hR)).trans
    (sylowConjugateClosure_eq_of_le x (le_sup_right.trans hR)).symm

/-- On the block system formed by the `sylowClosureBlock`s, the subgroup
attached to `P` fixes only its own block. -/
theorem closure_le_stabilizer_sylowClosureBlock_iff
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) (P Q : Sylow p G) :
    sylowConjugateClosure x P ≤
        MulAction.stabilizer G (sylowClosureBlock x Q) ↔
      sylowClosureBlock x Q = sylowClosureBlock x P := by
  rw [stabilizer_sylowClosureBlock]
  constructor
  · intro h
    exact (sylowClosureBlock_eq_iff_closure_eq x Q P).2
      (sylowConjugateClosure_eq_of_le_normalizer x h).symm
  · intro h
    have hclosure :
        sylowConjugateClosure x Q = sylowConjugateClosure x P :=
      (sylowClosureBlock_eq_iff_closure_eq x Q P).1 h
    rw [hclosure]
    exact (sylowConjugateClosure x P).le_normalizer

theorem nontrivial_orbit_sylowClosureBlock_of_not_mem_pCore
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hind : ∀ {K : Type u} [Group K] [Finite K],
      Nat.card K < Nat.card G → ∀ y : K,
        y ∈ pCore p K ↔
          ∀ k : K, IsPGroup p
            (Subgroup.closure ({y, k * y * k⁻¹} : Set K)))
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    (P : Sylow p G) (hxP : x ∈ P) (hx : x ∉ pCore p G) :
    Nontrivial (MulAction.orbit G (sylowClosureBlock x P)) := by
  rw [nontrivial_iff]
  have hcoatom :=
    normalizer_sylowConjugateClosure_isCoatom hind x h P hxP hx
  have hstabilizer :
      MulAction.stabilizer G (sylowClosureBlock x P) ≠ ⊤ := by
    rw [stabilizer_sylowClosureBlock]
    exact hcoatom.1
  obtain ⟨g, -, hg⟩ :=
    SetLike.exists_of_lt (lt_top_iff_ne_top.mpr hstabilizer)
  refine
    ⟨⟨sylowClosureBlock x P,
        MulAction.mem_orbit_self (sylowClosureBlock x P)⟩,
      ⟨g • sylowClosureBlock x P,
        MulAction.mem_orbit (sylowClosureBlock x P) g⟩, ?_⟩
  intro heq
  apply hg
  rw [MulAction.mem_stabilizer_iff]
  exact (congr_arg Subtype.val heq).symm

theorem orbit_sylowClosureBlock_isPreprimitive_of_not_mem_pCore
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hind : ∀ {K : Type u} [Group K] [Finite K],
      Nat.card K < Nat.card G → ∀ y : K,
        y ∈ pCore p K ↔
          ∀ k : K, IsPGroup p
            (Subgroup.closure ({y, k * y * k⁻¹} : Set K)))
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    (P : Sylow p G) (hxP : x ∈ P) (hx : x ∉ pCore p G) :
    MulAction.IsPreprimitive G
      (MulAction.orbit G (sylowClosureBlock x P)) := by
  let B := sylowClosureBlock x P
  let b : MulAction.orbit G B :=
    ⟨B, MulAction.mem_orbit_self B⟩
  letI : Nontrivial (MulAction.orbit G B) :=
    nontrivial_orbit_sylowClosureBlock_of_not_mem_pCore
      hind x h P hxP hx
  rw [← MulAction.isCoatom_stabilizer_iff_preprimitive G b]
  have hstabilizer :
      MulAction.stabilizer G b = MulAction.stabilizer G B := by
    ext g
    simp only [MulAction.mem_stabilizer_iff]
    exact Subtype.ext_iff
  rw [hstabilizer, show B = sylowClosureBlock x P from rfl,
    stabilizer_sylowClosureBlock]
  exact normalizer_sylowConjugateClosure_isCoatom hind x h P hxP hx

theorem sylowClosureBlock_nonempty
    {G : Type*} [Group G] {p : ℕ} (x : G) (P : Sylow p G) :
    (sylowClosureBlock x P).Nonempty :=
  ⟨P, sylowConjugateClosure_le x P⟩

theorem mem_pCore_of_sylowClosureBlock_eq_univ
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) (P : Sylow p G) (hxP : x ∈ P)
    (hblock : sylowClosureBlock x P = Set.univ) :
    x ∈ LeanEval.GroupTheory.Defs.pCore p G := by
  apply (mem_pCore_iff_mem_all_sylow x).2
  intro Q
  have hle : sylowConjugateClosure x P ≤ Q := by
    rw [← mem_sylowClosureBlock_iff]
    simp [hblock]
  apply hle
  apply Subgroup.subset_closure
  exact ⟨Group.subset_conjugatesOfSet (Set.mem_singleton x), hxP⟩

/-- The orbit of a Sylow-closure block has cardinality prime to `p`.

The stabilizer of the base block contains `P`, so its index divides the
index of `P`; the latter is not divisible by `p`. -/
theorem prime_not_dvd_card_orbit_sylowClosureBlock
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) (P : Sylow p G) :
    ¬p ∣ Nat.card (MulAction.orbit G (sylowClosureBlock x P)) := by
  let B := sylowClosureBlock x P
  let b : MulAction.orbit G B :=
    ⟨B, MulAction.mem_orbit_self B⟩
  have hstabilizer :
      MulAction.stabilizer G b =
        Subgroup.normalizer (sylowConjugateClosure x P : Set G) := by
    rw [← stabilizer_sylowClosureBlock x P]
    ext g
    simp only [MulAction.mem_stabilizer_iff]
    exact Subtype.ext_iff
  have hP :
      (P : Subgroup G) ≤ MulAction.stabilizer G b := by
    rw [hstabilizer]
    exact sylow_le_normalizer_sylowConjugateClosure x P
  rw [← MulAction.index_stabilizer_of_transitive G b]
  intro hp
  exact P.not_dvd_index
    (hp.trans (Subgroup.index_dvd_of_le hP))

/-- A `p`-subgroup of `G` fixes a point on the Sylow-closure block orbit. -/
theorem nonempty_fixedPoints_orbit_sylowClosureBlock_of_isPGroup
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) (P : Sylow p G) (L : Subgroup G)
    (hL : IsPGroup p L) :
    (MulAction.fixedPoints L
      (MulAction.orbit G (sylowClosureBlock x P))).Nonempty :=
  hL.nonempty_fixed_point_of_prime_not_dvd_card _
    (prime_not_dvd_card_orbit_sylowClosureBlock x P)

/-- The Sylow subgroup `P` fixes only the point represented by its own
Sylow-closure block. -/
theorem fixedPoints_sylow_orbit_sylowClosureBlock
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) (P : Sylow p G) :
    MulAction.fixedPoints (P : Subgroup G)
        (MulAction.orbit G (sylowClosureBlock x P)) =
      {⟨sylowClosureBlock x P,
        MulAction.mem_orbit_self (sylowClosureBlock x P)⟩} := by
  classical
  ext Q
  constructor
  · intro hQ
    obtain ⟨g, hg⟩ := Q.property
    have hPstab :
        (P : Subgroup G) ≤
          MulAction.stabilizer G (Q : Set (Sylow p G)) := by
      intro y hy
      rw [MulAction.mem_stabilizer_iff]
      exact congrArg Subtype.val (hQ ⟨y, hy⟩)
    have hQeq :
        (Q : Set (Sylow p G)) =
          sylowClosureBlock x (g • P) := by
      rw [← sylowClosureBlock_smul x g P]
      exact hg.symm
    have hclosures :
        sylowConjugateClosure x P =
          sylowConjugateClosure x (g • P) := by
      apply sylowConjugateClosure_eq_of_le_normalizer x
      apply (sylowConjugateClosure_le x P).trans
      rw [← stabilizer_sylowClosureBlock x (g • P), ← hQeq]
      exact hPstab
    have hblocks :
        sylowClosureBlock x (g • P) =
          sylowClosureBlock x P :=
      (sylowClosureBlock_eq_iff_closure_eq x (g • P) P).2
        hclosures.symm
    rw [Set.mem_singleton_iff]
    apply Subtype.ext
    rw [hQeq, hblocks]
  · rw [Set.mem_singleton_iff]
    rintro rfl
    intro y
    rw [Subtype.ext_iff]
    change (y : G) • sylowClosureBlock x P = sylowClosureBlock x P
    rw [sylowClosureBlock_smul,
      sylowClosureBlock_eq_iff_closure_eq,
      ← sylowConjugateClosure_smul]
    have hyN :
        (y : G) ∈
          Subgroup.normalizer (sylowConjugateClosure x P : Set G) :=
      sylow_le_normalizer_sylowConjugateClosure x P y.property
    rwa [Subgroup.mem_normalizer_iff_map_conj_eq] at hyN

/-- Every Sylow subgroup fixes exactly its own closure block on the common
orbit of the closure blocks, independently of the block chosen to present
that orbit. -/
theorem fixedPoints_sylow_orbit_sylowClosureBlock_of_base
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (x : G) (P Q : Sylow p G) :
    MulAction.fixedPoints (Q : Subgroup G)
        (MulAction.orbit G (sylowClosureBlock x P)) =
      {⟨sylowClosureBlock x Q, by
        obtain ⟨g, rfl⟩ := MulAction.exists_smul_eq G P Q
        rw [← sylowClosureBlock_smul]
        exact MulAction.mem_orbit _ g⟩} := by
  classical
  ext R
  constructor
  · intro hR
    obtain ⟨g, hg⟩ := R.property
    have hQstab :
        (Q : Subgroup G) ≤
          MulAction.stabilizer G (R : Set (Sylow p G)) := by
      intro y hy
      rw [MulAction.mem_stabilizer_iff]
      exact congrArg Subtype.val (hR ⟨y, hy⟩)
    have hReq :
        (R : Set (Sylow p G)) =
          sylowClosureBlock x (g • P) := by
      rw [← sylowClosureBlock_smul x g P]
      exact hg.symm
    have hclosures :
        sylowConjugateClosure x Q =
          sylowConjugateClosure x (g • P) := by
      apply sylowConjugateClosure_eq_of_le_normalizer x
      apply (sylowConjugateClosure_le x Q).trans
      rw [← stabilizer_sylowClosureBlock x (g • P), ← hReq]
      exact hQstab
    have hblocks :
        sylowClosureBlock x (g • P) =
          sylowClosureBlock x Q :=
      (sylowClosureBlock_eq_iff_closure_eq x (g • P) Q).2
        hclosures.symm
    rw [Set.mem_singleton_iff]
    apply Subtype.ext
    rw [hReq, hblocks]
  · rw [Set.mem_singleton_iff]
    rintro rfl
    intro y
    rw [Subtype.ext_iff]
    change (y : G) • sylowClosureBlock x Q =
      sylowClosureBlock x Q
    rw [sylowClosureBlock_smul,
      sylowClosureBlock_eq_iff_closure_eq,
      ← sylowConjugateClosure_smul]
    have hyN :
        (y : G) ∈
          Subgroup.normalizer (sylowConjugateClosure x Q : Set G) :=
      sylow_le_normalizer_sylowConjugateClosure x Q y.property
    rwa [Subgroup.mem_normalizer_iff_map_conj_eq] at hyN

