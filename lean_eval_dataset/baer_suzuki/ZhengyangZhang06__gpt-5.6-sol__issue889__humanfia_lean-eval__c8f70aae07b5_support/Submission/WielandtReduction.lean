import Submission.Zipper

open LeanEval.GroupTheory
open LeanEval.GroupTheory.Defs

namespace Submission.Helpers

universe u

/-- The final, elementary part of the minimal-counterexample argument.

Once the cyclic subgroup generated by `x` has a unique maximal overgroup,
every conjugate of `x` belongs to that overgroup: the subgroup generated by
the pair is a proper `p`-subgroup and can be extended to a maximal subgroup.
This contradicts normal generation by `x`. -/
theorem mem_pCore_of_unique_coatom_containing_singletonClosure_of_induction
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hind : ∀ {K : Type u} [Group K] [Finite K],
      Nat.card K < Nat.card G → ∀ y : K,
        y ∈ pCore p K ↔
          ∀ k : K, IsPGroup p
            (Subgroup.closure ({y, k * y * k⁻¹} : Set K)))
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    (M : Subgroup G) (hM : IsCoatom M)
    (hunique : ∀ K : Subgroup G, IsCoatom K →
      Subgroup.closure ({x} : Set G) ≤ K → K = M) :
    x ∈ pCore p G := by
  by_contra hx
  have hnormalClosure :
      Subgroup.normalClosure ({x} : Set G) = ⊤ :=
    normalClosure_singleton_eq_top_of_not_mem_pCore hind x h hx
  have hconj : ∀ g : G, g * x * g⁻¹ ∈ M := by
    intro g
    let L : Subgroup G :=
      Subgroup.closure ({x, g * x * g⁻¹} : Set G)
    have hLne : L ≠ ⊤ := by
      intro hL
      have hpTop : IsPGroup p (⊤ : Subgroup G) := by
        have hpL : IsPGroup p L := h g
        rwa [hL] at hpL
      have hpG : IsPGroup p G :=
        hpTop.of_equiv Subgroup.topEquiv
      apply hx
      rw [pCore_eq_top_of_isPGroup hpG]
      exact Subgroup.mem_top x
    obtain hLtop | ⟨K, hK, hLK⟩ :=
      eq_top_or_exists_le_coatom L
    · exact (hLne hLtop).elim
    · have hxK : Subgroup.closure ({x} : Set G) ≤ K := by
        apply le_trans _ hLK
        rw [Subgroup.closure_le]
        intro y hy
        rw [Set.mem_singleton_iff] at hy
        subst y
        exact Subgroup.subset_closure (by simp)
      rw [hunique K hK hxK] at hLK
      exact hLK (Subgroup.subset_closure (by simp))
  have hnormalClosure_le : Subgroup.normalClosure ({x} : Set G) ≤ M := by
    rw [Subgroup.normalClosure, Subgroup.closure_le]
    intro y hy
    obtain ⟨z, hz, hyz⟩ := Group.mem_conjugatesOfSet_iff.mp hy
    rw [Set.mem_singleton_iff] at hz
    subst z
    obtain ⟨g, hg⟩ := isConj_iff.mp hyz
    rw [← hg]
    exact hconj g
  have htopM : (⊤ : Subgroup G) ≤ M := by
    rwa [← hnormalClosure]
  exact hM.1 (top_unique htopM)

theorem mem_pCore_of_wielandt_zipper_dichotomy_of_induction
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hind : ∀ {K : Type u} [Group K] [Finite K],
      Nat.card K < Nat.card G → ∀ y : K,
        y ∈ pCore p K ↔
          ∀ k : K, IsPGroup p
            (Subgroup.closure ({y, k * y * k⁻¹} : Set K)))
    (x : G)
    (h : ∀ g : G, IsPGroup p
      (Subgroup.closure ({x, g * x * g⁻¹} : Set G)))
    (hzipper :
      (Subgroup.closure ({x} : Set G)).IsSubnormal ∨
        ∃ M : Subgroup G, IsCoatom M ∧
          ∀ K : Subgroup G, IsCoatom K →
            Subgroup.closure ({x} : Set G) ≤ K → K = M) :
    x ∈ pCore p G := by
  rcases hzipper with hsubnormal | ⟨M, hM, hunique⟩
  · exact mem_pCore_of_singletonClosure_isSubnormal x h hsubnormal
  · exact
      mem_pCore_of_unique_coatom_containing_singletonClosure_of_induction
        hind x h M hM hunique

end Submission.Helpers
