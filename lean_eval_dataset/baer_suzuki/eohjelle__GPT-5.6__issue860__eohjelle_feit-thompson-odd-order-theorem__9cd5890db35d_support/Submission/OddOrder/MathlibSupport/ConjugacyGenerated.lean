import Submission.OddOrder.MathlibSupport.PCore

/-!
The normal subgroup generated by one conjugacy class.

This is the target subgroup in the Baer-Suzuki induction used by Appendix A.
-/

namespace Submission.OddOrder.MathlibSupport

variable {G : Type*} [Group G]

/-- The least normal subgroup containing `x`. -/
def conjugacyGenerated (x : G) : Subgroup G :=
  Subgroup.normalClosure (Subgroup.zpowers x : Set G)

instance conjugacyGenerated_normal (x : G) : (conjugacyGenerated x).Normal := by
  dsimp [conjugacyGenerated]
  infer_instance

theorem mem_conjugacyGenerated (x : G) : x ∈ conjugacyGenerated x := by
  apply Subgroup.subset_normalClosure
  exact Subgroup.mem_zpowers x

theorem zpowers_le_conjugacyGenerated (x : G) :
    Subgroup.zpowers x ≤ conjugacyGenerated x :=
  Subgroup.subset_normalClosure

theorem conjugacyGenerated_le {x : G} {N : Subgroup G} [N.Normal]
    (hx : x ∈ N) : conjugacyGenerated x ≤ N := by
  apply Subgroup.normalClosure_le_normal
  exact Subgroup.zpowers_le.mpr hx

theorem conjugacyGenerated_le_iff {x : G} {N : Subgroup G} [N.Normal] :
    conjugacyGenerated x ≤ N ↔ x ∈ N :=
  ⟨fun h ↦ h (mem_conjugacyGenerated x), conjugacyGenerated_le⟩

theorem conjugate_mem_conjugacyGenerated (x g : G) :
    g * x * g⁻¹ ∈ conjugacyGenerated x := by
  exact (show (conjugacyGenerated x).Normal from inferInstance).conj_mem x
    (mem_conjugacyGenerated x) g

/-- The final step of Baer-Suzuki: once the normal closure of `x` is a
p-group, `x` belongs to the p-core. -/
theorem mem_pCore_of_conjugacyGenerated_isPGroup [Finite G] {p : ℕ} {x : G}
    (hx : IsPGroup p (conjugacyGenerated x)) : x ∈ pCore p G := by
  exact le_pCore hx (by infer_instance) (mem_conjugacyGenerated x)

end Submission.OddOrder.MathlibSupport
