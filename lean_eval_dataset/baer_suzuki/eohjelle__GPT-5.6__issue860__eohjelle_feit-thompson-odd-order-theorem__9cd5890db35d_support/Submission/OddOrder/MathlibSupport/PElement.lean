import Mathlib

/-!
Subgroups generated by `p`-elements.

This ports the definition `p_elt_gen` and its normality observation from
`BGsection1.v`.  Defining the construction on a group type means that the Coq
expression `p_elt_gen p H` is represented by `pElementGenerated p H` when `H`
is a mathlib subgroup subtype.
-/

namespace Submission.OddOrder.MathlibSupport

variable {G K : Type*} [Group G] [Group K] {p : ℕ}

/-- An element annihilated by a power of `p`. -/
def IsPElement (p : ℕ) {G : Type*} [Group G] (x : G) : Prop :=
  ∃ k : ℕ, x ^ p ^ k = 1

namespace IsPElement

variable {x : G}

theorem one : IsPElement p (1 : G) :=
  ⟨0, by simp⟩

theorem map (f : G →* K) (hx : IsPElement p x) : IsPElement p (f x) := by
  obtain ⟨k, hk⟩ := hx
  exact ⟨k, by rw [← f.map_pow, hk, f.map_one]⟩

theorem of_map_of_injective (f : G →* K) (hf : Function.Injective f)
    (hx : IsPElement p (f x)) : IsPElement p x := by
  obtain ⟨k, hk⟩ := hx
  refine ⟨k, hf ?_⟩
  simpa using hk

theorem map_iff_of_injective (f : G →* K) (hf : Function.Injective f) :
    IsPElement p (f x) ↔ IsPElement p x :=
  ⟨of_map_of_injective f hf, map f⟩

theorem conj (g : G) (hx : IsPElement p x) :
    IsPElement p (g * x * g⁻¹) := by
  obtain ⟨k, hk⟩ := hx
  exact ⟨k, by simp [hk]⟩

end IsPElement

/-- The subgroup generated by all `p`-elements of `G`. -/
def pElementGenerated (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure {x : G | IsPElement p x}

theorem isPElement_subset_pElementGenerated {x : G} (hx : IsPElement p x) :
    x ∈ pElementGenerated p G :=
  Subgroup.subset_closure hx

theorem pElementGenerated_le_iff (H : Subgroup G) :
    pElementGenerated p G ≤ H ↔ ∀ x : G, IsPElement p x → x ∈ H := by
  constructor
  · exact fun h x hx => h (isPElement_subset_pElementGenerated hx)
  · exact fun h => (Subgroup.closure_le _).2 h

theorem map_pElementGenerated_le (f : G →* K) :
    (pElementGenerated p G).map f ≤ pElementGenerated p K := by
  rw [pElementGenerated, MonoidHom.map_closure]
  apply Subgroup.closure_mono
  rintro _ ⟨x, hx, rfl⟩
  exact hx.map f

theorem map_pElementGenerated_equiv (e : G ≃* K) :
    (pElementGenerated p G).map e.toMonoidHom = pElementGenerated p K := by
  rw [pElementGenerated, MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact hx.map e.toMonoidHom
  · intro hy
    exact ⟨e.symm y, hy.map e.symm.toMonoidHom, e.apply_symm_apply y⟩

instance pElementGenerated_characteristic :
    (pElementGenerated p G).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  exact map_pElementGenerated_equiv

theorem pElementGenerated_normal : (pElementGenerated p G).Normal :=
  inferInstance

theorem pElementGenerated_eq_top_of_isPGroup (hG : IsPGroup p G) :
    pElementGenerated p G = ⊤ := by
  rw [Subgroup.eq_top_iff']
  exact fun x => isPElement_subset_pElementGenerated (hG x)

end Submission.OddOrder.MathlibSupport
