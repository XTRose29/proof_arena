import Submission.OddOrder.MathlibSupport.ConjugacyGenerated

/-!
The subgroup generated by a conjugacy class.
-/

namespace Submission.OddOrder.MathlibSupport

variable {G : Type*} [Group G]

/-- The subgroup generated by the conjugacy class of `x`. -/
def conjugacyClassGenerated (x : G) : Subgroup G :=
  Subgroup.closure (conjugatesOf x)

theorem conjugacyGenerated_eq_normalClosure_singleton (x : G) :
    conjugacyGenerated x = Subgroup.normalClosure ({x} : Set G) := by
  rw [conjugacyGenerated, Subgroup.zpowers_eq_closure,
    Subgroup.normalClosure_closure_eq_normalClosure]

theorem conjugacyClassGenerated_eq_conjugacyGenerated (x : G) :
    conjugacyClassGenerated x = conjugacyGenerated x := by
  rw [conjugacyClassGenerated, conjugacyGenerated_eq_normalClosure_singleton,
    Subgroup.normalClosure, Group.conjugatesOfSet]
  simp

instance conjugacyClassGenerated_normal (x : G) :
    (conjugacyClassGenerated x).Normal := by
  rw [conjugacyClassGenerated_eq_conjugacyGenerated]
  infer_instance

theorem conjugatesOf_subset_conjugacyClassGenerated (x : G) :
    conjugatesOf x ⊆ conjugacyClassGenerated x :=
  Subgroup.subset_closure

theorem mem_conjugacyClassGenerated (x : G) :
    x ∈ conjugacyClassGenerated x := by
  rw [conjugacyClassGenerated_eq_conjugacyGenerated]
  exact mem_conjugacyGenerated x

theorem conjugacyClassGenerated_le_iff {x : G} {N : Subgroup G} [N.Normal] :
    conjugacyClassGenerated x ≤ N ↔ x ∈ N := by
  rw [conjugacyClassGenerated_eq_conjugacyGenerated,
    conjugacyGenerated_le_iff]

theorem mem_pCore_of_conjugacyClassGenerated_isPGroup [Finite G]
    {p : ℕ} {x : G} (hx : IsPGroup p (conjugacyClassGenerated x)) :
    x ∈ pCore p G := by
  rw [conjugacyClassGenerated_eq_conjugacyGenerated] at hx
  apply mem_pCore_of_conjugacyGenerated_isPGroup
  exact hx

end Submission.OddOrder.MathlibSupport
