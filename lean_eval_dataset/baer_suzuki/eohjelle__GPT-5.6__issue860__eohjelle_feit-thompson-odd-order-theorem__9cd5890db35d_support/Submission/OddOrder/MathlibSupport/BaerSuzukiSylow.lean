import Submission.OddOrder.BG.AppendixAB.TwoGenerator
import Submission.OddOrder.MathlibSupport.ConjugacyClassGenerated

/-!
The initial Sylow selection in the Baer-Suzuki induction.
-/

namespace Submission.OddOrder.MathlibSupport

open Submission.OddOrder.BG.AppendixAB

variable {G : Type*} [Group G]

/-- Every pair in the conjugacy class of `x` generates a p-group. -/
def ConjugacyPairsArePGroup (p : ℕ) (x : G) : Prop :=
  ∀ a ∈ conjugatesOf x, ∀ b ∈ conjugatesOf x,
    IsPGroup p (pairGenerated a b)

theorem zpowers_isPGroup_of_conjugacyPairsArePGroup {p : ℕ} {x : G}
    (hx : ConjugacyPairsArePGroup p x) : IsPGroup p (Subgroup.zpowers x) := by
  have hxx := hx x mem_conjugatesOf_self x mem_conjugatesOf_self
  rw [pairGenerated, sup_idem] at hxx
  exact hxx

/-- Under the Baer-Suzuki pair hypothesis, some Sylow subgroup of the group
generated by the conjugacy class contains `x`. -/
theorem exists_sylow_conjugacyClassGenerated_mem {p : ℕ} {x : G}
    (hx : ConjugacyPairsArePGroup p x) :
    ∃ P : Sylow p (conjugacyClassGenerated x),
      (⟨x, mem_conjugacyClassGenerated x⟩ : conjugacyClassGenerated x) ∈ P := by
  let E : Subgroup G := conjugacyClassGenerated x
  let X : Subgroup E := (Subgroup.zpowers x).comap E.subtype
  have hX : IsPGroup p X := by
    exact (zpowers_isPGroup_of_conjugacyPairsArePGroup hx).comap_subtype
  obtain ⟨P, hXP⟩ := hX.exists_le_sylow
  refine ⟨P, hXP ?_⟩
  change x ∈ Subgroup.zpowers x
  exact Subgroup.mem_zpowers x

end Submission.OddOrder.MathlibSupport
