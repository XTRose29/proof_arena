import Submission.OddOrder.MathlibSupport.BaerSuzukiNormalizerGenerated
import Submission.OddOrder.MathlibSupport.SubgroupCardinality

/-!
Cardinality induction on the normalizer in the Baer-Suzuki proof.
-/

namespace Submission.OddOrder.MathlibSupport

universe u

variable {G : Type u} [Group G] [Finite G]

/-- The strong-induction hypothesis on smaller finite groups makes the
subgroup generated by normalizing conjugates into a p-group. -/
theorem normalizerConjugacyGenerated_isPGroup_of_card_induction
    {p : ℕ} {x : G} {D : Set G}
    (hpairs : ConjugacyPairsArePGroup p x)
    (hproper : ¬(⊤ : Subgroup G) ≤ Subgroup.normalizer D)
    (ih : ∀ {K : Type u} [Group K] [Finite K] {a : K},
      Nat.card K < Nat.card G → ConjugatePairsArePGroup p a →
        a ∈ pCore p K) :
    IsPGroup p (normalizerConjugacyGenerated x D) := by
  have hcard : Nat.card (Subgroup.normalizer D) < Nat.card G :=
    natCard_normalizer_lt_of_not_top_le hproper
  apply normalizerConjugacyGenerated_isPGroup_of_mem_pCore
  intro a ha haN
  apply ih hcard
  exact conjugatePairsArePGroup_subtype_of_mem_conjugatesOf
    hpairs ha haN

end Submission.OddOrder.MathlibSupport
