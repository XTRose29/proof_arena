import Mathlib
import ChallengeDeps

open Set Geometry Filter
open scoped Topology

namespace Submission.Polytope

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

noncomputable def faceVertices (S : Finset E) (F : Set E) : Finset E := by
  classical
  exact S.filter (· ∈ F)

omit [NormedAddCommGroup E] [NormedSpace ℝ E] in
@[simp]
theorem mem_faceVertices (S : Finset E) (F : Set E) (x : E) :
    x ∈ faceVertices S F ↔ x ∈ S ∧ x ∈ F := by
  classical
  simp [faceVertices]

/-- An exposed face of a finite convex hull is generated by exactly the
original generators that it contains. -/
theorem convexHull_filter_mem_exposed (S : Finset E) {F : Set E}
    (hF : IsExposed ℝ (convexHull ℝ (S : Set E)) F) :
    convexHull ℝ (faceVertices S F : Set E) = F := by
  classical
  apply Subset.antisymm
  · apply convexHull_min
    · intro x hx
      exact (mem_faceVertices S F x).mp (Finset.mem_coe.mp hx) |>.2
    · exact hF.convex (convex_convexHull ℝ (S : Set E))
  · intro x hxF
    obtain rfl | hFne := F.eq_empty_or_nonempty
    · exact hxF.elim
    obtain ⟨l, hFl⟩ := hF hFne
    have hxmax : ∀ y ∈ convexHull ℝ (S : Set E), l y ≤ l x := by
      exact (hFl ▸ hxF).2
    obtain ⟨w, hw_nonneg, hw_sum, hw_center⟩ :=
      Finset.mem_convexHull'.mp (hF.subset hxF)
    have hvertices_subset : faceVertices S F ⊆ S := by
      intro y hy
      exact (mem_faceVertices S F y).mp hy |>.1
    have hw_eq_zero (y : E) (hyS : y ∈ S) (hyF : y ∉ F) : w y = 0 := by
      apply le_antisymm
      · apply not_lt.mp
        intro hwy
        have hly : l y < l x := by
          refine lt_of_le_of_ne (hxmax y (subset_convexHull ℝ (S : Set E) ?_)) ?_
          · exact Finset.mem_coe.mpr hyS
          · intro hEq
            apply hyF
            rw [hFl]
            exact ⟨subset_convexHull ℝ (S : Set E) (Finset.mem_coe.mpr hyS),
              fun z hz => (hxmax z hz).trans hEq.symm.le⟩
        have hterm (z : E) (hzS : z ∈ S) : w z * l z ≤ w z * l x :=
          mul_le_mul_of_nonneg_left (hxmax z
            (subset_convexHull ℝ (S : Set E) (Finset.mem_coe.mpr hzS)))
              (hw_nonneg z hzS)
        have hsum_lt : ∑ z ∈ S, w z * l z < ∑ z ∈ S, w z * l x := by
          exact Finset.sum_lt_sum hterm ⟨y, hyS, mul_lt_mul_of_pos_left hly hwy⟩
        have hmap : ∑ z ∈ S, w z * l z = l x := by
          simpa only [map_sum, map_smul, id_eq, smul_eq_mul] using congrArg l hw_center
        rw [hmap, ← Finset.sum_mul, hw_sum, one_mul] at hsum_lt
        exact lt_irrefl _ hsum_lt
      · exact hw_nonneg y hyS
    apply Finset.mem_convexHull'.mpr
    refine ⟨w, ?_, ?_, ?_⟩
    · intro y hy
      exact hw_nonneg y ((mem_faceVertices S F y).mp hy).1
    · calc
        ∑ y ∈ faceVertices S F, w y = ∑ y ∈ S, w y :=
          Finset.sum_subset hvertices_subset fun y hyS hyfilter =>
            hw_eq_zero y hyS fun hyF => hyfilter <|
              (mem_faceVertices S F y).mpr ⟨hyS, hyF⟩
        _ = 1 := hw_sum
    · calc
        ∑ y ∈ faceVertices S F, w y • y = ∑ y ∈ S, w y • y :=
          Finset.sum_subset hvertices_subset fun y hyS hyfilter => by
            rw [hw_eq_zero y hyS fun hyF => hyfilter <|
              (mem_faceVertices S F y).mpr ⟨hyS, hyF⟩, zero_smul]
        _ = x := hw_center

/-- A nonempty convex extreme subset of a finite convex hull is generated by
the original vertices that it contains. -/
theorem convexHull_filter_mem_extreme (S : Finset E) {F : Set E}
    (hFconv : Convex ℝ F) (hFext : IsExtreme ℝ (convexHull ℝ (S : Set E)) F) :
    convexHull ℝ (faceVertices S F : Set E) = F := by
  classical
  apply Subset.antisymm
  · exact convexHull_min
      (fun x hx => (mem_faceVertices S F x).mp (Finset.mem_coe.mp hx) |>.2) hFconv
  · intro x hxF
    let inside : Finset E := faceVertices S F
    let outside : Finset E := S.filter (· ∉ F)
    have hsplit : (S : Set E) = (inside : Set E) ∪ (outside : Set E) := by
      ext y
      simp only [inside, outside, faceVertices, Finset.mem_coe, Finset.mem_filter,
        Set.mem_union]
      tauto
    have hout_subset : (outside : Set E) ⊆ convexHull ℝ (S : Set E) \ F := by
      intro y hy
      have hy' := Finset.mem_filter.mp (Finset.mem_coe.mp hy)
      exact ⟨subset_convexHull ℝ _ (Finset.mem_coe.mpr hy'.1), hy'.2⟩
    have hout_disjoint : convexHull ℝ (outside : Set E) ⊆
        convexHull ℝ (S : Set E) \ F :=
      convexHull_min hout_subset
        (hFext.convex_sdiff (convex_convexHull ℝ (S : Set E)))
    by_cases hin : inside.Nonempty
    · by_cases hout : outside.Nonempty
      · have hxjoin : x ∈ convexJoin ℝ
            (convexHull ℝ (inside : Set E)) (convexHull ℝ (outside : Set E)) := by
          have hin' : (inside : Set E).Nonempty :=
            ⟨hin.choose, Finset.mem_coe.mpr hin.choose_spec⟩
          have hout' : (outside : Set E).Nonempty :=
            ⟨hout.choose, Finset.mem_coe.mpr hout.choose_spec⟩
          rw [← convexHull_union hin' hout', ← hsplit]
          exact hFext.subset hxF
        obtain ⟨a, ha, b, hb, r, s, hr, hs, hrs, hx⟩ := mem_convexJoin.mp hxjoin
        have haF : a ∈ F := convexHull_min
          (fun y hy => (mem_faceVertices S F y).mp (Finset.mem_coe.mp hy) |>.2) hFconv ha
        have hbnot : b ∉ F := (hout_disjoint hb).2
        have hrpos : 0 < r := by
          by_contra hrn
          have hrzero : r = 0 := le_antisymm (not_lt.mp hrn) hr
          have hsone : s = 1 := by linarith
          apply hbnot
          have hxb : x = b := by simpa [hrzero, hsone] using hx.symm
          exact hxb ▸ hxF
        by_cases hspos : 0 < s
        · have hxseg : x ∈ openSegment ℝ a b :=
            ⟨r, s, hrpos, hspos, hrs, hx⟩
          exact (hbnot <| hFext.right_mem_of_mem_openSegment
            (hFext.subset haF) (hout_disjoint hb).1 hxF hxseg).elim
        · have hszero : s = 0 := le_antisymm (not_lt.mp hspos) hs
          have hrone : r = 1 := by linarith
          have hxa : x = a := by simpa [hszero, hrone] using hx.symm
          exact hxa ▸ ha
      · have hout_empty : outside = ∅ := Finset.not_nonempty_iff_eq_empty.mp hout
        have hinside_all : inside = S := by
          apply Finset.Subset.antisymm
          · intro y hy
            exact (mem_faceVertices S F y).mp hy |>.1
          · intro y hyS
            by_contra hyin
            have : y ∈ outside := Finset.mem_filter.mpr ⟨hyS, fun hyF => hyin <|
              (mem_faceVertices S F y).mpr ⟨hyS, hyF⟩⟩
            simp [hout_empty] at this
        simpa [inside, hinside_all] using hFext.subset hxF
    · have hin_empty : inside = ∅ := Finset.not_nonempty_iff_eq_empty.mp hin
      have hSoutside : S ⊆ outside := by
        intro y hyS
        apply Finset.mem_filter.mpr
        refine ⟨hyS, ?_⟩
        intro hyF
        have : y ∈ inside := (mem_faceVertices S F y).mpr ⟨hyS, hyF⟩
        simp [hin_empty] at this
      have hxout : x ∈ convexHull ℝ (outside : Set E) :=
        convexHull_mono (fun y hy => Finset.mem_coe.mpr <| hSoutside <|
          Finset.mem_coe.mp hy) (hFext.subset hxF)
      exact (hout_disjoint hxout).2 hxF |>.elim

/-- An extreme subset containing an interior point of a convex set is the
whole convex set. -/
theorem extreme_eq_of_mem_interior {A B : Set E}
    (hAB : IsExtreme ℝ A B) {x : E} (hxA : x ∈ interior A) (hxB : x ∈ B) :
    B = A := by
  apply Subset.antisymm hAB.subset
  intro y hyA
  by_cases hyx : y = x
  · simpa [hyx] using hxB
  have hline : AffineMap.lineMap y x (1 : ℝ) = x := AffineMap.lineMap_apply_one y x
  obtain ⟨t, ht, hyt⟩ :=
    (AffineMap.lineMap_continuous.tendsto' (1 : ℝ) x hline).eventually_mem
      (mem_interior_iff_mem_nhds.mp hxA) |>.exists_gt
  apply hAB.left_mem_of_mem_openSegment hyA hyt hxB
  nth_rw 1 [← AffineMap.lineMap_apply_zero (k := ℝ) y x, ← image_openSegment]
  exact ⟨1, Ioo_subset_openSegment ⟨zero_lt_one, ht⟩, hline⟩

/-- Intrinsic-interior version of `extreme_eq_of_mem_interior`. -/
theorem extreme_eq_of_mem_intrinsicInterior {A B : Set E}
    (hAB : IsExtreme ℝ A B) {x : E} (hxA : x ∈ intrinsicInterior ℝ A)
    (hxB : x ∈ B) : B = A := by
  have hxmem : x ∈ A := intrinsicInterior_subset hxA
  letI : Nonempty (affineSpan ℝ A) :=
    ⟨⟨x, subset_affineSpan ℝ A hxmem⟩⟩
  let inclusion : affineSpan ℝ A →ᵃ[ℝ] E :=
    AffineSubspace.subtype (affineSpan ℝ A)
  let A' : Set (affineSpan ℝ A) := inclusion ⁻¹' A
  let B' : Set (affineSpan ℝ A) := inclusion ⁻¹' B
  obtain ⟨x', hx'int, hx'eq⟩ := mem_intrinsicInterior.mp hxA
  let e := AffineIsometryEquiv.constVSub ℝ x'
  let Av := e '' A'
  let Bv := e '' B'
  have hABv : IsExtreme ℝ Av Bv := by
    constructor
    · rintro _ ⟨z, hzB', rfl⟩
      exact ⟨z, hAB.subset hzB', rfl⟩
    · rintro _ ⟨y, hyA', rfl⟩ _ ⟨z, hzA', rfl⟩ _ ⟨w, hwB', rfl⟩ hwseg
      have hwseg' : (w : E) ∈ openSegment ℝ (y : E) (z : E) := by
        rw [openSegment_eq_image_lineMap] at hwseg
        obtain ⟨t, ht, htw⟩ := hwseg
        rw [openSegment_eq_image_lineMap]
        refine ⟨t, ht, ?_⟩
        have hu : AffineMap.lineMap y z t = w := by
          apply e.injective
          change e.toAffineEquiv (AffineMap.lineMap y z t) = e.toAffineEquiv w
          rw [e.toAffineEquiv.apply_lineMap]
          simpa only [AffineIsometryEquiv.coe_toAffineEquiv] using htw
        calc
          AffineMap.lineMap (y : E) (z : E) t =
              inclusion (AffineMap.lineMap y z t) := by
                exact (inclusion.apply_lineMap y z t).symm
          _ = inclusion w := congrArg inclusion hu
          _ = (w : E) := rfl
      exact ⟨y, hAB.left_mem_of_mem_openSegment hyA' hzA' hwB' hwseg', rfl⟩
  have hxvint : e x' ∈ interior Av := by
    change e x' ∈ interior (e '' A')
    rw [← AffineIsometryEquiv.coe_toHomeomorph, ← e.toHomeomorph.image_interior]
    exact ⟨x', hx'int, rfl⟩
  have hxvB : e x' ∈ Bv := by
    refine ⟨x', ?_, rfl⟩
    change (x' : E) ∈ B
    simpa only [hx'eq] using hxB
  have hBvAv : Bv = Av := extreme_eq_of_mem_interior hABv hxvint hxvB
  apply Subset.antisymm hAB.subset
  intro y hyA
  let y' : affineSpan ℝ A := ⟨y, subset_affineSpan ℝ A hyA⟩
  have heyAv : e y' ∈ Av := ⟨y', hyA, rfl⟩
  obtain ⟨z, hzB', hzy⟩ : e y' ∈ Bv := hBvAv ▸ heyAv
  have hzy' : z = y' := e.injective hzy
  change (z : E) ∈ B at hzB'
  simpa [hzy', y'] using hzB'

/-- A point carrying a nonzero coefficient in a vanishing affine relation
lies in the affine span of the other points in that relation. -/
theorem mem_affineSpan_erase_of_weightedVSub_eq_zero {J : Type*}
    [DecidableEq J] (p : J → E) (s : Finset J) (w : J → ℝ) {i : J} (hi : i ∈ s)
    (hwi : w i ≠ 0) (hsum : ∑ j ∈ s, w j = 0)
    (hweighted : s.weightedVSub p w = 0) :
    p i ∈ affineSpan ℝ (p '' (s.erase i : Set J)) := by
  classical
  let t := s.erase i
  let p' : t → E := fun j => p j
  let w' : t → ℝ := fun j => -(w i)⁻¹ * w j
  have hsum_erase : ∑ j ∈ s.erase i, w j = -w i := by
    rw [Finset.sum_erase_eq_sub hi, hsum, zero_sub]
  have hw' : ∑ j, w' j = 1 := by
    rw [Finset.univ_eq_attach]
    simp only [w', Finset.sum_attach, ← Finset.mul_sum, t, hsum_erase]
    field_simp
  have hlinear : ∑ j ∈ s, w j • p j = 0 := by
    simpa only [Finset.weightedVSub_eq_linear_combination s hsum] using hweighted
  have hip : w i • p i = -∑ j ∈ s.erase i, w j • p j := by
    have herase : ∑ j ∈ s.erase i, w j • p j = -(w i • p i) := by
      rw [Finset.sum_erase_eq_sub hi, hlinear, zero_sub]
    calc
      w i • p i = -(-(w i • p i)) := by simp
      _ = -∑ j ∈ s.erase i, w j • p j :=
        congrArg (fun z : E => -z) herase.symm
  have hp' : p i = ∑ j, w' j • p' j := by
    rw [Finset.univ_eq_attach]
    simp only [w', p', t]
    calc
      p i = (w i)⁻¹ • (w i • p i) := by rw [inv_smul_smul₀ hwi]
      _ = (w i)⁻¹ • (-∑ j ∈ s.erase i, w j • p j) := by rw [hip]
      _ = ∑ j ∈ s.erase i, (-(w i)⁻¹ * w j) • p j := by
        rw [smul_neg, Finset.smul_sum, ← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro j hj
        simp only [smul_smul]
        simp only [neg_smul, neg_mul]
      _ = ∑ j ∈ (s.erase i).attach, (-(w i)⁻¹ * w j) • p j := by
        exact (Finset.sum_attach (s.erase i)
          (fun j : J => (-(w i)⁻¹ * w j) • p j)).symm
  have hmem : p i ∈ affineSpan ℝ (Set.range p') := by
    rw [hp', ← Finset.affineCombination_eq_linear_combination Finset.univ p' w' hw']
    exact affineCombination_mem_affineSpan hw' p'
  have hrange : Set.range p' = p '' (t : Set J) := by
    ext y
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨j, j.2, rfl⟩
    · rintro ⟨j, hj, rfl⟩
      exact ⟨⟨j, hj⟩, rfl⟩
  rw [hrange] at hmem
  exact hmem

/-- The open segment from an intrinsic-interior point to a point of a
convex set remains in the intrinsic interior. -/
theorem Convex.openSegment_intrinsicInterior_self_subset_intrinsicInterior
    {A : Set E} (hA : Convex ℝ A) {x y : E}
    (hx : x ∈ intrinsicInterior ℝ A) (hy : y ∈ A) :
    openSegment ℝ x y ⊆ intrinsicInterior ℝ A := by
  intro z hz
  have hxA : x ∈ A := intrinsicInterior_subset hx
  letI : Nonempty (affineSpan ℝ A) :=
    ⟨⟨x, subset_affineSpan ℝ A hxA⟩⟩
  let inclusion : affineSpan ℝ A →ᵃ[ℝ] E :=
    AffineSubspace.subtype (affineSpan ℝ A)
  let A' : Set (affineSpan ℝ A) := inclusion ⁻¹' A
  obtain ⟨x', hx'int, hx'eq⟩ := mem_intrinsicInterior.mp hx
  let y' : affineSpan ℝ A := ⟨y, subset_affineSpan ℝ A hy⟩
  let e := AffineIsometryEquiv.constVSub ℝ x'
  let φ : (affineSpan ℝ A).direction →ᵃ[ℝ] E :=
    inclusion.comp e.symm.toAffineEquiv.toAffineMap
  let Av : Set (affineSpan ℝ A).direction := e '' A'
  have hAv_eq : Av = φ ⁻¹' A := by
    ext v
    constructor
    · rintro ⟨u, hu, rfl⟩
      change inclusion u ∈ A at hu
      change inclusion (e.symm (e u)) ∈ A
      simpa only [e.symm_apply_apply] using hu
    · intro hv
      refine ⟨e.symm v, ?_, e.apply_symm_apply v⟩
      change inclusion (e.symm v) ∈ A at hv
      exact hv
  have hAv : Convex ℝ Av := by
    rw [hAv_eq]
    exact hA.affine_preimage φ
  have hxv : e x' ∈ interior Av := by
    change e x' ∈ interior (e '' A')
    rw [← AffineIsometryEquiv.coe_toHomeomorph, ← e.toHomeomorph.image_interior]
    exact ⟨x', hx'int, rfl⟩
  have hyv : e y' ∈ Av := by
    refine ⟨y', ?_, rfl⟩
    exact hy
  have hzspan : z ∈ affineSpan ℝ A := by
    apply (affineSpan ℝ A).convex.segment_subset
      (subset_affineSpan ℝ A hxA) (subset_affineSpan ℝ A hy)
    exact openSegment_subset_segment ℝ x y hz
  let z' : affineSpan ℝ A := ⟨z, hzspan⟩
  have hzv : e z' ∈ openSegment ℝ (e x') (e y') := by
    rw [openSegment_eq_image_lineMap] at hz ⊢
    obtain ⟨t, ht, htz⟩ := hz
    refine ⟨t, ht, ?_⟩
    have hz' : AffineMap.lineMap x' y' t = z' := by
      apply Subtype.ext
      change AffineMap.lineMap (x' : E) (y' : E) t = z
      simpa only [hx'eq] using htz
    calc
      AffineMap.lineMap (e x') (e y') t =
          e.toAffineEquiv (AffineMap.lineMap x' y' t) := by
            rw [e.toAffineEquiv.apply_lineMap]
            rfl
      _ = e z' := by rw [hz']; rfl
  have hzvint : e z' ∈ interior Av :=
    hAv.openSegment_interior_self_subset_interior hxv hyv hzv
  have hz'int : z' ∈ interior A' := by
    have hzimage : e z' ∈ e '' interior A' := by
      change e.toHomeomorph z' ∈ e.toHomeomorph '' interior A'
      rw [e.toHomeomorph.image_interior]
      exact hzvint
    obtain ⟨u, hu, huz⟩ := hzimage
    exact e.injective huz |>.symm ▸ hu
  exact mem_intrinsicInterior.mpr ⟨z', hz'int, rfl⟩

/-- A ray from an intrinsic-interior point meets the intrinsic frontier at
most once. This coefficient form is convenient for barycentric
subdivision. -/
theorem radial_decomposition_unique {A : Set E} (hA : Convex ℝ A)
    {c y z : E} (hc : c ∈ intrinsicInterior ℝ A) (hy : y ∈ A) (hz : z ∈ A)
    (hy' : y ∉ intrinsicInterior ℝ A) (hz' : z ∉ intrinsicInterior ℝ A)
    {a b : ℝ} (ha₀ : 0 ≤ a) (ha₁ : a < 1) (hb₀ : 0 ≤ b) (hb₁ : b < 1)
    (h : a • c + (1 - a) • y = b • c + (1 - b) • z) :
    a = b ∧ y = z := by
  have no_lt (u v : E) (hu : u ∈ A) (hv : v ∈ A)
      (hu' : u ∉ intrinsicInterior ℝ A) {r s : ℝ}
      (hr₀ : 0 ≤ r) (hr₁ : r < 1) (hs₀ : 0 ≤ s) (hs₁ : s < 1)
      (hrs : r • c + (1 - r) • u = s • c + (1 - s) • v) : ¬ r < s := by
    intro hrs_lt
    have hrden : 1 - r ≠ 0 := by linarith
    let lam : ℝ := (s - r) / (1 - r)
    let mu : ℝ := (1 - s) / (1 - r)
    have hlam : 0 < lam := by
      exact div_pos (sub_pos.mpr hrs_lt) (sub_pos.mpr hr₁)
    have hmu : 0 < mu := by
      exact div_pos (sub_pos.mpr hs₁) (sub_pos.mpr hr₁)
    have hlammu : lam + mu = 1 := by
      dsimp [lam, mu]
      field_simp [hrden]
      ring
    have hmul : (1 - r) • u = (s - r) • c + (1 - s) • v := by
      calc
        (1 - r) • u = (r • c + (1 - r) • u) - r • c := by module
        _ = (s • c + (1 - s) • v) - r • c := by rw [hrs]
        _ = (s - r) • c + (1 - s) • v := by module
    have hucombo : lam • c + mu • v = u := by
      rw [← inv_smul_smul₀ hrden u, hmul, smul_add]
      dsimp [lam, mu]
      simp only [smul_smul, div_eq_mul_inv]
      module
    apply hu'
    apply Submission.Polytope.Convex.openSegment_intrinsicInterior_self_subset_intrinsicInterior
      hA hc hv
    exact ⟨lam, mu, hlam, hmu, hlammu, hucombo⟩
  have hab : a = b := by
    apply le_antisymm
    · exact not_lt.mp <| no_lt z y hz hy hz' hb₀ hb₁ ha₀ ha₁ h.symm
    · exact not_lt.mp <| no_lt y z hy hz hy' ha₀ ha₁ hb₀ hb₁ h
  subst b
  refine ⟨rfl, ?_⟩
  have hscale : (1 - a) • y = (1 - a) • z := by
    calc
      (1 - a) • y = (a • c + (1 - a) • y) - a • c := by module
      _ = (a • c + (1 - a) • z) - a • c := by rw [h]
      _ = (1 - a) • z := by module
  exact smul_right_injective E (sub_ne_zero.mpr (ne_of_gt ha₁)) hscale

/-- A nonempty convex face of the polytope generated by `S`. -/
@[ext]
structure ExposedFace (S : Finset E) where
  carrier : Set E
  nonempty : carrier.Nonempty
  convex_carrier : Convex ℝ carrier
  extreme_carrier : IsExtreme ℝ (convexHull ℝ (S : Set E)) carrier

namespace ExposedFace

instance (S : Finset E) : SetLike (ExposedFace S) E where
  coe F := F.carrier
  coe_injective := by
    intro F G h
    exact ExposedFace.ext h

noncomputable def vertexSubtype (S : Finset E) (F : ExposedFace S) : Finset S := by
  classical
  exact S.attach.filter fun x => x.1 ∈ F

@[simp]
theorem mem_vertexSubtype (S : Finset E) (F : ExposedFace S) (x : S) :
    x ∈ F.vertexSubtype S ↔ x.1 ∈ F := by
  classical
  simp [vertexSubtype]

theorem vertexSubtype_injective (S : Finset E) :
    Function.Injective (vertexSubtype S) := by
  intro F G h
  apply ExposedFace.ext
  rw [← convexHull_filter_mem_extreme S F.convex_carrier F.extreme_carrier,
    ← convexHull_filter_mem_extreme S G.convex_carrier G.extreme_carrier]
  congr 1
  ext x
  constructor
  · intro hx
    have hxS : x ∈ S := (mem_faceVertices S F x).mp hx |>.1
    let xs : S := ⟨x, hxS⟩
    have hxs : xs ∈ F.vertexSubtype S := (mem_vertexSubtype S F xs).mpr <|
      (mem_faceVertices S F x).mp hx |>.2
    have : xs ∈ G.vertexSubtype S := by simpa only [h] using hxs
    exact (mem_faceVertices S G x).mpr ⟨hxS, (mem_vertexSubtype S G xs).mp this⟩
  · intro hx
    have hxS : x ∈ S := (mem_faceVertices S G x).mp hx |>.1
    let xs : S := ⟨x, hxS⟩
    have hxs : xs ∈ G.vertexSubtype S := (mem_vertexSubtype S G xs).mpr <|
      (mem_faceVertices S G x).mp hx |>.2
    have : xs ∈ F.vertexSubtype S := by simpa only [h] using hxs
    exact (mem_faceVertices S F x).mpr ⟨hxS, (mem_vertexSubtype S F xs).mp this⟩

noncomputable instance (S : Finset E) : Fintype (ExposedFace S) :=
  Fintype.ofInjective (vertexSubtype S) (vertexSubtype_injective S)

instance (S : Finset E) : PartialOrder (ExposedFace S) :=
  PartialOrder.lift (fun F => F.carrier) fun _ _ => ExposedFace.ext

@[simp]
theorem le_iff_subset (S : Finset E) (F G : ExposedFace S) : F ≤ G ↔ F.carrier ⊆ G.carrier :=
  Iff.rfl

theorem convex (S : Finset E) (F : ExposedFace S) : Convex ℝ F.carrier :=
  F.convex_carrier

variable [hfd : FiniteDimensional ℝ E]

/-- A choice of intrinsic-interior point that depends only on the carrier
set. This makes barycentric subdivisions agree on shared polytope faces. -/
noncomputable def convexCenter (A : Set E) : E :=
  by
    classical
    exact if h : A.Nonempty ∧ Convex ℝ A then
      Classical.choose <| h.1.intrinsicInterior h.2
    else 0

theorem convexCenter_mem_intrinsicInterior (A : Set E) (hA : A.Nonempty)
    (hconv : Convex ℝ A) :
    convexCenter A ∈ intrinsicInterior ℝ A := by
  rw [convexCenter, dif_pos ⟨hA, hconv⟩]
  exact Classical.choose_spec <| hA.intrinsicInterior hconv

noncomputable def center (S : Finset E) (F : ExposedFace S) : E :=
  convexCenter F.carrier

theorem center_mem_intrinsicInterior (S : Finset E) (F : ExposedFace S) :
    F.center S ∈ intrinsicInterior ℝ F.carrier :=
  convexCenter_mem_intrinsicInterior F.carrier F.nonempty F.convex_carrier

include hfd in
theorem center_eq_of_carrier_eq {S T : Finset E} (F : ExposedFace S)
    (G : ExposedFace T) (h : F.carrier = G.carrier) :
    F.center S = G.center T := by
  simp only [center, h]

theorem center_mem (S : Finset E) (F : ExposedFace S) : F.center S ∈ F :=
  intrinsicInterior_subset (center_mem_intrinsicInterior S F)

theorem center_mem_iff_le (S : Finset E) (F H : ExposedFace S) :
    F.center S ∈ H ↔ F ≤ H := by
  constructor
  · intro hcH
    have hIambient : IsExtreme ℝ (convexHull ℝ (S : Set E))
        (F.carrier ∩ H.carrier) :=
      F.extreme_carrier.inter H.extreme_carrier
    have hIext : IsExtreme ℝ F.carrier (F.carrier ∩ H.carrier) :=
      hIambient.mono F.extreme_carrier.subset inter_subset_left
    have hcI : F.center S ∈ F.carrier ∩ H.carrier := ⟨F.center_mem S, hcH⟩
    have heq : F.carrier ∩ H.carrier = F.carrier :=
      extreme_eq_of_mem_intrinsicInterior hIext (F.center_mem_intrinsicInterior S) hcI
    intro x hxF
    have hxI : x ∈ F.carrier ∩ H.carrier := heq.symm ▸ hxF
    exact hxI.2
  · intro hFH
    exact hFH (F.center_mem S)

/-- Regard a face below `H` as a face of the polytope `H` itself. -/
def restrictFaceTo (S : Finset E) (H F : ExposedFace S) (hFH : F ≤ H) :
    ExposedFace (faceVertices S H.carrier) where
  carrier := F.carrier
  nonempty := F.nonempty
  convex_carrier := F.convex_carrier
  extreme_carrier := by
    rw [convexHull_filter_mem_extreme S H.convex_carrier H.extreme_carrier]
    exact F.extreme_carrier.mono H.extreme_carrier.subset hFH

theorem center_restrictFaceTo (S : Finset E) (H F : ExposedFace S) (hFH : F ≤ H) :
    (restrictFaceTo S H F hFH).center (faceVertices S H.carrier) = F.center S := by
  exact (center_eq_of_carrier_eq (restrictFaceTo S H F hFH) F rfl).symm

omit [FiniteDimensional ℝ E] in
theorem isCompact (S : Finset E) (F : ExposedFace S) : IsCompact F.carrier := by
  rw [← convexHull_filter_mem_extreme S F.convex_carrier F.extreme_carrier]
  exact (faceVertices S F.carrier).finite_toSet.isCompact_convexHull ℝ

/-- Every point of a face is either its chosen center or lies on the segment
from that center to a point of the intrinsic frontier. -/
theorem radial_decomposition (S : Finset E) (F : ExposedFace S) {x : E}
    (hx : x ∈ F) :
    x = F.center S ∨
      ∃ (a : ℝ) (y : E), 0 ≤ a ∧ a < 1 ∧ y ∈ F ∧
        y ∉ intrinsicInterior ℝ F.carrier ∧
        x = a • F.center S + (1 - a) • y := by
  by_cases hxc : x = F.center S
  · exact Or.inl hxc
  right
  obtain ⟨c, hcint, hceq⟩ := mem_intrinsicInterior.mp (F.center_mem_intrinsicInterior S)
  letI : Nonempty (affineSpan ℝ F.carrier) := ⟨c⟩
  let inclusion : affineSpan ℝ F.carrier →ᵃ[ℝ] E :=
    AffineSubspace.subtype (affineSpan ℝ F.carrier)
  let A : Set (affineSpan ℝ F.carrier) := inclusion ⁻¹' F.carrier
  let e := AffineIsometryEquiv.constVSub ℝ c
  let Av : Set (affineSpan ℝ F.carrier).direction := e '' A
  let φ : (affineSpan ℝ F.carrier).direction →ᵃ[ℝ] E :=
    inclusion.comp e.symm.toAffineEquiv.toAffineMap
  let x' : affineSpan ℝ F.carrier := ⟨x, subset_affineSpan ℝ F.carrier hx⟩
  let xv : (affineSpan ℝ F.carrier).direction := e x'
  have hAv_eq : Av = φ ⁻¹' F.carrier := by
    ext v
    constructor
    · rintro ⟨u, hu, rfl⟩
      change inclusion u ∈ F.carrier at hu
      change inclusion (e.symm (e u)) ∈ F.carrier
      simpa only [e.symm_apply_apply] using hu
    · intro hv
      refine ⟨e.symm v, ?_, e.apply_symm_apply v⟩
      change inclusion (e.symm v) ∈ F.carrier at hv
      exact hv
  have hAvconv : Convex ℝ Av := by
    rw [hAv_eq]
    exact F.convex_carrier.affine_preimage φ
  have hAimage : Subtype.val '' A = F.carrier := by
    ext z
    constructor
    · rintro ⟨z', hz', rfl⟩
      exact hz'
    · intro hz
      exact ⟨⟨z, subset_affineSpan ℝ F.carrier hz⟩, hz, rfl⟩
  have hAcompact : IsCompact A := by
    apply Topology.IsEmbedding.subtypeVal.isCompact_iff.mpr
    rw [hAimage]
    exact F.isCompact S
  have hAvcompact : IsCompact Av := hAcompact.image e.continuous
  have hcAvint : (0 : (affineSpan ℝ F.carrier).direction) ∈ interior Av := by
    have : e c ∈ interior (e '' A) := by
      rw [← AffineIsometryEquiv.coe_toHomeomorph, ← e.toHomeomorph.image_interior]
      exact ⟨c, hcint, rfl⟩
    simpa [Av, e] using this
  have hAvnhds : Av ∈ 𝓝 (0 : (affineSpan ℝ F.carrier).direction) :=
    Filter.mem_of_superset (isOpen_interior.mem_nhds hcAvint) interior_subset
  have hxA : x' ∈ A := hx
  have hxvAv : xv ∈ Av := ⟨x', hxA, rfl⟩
  have hxv_ne : xv ≠ 0 := by
    intro hxv
    apply hxc
    have hxc' : x' = c := by
      apply e.injective
      simpa [xv, e] using hxv
    exact (congrArg (fun q : affineSpan ℝ F.carrier ↦ (q : E)) hxc').trans hceq
  let g : ℝ := gauge Av xv
  have hgpos : 0 < g := by
    exact (gauge_pos (absorbent_nhds_zero hAvnhds)
      (hAvcompact.isVonNBounded ℝ)).mpr hxv_ne
  have hgle : g ≤ 1 := gauge_le_one_of_mem hxvAv
  let yv : (affineSpan ℝ F.carrier).direction := g⁻¹ • xv
  have hgyv : g • yv = xv := by
    dsimp [yv]
    rw [smul_smul, mul_inv_cancel₀ hgpos.ne', one_smul]
  have hgyv_gauge : gauge Av yv = 1 := by
    dsimp [yv]
    rw [gauge_smul_of_nonneg (inv_nonneg.mpr hgpos.le)]
    change g⁻¹ * g = 1
    exact inv_mul_cancel₀ hgpos.ne'
  have hyvfrontier : yv ∈ frontier Av :=
    (gauge_eq_one_iff_mem_frontier hAvconv hAvnhds).mp hgyv_gauge
  have hyvAv : yv ∈ Av := hAvcompact.isClosed.closure_subset hyvfrontier.1
  let y' : affineSpan ℝ F.carrier := e.symm yv
  let y : E := y'
  have hyA : y' ∈ A := by
    obtain ⟨z, hzA, hzy⟩ := hyvAv
    have hz : z = y' := by
      apply e.injective
      simpa [y'] using hzy
    exact hz ▸ hzA
  have hyF : y ∈ F := hyA
  have hy_not : y ∉ intrinsicInterior ℝ F.carrier := by
    intro hyint
    obtain ⟨z, hzint, hzeq⟩ := mem_intrinsicInterior.mp hyint
    have hz : z = y' := Subtype.ext hzeq
    apply hyvfrontier.2
    have : e y' ∈ interior (e '' A) := by
      rw [← AffineIsometryEquiv.coe_toHomeomorph, ← e.toHomeomorph.image_interior]
      exact ⟨y', hz ▸ hzint, rfl⟩
    simpa [y', Av] using this
  have hline : AffineMap.lineMap c y' g = x' := by
    apply e.injective
    change e.toAffineEquiv (AffineMap.lineMap c y' g) = e.toAffineEquiv x'
    rw [e.toAffineEquiv.apply_lineMap]
    rw [show e.toAffineEquiv c = 0 by simp [e],
      show e.toAffineEquiv y' = yv by simp [y'],
      show e.toAffineEquiv x' = xv by rfl]
    simpa [AffineMap.lineMap_apply] using hgyv
  refine ⟨1 - g, y, sub_nonneg.mpr hgle, by linarith, hyF, hy_not, ?_⟩
  have hline' := congrArg (fun q : affineSpan ℝ F.carrier ↦ (q : E)) hline
  change x = (1 - g) • F.center S + (1 - (1 - g)) • y
  rw [← hceq]
  calc
    x = g • ((y' : E) - (c : E)) + (c : E) := by
      simpa [AffineMap.lineMap_apply] using hline'.symm
    _ = (1 - g) • (c : E) + (1 - (1 - g)) • y := by
      dsimp [y]
      module

/-- A point outside the intrinsic interior of a face lies in a proper
subface. -/
theorem exists_lt_of_not_mem_intrinsicInterior (S : Finset E)
    (F : ExposedFace S) {y : E} (hyF : y ∈ F)
    (hy_not : y ∉ intrinsicInterior ℝ F.carrier) :
    ∃ G : ExposedFace S, G < F ∧ y ∈ G := by
  obtain ⟨c, hcint, hceq⟩ := mem_intrinsicInterior.mp (F.center_mem_intrinsicInterior S)
  letI : Nonempty (affineSpan ℝ F.carrier) := ⟨c⟩
  let inclusion : affineSpan ℝ F.carrier →ᵃ[ℝ] E :=
    AffineSubspace.subtype (affineSpan ℝ F.carrier)
  let A : Set (affineSpan ℝ F.carrier) := inclusion ⁻¹' F.carrier
  let e := AffineIsometryEquiv.constVSub ℝ c
  let Av : Set (affineSpan ℝ F.carrier).direction := e '' A
  let φ : (affineSpan ℝ F.carrier).direction →ᵃ[ℝ] E :=
    inclusion.comp e.symm.toAffineEquiv.toAffineMap
  let y' : affineSpan ℝ F.carrier := ⟨y, subset_affineSpan ℝ F.carrier hyF⟩
  let yv : (affineSpan ℝ F.carrier).direction := e y'
  have hAv_eq : Av = φ ⁻¹' F.carrier := by
    ext v
    constructor
    · rintro ⟨u, hu, rfl⟩
      change inclusion u ∈ F.carrier at hu
      change inclusion (e.symm (e u)) ∈ F.carrier
      simpa only [e.symm_apply_apply] using hu
    · intro hv
      refine ⟨e.symm v, ?_, e.apply_symm_apply v⟩
      change inclusion (e.symm v) ∈ F.carrier at hv
      exact hv
  have hAvconv : Convex ℝ Av := by
    rw [hAv_eq]
    exact F.convex_carrier.affine_preimage φ
  have hcAvint : (0 : (affineSpan ℝ F.carrier).direction) ∈ interior Av := by
    have : e c ∈ interior (e '' A) := by
      rw [← AffineIsometryEquiv.coe_toHomeomorph, ← e.toHomeomorph.image_interior]
      exact ⟨c, hcint, rfl⟩
    simpa [Av, e] using this
  have hyvAv : yv ∈ Av := ⟨y', hyF, rfl⟩
  have hyv_not : yv ∉ interior Av := by
    intro hyvint
    apply hy_not
    apply mem_intrinsicInterior.mpr
    refine ⟨y', ?_, rfl⟩
    have hyimage : e y' ∈ e '' interior A := by
      change e.toHomeomorph y' ∈ e.toHomeomorph '' interior A
      rw [e.toHomeomorph.image_interior]
      exact hyvint
    obtain ⟨z, hzint, hzy⟩ := hyimage
    exact e.injective hzy |>.symm ▸ hzint
  obtain ⟨l, hlne, hlmax⟩ :=
    geometric_hahn_banach_of_nonempty_interior_point hAvconv hyv_not ⟨0, hcAvint⟩
  let Bv : Set (affineSpan ℝ F.carrier).direction := l.toExposed Av
  have hyBv : yv ∈ Bv := ⟨hyvAv, hlmax⟩
  have hBvexposed : IsExposed ℝ Av Bv :=
    ContinuousLinearMap.toExposed.isExposed
  have hBvconv : Convex ℝ Bv := hBvexposed.convex hAvconv
  have hBvext : IsExtreme ℝ Av Bv := hBvexposed.isExtreme
  have hlpos : ∃ w, 0 < l w := by
    have hex : ∃ w, l w ≠ 0 := by
      by_contra h
      push Not at h
      apply hlne
      ext w
      simpa using h w
    obtain ⟨w, hw⟩ := hex
    by_cases hwpos : 0 < l w
    · exact ⟨w, hwpos⟩
    · refine ⟨-w, ?_⟩
      rw [map_neg]
      exact neg_pos.mpr (lt_of_le_of_ne (not_lt.mp hwpos) hw)
  have hzero_not : (0 : (affineSpan ℝ F.carrier).direction) ∉ Bv := by
    intro hzero
    obtain ⟨w, hwpos⟩ := hlpos
    have hsmul : Tendsto (fun r : ℝ ↦ r • w) (𝓝 0) (𝓝 0) := by
      have hc : Continuous (fun r : ℝ ↦ r • w) :=
        (continuous_id : Continuous (fun r : ℝ ↦ r)).smul
          (continuous_const : Continuous (fun _ : ℝ ↦ w))
      have hc₀ : ContinuousAt (fun r : ℝ ↦ r • w) 0 := hc.continuousAt
      simpa only [ContinuousAt, zero_smul] using hc₀
    have hAvnhds : Av ∈ 𝓝 (0 : (affineSpan ℝ F.carrier).direction) :=
      Filter.mem_of_superset (isOpen_interior.mem_nhds hcAvint) interior_subset
    obtain ⟨r, hr, hrAv⟩ := (hsmul.eventually hAvnhds).exists_gt
    have hle := hzero.2 (r • w) hrAv
    simp only [map_smul, map_zero, smul_eq_mul] at hle
    nlinarith
  have hφinj : Function.Injective φ := by
    intro v w hvw
    apply e.symm.injective
    apply Subtype.ext
    exact hvw
  let B : Set E := φ '' Bv
  have hBne : B.Nonempty := ⟨φ yv, ⟨yv, hyBv, rfl⟩⟩
  have hBconv : Convex ℝ B := hBvconv.affine_image φ
  have hBextF : IsExtreme ℝ F.carrier B := by
    constructor
    · rintro _ ⟨v, hvB, rfl⟩
      have hvAv := hBvext.subset hvB
      rw [hAv_eq] at hvAv
      exact hvAv
    · rintro x₁ hx₁F x₂ hx₂F _ ⟨v, hvB, rfl⟩ hvseg
      let v₁ : (affineSpan ℝ F.carrier).direction :=
        e ⟨x₁, subset_affineSpan ℝ F.carrier hx₁F⟩
      let v₂ : (affineSpan ℝ F.carrier).direction :=
        e ⟨x₂, subset_affineSpan ℝ F.carrier hx₂F⟩
      have hv₁Av : v₁ ∈ Av := by
        rw [hAv_eq]
        simpa [v₁, φ, inclusion]
      have hv₂Av : v₂ ∈ Av := by
        rw [hAv_eq]
        simpa [v₂, φ, inclusion]
      have hvseg' : v ∈ openSegment ℝ v₁ v₂ := by
        rw [openSegment_eq_image_lineMap] at hvseg ⊢
        obtain ⟨t, ht, htv⟩ := hvseg
        refine ⟨t, ht, ?_⟩
        apply hφinj
        rw [φ.apply_lineMap]
        simpa [v₁, v₂, φ, inclusion] using htv
      have hv₁B := hBvext.left_mem_of_mem_openSegment hv₁Av hv₂Av hvB hvseg'
      refine ⟨v₁, hv₁B, ?_⟩
      simp [v₁, φ, inclusion]
  let G : ExposedFace S :=
    { carrier := B
      nonempty := hBne
      convex_carrier := hBconv
      extreme_carrier := F.extreme_carrier.trans hBextF }
  have hGF : G ≤ F := hBextF.subset
  have hφ0 : φ 0 = F.center S := by
    simpa [φ, inclusion, e] using hceq
  have hcenter_not : F.center S ∉ G := by
    rintro ⟨v, hvB, hv⟩
    have hvzero : v = 0 := hφinj (hv.trans hφ0.symm)
    exact hzero_not (hvzero ▸ hvB)
  have hGne : G ≠ F := by
    intro hGF'
    apply hcenter_not
    rw [hGF']
    exact F.center_mem S
  refine ⟨G, lt_of_le_of_ne hGF hGne, ?_⟩
  exact ⟨yv, hyBv, by simp [φ, inclusion, yv, y']⟩

theorem center_injective (S : Finset E) : Function.Injective (center S) := by
  intro F G hcenter
  have hinter : IsExtreme ℝ (convexHull ℝ (S : Set E)) (F.carrier ∩ G.carrier) :=
    F.extreme_carrier.inter G.extreme_carrier
  have hinterF : IsExtreme ℝ F.carrier (F.carrier ∩ G.carrier) :=
    hinter.mono F.extreme_carrier.subset inter_subset_left
  have hinterG : IsExtreme ℝ G.carrier (F.carrier ∩ G.carrier) :=
    hinter.mono G.extreme_carrier.subset inter_subset_right
  have hFG : F ≤ G := by
    intro x hxF
    have hcinter : F.center S ∈ F.carrier ∩ G.carrier :=
      ⟨F.center_mem S, hcenter ▸ G.center_mem S⟩
    have heq := extreme_eq_of_mem_intrinsicInterior hinterF
      (F.center_mem_intrinsicInterior S) hcinter
    have hxinter : x ∈ F.carrier ∩ G.carrier := by
      rw [heq]
      exact hxF
    exact hxinter.2
  have hGF : G ≤ F := by
    intro x hxG
    have hcinter : F.center S ∈ F.carrier ∩ G.carrier :=
      ⟨F.center_mem S, hcenter ▸ G.center_mem S⟩
    have heq := extreme_eq_of_mem_intrinsicInterior hinterG
      (hcenter ▸ G.center_mem_intrinsicInterior S) hcinter
    have hxinter : x ∈ F.carrier ∩ G.carrier := by
      rw [heq]
      exact hxG
    exact hxinter.1
  exact le_antisymm hFG hGF

omit [FiniteDimensional ℝ E] in
theorem eq_of_mem_intrinsicInterior (S : Finset E) (F G : ExposedFace S) {x : E}
    (hxF : x ∈ intrinsicInterior ℝ F.carrier)
    (hxG : x ∈ intrinsicInterior ℝ G.carrier) : F = G := by
  have hinter : IsExtreme ℝ (convexHull ℝ (S : Set E)) (F.carrier ∩ G.carrier) :=
    F.extreme_carrier.inter G.extreme_carrier
  have hinterF : IsExtreme ℝ F.carrier (F.carrier ∩ G.carrier) :=
    hinter.mono F.extreme_carrier.subset inter_subset_left
  have hinterG : IsExtreme ℝ G.carrier (F.carrier ∩ G.carrier) :=
    hinter.mono G.extreme_carrier.subset inter_subset_right
  have hxinter : x ∈ F.carrier ∩ G.carrier :=
    ⟨intrinsicInterior_subset hxF, intrinsicInterior_subset hxG⟩
  have hIF := extreme_eq_of_mem_intrinsicInterior hinterF hxF hxinter
  have hIG := extreme_eq_of_mem_intrinsicInterior hinterG hxG hxinter
  apply SetLike.coe_injective
  exact hIF.symm.trans hIG

theorem center_not_mem_affineSpan_of_lt (S : Finset E) {F G : ExposedFace S}
    (hFG : F < G) : G.center S ∉ affineSpan ℝ F.carrier := by
  intro hcspan
  obtain ⟨cF, hcFint, hcFeq⟩ := mem_intrinsicInterior.mp (F.center_mem_intrinsicInterior S)
  letI : Nonempty (affineSpan ℝ F.carrier) := ⟨cF⟩
  let cG : affineSpan ℝ F.carrier := ⟨G.center S, hcspan⟩
  have hline : AffineMap.lineMap (k := ℝ) cG cF (1 : ℝ) = cF :=
    AffineMap.lineMap_apply_one cG cF
  obtain ⟨t, ht, hzt⟩ :=
    AffineMap.lineMap_continuous.tendsto' (1 : ℝ) cF hline |>.eventually_mem
      (mem_interior_iff_mem_nhds.mp hcFint) |>.exists_gt
  let z : E := AffineMap.lineMap (k := ℝ) cG cF t
  have hzF : z ∈ F := by
    change (AffineMap.lineMap cG cF t : affineSpan ℝ F.carrier) ∈
      ((AffineSubspace.subtype (affineSpan ℝ F.carrier)) ⁻¹' F.carrier :
        Set (affineSpan ℝ F.carrier)) at hzt
    exact hzt
  have hcFseg : F.center S ∈ openSegment ℝ (G.center S) z := by
    rw [openSegment_eq_image_lineMap]
    let r : ℝ := t⁻¹
    refine ⟨r, ⟨inv_pos.mpr (lt_trans zero_lt_one ht), inv_lt_one_of_one_lt₀ ht⟩, ?_⟩
    have hsub : AffineMap.lineMap cG (AffineMap.lineMap cG cF t) r = cF := by
      rw [AffineMap.lineMap_lineMap_right]
      have hrt : r * t = 1 := by
        dsimp [r]
        exact inv_mul_cancel₀ (ne_of_gt (lt_trans zero_lt_one ht))
      rw [hrt, AffineMap.lineMap_apply_one]
    change AffineMap.lineMap
      ((AffineSubspace.subtype (affineSpan ℝ F.carrier)) cG)
      ((AffineSubspace.subtype (affineSpan ℝ F.carrier))
        (AffineMap.lineMap cG cF t)) r = F.center S
    rw [← AffineMap.apply_lineMap, hsub]
    exact hcFeq
  have hFextG : IsExtreme ℝ G.carrier F.carrier :=
    F.extreme_carrier.mono G.extreme_carrier.subset hFG.le
  have hcGinF : G.center S ∈ F := hFextG.left_mem_of_mem_openSegment
    (G.center_mem S) (hFG.le hzF) (F.center_mem S) hcFseg
  have heq := extreme_eq_of_mem_intrinsicInterior hFextG
    (G.center_mem_intrinsicInterior S) hcGinF
  exact hFG.ne (SetLike.coe_injective heq)

/-- The affine dimension of a face. -/
noncomputable def affineRank {S : Finset E} (F : ExposedFace S) : ℕ :=
  Module.finrank ℝ (affineSpan ℝ F.carrier).direction

theorem affineRank_lt_of_lt (S : Finset E) {F G : ExposedFace S} (hFG : F < G) :
    affineRank F < affineRank G := by
  have hspanle : affineSpan ℝ F.carrier ≤ affineSpan ℝ G.carrier :=
    affineSpan_mono ℝ hFG.le
  have hspanne : affineSpan ℝ F.carrier ≠ affineSpan ℝ G.carrier := by
    intro heq
    apply F.center_not_mem_affineSpan_of_lt S hFG
    rw [heq]
    exact subset_affineSpan ℝ G.carrier (G.center_mem S)
  have hspanlt : affineSpan ℝ F.carrier < affineSpan ℝ G.carrier :=
    lt_of_le_of_ne hspanle hspanne
  have hspanFne : ((affineSpan ℝ F.carrier : AffineSubspace ℝ E) : Set E).Nonempty :=
    F.nonempty.mono (subset_affineSpan ℝ F.carrier)
  have hdirlt := AffineSubspace.direction_lt_of_nonempty hspanlt hspanFne
  exact Submodule.finrank_lt_finrank_of_lt hdirlt

theorem affineRank_le_finrank {S : Finset E} (F : ExposedFace S) :
    affineRank F ≤ Module.finrank ℝ E := by
  exact Submodule.finrank_le _

noncomputable def rankIndex {k : ℕ} (S : Finset (Fin k → ℝ))
    (F : ExposedFace S) : Fin (k + 1) :=
  ⟨affineRank F, by
    apply Nat.lt_succ_of_le
    simpa only [Module.finrank_fin_fun] using affineRank_le_finrank F⟩

theorem rankIndex_lt_of_lt {k : ℕ} (S : Finset (Fin k → ℝ))
    {F G : ExposedFace S} (hFG : F < G) : rankIndex S F < rankIndex S G :=
  affineRank_lt_of_lt S hFG

def IsChain (S : Finset E) (c : Finset (ExposedFace S)) : Prop :=
  c.Nonempty ∧ ∀ F ∈ c, ∀ G ∈ c, F ≤ G ∨ G ≤ F

theorem rankIndex_injective_on_chain {k : ℕ} (S : Finset (Fin k → ℝ))
    (c : Finset (ExposedFace S)) (hc : IsChain S c) :
    Set.InjOn (rankIndex S) (c : Set (ExposedFace S)) := by
  intro F hFc G hGc hrank
  rcases hc.2 F (Finset.mem_coe.mp hFc) G (Finset.mem_coe.mp hGc) with hFG | hGF
  · by_cases heq : F = G
    · exact heq
    · exact ((rankIndex_lt_of_lt S (lt_of_le_of_ne hFG heq)).ne hrank).elim
  · by_cases heq : G = F
    · exact heq.symm
    · exact ((rankIndex_lt_of_lt S (lt_of_le_of_ne hGF heq)).ne hrank.symm).elim

noncomputable def chainVertices (S : Finset E) (c : Finset (ExposedFace S)) : Finset E := by
  classical
  exact c.image (center S)

/-- Restrict a chain of faces to those lying in `H`, viewed as faces of
`H` with its inherited finite presentation. -/
noncomputable def restrictedChain (S : Finset E) (H : ExposedFace S)
    (c : Finset (ExposedFace S)) :
    Finset (ExposedFace (faceVertices S H.carrier)) := by
  classical
  exact Finset.univ.filter fun G =>
    ∃ F ∈ c, F ≤ H ∧ G.carrier = F.carrier

omit hfd in
@[simp]
theorem mem_restrictedChain (S : Finset E) (H : ExposedFace S)
    (c : Finset (ExposedFace S)) (G : ExposedFace (faceVertices S H.carrier)) :
    G ∈ restrictedChain S H c ↔
      ∃ F ∈ c, F ≤ H ∧ G.carrier = F.carrier := by
  classical
  simp [restrictedChain]

omit hfd in
theorem restrictedChain_nonempty (S : Finset E) (H : ExposedFace S)
    {c : Finset (ExposedFace S)}
    (hc : ∃ F ∈ c, F ≤ H) : (restrictedChain S H c).Nonempty := by
  classical
  obtain ⟨F, hFc, hFH⟩ := hc
  let G := restrictFaceTo S H F hFH
  exact ⟨G, (mem_restrictedChain S H c G).mpr ⟨F, hFc, hFH, rfl⟩⟩

omit hfd in
theorem isChain_restrictedChain (S : Finset E) (H : ExposedFace S)
    {c : Finset (ExposedFace S)} (hc : IsChain S c)
    (hne : (restrictedChain S H c).Nonempty) :
    IsChain (faceVertices S H.carrier) (restrictedChain S H c) := by
  refine ⟨hne, ?_⟩
  intro G hGc K hKc
  obtain ⟨F, hFc, _hFH, hGF⟩ := (mem_restrictedChain S H c G).mp hGc
  obtain ⟨J, hJc, _hJH, hKJ⟩ := (mem_restrictedChain S H c K).mp hKc
  rcases hc.2 F hFc J hJc with hFJ | hJF
  · left
    change G.carrier ⊆ K.carrier
    rw [hGF, hKJ]
    exact hFJ
  · right
    change K.carrier ⊆ G.carrier
    rw [hGF, hKJ]
    exact hJF

noncomputable def eraseFace (S : Finset E) (c : Finset (ExposedFace S))
    (H : ExposedFace S) :
    Finset (ExposedFace S) := by
  classical
  exact c.erase H

omit [FiniteDimensional ℝ E] in
@[simp]
theorem mem_eraseFace (S : Finset E) (c : Finset (ExposedFace S))
    (H F : ExposedFace S) :
    F ∈ eraseFace S c H ↔ F ≠ H ∧ F ∈ c := by
  classical
  simp [eraseFace]

@[simp]
theorem mem_chainVertices (S : Finset E) (c : Finset (ExposedFace S)) (x : E) :
    x ∈ chainVertices S c ↔ ∃ F ∈ c, F.center S = x := by
  classical
  simp [chainVertices]

noncomputable def chainVerticesInFace (S : Finset E) (H : ExposedFace S)
    (c : Finset (ExposedFace S)) : Finset E := by
  classical
  exact (chainVertices S c).filter (· ∈ H.carrier)

@[simp]
theorem mem_chainVerticesInFace (S : Finset E) (H : ExposedFace S)
    (c : Finset (ExposedFace S)) (x : E) :
    x ∈ chainVerticesInFace S H c ↔ x ∈ chainVertices S c ∧ x ∈ H.carrier := by
  classical
  simp [chainVerticesInFace]

theorem chainVertices_restrictedChain (S : Finset E) (H : ExposedFace S)
    (c : Finset (ExposedFace S)) :
    chainVertices (faceVertices S H.carrier) (restrictedChain S H c) =
      chainVerticesInFace S H c := by
  classical
  ext x
  rw [mem_chainVerticesInFace]
  constructor
  · intro hx
    obtain ⟨G, hG, hGx⟩ :=
      (mem_chainVertices (faceVertices S H.carrier) (restrictedChain S H c) x).mp hx
    obtain ⟨F, hFc, hFH, hcarrier⟩ := (mem_restrictedChain S H c G).mp hG
    have hcenter : G.center (faceVertices S H.carrier) = F.center S :=
      center_eq_of_carrier_eq G F hcarrier
    refine ⟨(mem_chainVertices S c x).mpr ⟨F, hFc, hcenter.symm.trans hGx⟩, ?_⟩
    rw [← hGx, hcenter]
    exact hFH (F.center_mem S)
  · rintro ⟨hx, hxH⟩
    obtain ⟨F, hFc, hFx⟩ := (mem_chainVertices S c x).mp hx
    have hcH : F.center S ∈ H := hFx.symm ▸ hxH
    have hFH : F ≤ H := (center_mem_iff_le S F H).mp hcH
    let G := restrictFaceTo S H F hFH
    apply (mem_chainVertices (faceVertices S H.carrier) (restrictedChain S H c) x).mpr
    refine ⟨G, (mem_restrictedChain S H c G).mpr ⟨F, hFc, hFH, rfl⟩, ?_⟩
    exact (center_restrictFaceTo S H F hFH).trans hFx

theorem restrictedChain_nonempty_of_filter_nonempty (S : Finset E) (H : ExposedFace S)
    {c : Finset (ExposedFace S)}
    (h : (chainVerticesInFace S H c).Nonempty) :
    (restrictedChain S H c).Nonempty := by
  rw [← chainVertices_restrictedChain S H c] at h
  obtain ⟨x, hx⟩ := h
  obtain ⟨G, hG, _hGx⟩ :=
    (mem_chainVertices (faceVertices S H.carrier) (restrictedChain S H c) x).mp hx
  exact ⟨G, hG⟩

theorem affineIndependent_centers_of_isChain (S : Finset E)
    (c : Finset (ExposedFace S)) (hc : IsChain S c) :
    AffineIndependent ℝ (fun F : c => F.1.center S) := by
  classical
  letI : LinearOrder c :=
    { (inferInstance : PartialOrder c) with
      le_total := fun F G => hc.2 F.1 F.2 G.1 G.2
      toDecidableEq := Classical.decEq c
      toDecidableLE := Classical.decRel (fun F G : c => F ≤ G) }
  intro s w hsum hweighted i hi
  by_contra hwi
  let support := s.filter fun j => w j ≠ 0
  have hisupport : i ∈ support := Finset.mem_filter.mpr ⟨hi, hwi⟩
  have hsupport : support.Nonempty := ⟨i, hisupport⟩
  let m : c := support.max' hsupport
  have hm_support : m ∈ support := support.max'_mem hsupport
  have hm_s : m ∈ s := (Finset.mem_filter.mp hm_support).1
  have hwm : w m ≠ 0 := (Finset.mem_filter.mp hm_support).2
  have hsum_support : ∑ j ∈ support, w j = 0 := by
    change ∑ j ∈ s.filter (fun j => w j ≠ 0), w j = 0
    rw [Finset.sum_filter_ne_zero]
    exact hsum
  have hweighted_support : support.weightedVSub (fun F : c => F.1.center S) w = 0 := by
    change (s.filter fun j => w j ≠ 0).weightedVSub (fun F : c => F.1.center S) w = 0
    rw [Finset.weightedVSub_filter_of_ne, hweighted]
    intro j hj hwj
    exact hwj
  have hmspan := mem_affineSpan_erase_of_weightedVSub_eq_zero
    (fun F : c => F.1.center S) support w hm_support hwm hsum_support hweighted_support
  have hrest : (support.erase m).Nonempty := by
    by_contra hrest
    have hsubset : support ⊆ {m} := by
      intro j hj
      simp only [Finset.mem_singleton]
      by_contra hjm
      exact hrest ⟨j, Finset.mem_erase.mpr ⟨hjm, hj⟩⟩
    have heq : support = {m} := Finset.Subset.antisymm hsubset <|
      Finset.singleton_subset_iff.mpr hm_support
    apply hwm
    simpa [heq] using hsum_support
  let g : c := (support.erase m).max' hrest
  have hg_rest : g ∈ support.erase m := (support.erase m).max'_mem hrest
  have hg_support : g ∈ support := Finset.mem_of_mem_erase hg_rest
  have hgm_ne : g ≠ m := Finset.ne_of_mem_erase hg_rest
  have hgm : g.1 < m.1 := by
    refine lt_of_le_of_ne ?_ ?_
    · exact support.le_max' g hg_support
    · exact fun h => hgm_ne (Subtype.ext h)
  have himage :
      (fun F : c => F.1.center S) '' (support.erase m : Set c) ⊆ g.1.carrier := by
    rintro _ ⟨j, hj, rfl⟩
    have hjg : j ≤ g := (support.erase m).le_max' j hj
    exact hjg (j.1.center_mem S)
  have hmspan' : m.1.center S ∈ affineSpan ℝ g.1.carrier :=
    affineSpan_mono ℝ himage hmspan
  exact g.1.center_not_mem_affineSpan_of_lt S hgm hmspan'

theorem exists_maximal_decomposition (S : Finset E)
    (c : Finset (ExposedFace S)) (hc : IsChain S c) {x : E}
    (hx : x ∈ convexHull ℝ (chainVertices S c : Set E)) :
    ∃ H : ExposedFace S, H ∈ c ∧ x ∈ intrinsicInterior ℝ H.carrier ∧
      (x = H.center S ∨
        ∃ (a : ℝ) (y : E) (G : ExposedFace S),
          0 < a ∧ a < 1 ∧ G ∈ c ∧ G < H ∧
          y ∈ convexHull ℝ (chainVertices S (eraseFace S c H) : Set E) ∧
          y ∈ G ∧ x = a • H.center S + (1 - a) • y) := by
  classical
  letI : LinearOrder c :=
    { (inferInstance : PartialOrder c) with
      le_total := fun F G => hc.2 F.1 F.2 G.1 G.2
      toDecidableEq := Classical.decEq c
      toDecidableLE := Classical.decRel (fun F G : c => F ≤ G) }
  obtain ⟨w, hw₀, hw₁, hwcenter⟩ := Finset.mem_convexHull'.mp hx
  let wt : c → ℝ := fun F => w (F.1.center S)
  have hwt₀ (F : c) : 0 ≤ wt F := by
    apply hw₀
    exact (mem_chainVertices S c (F.1.center S)).mpr ⟨F.1, F.2, rfl⟩
  have hsum_base : ∑ F ∈ c, w (F.center S) = 1 := by
    rw [← hw₁]
    rw [chainVertices, Finset.sum_image]
    exact (center_injective S).injOn
  have hsum : ∑ F, wt F = 1 := by
    calc
      ∑ F, wt F = ∑ F ∈ c.attach, w (F.1.center S) := by
        rw [Finset.univ_eq_attach]
      _ = ∑ F ∈ c, w (F.center S) :=
        Finset.sum_attach c fun F : ExposedFace S => w (F.center S)
      _ = 1 := hsum_base
  have hcenter_base : ∑ F ∈ c, w (F.center S) • F.center S = x := by
    rw [← hwcenter]
    rw [chainVertices, Finset.sum_image]
    exact (center_injective S).injOn
  have hcenter : ∑ F, wt F • F.1.center S = x := by
    calc
      ∑ F, wt F • F.1.center S =
          ∑ F ∈ c.attach, w (F.1.center S) • F.1.center S := by
        rw [Finset.univ_eq_attach]
      _ = ∑ F ∈ c, w (F.center S) • F.center S :=
        Finset.sum_attach c fun F : ExposedFace S => w (F.center S) • F.center S
      _ = x := hcenter_base
  let support : Finset c := Finset.univ.filter fun F => 0 < wt F
  have hsupport : support.Nonempty := by
    by_contra hsupp
    have hzero : ∀ F : c, wt F = 0 := by
      intro F
      apply le_antisymm
      · apply not_lt.mp
        intro hpos
        exact hsupp ⟨F, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hpos⟩⟩
      · exact hwt₀ F
    have : ∑ F, wt F = 0 := by simp [hzero]
    linarith
  let Hc : c := support.max' hsupport
  let H : ExposedFace S := Hc.1
  have hHsupport : Hc ∈ support := support.max'_mem hsupport
  have hHc : H ∈ c := Hc.2
  have ha_pos : 0 < wt Hc := (Finset.mem_filter.mp hHsupport).2
  have hzero_out (F : c) (hF : F ∉ support) : wt F = 0 := by
    apply le_antisymm
    · exact not_lt.mp fun hpos => hF <| Finset.mem_filter.mpr ⟨Finset.mem_univ _, hpos⟩
    · exact hwt₀ F
  have hsum_support : ∑ F ∈ support, wt F = 1 := by
    calc
      ∑ F ∈ support, wt F = ∑ F ∈ Finset.univ, wt F :=
        Finset.sum_subset (Finset.subset_univ _) fun F _ hF => hzero_out F hF
      _ = 1 := by simpa using hsum
  have hcenter_support : ∑ F ∈ support, wt F • F.1.center S = x := by
    calc
      ∑ F ∈ support, wt F • F.1.center S =
          ∑ F ∈ Finset.univ, wt F • F.1.center S :=
        Finset.sum_subset (Finset.subset_univ _) fun F _ hF => by
          rw [hzero_out F hF, zero_smul]
      _ = x := by simpa using hcenter
  by_cases hrest : (support.erase Hc).Nonempty
  · let Gc : c := (support.erase Hc).max' hrest
    let G : ExposedFace S := Gc.1
    have hGrest : Gc ∈ support.erase Hc := (support.erase Hc).max'_mem hrest
    have hGsupport : Gc ∈ support := Finset.mem_of_mem_erase hGrest
    have hGH_ne : Gc ≠ Hc := Finset.ne_of_mem_erase hGrest
    have hGH : G < H := by
      refine lt_of_le_of_ne (support.le_max' Gc hGsupport) ?_
      exact fun h => hGH_ne (Subtype.ext h)
    have hsum_rest : ∑ F ∈ support.erase Hc, wt F = 1 - wt Hc := by
      rw [Finset.sum_erase_eq_sub hHsupport, hsum_support]
    have hsum_rest_pos : 0 < ∑ F ∈ support.erase Hc, wt F := by
      refine lt_of_lt_of_le ((Finset.mem_filter.mp hGsupport).2) ?_
      exact Finset.single_le_sum (fun F hF => hwt₀ F) hGrest
    have ha_lt : wt Hc < 1 := by linarith
    let nw : c → ℝ := fun F => wt F / (1 - wt Hc)
    have hnw₀ (F : c) (hF : F ∈ support.erase Hc) : 0 ≤ nw F := by
      exact div_nonneg (hwt₀ F) (sub_nonneg.mpr ha_lt.le)
    have hnwsum : ∑ F ∈ support.erase Hc, nw F = 1 := by
      simp only [nw, ← Finset.sum_div, hsum_rest]
      exact div_self (sub_ne_zero.mpr (ne_of_gt ha_lt))
    let y : E := ∑ F ∈ support.erase Hc, nw F • F.1.center S
    have hyhull : y ∈ convexHull ℝ (chainVertices S (eraseFace S c H) : Set E) := by
      apply (convex_convexHull ℝ (chainVertices S (eraseFace S c H) : Set E)).sum_mem
        hnw₀ hnwsum
      intro F hF
      apply subset_convexHull
      rw [Finset.mem_coe, mem_chainVertices]
      refine ⟨F.1, ?_, rfl⟩
      apply (mem_eraseFace S c H F.1).mpr
      refine ⟨?_, F.2⟩
      intro hFH
      apply Finset.ne_of_mem_erase hF
      apply Subtype.ext
      simpa only [H] using hFH
    have hyG : y ∈ G.carrier := by
      apply (G.convex S).sum_mem hnw₀ hnwsum
      intro F hF
      have hFGc : F ≤ Gc := (support.erase Hc).le_max' F hF
      exact hFGc (F.1.center_mem S)
    have hyscale : (1 - wt Hc) • y =
        ∑ F ∈ support.erase Hc, wt F • F.1.center S := by
      dsimp [y]
      rw [Finset.smul_sum]
      apply Finset.sum_congr rfl
      intro F hF
      simp only [nw, smul_smul]
      field_simp [sub_ne_zero.mpr (ne_of_gt ha_lt)]
    have hxdecomp : x = wt Hc • H.center S + (1 - wt Hc) • y := by
      rw [hyscale]
      rw [← hcenter_support, ← Finset.sum_erase_add _ _ hHsupport]
      simp only [H, add_comm]
    have hyH : y ∈ H.carrier := hGH.le hyG
    have hxri : x ∈ intrinsicInterior ℝ H.carrier := by
      apply Submission.Polytope.Convex.openSegment_intrinsicInterior_self_subset_intrinsicInterior
        (H.convex S) (H.center_mem_intrinsicInterior S) hyH
      exact ⟨wt Hc, 1 - wt Hc, ha_pos, sub_pos.mpr ha_lt, by ring, hxdecomp.symm⟩
    refine ⟨H, hHc, hxri, Or.inr ⟨wt Hc, y, G, ha_pos, ha_lt, Gc.2, hGH, ?_, hyG,
      hxdecomp⟩⟩
    exact hyhull
  · have hsubset : support ⊆ {Hc} := by
      intro F hF
      simp only [Finset.mem_singleton]
      by_contra hFH
      exact hrest ⟨F, Finset.mem_erase.mpr ⟨hFH, hF⟩⟩
    have heq : support = {Hc} := Finset.Subset.antisymm hsubset <|
      Finset.singleton_subset_iff.mpr hHsupport
    have ha_one : wt Hc = 1 := by simpa [heq] using hsum_support
    have hxcenter : x = H.center S := by
      simpa [heq, ha_one, H] using hcenter_support.symm
    refine ⟨H, hHc, ?_, Or.inl hxcenter⟩
    simpa only [hxcenter] using H.center_mem_intrinsicInterior S

omit [FiniteDimensional ℝ E] in
theorem IsChain.subset (S : Finset E) {c d : Finset (ExposedFace S)}
    (hc : IsChain S c) (hd : d.Nonempty) (hdc : d ⊆ c) : IsChain S d := by
  refine ⟨hd, ?_⟩
  intro F hF G hG
  exact hc.2 F (hdc hF) G (hdc hG)

theorem chainVertices_mono (S : Finset E) {c d : Finset (ExposedFace S)}
    (hcd : c ⊆ d) : chainVertices S c ⊆ chainVertices S d := by
  intro x hx
  obtain ⟨F, hFc, rfl⟩ := (mem_chainVertices S c x).mp hx
  exact (mem_chainVertices S d (F.center S)).mpr ⟨F, hcd hFc, rfl⟩

/-- Every point of a face belongs to a simplex of the face-order complex
whose maximal face is the given face. -/
theorem exists_chain_convexHull (S : Finset E) (F : ExposedFace S) {x : E}
    (hx : x ∈ F) :
    ∃ c : Finset (ExposedFace S),
      IsChain S c ∧ F ∈ c ∧ (∀ G ∈ c, G ≤ F) ∧
        x ∈ convexHull ℝ (chainVertices S c : Set E) := by
  classical
  rcases F.radial_decomposition S hx with hxc | ⟨a, y, ha₀, ha₁, hyF, hy_not, hxy⟩
  · let c : Finset (ExposedFace S) := {F}
    refine ⟨c, ?_, by simp [c], ?_, ?_⟩
    · refine ⟨by simp [c], ?_⟩
      intro G hG H hH
      simp only [c, Finset.mem_singleton] at hG hH
      subst G
      subst H
      exact Or.inl le_rfl
    · intro G hG
      have hGF : G = F := by simpa [c] using hG
      exact hGF ▸ le_rfl
    · rw [hxc]
      apply subset_convexHull ℝ
      exact Finset.mem_coe.mpr <|
        (mem_chainVertices S c (F.center S)).mpr ⟨F, by simp [c], rfl⟩
  · obtain ⟨G, hGF, hyG⟩ := F.exists_lt_of_not_mem_intrinsicInterior S hyF hy_not
    obtain ⟨c, hc, hGc, hcG, hyc⟩ := exists_chain_convexHull S G hyG
    let d : Finset (ExposedFace S) := insert F c
    have hvertex_subset : G.vertexSubtype S ⊆ F.vertexSubtype S := by
      intro z hz
      rw [mem_vertexSubtype] at hz ⊢
      exact hGF.le hz
    have hvertex_ne : G.vertexSubtype S ≠ F.vertexSubtype S := by
      intro h
      exact hGF.ne (vertexSubtype_injective S h)
    have _hcard : (G.vertexSubtype S).card < (F.vertexSubtype S).card :=
      Finset.card_lt_card <| Finset.ssubset_iff_subset_ne.mpr
        ⟨hvertex_subset, hvertex_ne⟩
    have hdchain : IsChain S d := by
      refine ⟨Finset.insert_nonempty F c, ?_⟩
      intro H hHd J hJd
      rw [Finset.mem_insert] at hHd hJd
      rcases hHd with rfl | hHc
      · rcases hJd with rfl | hJc
        · exact Or.inl le_rfl
        · exact Or.inr ((hcG J hJc).trans hGF.le)
      · rcases hJd with rfl | hJc
        · exact Or.inl ((hcG H hHc).trans hGF.le)
        · exact hc.2 H hHc J hJc
    have hdmax : ∀ H ∈ d, H ≤ F := by
      intro H hHd
      rw [Finset.mem_insert] at hHd
      exact hHd.elim (fun h ↦ h ▸ le_rfl) fun hHc ↦ (hcG H hHc).trans hGF.le
    have hcenter : F.center S ∈ chainVertices S d :=
      (mem_chainVertices S d (F.center S)).mpr ⟨F, Finset.mem_insert_self F c, rfl⟩
    have hy_big : y ∈ convexHull ℝ (chainVertices S d : Set E) := by
      apply convexHull_mono _ hyc
      intro z hz
      exact Finset.mem_coe.mpr <| chainVertices_mono S (Finset.subset_insert F c)
        (Finset.mem_coe.mp hz)
    have hx_big : x ∈ convexHull ℝ (chainVertices S d : Set E) := by
      rw [hxy]
      exact (convex_convexHull ℝ (chainVertices S d : Set E))
        (subset_convexHull ℝ _ (Finset.mem_coe.mpr hcenter)) hy_big
          ha₀ (sub_nonneg.mpr ha₁.le) (by ring)
    exact ⟨d, hdchain, Finset.mem_insert_self F c, hdmax, hx_big⟩
termination_by (F.vertexSubtype S).card
decreasing_by
  apply Finset.card_lt_card
  rw [Finset.ssubset_iff_subset_ne]
  constructor
  · intro z hz
    rw [mem_vertexSubtype] at hz ⊢
    exact hGF.le hz
  · intro h
    exact hGF.ne (vertexSubtype_injective S h)

noncomputable def restrictChain (S : Finset E) (c : Finset (ExposedFace S))
    (s : Finset E) : Finset (ExposedFace S) := by
  classical
  exact c.filter fun F => F.center S ∈ s

@[simp]
theorem mem_restrictChain (S : Finset E) (c : Finset (ExposedFace S))
    (s : Finset E) (F : ExposedFace S) :
    F ∈ restrictChain S c s ↔ F ∈ c ∧ F.center S ∈ s := by
  classical
  simp [restrictChain]

theorem restrictChain_subset (S : Finset E) (c : Finset (ExposedFace S))
    (s : Finset E) : restrictChain S c s ⊆ c := by
  intro F hF
  exact (mem_restrictChain S c s F).mp hF |>.1

theorem restrictChain_nonempty (S : Finset E) {c : Finset (ExposedFace S)}
    {s : Finset E} (hs : s.Nonempty) (hsc : s ⊆ chainVertices S c) :
    (restrictChain S c s).Nonempty := by
  obtain ⟨x, hxs⟩ := hs
  obtain ⟨F, hFc, hFx⟩ := (mem_chainVertices S c x).mp (hsc hxs)
  exact ⟨F, (mem_restrictChain S c s F).mpr ⟨hFc, hFx ▸ hxs⟩⟩

theorem chainVertices_restrictChain (S : Finset E) {c : Finset (ExposedFace S)}
    {s : Finset E} (hsc : s ⊆ chainVertices S c) :
    chainVertices S (restrictChain S c s) = s := by
  classical
  ext x
  constructor
  · intro hx
    obtain ⟨F, hF, hFx⟩ := (mem_chainVertices S (restrictChain S c s) x).mp hx
    exact hFx ▸ (mem_restrictChain S c s F).mp hF |>.2
  · intro hx
    obtain ⟨F, hFc, hFx⟩ := (mem_chainVertices S c x).mp (hsc hx)
    exact (mem_chainVertices S (restrictChain S c s) x).mpr
      ⟨F, (mem_restrictChain S c s F).mpr ⟨hFc, hFx ▸ hx⟩, hFx⟩

theorem affineIndependent_chainVertices (S : Finset E)
    (c : Finset (ExposedFace S)) (hc : IsChain S c) :
    AffineIndependent ℝ ((↑) : chainVertices S c → E) := by
  have h := (affineIndependent_centers_of_isChain S c hc).range
  have hrange : Set.range (fun F : c => F.1.center S) =
      (chainVertices S c : Set E) := by
    ext x
    constructor
    · rintro ⟨F, rfl⟩
      exact Finset.mem_coe.mpr <|
        (mem_chainVertices S c (F.1.center S)).mpr ⟨F.1, F.2, rfl⟩
    · intro hx
      obtain ⟨F, hFc, hFx⟩ := (mem_chainVertices S c x).mp (Finset.mem_coe.mp hx)
      exact ⟨⟨F, hFc⟩, hFx⟩
  refine h.mono ?_
  simpa only [hrange] using (Set.Subset.rfl :
    (Set.range fun F : c => F.1.center S) ⊆ Set.range fun F : c => F.1.center S)

omit [FiniteDimensional ℝ E] in
theorem not_mem_intrinsicInterior_of_mem_lt (S : Finset E) {F G : ExposedFace S}
    (hFG : F < G) {x : E} (hxF : x ∈ F) : x ∉ intrinsicInterior ℝ G.carrier := by
  intro hxG
  have hFextG : IsExtreme ℝ G.carrier F.carrier :=
    F.extreme_carrier.mono G.extreme_carrier.subset hFG.le
  have heq := extreme_eq_of_mem_intrinsicInterior hFextG hxG hxF
  exact hFG.ne (SetLike.coe_injective heq)

theorem center_ne_combo_of_mem_lt (S : Finset E) {F G : ExposedFace S}
    (hFG : F < G) {a : ℝ} (ha : a < 1) {y : E} (hyF : y ∈ F) :
    G.center S ≠ a • G.center S + (1 - a) • y := by
  intro h
  have hscale : (1 - a) • G.center S = (1 - a) • y := by
    calc
      (1 - a) • G.center S = G.center S - a • G.center S := by module
      _ = (a • G.center S + (1 - a) • y) - a • G.center S := by
        nth_rw 1 [h]
      _ = (1 - a) • y := by module
  have hcy : G.center S = y :=
    smul_right_injective E (sub_ne_zero.mpr (ne_of_gt ha)) hscale
  apply F.center_not_mem_affineSpan_of_lt S hFG
  exact subset_affineSpan ℝ F.carrier (hcy ▸ hyF)

/-- Convex hulls of two simplices in the exposed-face order complex meet
only along their common vertices. -/
theorem convexHull_chainVertices_inter (S : Finset E)
    (c d : Finset (ExposedFace S)) (hc : IsChain S c) (hd : IsChain S d) :
    convexHull ℝ (chainVertices S c : Set E) ∩
        convexHull ℝ (chainVertices S d : Set E) ⊆
      convexHull ℝ ((chainVertices S c : Set E) ∩ (chainVertices S d : Set E)) := by
  classical
  intro x hx
  obtain ⟨F, hFc, hxF, hdecF⟩ := exists_maximal_decomposition S c hc hx.1
  obtain ⟨G, hGd, hxG, hdecG⟩ := exists_maximal_decomposition S d hd hx.2
  have hFG : F = G := eq_of_mem_intrinsicInterior S F G hxF hxG
  subst G
  have hcenter_mem : F.center S ∈
      (chainVertices S c : Set E) ∩ (chainVertices S d : Set E) :=
    ⟨Finset.mem_coe.mpr <| (mem_chainVertices S c (F.center S)).mpr ⟨F, hFc, rfl⟩,
      Finset.mem_coe.mpr <| (mem_chainVertices S d (F.center S)).mpr ⟨F, hGd, rfl⟩⟩
  rcases hdecF with hxc | ⟨a, y, F', ha₀, ha₁, hF'c, hF'F, hyc, hyF', hxy⟩
  · rcases hdecG with hxc' | ⟨b, z, G', hb₀, hb₁, hG'd, hG'F, hzd, hzG', hxz⟩
    · rw [hxc]
      exact subset_convexHull ℝ _ hcenter_mem
    · exfalso
      exact center_ne_combo_of_mem_lt S hG'F hb₁ hzG' (hxc.symm.trans hxz)
  · rcases hdecG with hxc' | ⟨b, z, G', hb₀, hb₁, hG'd, hG'F, hzd, hzG', hxz⟩
    · exfalso
      exact center_ne_combo_of_mem_lt S hF'F ha₁ hyF' (hxc'.symm.trans hxy)
    · have hyF : y ∈ F := hF'F.le hyF'
      have hzF : z ∈ F := hG'F.le hzG'
      have hy_not : y ∉ intrinsicInterior ℝ F.carrier :=
        not_mem_intrinsicInterior_of_mem_lt S hF'F hyF'
      have hz_not : z ∉ intrinsicInterior ℝ F.carrier :=
        not_mem_intrinsicInterior_of_mem_lt S hG'F hzG'
      obtain ⟨hab, hyz⟩ := radial_decomposition_unique (F.convex S)
        (F.center_mem_intrinsicInterior S) hyF hzF hy_not hz_not
        ha₀.le ha₁ hb₀.le hb₁ (hxy.symm.trans hxz)
      subst b
      subst z
      have hce_nonempty : (eraseFace S c F).Nonempty := by
        by_contra hne
        have hempty := Finset.not_nonempty_iff_eq_empty.mp hne
        rw [hempty, chainVertices, Finset.image_empty, Finset.coe_empty,
          convexHull_empty] at hyc
        exact hyc
      have hde_nonempty : (eraseFace S d F).Nonempty := by
        by_contra hne
        have hempty := Finset.not_nonempty_iff_eq_empty.mp hne
        rw [hempty, chainVertices, Finset.image_empty, Finset.coe_empty,
          convexHull_empty] at hzd
        exact hzd
      have hce : IsChain S (eraseFace S c F) :=
        hc.subset S hce_nonempty (Finset.erase_subset F c)
      have hde : IsChain S (eraseFace S d F) :=
        hd.subset S hde_nonempty (Finset.erase_subset F d)
      have hy_small := convexHull_chainVertices_inter S
        (eraseFace S c F) (eraseFace S d F) hce hde ⟨hyc, hzd⟩
      have hinter_subset :
          (chainVertices S (eraseFace S c F) : Set E) ∩
              (chainVertices S (eraseFace S d F) : Set E) ⊆
            (chainVertices S c : Set E) ∩ (chainVertices S d : Set E) := by
        intro q hq
        exact
          ⟨Finset.mem_coe.mpr <| chainVertices_mono S (Finset.erase_subset F c)
              (Finset.mem_coe.mp hq.1),
            Finset.mem_coe.mpr <| chainVertices_mono S (Finset.erase_subset F d)
              (Finset.mem_coe.mp hq.2)⟩
      have hy_big : y ∈ convexHull ℝ
          ((chainVertices S c : Set E) ∩ (chainVertices S d : Set E)) :=
        convexHull_mono hinter_subset hy_small
      rw [hxy]
      exact (convex_convexHull ℝ
        ((chainVertices S c : Set E) ∩ (chainVertices S d : Set E)))
          (subset_convexHull ℝ _ hcenter_mem) hy_big
          ha₀.le (sub_nonneg.mpr ha₁.le) (by ring)
termination_by c.card + d.card
decreasing_by
  classical
  simp only [eraseFace]
  exact Nat.add_lt_add (Finset.card_erase_lt_of_mem hFc)
    (Finset.card_erase_lt_of_mem hGd)

end ExposedFace

open ExposedFace

section Barycentric

variable [FiniteDimensional ℝ E]

/-- The barycentric order complex of the nonempty exposed faces of a
polytope. Coverage of the polytope is proved separately below. -/
noncomputable def barycentricComplex (S : Finset E) : SimplicialComplex ℝ E := by
  classical
  exact
    { faces := {s | ∃ c : Finset (ExposedFace S), IsChain S c ∧ s = chainVertices S c}
      isRelLowerSet_faces := by
        rintro s ⟨c, hc, rfl⟩
        constructor
        · rw [chainVertices]
          exact Finset.image_nonempty.mpr hc.1
        · intro t hts ht
          let d := restrictChain S c t
          have hdne : d.Nonempty := restrictChain_nonempty S ht hts
          have hd : IsChain S d := hc.subset S hdne (restrictChain_subset S c t)
          exact ⟨d, hd, (chainVertices_restrictChain S hts).symm⟩
      indep := by
        rintro s ⟨c, hc, rfl⟩
        exact affineIndependent_chainVertices S c hc
      inter_subset_convexHull := by
        rintro s t ⟨c, hc, rfl⟩ ⟨d, hd, rfl⟩
        simpa only [Finset.coe_inter] using convexHull_chainVertices_inter S c d hc hd }

@[simp]
theorem mem_barycentricComplex_faces (S : Finset E) (s : Finset E) :
    s ∈ (barycentricComplex S).faces ↔
      ∃ c : Finset (ExposedFace S), IsChain S c ∧ s = chainVertices S c :=
  Iff.rfl

theorem barycentricComplex_faces_finite (S : Finset E) :
    (barycentricComplex S).faces.Finite := by
  classical
  let V : Finset E := Finset.univ.image (center S)
  refine V.powerset.finite_toSet.subset ?_
  intro s hs
  obtain ⟨c, _hc, rfl⟩ := hs
  apply Finset.mem_powerset.mpr
  intro x hx
  obtain ⟨F, _hFc, rfl⟩ := (mem_chainVertices S c x).mp hx
  exact Finset.mem_image.mpr ⟨F, Finset.mem_univ F, rfl⟩

theorem chainVerticesInFace_mem_barycentricComplex_faces (S : Finset E)
    (H : ExposedFace S) (c : Finset (ExposedFace S)) (hc : IsChain S c)
    (hne : (chainVerticesInFace S H c).Nonempty) :
    chainVerticesInFace S H c ∈
      (barycentricComplex (faceVertices S H.carrier)).faces := by
  let d := restrictedChain S H c
  have hdne : d.Nonempty := restrictedChain_nonempty_of_filter_nonempty S H hne
  have hd : IsChain (faceVertices S H.carrier) d :=
    isChain_restrictedChain S H hc hdne
  exact ⟨d, hd, (chainVertices_restrictedChain S H c).symm⟩

theorem convexHull_chainVertices_inter_face (S : Finset E) (H : ExposedFace S)
    (c : Finset (ExposedFace S)) :
    convexHull ℝ (chainVertices S c : Set E) ∩ H.carrier =
      convexHull ℝ (chainVerticesInFace S H c : Set E) := by
  let B : Set E := convexHull ℝ (chainVertices S c : Set E)
  have hBC : B ⊆ convexHull ℝ (S : Set E) := by
    apply convexHull_min
    · intro x hx
      obtain ⟨F, _hFc, rfl⟩ :=
        (mem_chainVertices S c x).mp (Finset.mem_coe.mp hx)
      exact F.extreme_carrier.subset (F.center_mem S)
    · exact convex_convexHull ℝ (S : Set E)
  have hBHext : IsExtreme ℝ B (B ∩ H.carrier) := by
    refine ⟨inter_subset_left, ?_⟩
    intro x hxB y hyB z hz hxseg
    have hxC : x ∈ convexHull ℝ (S : Set E) := hBC hxB
    have hyC : y ∈ convexHull ℝ (S : Set E) := hBC hyB
    have hxH : x ∈ H.carrier :=
      H.extreme_carrier.left_mem_of_mem_openSegment hxC hyC hz.2 hxseg
    exact ⟨hxB, hxH⟩
  have hgen := convexHull_filter_mem_extreme (chainVertices S c)
    ((convex_convexHull ℝ (chainVertices S c : Set E)).inter H.convex_carrier) hBHext
  have hvertices : faceVertices (chainVertices S c) (B ∩ H.carrier) =
      chainVerticesInFace S H c := by
    classical
    ext x
    rw [mem_faceVertices, mem_chainVerticesInFace]
    constructor
    · rintro ⟨hx, _hxB, hxH⟩
      exact ⟨hx, hxH⟩
    · rintro ⟨hx, hxH⟩
      exact ⟨hx, subset_convexHull ℝ _ (Finset.mem_coe.mpr hx), hxH⟩
  rw [← hvertices]
  exact hgen.symm

@[simp]
theorem barycentricComplex_space (S : Finset E) :
    (barycentricComplex S).space = convexHull ℝ (S : Set E) := by
  apply Subset.antisymm
  · intro x hx
    rw [SimplicialComplex.mem_space_iff] at hx
    obtain ⟨s, ⟨c, _hc, rfl⟩, hxs⟩ := hx
    apply convexHull_min _ (convex_convexHull ℝ (S : Set E)) hxs
    intro z hz
    obtain ⟨F, _hFc, rfl⟩ :=
      (mem_chainVertices S c z).mp (Finset.mem_coe.mp hz)
    exact F.extreme_carrier.subset (F.center_mem S)
  · intro x hx
    let F : ExposedFace S :=
      { carrier := convexHull ℝ (S : Set E)
        nonempty := ⟨x, hx⟩
        convex_carrier := convex_convexHull ℝ (S : Set E)
        extreme_carrier := IsExtreme.rfl }
    obtain ⟨c, hc, _hFc, _hcF, hxc⟩ := F.exists_chain_convexHull S hx
    rw [SimplicialComplex.mem_space_iff]
    exact ⟨chainVertices S c, ⟨c, hc, rfl⟩, hxc⟩

end Barycentric

/-- The geometric simplicial complex consisting of all nonempty faces of
an affinely independent finite set. -/
noncomputable def simplexComplex (D : Finset E)
    (hD : AffineIndependent ℝ ((↑) : D → E)) : SimplicialComplex ℝ E := by
  classical
  exact
    { faces := {s | s.Nonempty ∧ s ⊆ D}
      isRelLowerSet_faces := by
        rintro s ⟨hs, hsD⟩
        exact ⟨hs, fun t hts ht => ⟨ht, hts.trans hsD⟩⟩
      indep := by
        rintro s ⟨_, hsD⟩
        exact hD.mono fun x hx => hsD hx
      inter_subset_convexHull := by
        rintro s t ⟨_, hsD⟩ ⟨_, htD⟩
        rw [← hD.convexHull_inter hsD htD] }

@[simp]
theorem mem_simplexComplex_faces (D : Finset E)
    (hD : AffineIndependent ℝ ((↑) : D → E)) (s : Finset E) :
    s ∈ (simplexComplex D hD).faces ↔ s.Nonempty ∧ s ⊆ D :=
  Iff.rfl

theorem simplexComplex_faces_finite (D : Finset E)
    (hD : AffineIndependent ℝ ((↑) : D → E)) :
    (simplexComplex D hD).faces.Finite := by
  classical
  refine D.powerset.finite_toSet.subset ?_
  intro s hs
  exact Finset.mem_powerset.mpr hs.2

@[simp]
theorem simplexComplex_space (D : Finset E)
    (hD : AffineIndependent ℝ ((↑) : D → E)) :
    (simplexComplex D hD).space = convexHull ℝ (D : Set E) := by
  classical
  apply Subset.antisymm
  · intro x hx
    rw [SimplicialComplex.mem_space_iff] at hx
    obtain ⟨s, hs, hxs⟩ := hx
    exact convexHull_mono hs.2 hxs
  · intro x hx
    by_cases hDne : D.Nonempty
    · exact (simplexComplex D hD).convexHull_subset_space ⟨hDne, Subset.rfl⟩ hx
    · rw [Finset.not_nonempty_iff_eq_empty.mp hDne, Finset.coe_empty, convexHull_empty] at hx
      exact hx.elim

open _root_.FamiliesOfMapsB01 in
/-- An affinely independent presentation of a polyhedron is already a
subdivision. -/
noncomputable def simplexSubdivision {k : ℕ} (D : Finset (Fin k → ℝ))
    (hD : AffineIndependent ℝ ((↑) : D → Fin k → ℝ)) :
    Subdivision (convexHull ℝ (D : Set (Fin k → ℝ))) where
  complex := simplexComplex D hD
  faces_finite := simplexComplex_faces_finite D hD
  space_eq := simplexComplex_space D hD

end Submission.Polytope
