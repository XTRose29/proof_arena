import Submission.OddOrder.MathlibSupport.PElement

/-!
Cyclic subgroups generated by p-elements.
-/

namespace Submission.OddOrder.MathlibSupport

variable {G : Type*} [Group G]

theorem IsPElement.zpowers_isPGroup {p : ℕ} [Fact p.Prime] {x : G}
    (hx : IsPElement p x) : IsPGroup p (Subgroup.zpowers x) := by
  obtain ⟨k, hk⟩ := hx
  obtain ⟨m, _, hm⟩ := (Nat.dvd_prime_pow Fact.out).mp
    (orderOf_dvd_of_pow_eq_one hk)
  apply IsPGroup.of_card
  rw [Nat.card_zpowers, hm]

end Submission.OddOrder.MathlibSupport
