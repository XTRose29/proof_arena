import Submission.OddOrder.MathlibSupport.PGroupCenter
import Submission.OddOrder.MathlibSupport.SCNExistence

/-!
The first omega subgroup of the centralizer of an inclusion-maximal normal
elementary-abelian subgroup of an odd finite `p`-group.

This is the mathlib-shaped port of MathComp's
`Ohm1_cent_max_normal_abelem` (`solvable/maximal.v`, Aschbacher 23.16).
-/

namespace Submission.OddOrder.MathlibSupport

open scoped commutatorElement IsMulCommutative Pointwise

universe u

variable {G : Type u} [Group G] [Finite G]
variable {p : ℕ} [Fact p.Prime]

/-- In a finite `p`-group, an order-`p` subgroup is centralized by its
normalizer.  This is the `p'group_quotient_cent_prime` step in MathComp's
proof of Aschbacher 23.16. -/
private theorem normalizer_le_centralizer_of_isPGroup_of_card_eq_prime
    {Q : Type*} [Group Q] [Finite Q]
    (hQ : IsPGroup p Q) (H : Subgroup Q) (hHcard : Nat.card H = p) :
    Subgroup.normalizer (H : Set Q) ≤ Subgroup.centralizer (H : Set Q) := by
  classical
  let N : Subgroup Q := Subgroup.normalizer (H : Set Q)
  let f : N →* MulAut H := H.normalizerMonoidHom
  have hNp : IsPGroup p N := hQ.to_subgroup N
  have hRangeP : IsPGroup p f.range := by
    exact hNp.of_surjective f.rangeRestrict f.rangeRestrict_surjective
  have hRange : f.range = ⊥ := by
    by_contra hne
    have hcardRangeGt : 1 < Nat.card f.range :=
      f.range.one_lt_card_iff_ne_bot.mpr hne
    have hpDvdRange : p ∣ Nat.card f.range :=
      hRangeP.card_eq_or_dvd.resolve_left hcardRangeGt.ne'
    have hcyclicH : IsCyclic H := isCyclic_of_prime_card hHcard
    letI : IsCyclic H := hcyclicH
    have hcardAut : Nat.card (MulAut H) = p - 1 := by
      rw [IsCyclic.card_mulAut, hHcard, Nat.totient_prime Fact.out]
    have hRangeDvdAut : Nat.card f.range ∣ Nat.card (MulAut H) :=
      f.range.card_subgroup_dvd_card
    have hpDvdAut : p ∣ Nat.card (MulAut H) :=
      dvd_trans hpDvdRange hRangeDvdAut
    have hpDvdPred : p ∣ p - 1 := by simpa [hcardAut] using hpDvdAut
    have hpTwo : 2 ≤ p := (Fact.out : p.Prime).two_le
    have hpredPos : 0 < p - 1 := by omega
    have hpLePred : p ≤ p - 1 := Nat.le_of_dvd hpredPos hpDvdPred
    omega
  intro n hn
  rw [Subgroup.mem_centralizer_iff]
  intro h hh
  let nN : N := ⟨n, hn⟩
  have hfn : f nN = 1 := by
    have : f nN ∈ f.range := ⟨nN, rfl⟩
    rw [hRange] at this
    exact Subgroup.mem_bot.mp this
  have hfix := congrArg (fun a : MulAut H ↦ a ⟨h, hh⟩) hfn
  have hcomm : n * h = h * n :=
    mul_inv_eq_iff_eq_mul.mp (congrArg Subtype.val hfix)
  exact hcomm.symm

/-- A normal closure of one `p`-torsion element is generated by
`p`-torsion elements (its conjugates), hence is its own first omega
subgroup. -/
private theorem omegaOne_normalClosure_singleton_eq_top
    {K : Type*} [Group K] (x : K) (hxp : x ^ p = 1) :
    omegaOne p (Subgroup.normalClosure ({x} : Set K)) = ⊤ := by
  classical
  let N : Subgroup K := Subgroup.normalClosure ({x} : Set K)
  let W : Subgroup K := (omegaOne p N).map N.subtype
  have hWnormal : W.Normal := by
    dsimp [W, N]
    infer_instance
  letI : W.Normal := hWnormal
  have hxN : x ∈ N := Subgroup.subset_normalClosure (Set.mem_singleton x)
  let xN : N := ⟨x, hxN⟩
  have hxW : x ∈ W := by
    refine ⟨xN, mem_omegaOne_of_pow_eq_one p ?_, rfl⟩
    apply Subtype.ext
    exact hxp
  have hNW : N ≤ W := by
    apply Subgroup.normalClosure_le_normal
    intro y hy
    simpa only [Set.mem_singleton_iff] using hy ▸ hxW
  have hWN : W ≤ N := Subgroup.map_subtype_le (omegaOne p N)
  have hWeq : W = N := le_antisymm hWN hNW
  apply Subgroup.map_injective N.subtype_injective
  rw [show (omegaOne p N).map N.subtype = N by exact hWeq]
  exact ((MonoidHom.range_eq_map N.subtype).symm.trans N.range_subtype).symm

/-- Omega one is idempotent at the level of generated subgroups: the
subtype `omegaOne p K` is generated by its own `p`-torsion elements. -/
private theorem omegaOne_omegaOne_eq_top
    {K : Type*} [Group K] : omegaOne p (omegaOne p K) = ⊤ := by
  classical
  let O : Subgroup K := omegaOne p K
  let W : Subgroup K := (omegaOne p O).map O.subtype
  have hOW : O ≤ W := by
    intro z hz
    change z ∈ Subgroup.closure {x : K | x ^ p = 1} at hz
    induction hz using Subgroup.closure_induction with
    | mem x hx =>
        let xO : O := ⟨x, Subgroup.subset_closure hx⟩
        exact ⟨xO, mem_omegaOne_of_pow_eq_one p (Subtype.ext hx), rfl⟩
    | one => exact W.one_mem
    | mul x y _ _ hx hy => exact W.mul_mem hx hy
    | inv x _ hx => exact W.inv_mem hx
  have hWO : W ≤ O := Subgroup.map_subtype_le (omegaOne p O)
  have hWeq : W = O := le_antisymm hWO hOW
  apply Subgroup.map_injective O.subtype_injective
  rw [show (omegaOne p O).map O.subtype = O by exact hWeq]
  exact ((MonoidHom.range_eq_map O.subtype).symm.trans O.range_subtype).symm

/-- Being generated by `p`-torsion is invariant under an isomorphism. -/
private theorem omegaOne_eq_top_of_mulEquiv
    {K L : Type*} [Group K] [Group L] (e : K ≃* L)
    (hK : omegaOne p K = ⊤) : omegaOne p L = ⊤ := by
  calc
    omegaOne p L = (omegaOne p K).map e.toMonoidHom :=
      (map_omegaOne_equiv p e).symm
    _ = ⊤ := by
      rw [hK]
      exact Subgroup.map_top_of_surjective e.toMonoidHom e.surjective

/-- A group generated by two commuting elements is abelian. -/
private theorem isMulCommutative_of_sup_zpowers_eq_top_of_commute
    {K : Type*} [Group K] {x y : K}
    (hgen : Subgroup.zpowers x ⊔ Subgroup.zpowers y = ⊤)
    (hxy : Commute x y) : IsMulCommutative K := by
  let H : Subgroup K := Subgroup.zpowers x ⊔ Subgroup.zpowers y
  have hHclosure : H = Subgroup.closure ({x, y} : Set K) := by
    dsimp [H]
    rw [Subgroup.zpowers_eq_closure, Subgroup.zpowers_eq_closure,
      ← Subgroup.closure_union]
    congr 1
  letI : IsMulCommutative H := by
    rw [hHclosure]
    apply Subgroup.isMulCommutative_closure
    intro a ha b hb
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
    · rfl
    · exact hxy.eq
    · exact hxy.eq.symm
    · rfl
  refine ⟨⟨fun a b ↦ ?_⟩⟩
  have hHtop : H = ⊤ := by exact hgen
  have ha : a ∈ H := by rw [hHtop]; trivial
  have hb : b ∈ H := by rw [hHtop]; trivial
  exact congrArg Subtype.val (mul_comm (⟨a, ha⟩ : H) ⟨b, hb⟩)

/-- Aschbacher 23.15(3), in the one-generator form needed below.  An
element of order dividing `p` that centralizes the first omega subgroup of
a self-centralizing normal abelian subgroup acts trivially on the quotient
by that omega subgroup. -/
private theorem commutator_zpowers_le_omegaOne_of_selfCentralizing
    (hG : IsPGroup p G) (hpodd : Odd p)
    (A Z : Subgroup G) [A.Normal] [Z.Normal]
    (hAcomm : IsMulCommutative A) (hZA : Z ≤ A)
    (hZpow : ∀ z : Z, z ^ p = 1)
    (hZomega : (omegaOne p A).map A.subtype = Z)
    (hAself : Subgroup.centralizer (A : Set G) = A)
    (x : G) (hxZ : x ∈ Subgroup.centralizer (Z : Set G))
    (hxp : x ^ p = 1) :
    ⁅Subgroup.zpowers x, A⁆ ≤ Z := by
  classical
  letI : IsMulCommutative A := hAcomm
  let q : G →* G ⧸ Z := QuotientGroup.mk' Z
  let X : Subgroup G := Subgroup.zpowers x
  let Cx : Subgroup (G ⧸ Z) :=
    Subgroup.centralizer ({q x} : Set (G ⧸ Z))
  let D : Subgroup G := Cx.comap q
  let B : Subgroup G := A ⊓ D
  let Y : Subgroup G := X ⊔ B
  let XA : Subgroup G := X ⊔ A
  let W : Subgroup G := (omegaOne p Y).map Y.subtype

  have hZB : Z ≤ B := by
    intro z hz
    refine ⟨hZA hz, ?_⟩
    change q z ∈ Cx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    simp only [Set.mem_singleton_iff] at hy
    subst y
    have hqz : q z = 1 := (QuotientGroup.eq_one_iff z).mpr hz
    simp [hqz]
  have hXCZ : X ≤ Subgroup.centralizer (Z : Set G) :=
    Subgroup.zpowers_le.mpr hxZ
  have hACZ : A ≤ Subgroup.centralizer (Z : Set G) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro z hz
    let aA : A := ⟨a, ha⟩
    let zA : A := ⟨z, hZA hz⟩
    exact congrArg Subtype.val (mul_comm zA aA)
  have hYCZ : Y ≤ Subgroup.centralizer (Z : Set G) := by
    apply sup_le hXCZ
    exact (inf_le_left : B ≤ A).trans hACZ

  have hqXCx : X.map q ≤ Cx := by
    rw [show X.map q = Subgroup.zpowers (q x) by
      simp [X, MonoidHom.map_zpowers]]
    apply Subgroup.zpowers_le.mpr
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    simp only [Set.mem_singleton_iff] at hy
    subst y
    rfl
  have hXnormD : X ≤ Subgroup.normalizer (D : Set G) := by
    have hXcomap : X ≤ (Subgroup.normalizer (Cx : Set (G ⧸ Z))).comap q := by
      intro t ht
      exact Cx.le_normalizer (hqXCx ⟨t, ht, rfl⟩)
    exact hXcomap.trans (Subgroup.le_normalizer_comap q)
  have hXnormB : X ≤ Subgroup.normalizer (B : Set G) := by
    have hXnormA : X ≤ Subgroup.normalizer (A : Set G) :=
      Subgroup.le_normalizer_of_normal
    exact (le_inf hXnormA hXnormD).trans
      Subgroup.inf_normalizer_le_normalizer_inf

  have hBqCent : B.map q ≤ Subgroup.centralizer (X.map q : Set (G ⧸ Z)) := by
    intro b hb
    obtain ⟨b, hb, rfl⟩ := hb
    have hbCx : q b ∈ Cx := hb.2
    simpa [Cx, X, MonoidHom.map_zpowers, ← Subgroup.centralizer_closure,
      ← Subgroup.zpowers_eq_closure] using hbCx
  have hXB : ⁅X, B⁆ ≤ Z := by
    rw [← QuotientGroup.ker_mk' Z, ← Subgroup.map_eq_bot_iff,
      Subgroup.map_commutator, Subgroup.commutator_comm,
      Subgroup.commutator_eq_bot_iff_le_centralizer]
    exact hBqCent
  have hXX : ⁅X, X⁆ ≤ Z := by
    calc
      ⁅X, X⁆ = ⊥ := Subgroup.commutator_eq_bot_iff_le_centralizer.mpr (by
        intro a ha
        rw [Subgroup.mem_centralizer_iff]
        intro b hb
        let aX : X := ⟨a, ha⟩
        let bX : X := ⟨b, hb⟩
        exact congrArg Subtype.val (mul_comm bX aX))
      _ ≤ Z := bot_le
  have hBB : ⁅B, B⁆ ≤ Z := by
    calc
      ⁅B, B⁆ = ⊥ := Subgroup.commutator_eq_bot_iff_le_centralizer.mpr (by
        intro a ha
        rw [Subgroup.mem_centralizer_iff]
        intro b hb
        let aA : A := ⟨a, ha.1⟩
        let bA : A := ⟨b, hb.1⟩
        exact congrArg Subtype.val (mul_comm bA aA))
      _ ≤ Z := bot_le
  have hBY : ⁅B, Y⁆ ≤ Z := by
    apply commutator_sup_le_of_normal
    · simpa [Subgroup.commutator_comm] using hXB
    · exact hBB
  have hXY : ⁅X, Y⁆ ≤ Z :=
    commutator_sup_le_of_normal hXX hXB
  have hYY : ⁅Y, Y⁆ ≤ Z := by
    rw [Subgroup.commutator_comm]
    exact commutator_sup_le_of_normal
      (by simpa [Subgroup.commutator_comm] using hXY)
      (by simpa [Subgroup.commutator_comm] using hBY)

  have hYcommCenter : _root_.commutator Y ≤ Subgroup.center Y := by
    intro c hc
    have hcAmbient : (c : G) ∈ ⁅Y, Y⁆ := by
      rw [← Y.map_subtype_commutator]
      exact ⟨c, hc, rfl⟩
    have hcZ : (c : G) ∈ Z := hYY hcAmbient
    rw [Subgroup.mem_center_iff]
    intro y
    apply Subtype.ext
    exact (Subgroup.mem_centralizer_iff.mp (hYCZ y.property) (c : G) hcZ).symm
  have hYp : IsPGroup p Y := hG.to_subgroup Y
  letI : Group.IsNilpotent Y := hYp.isNilpotent
  have hYclass2 : Group.nilpotencyClass Y ≤ 2 :=
    nilpotencyClass_le_two_of_commutator_le_center hYcommCenter
  have hYclass : Group.nilpotencyClass Y ≤ if 3 < p then 3 else 2 := by
    exact hYclass2.trans (by split_ifs <;> omega)
  have hWpow (w : Y) (hw : w ∈ omegaOne p Y) : w ^ p = 1 :=
    omegaOne_pow_eq_one_of_small_nilpotencyClass
      p Fact.out hpodd hYp hYclass w hw

  have hxY : x ∈ Y :=
    (show X ≤ Y from le_sup_left) (Subgroup.mem_zpowers x)
  have hXW : X ≤ W := by
    apply Subgroup.zpowers_le.mpr
    let xY : Y := ⟨x, hxY⟩
    refine ⟨xY, mem_omegaOne_of_pow_eq_one p ?_, rfl⟩
    apply Subtype.ext
    exact hxp
  have hZW : Z ≤ W := by
    intro z hz
    let zY : Y := ⟨z, (show B ≤ Y from le_sup_right) (hZB hz)⟩
    refine ⟨zY, mem_omegaOne_of_pow_eq_one p ?_, rfl⟩
    apply Subtype.ext
    simpa [zY] using congrArg Subtype.val (hZpow ⟨z, hz⟩)
  have hWdef : W = X ⊔ Z := by
    apply le_antisymm ?_ (sup_le hXW hZW)
    intro w hw
    obtain ⟨wY, hwY, rfl⟩ := hw
    have hwMem : (wY : G) ∈ X ⊔ B := by exact wY.property
    have hwMul : (wY : G) ∈ (X : Set G) * (B : Set G) := by
      rw [← Subgroup.coe_mul_of_left_le_normalizer_right X B hXnormB]
      exact hwMem
    obtain ⟨t, htX, b, hbB, htb⟩ := hwMul
    have htW : t ∈ W := hXW htX
    have hwW : (wY : G) ∈ W := ⟨wY, hwY, rfl⟩
    have hbW : b ∈ W := by
      have := W.mul_mem (W.inv_mem htW) hwW
      simpa [← htb, mul_assoc] using this
    obtain ⟨bY, hbOmega, hbY⟩ := hbW
    have hbpowY : bY ^ p = 1 := hWpow bY hbOmega
    have hbpow : b ^ p = 1 := by
      rw [← hbY]
      exact congrArg Subtype.val hbpowY
    let bA : A := ⟨b, hbB.1⟩
    have hbOmegaA : bA ∈ omegaOne p A :=
      mem_omegaOne_of_pow_eq_one p (Subtype.ext hbpow)
    have hbZ : b ∈ Z := by
      rw [← hZomega]
      exact ⟨bA, hbOmegaA, rfl⟩
    change (wY : G) ∈ X ⊔ Z
    rw [← htb]
    exact Subgroup.mul_mem_sup htX hbZ

  have hNormalizesWWithin :
      XA ⊓ Subgroup.normalizer (W : Set G) ≤ Y := by
    intro g hg
    have hgXA : g ∈ X ⊔ A := by exact hg.1
    have hgNW : g ∈ Subgroup.normalizer (W : Set G) := hg.2
    have hgMul : g ∈ (X : Set G) * (A : Set G) := by
      rw [← Subgroup.mul_normal X A]
      exact hgXA
    obtain ⟨t, htX, a, haA, hta⟩ := hgMul
    have hqgNormMap : q g ∈ Subgroup.normalizer (W.map q : Set (G ⧸ Z)) := by
      apply Subgroup.le_normalizer_map q
      exact ⟨g, hgNW, rfl⟩
    have hZmap : Z.map q = ⊥ := by
      apply le_antisymm
      · rintro _ ⟨z, hz, rfl⟩
        exact Subgroup.mem_bot.mpr ((QuotientGroup.eq_one_iff z).mpr hz)
      · exact bot_le
    have hWmap : W.map q = X.map q := by
      rw [hWdef, Subgroup.map_sup, hZmap]
      simp
    have hqgNormX : q g ∈ Subgroup.normalizer (X.map q : Set (G ⧸ Z)) := by
      simpa [hWmap] using hqgNormMap
    have hqtX : q t ∈ X.map q := ⟨t, htX, rfl⟩
    have hqaNormX : q a ∈ Subgroup.normalizer (X.map q : Set (G ⧸ Z)) := by
      have hqtNorm : q t ∈ Subgroup.normalizer (X.map q : Set (G ⧸ Z)) :=
        (X.map q).le_normalizer hqtX
      have hrel : q a = (q t)⁻¹ * q g := by
        rw [← map_inv, ← map_mul, ← hta]
        simp
      rw [hrel]
      exact (Subgroup.normalizer (X.map q : Set (G ⧸ Z))).mul_mem
        ((Subgroup.normalizer (X.map q : Set (G ⧸ Z))).inv_mem hqtNorm)
        hqgNormX
    have hqaCentX : q a ∈ Subgroup.centralizer (X.map q : Set (G ⧸ Z)) := by
      by_cases hXmap : X.map q = ⊥
      · rw [hXmap]
        rw [Subgroup.mem_centralizer_iff]
        intro y hy
        have hy1 : y = 1 := Subgroup.mem_bot.mp hy
        subst y
        simp
      · have hqxNe : q x ≠ 1 := by
          intro hqx
          apply hXmap
          rw [show X.map q = Subgroup.zpowers (q x) by
            simp [X, MonoidHom.map_zpowers], hqx, Subgroup.zpowers_one_eq_bot]
        have hqxp : (q x) ^ p = 1 := by rw [← map_pow, hxp, map_one]
        have hord : orderOf (q x) = p := by
          have hdvd := orderOf_dvd_of_pow_eq_one hqxp
          exact ((Nat.dvd_prime Fact.out).mp hdvd).resolve_left
            (by simpa [orderOf_eq_one_iff] using hqxNe)
        have hcardXmap : Nat.card (X.map q) = p := by
          rw [show X.map q = Subgroup.zpowers (q x) by
            simp [X, MonoidHom.map_zpowers], Nat.card_zpowers, hord]
        exact normalizer_le_centralizer_of_isPGroup_of_card_eq_prime
          (hG.to_quotient Z) (X.map q) hcardXmap hqaNormX
    have haB : a ∈ B := by
      refine ⟨haA, ?_⟩
      change q a ∈ Cx
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      simp only [Set.mem_singleton_iff] at hy
      subst y
      exact Subgroup.mem_centralizer_iff.mp hqaCentX (q x)
        ⟨x, Subgroup.mem_zpowers x, rfl⟩
    rw [← hta]
    exact Subgroup.mul_mem_sup htX haB

  have hYXA : Y ≤ XA := sup_le le_sup_left (inf_le_left.trans le_sup_right)
  have hYeqXA : Y = XA := by
    apply le_antisymm hYXA
    by_contra hnot
    have hne : Y ≠ XA := fun h ↦ hnot h.symm.le
    have hproper : Y < XA := lt_of_le_of_ne hYXA hne
    let YX : Subgroup XA := Y.subgroupOf XA
    have hYXproper : YX < (⊤ : Subgroup XA) := by
      rw [lt_top_iff_ne_top]
      intro htop
      have : Y = XA := by
        have hm := congrArg (Subgroup.map XA.subtype) htop
        have htopmap : (⊤ : Subgroup XA).map XA.subtype = XA := by
          exact (MonoidHom.range_eq_map XA.subtype).symm.trans XA.range_subtype
        rw [show YX.map XA.subtype = Y by
          exact Subgroup.map_subgroupOf_eq_of_le hYXA, htopmap] at hm
        exact hm
      exact hnot this.symm.le
    have hXAp : IsPGroup p XA := hG.to_subgroup XA
    letI : Group.IsNilpotent XA := hXAp.isNilpotent
    have hnormLt : YX < Subgroup.normalizer (YX : Set XA) :=
      Group.normalizerCondition_of_isNilpotent YX hYXproper
    obtain ⟨n, hnNorm, hnNot⟩ := SetLike.exists_of_lt hnormLt
    let g : G := (n : XA)
    have hgXA : g ∈ XA := n.property
    have hgNormY : g ∈ Subgroup.normalizer (Y : Set G) := by
      have hn : n ∈ (Subgroup.normalizer (Y : Set G)).subgroupOf XA := by
        rw [Subgroup.subgroupOf_normalizer_eq hYXA]
        exact hnNorm
      exact hn
    have hgNormW : g ∈ Subgroup.normalizer (W : Set G) := by
      rw [Subgroup.mem_normalizer_iff]
      intro d
      constructor
      · intro hd
        change d ∈ (omegaOne p Y).map Y.subtype at hd
        change g * d * g⁻¹ ∈ (omegaOne p Y).map Y.subtype
        exact characteristic_map_subtype_invariant_under_normalizer
          Y (Subgroup.normalizer (Y : Set G)) (omegaOne p Y)
          le_rfl g hgNormY d hd
      · intro hgd
        change g * d * g⁻¹ ∈ (omegaOne p Y).map Y.subtype at hgd
        have hgInv : g⁻¹ ∈ Subgroup.normalizer (Y : Set G) :=
          (Subgroup.normalizer (Y : Set G)).inv_mem hgNormY
        have hback := characteristic_map_subtype_invariant_under_normalizer
          Y (Subgroup.normalizer (Y : Set G)) (omegaOne p Y)
          le_rfl g⁻¹ hgInv (g * d * g⁻¹) hgd
        change d ∈ (omegaOne p Y).map Y.subtype
        simpa [mul_assoc] using hback
    have hgY : g ∈ Y := hNormalizesWWithin ⟨hgXA, hgNormW⟩
    apply hnNot
    exact hgY

  have hAB : A ≤ B := by
    intro a haA
    have haY0 : a ∈ Y := by
      rw [hYeqXA]
      exact (show A ≤ X ⊔ A from le_sup_right) haA
    have haY : a ∈ X ⊔ B := haY0
    have haMul : a ∈ (X : Set G) * (B : Set G) := by
      rw [← Subgroup.coe_mul_of_left_le_normalizer_right X B hXnormB]
      exact haY
    obtain ⟨t, htX, b, hbB, htb⟩ := haMul
    have htA : t ∈ A := by
      have : t = a * b⁻¹ := by rw [← htb]; group
      rw [this]
      exact A.mul_mem haA (A.inv_mem hbB.1)
    have htp : t ^ p = 1 := by
      change t ∈ Subgroup.zpowers x at htX
      rw [Subgroup.mem_zpowers_iff] at htX
      obtain ⟨n, rfl⟩ := htX
      rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul,
        zpow_natCast, hxp, one_zpow]
    let tA : A := ⟨t, htA⟩
    have htOmega : tA ∈ omegaOne p A :=
      mem_omegaOne_of_pow_eq_one p (Subtype.ext htp)
    have htZ : t ∈ Z := by
      rw [← hZomega]
      exact ⟨tA, htOmega, rfl⟩
    have htB : t ∈ B := hZB htZ
    rw [← htb]
    exact B.mul_mem htB hbB

  rw [← QuotientGroup.ker_mk' Z, ← Subgroup.map_eq_bot_iff,
    Subgroup.map_commutator, Subgroup.commutator_eq_bot_iff_le_centralizer]
  intro t ht
  rw [Subgroup.mem_centralizer_iff]
  intro a ha
  obtain ⟨a, haA, rfl⟩ := ha
  have haB := hAB haA
  have hqaCx : q a ∈ Cx := haB.2
  have htXq : t ∈ X.map q := ht
  rw [show X.map q = Subgroup.zpowers (q x) by
    simp [X, MonoidHom.map_zpowers]] at htXq
  have hCxEq : Cx = Subgroup.centralizer (Subgroup.zpowers (q x) : Set (G ⧸ Z)) := by
    simp [Cx, ← Subgroup.centralizer_closure, ← Subgroup.zpowers_eq_closure]
  rw [hCxEq] at hqaCx
  exact (Subgroup.mem_centralizer_iff.mp hqaCx t htXq).symm

/-- `Ohm1_cent_max_normal_abelem` (Aschbacher 23.16).  If `Z` is an
inclusion-maximal normal elementary-abelian subgroup of an odd finite
`p`-group, then the first omega subgroup of its centralizer is exactly
`Z`.  Since omega one is formed in the centralizer subtype, the conclusion
is transported back to the ambient group. -/
theorem map_omegaOne_centralizerWithin_eq_of_maximal_normal_elementaryAbelian
    (hG : IsPGroup p G) (hpodd : Odd p)
    (Z : Subgroup G) [Z.Normal]
    (hZ : IsElementaryAbelianGroup p Z)
    (hmax : ∀ {E : Subgroup G}, E.Normal →
      IsElementaryAbelianGroup p E → Z ≤ E → E ≤ Z) :
    (omegaOne p (centralizerWithin (⊤ : Subgroup G) Z)).map
        (centralizerWithin (⊤ : Subgroup G) Z).subtype = Z := by
  classical
  let C : Subgroup G := Subgroup.centralizer (Z : Set G)
  let O : Subgroup C := omegaOne p C
  let X : Subgroup G := O.map C.subtype
  have hCeq : centralizerWithin (⊤ : Subgroup G) Z = C := by
    simp [centralizerWithin, C]
  suffices hXZ : X = Z by
    rw [hCeq]
    simpa [O, X] using hXZ

  letI : IsMulCommutative Z := hZ.commutative
  have hZC : Z ≤ C := by
    intro z hz
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    let zZ : Z := ⟨z, hz⟩
    let wZ : Z := ⟨w, hw⟩
    exact congrArg Subtype.val (mul_comm wZ zZ)
  have hZX : Z ≤ X := by
    intro z hz
    let zC : C := ⟨z, hZC hz⟩
    refine ⟨zC, mem_omegaOne_of_pow_eq_one p ?_, rfl⟩
    apply Subtype.ext
    simpa [zC] using congrArg Subtype.val (hZ.pow_eq_one ⟨z, hz⟩)
  have hXCZ : X ≤ Subgroup.centralizer (Z : Set G) := by
    exact (Subgroup.map_subtype_le O).trans_eq rfl
  have hCnormal : C.Normal := by
    dsimp [C]
    infer_instance
  letI : C.Normal := hCnormal
  have hXnormal : X.Normal := by
    dsimp [X, O]
    infer_instance
  letI : X.Normal := hXnormal

  have hZnormalAbelian : IsNormalAbelian Z :=
    ⟨show Z.Normal from inferInstance, hZ.commutative⟩
  obtain ⟨A, hZA, hAnormAb, hAself⟩ :=
    exists_selfCentralizing_isNormalAbelian_containing hG Z hZnormalAbelian
  letI : A.Normal := hAnormAb.normal
  letI : IsMulCommutative A := hAnormAb.isMulCommutative
  let ZA : Subgroup G := (omegaOne p A).map A.subtype
  have hZA_normal : ZA.Normal := by
    dsimp [ZA]
    infer_instance
  letI : ZA.Normal := hZA_normal
  have hZ_ZA : Z ≤ ZA := by
    intro z hz
    let zA : A := ⟨z, hZA hz⟩
    refine ⟨zA, mem_omegaOne_of_pow_eq_one p ?_, rfl⟩
    apply Subtype.ext
    simpa [zA] using congrArg Subtype.val (hZ.pow_eq_one ⟨z, hz⟩)
  have hZA_elem : IsElementaryAbelianGroup p ZA := by
    refine
      { isPGroup := hG.to_subgroup ZA
        commutative := ?_
        pow_eq_one := ?_ }
    · refine ⟨⟨fun a b ↦ ?_⟩⟩
      apply Subtype.ext
      obtain ⟨aA, _, ha⟩ := a.property
      obtain ⟨bA, _, hb⟩ := b.property
      change (a : G) * b = b * a
      rw [← ha, ← hb]
      exact congrArg Subtype.val (mul_comm aA bA)
    · intro z
      obtain ⟨zA, hzOmega, hz⟩ := z.property
      apply Subtype.ext
      change (z : G) ^ p = 1
      rw [← hz]
      simpa using congrArg Subtype.val
        (omegaOne_pow_eq_one_of_mul_closed p
          (fun a b ha hb ↦ by rw [mul_pow, ha, hb, one_mul]) hzOmega)
  have hZA_Z : ZA ≤ Z := hmax hZA_normal hZA_elem hZ_ZA
  have hZAeq : ZA = Z := le_antisymm hZA_Z hZ_ZA

  let q : G →* G ⧸ Z := QuotientGroup.mk' Z
  let S : Subgroup C :=
    (Subgroup.centralizer (A.map q : Set (G ⧸ Z))).comap
      (q.comp C.subtype)
  have hOS : O ≤ S := by
    apply omegaOne_le
    intro c hcp
    have hcZ : (c : G) ∈ Subgroup.centralizer (Z : Set G) := c.property
    have hcpG : (c : G) ^ p = 1 := congrArg Subtype.val hcp
    have hcomm := commutator_zpowers_le_omegaOne_of_selfCentralizing
      hG hpodd A Z hAnormAb.isMulCommutative hZA hZ.pow_eq_one
      hZAeq hAself (c : G) hcZ hcpG
    change q (c : G) ∈ Subgroup.centralizer (A.map q : Set (G ⧸ Z))
    have hmapComm :
        ⁅(Subgroup.zpowers (c : G)).map q, A.map q⁆ = ⊥ := by
      rw [← Subgroup.map_commutator, Subgroup.map_eq_bot_iff]
      simpa [q, QuotientGroup.ker_mk'] using hcomm
    have hcent := Subgroup.commutator_eq_bot_iff_le_centralizer.mp hmapComm
    exact hcent ⟨(c : G), Subgroup.mem_zpowers (c : G), rfl⟩
  have hXqCent : X.map q ≤
      Subgroup.centralizer (A.map q : Set (G ⧸ Z)) := by
    rintro y ⟨x, hx, rfl⟩
    obtain ⟨c, hcO, hc⟩ := hx
    rw [← hc]
    exact hOS hcO
  have hXAcomm : ⁅X, A⁆ ≤ Z := by
    rw [← QuotientGroup.ker_mk' Z, ← Subgroup.map_eq_bot_iff,
      Subgroup.map_commutator,
      Subgroup.commutator_eq_bot_iff_le_centralizer]
    exact hXqCent
  have hZXcommBot : ⁅Z, X⁆ = ⊥ := by
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    intro z hz
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    exact (Subgroup.mem_centralizer_iff.mp (hXCZ hx) z hz).symm
  have hXAZX : ⁅⁅X, A⁆, X⁆ = ⊥ := by
    apply le_bot_iff.mp
    exact (Subgroup.commutator_mono hXAcomm le_rfl).trans (by
      simpa using hZXcommBot.le)
  have hAXZX : ⁅⁅A, X⁆, X⁆ = ⊥ := by
    have hAX : ⁅A, X⁆ ≤ Z := by
      simpa [Subgroup.commutator_comm] using hXAcomm
    apply le_bot_iff.mp
    exact (Subgroup.commutator_mono hAX le_rfl).trans (by
      simpa using hZXcommBot.le)
  have hderivedCentralizesA : ⁅⁅X, X⁆, A⁆ = ⊥ :=
    Subgroup.commutator_commutator_eq_bot_of_rotate hXAZX hAXZX
  have hXderivedA : ⁅X, X⁆ ≤ A := by
    have hcentA := Subgroup.commutator_eq_bot_iff_le_centralizer.mp
      hderivedCentralizesA
    simpa [hAself] using hcentA

  let eOX : O ≃* X :=
    O.equivMapOfInjective C.subtype C.subtype_injective
  have hOmegaX : omegaOne p X = ⊤ :=
    omegaOne_eq_top_of_mulEquiv eOX omegaOne_omegaOne_eq_top
  have hXp : IsPGroup p X := hG.to_subgroup X
  have hXpow : ∀ x : X, x ^ p = 1 := by
    intro x₀
    by_contra hx₀
    let P : Subgroup X → Prop := fun U ↦
      omegaOne p U = ⊤ ∧ ∃ u : U, u ^ p ≠ 1
    let eTop : X ≃* (⊤ : Subgroup X) := Subgroup.topEquiv.symm
    let xTop : (⊤ : Subgroup X) := ⟨x₀, trivial⟩
    have hPtop : P ⊤ := by
      refine ⟨omegaOne_eq_top_of_mulEquiv eTop hOmegaX, xTop, ?_⟩
      intro hxTop
      apply hx₀
      exact congrArg Subtype.val hxTop
    obtain ⟨U, _, hUmin⟩ := Finite.exists_le_minimal hPtop
    have hPU : P U := hUmin.1
    have hOmegaU : omegaOne p U = ⊤ := hPU.1
    obtain ⟨uBad, huBad⟩ := hPU.2
    obtain ⟨x, y, hxp, hyp, hxyp⟩ :
        ∃ x y : U, x ^ p = 1 ∧ y ^ p = 1 ∧ (x * y) ^ p ≠ 1 := by
      by_contra hnone
      have hmul : ∀ a b : U, a ^ p = 1 → b ^ p = 1 →
          (a * b) ^ p = 1 := by
        intro a b ha hb
        by_contra hab
        exact hnone ⟨a, b, ha, hb, hab⟩
      have huOmega : uBad ∈ omegaOne p U := by
        rw [hOmegaU]
        trivial
      exact huBad (omegaOne_pow_eq_one_of_mul_closed p hmul huOmega)
    let H : Subgroup X :=
      Subgroup.zpowers (x : X) ⊔ Subgroup.zpowers (y : X)
    have hHU : H ≤ U := by
      apply sup_le
      · exact Subgroup.zpowers_le.mpr x.property
      · exact Subgroup.zpowers_le.mpr y.property
    let xH : H := ⟨(x : X),
      (show Subgroup.zpowers (x : X) ≤ H from le_sup_left)
        (Subgroup.mem_zpowers (x : X))⟩
    let yH : H := ⟨(y : X),
      (show Subgroup.zpowers (y : X) ≤ H from le_sup_right)
        (Subgroup.mem_zpowers (y : X))⟩
    have hgenH : Subgroup.zpowers xH ⊔ Subgroup.zpowers yH = ⊤ := by
      apply Subgroup.map_injective H.subtype_injective
      rw [Subgroup.map_sup, MonoidHom.map_zpowers,
        MonoidHom.map_zpowers]
      have htopMap : (⊤ : Subgroup H).map H.subtype = H :=
        (MonoidHom.range_eq_map H.subtype).symm.trans H.range_subtype
      rw [htopMap]
      rfl
    have hOmegaH : omegaOne p H = ⊤ := by
      apply top_unique
      rw [← hgenH]
      apply sup_le
      · apply Subgroup.zpowers_le.mpr
        apply mem_omegaOne_of_pow_eq_one p
        apply Subtype.ext
        exact congrArg (fun z : U ↦ (z : X)) hxp
      · apply Subgroup.zpowers_le.mpr
        apply mem_omegaOne_of_pow_eq_one p
        apply Subtype.ext
        exact congrArg (fun z : U ↦ (z : X)) hyp
    have hxyH : (xH * yH) ^ p ≠ 1 := by
      intro h
      apply hxyp
      apply Subtype.ext
      exact congrArg (fun z : H ↦ (z : X)) h
    have hPH : P H := ⟨hOmegaH, ⟨xH * yH, hxyH⟩⟩
    have hUeqH : U = H := hUmin.eq_of_ge hPH hHU
    have hUgen : Subgroup.zpowers x ⊔ Subgroup.zpowers y = ⊤ := by
      apply Subgroup.map_injective U.subtype_injective
      rw [Subgroup.map_sup, MonoidHom.map_zpowers,
        MonoidHom.map_zpowers]
      have htopMap : (⊤ : Subgroup U).map U.subtype = U :=
        (MonoidHom.range_eq_map U.subtype).symm.trans U.range_subtype
      rw [htopMap]
      simpa [H] using hUeqH.symm

    have hzxNeTop : Subgroup.zpowers x ≠ (⊤ : Subgroup U) := by
      intro hzxTop
      letI : IsCyclic U :=
        isCyclic_iff_exists_zpowers_eq_top.mpr ⟨x, hzxTop⟩
      letI : IsMulCommutative U := IsCyclic.isMulCommutative
      apply hxyp
      have hxy : Commute x y := Std.Commutative.comm x y
      simpa [hxp, hyp] using hxy.mul_pow p
    have hzxLt : Subgroup.zpowers x < (⊤ : Subgroup U) :=
      lt_top_iff_ne_top.mpr hzxNeTop
    obtain ⟨M, hxM, hMcoatom⟩ := exists_le_covBy_of_lt hzxLt
    have hUp : IsPGroup p U := hXp.to_subgroup U
    have hMnormal : M.Normal :=
      IsPGroup.isCoatom_normal hUp hMcoatom.isCoatom
    letI : M.Normal := hMnormal
    let VU : Subgroup U := Subgroup.normalClosure ({x} : Set U)
    have hVUM : VU ≤ M := by
      apply Subgroup.normalClosure_le_normal
      intro z hz
      simpa only [Set.mem_singleton_iff] using hz ▸
        (Subgroup.zpowers_le.mp hxM)
    have hVUproper : VU < (⊤ : Subgroup U) :=
      lt_of_le_of_lt hVUM hMcoatom.lt
    have hOmegaVU : omegaOne p VU = ⊤ :=
      omegaOne_normalClosure_singleton_eq_top x hxp
    let V : Subgroup X := VU.map U.subtype
    have hVltU : V < U := by
      have hm : VU.map U.subtype < (⊤ : Subgroup U).map U.subtype :=
        Subgroup.map_subtype_lt_map_subtype.mpr hVUproper
      have htopMap : (⊤ : Subgroup U).map U.subtype = U :=
        (MonoidHom.range_eq_map U.subtype).symm.trans U.range_subtype
      simpa [V, htopMap] using hm
    let eV : VU ≃* V :=
      VU.equivMapOfInjective U.subtype U.subtype_injective
    have hOmegaV : omegaOne p V = ⊤ :=
      omegaOne_eq_top_of_mulEquiv eV hOmegaVU
    have hVpow : ∀ v : V, v ^ p = 1 := by
      intro v
      by_contra hv
      have hPV : P V := ⟨hOmegaV, ⟨v, hv⟩⟩
      have hUeqV : U = V := hUmin.eq_of_ge hPV hVltU.le
      exact hVltU.ne hUeqV.symm

    letI : VU.Normal := by
      dsimp [VU]
      infer_instance
    have hxVU : x ∈ VU :=
      Subgroup.subset_normalClosure (Set.mem_singleton x)
    have hcVU : ⁅x, y⁆ ∈ VU := by
      apply Subgroup.commutator_le_left VU (⊤ : Subgroup U)
      exact Subgroup.commutator_mem_commutator hxVU trivial
    let cV : V := ⟨(⁅x, y⁆ : U), ⟨⁅x, y⁆, hcVU, rfl⟩⟩
    have hcGpow :
        ⁅(((x : U) : X) : G), (((y : U) : X) : G)⁆ ^ p = 1 := by
      have hcPow := hVpow cV
      exact congrArg (fun z : V ↦ (((z : X) : G))) hcPow
    have hcA : ⁅(((x : U) : X) : G), (((y : U) : X) : G)⁆ ∈ A :=
      hXderivedA (Subgroup.commutator_mem_commutator
        (x : X).property (y : X).property)
    have hcZ : ⁅(((x : U) : X) : G), (((y : U) : X) : G)⁆ ∈ Z := by
      rw [← hZAeq]
      let cA : A :=
        ⟨⁅(((x : U) : X) : G), (((y : U) : X) : G)⁆, hcA⟩
      exact ⟨cA, mem_omegaOne_of_pow_eq_one p (Subtype.ext hcGpow), rfl⟩
    have hcCenter : ⁅x, y⁆ ∈ Subgroup.center U := by
      rw [Subgroup.mem_center_iff]
      intro u
      apply Subtype.ext
      apply Subtype.ext
      exact (Subgroup.mem_centralizer_iff.mp
        (hXCZ (u : X).property)
        ⁅(((x : U) : X) : G), (((y : U) : X) : G)⁆ hcZ).symm

    have huBadNe : uBad ≠ 1 := by
      intro hu
      apply huBad
      rw [hu]
      simp
    letI : Nontrivial U := ⟨⟨uBad, 1, huBadNe⟩⟩
    let qU : U →* U ⧸ Subgroup.center U :=
      QuotientGroup.mk' (Subgroup.center U)
    have hqgen :
        Subgroup.zpowers (qU x) ⊔ Subgroup.zpowers (qU y) = ⊤ := by
      calc
        Subgroup.zpowers (qU x) ⊔ Subgroup.zpowers (qU y) =
            (Subgroup.zpowers x ⊔ Subgroup.zpowers y).map qU := by
              rw [Subgroup.map_sup, MonoidHom.map_zpowers,
                MonoidHom.map_zpowers]
        _ = ⊤ := by
          rw [hUgen]
          exact Subgroup.map_top_of_surjective qU
            (QuotientGroup.mk'_surjective (Subgroup.center U))
    have hqxy : Commute (qU x) (qU y) := by
      apply commutatorElement_eq_one_iff_commute.mp
      rw [← map_commutatorElement]
      exact (QuotientGroup.eq_one_iff ⁅x, y⁆).mpr hcCenter
    have hQcomm : IsMulCommutative (U ⧸ Subgroup.center U) :=
      isMulCommutative_of_sup_zpowers_eq_top_of_commute hqgen hqxy
    letI : Group.IsNilpotent U := hUp.isNilpotent
    have hQp : IsPGroup p (U ⧸ Subgroup.center U) :=
      hUp.to_quotient (Subgroup.center U)
    letI : Group.IsNilpotent (U ⧸ Subgroup.center U) := hQp.isNilpotent
    have hQclass :
        Group.nilpotencyClass (U ⧸ Subgroup.center U) ≤ 1 :=
      (Group.IsNilpotent.nilpotencyClass_le_one_iff).mpr hQcomm
    have hUclass : Group.nilpotencyClass U ≤ 2 := by
      rw [Group.nilpotencyClass_eq_quotient_center_plus_one]
      omega
    have hUclassBound :
        Group.nilpotencyClass U ≤ if 3 < p then 3 else 2 :=
      hUclass.trans (by split_ifs <;> omega)
    have huBadPow := omegaOne_pow_eq_one_of_small_nilpotencyClass
      p Fact.out hpodd hUp hUclassBound uBad (by
        rw [hOmegaU]
        trivial)
    exact huBad huBadPow
  have hXexp : Monoid.exponent X ∣ p :=
    Monoid.exponent_dvd_of_forall_pow_eq_one hXpow

  apply le_antisymm ?_ hZX
  by_contra hXZ
  let Xbar : Subgroup (G ⧸ Z) := X.map q
  have hXbarNormal : Xbar.Normal := by
    dsimp [Xbar]
    exact Subgroup.Normal.map (show X.Normal from inferInstance) q
      (QuotientGroup.mk'_surjective Z)
  letI : Xbar.Normal := hXbarNormal
  have hXbarNe : Xbar ≠ ⊥ := by
    intro hbot
    apply hXZ
    have hXker : X ≤ q.ker := (Subgroup.map_eq_bot_iff X).mp hbot
    simpa [q, QuotientGroup.ker_mk'] using hXker
  have hQp : IsPGroup p (G ⧸ Z) := hG.to_quotient Z
  have hmeet : Xbar ⊓ Subgroup.center (G ⧸ Z) ≠ ⊥ :=
    normal_inf_center_ne_bot hQp Xbar hXbarNe
  have hmeetNontrivial :
      Nontrivial ↑(Xbar ⊓ Subgroup.center (G ⧸ Z)) :=
    (Subgroup.nontrivial_iff_ne_bot _).mpr hmeet
  obtain ⟨z, hz, hzOne⟩ :=
    (Subgroup.nontrivial_iff_exists_ne_one
      (Xbar ⊓ Subgroup.center (G ⧸ Z))).mp hmeetNontrivial
  let K : Subgroup (G ⧸ Z) := Subgroup.zpowers z
  have hKXbar : K ≤ Xbar := Subgroup.zpowers_le.mpr hz.1
  have hKcenter : K ≤ Subgroup.center (G ⧸ Z) :=
    Subgroup.zpowers_le.mpr hz.2
  have hKne : K ≠ ⊥ := by
    simpa [K, Subgroup.zpowers_eq_bot] using hzOne
  letI : K.Normal := by
    constructor
    intro k hk g
    have hkCenter := Subgroup.mem_center_iff.mp (hKcenter hk) g
    simpa [hkCenter] using hk
  let D : Subgroup G := K.comap q
  have hZD : Z ≤ D := QuotientGroup.le_comap_mk' Z K
  have hDX : D ≤ X := by
    change K.comap q ≤ X
    apply (Subgroup.comap_mono hKXbar).trans_eq
    dsimp [Xbar]
    apply Subgroup.comap_map_eq_self
    simpa [q, QuotientGroup.ker_mk'] using hZX
  have hDnormal : D.Normal := by
    dsimp [D]
    infer_instance
  let f₀ : D →* (G ⧸ Z) := q.comp D.subtype
  let f : D →* K := f₀.codRestrict K fun d ↦ d.2
  have hfker : f.ker ≤ Subgroup.center D := by
    intro a ha
    rw [Subgroup.mem_center_iff]
    intro b
    apply Subtype.ext
    have hfa : f a = 1 := f.mem_ker.mp ha
    have hqa : q (a : G) = 1 := congrArg Subtype.val hfa
    have haZ : (a : G) ∈ Z :=
      (QuotientGroup.eq_one_iff (a : G)).mp (by simpa [q] using hqa)
    exact (Subgroup.mem_centralizer_iff.mp
      (hXCZ (hDX b.property)) (a : G) haZ).symm
  have hDcomm : IsMulCommutative D :=
    f.isMulCommutative_of_isCyclic_of_ker_le_center hfker
  have hDpow : ∀ d : D, d ^ p = 1 := by
    intro d
    let dX : X := ⟨(d : G), hDX d.property⟩
    apply Subtype.ext
    exact congrArg (fun x : X ↦ (x : G)) (hXpow dX)
  have hDelem : IsElementaryAbelianGroup p D :=
    { isPGroup := hG.to_subgroup D
      commutative := hDcomm
      pow_eq_one := hDpow }
  have hDZ : D ≤ Z := hmax hDnormal hDelem hZD
  apply hKne
  calc
    K = D.map q :=
      (Subgroup.map_comap_eq_self_of_surjective
        (QuotientGroup.mk'_surjective Z) K).symm
    _ = ⊥ := by
      rw [Subgroup.map_eq_bot_iff]
      simpa [q, QuotientGroup.ker_mk'] using hDZ

end Submission.OddOrder.MathlibSupport
