import Mathlib.GroupTheory.Rank
import Submission.OddOrder.MathlibSupport.HuppertGenerators
import Submission.OddOrder.MathlibSupport.Metacyclic

/-!
The generator-rank bound for metacyclic groups.
-/

namespace Submission.OddOrder.MathlibSupport

universe u

/-- A metacyclic group is generated by at most two elements. -/
theorem rank_le_two_of_isMetacyclic
    {G : Type u} [Group G] [Finite G] [Group.FG G]
    (hG : IsMetacyclic G) :
    Group.rank G ≤ 2 := by
  classical
  rcases hG with ⟨S, hSnormal, hScyclic, hQcyclic⟩
  letI : S.Normal := hSnormal
  letI : IsCyclic S := hScyclic
  letI : IsCyclic (G ⧸ S) := hQcyclic
  let T : Subgroup G := ⊥
  have hTnormal : T.Normal := by
    dsimp [T]
    infer_instance
  letI : T.Normal := hTnormal
  have hTsubS : T.subgroupOf S = (⊥ : Subgroup S) := by
    ext x
    simp [T]
  have hInnerCyclic : IsCyclic (S ⧸ T.subgroupOf S) :=
    (QuotientGroup.quotientMulEquivOfEq hTsubS).isCyclic.mpr
      (QuotientGroup.quotientBot.isCyclic.mpr hScyclic)
  letI : IsCyclic (S ⧸ T.subgroupOf S) := hInnerCyclic
  obtain ⟨x, y, _hxS, hxS, hyG⟩ :=
    exists_two_generators_of_cyclic_tower T S (by exact bot_le)
  have hxS' : Subgroup.zpowers x = S := by
    simpa [T] using hxS
  have hgen : Subgroup.zpowers y ⊔ Subgroup.zpowers x = ⊤ := by
    simpa [hxS'] using hyG
  have hclosure : Subgroup.closure ({y, x} : Set G) = ⊤ := by
    rw [← hgen, Subgroup.zpowers_eq_closure,
      Subgroup.zpowers_eq_closure, ← Subgroup.closure_union]
    congr 1
  calc
    Group.rank G ≤ ({y, x} : Finset G).card := by
      apply Group.rank_le
      simpa only [Finset.coe_insert, Finset.coe_singleton] using hclosure
    _ ≤ 2 := Finset.card_le_two

end Submission.OddOrder.MathlibSupport
