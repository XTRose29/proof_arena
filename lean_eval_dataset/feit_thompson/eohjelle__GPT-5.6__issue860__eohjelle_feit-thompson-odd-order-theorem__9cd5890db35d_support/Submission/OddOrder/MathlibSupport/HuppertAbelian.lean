import Submission.OddOrder.MathlibSupport.FrattiniPGroup
import Submission.OddOrder.MathlibSupport.Metacyclic
import Submission.OddOrder.MathlibSupport.OmegaOneCyclicMaximal
import Submission.OddOrder.MathlibSupport.PrimeIndex

/-!
The commutative branch of Huppert's metacyclicity criterion.

The proof uses the Burnside-basis argument in place of unpacking the full
finite-abelian-group classification.  The first omega subgroup is the kernel
of the `p`th-power endomorphism, so its cardinality bounds the Frattini
quotient.  A `p`-group of order at most `p²` is generated by two elements;
lifting those generators and using the nongenerating property of the
Frattini subgroup gives the required cyclic-by-cyclic decomposition.
-/

namespace Submission.OddOrder.MathlibSupport

open scoped IsMulCommutative

universe u

variable {G : Type u} [Group G] [Finite G]
variable {p : ℕ} [Fact p.Prime]

/-- A finite `p`-group of cardinality at most `p²` is generated by at most
two elements. -/
theorem exists_zpowers_sup_zpowers_eq_top_of_isPGroup_card_le_prime_sq
    (hG : IsPGroup p G) (hcard : Nat.card G ≤ p ^ 2) :
    ∃ x y : G, Subgroup.zpowers x ⊔ Subgroup.zpowers y = ⊤ := by
  classical
  obtain ⟨n, hn⟩ := hG.exists_card_eq
  have hnle : n ≤ 2 := by
    apply (Nat.pow_le_pow_iff_right (Fact.out : p.Prime).one_lt).mp
    simpa [hn] using hcard
  interval_cases n
  · have hcardOne : Nat.card G = 1 := by simpa using hn
    letI : Subsingleton G := (Nat.card_eq_one_iff_unique.mp hcardOne).1
    refine ⟨1, 1, top_unique ?_⟩
    intro z _
    simp [Subsingleton.elim z 1]
  · have hcardPrime : Nat.card G = p := by simpa using hn
    letI : IsCyclic G := isCyclic_of_prime_card hcardPrime
    obtain ⟨x, hx⟩ := isCyclic_iff_exists_zpowers_eq_top.mp
      (inferInstance : IsCyclic G)
    exact ⟨x, 1, by simp [hx]⟩
  · have hcardSq : Nat.card G = p ^ 2 := by simpa using hn
    by_cases hcyclic : IsCyclic G
    · obtain ⟨x, hx⟩ := isCyclic_iff_exists_zpowers_eq_top.mp hcyclic
      exact ⟨x, 1, by simp [hx]⟩
    · haveI : Nontrivial G := by
        apply Finite.one_lt_card_iff_nontrivial.mp
        rw [hcardSq]
        exact one_lt_pow₀ (Fact.out : p.Prime).one_lt (by omega)
      obtain ⟨x, hx⟩ := exists_ne (1 : G)
      obtain ⟨k, hk⟩ := IsPGroup.iff_orderOf.mp hG x
      have hkle : k ≤ 2 := by
        apply (Nat.pow_le_pow_iff_right (Fact.out : p.Prime).one_lt).mp
        rw [← hk, ← hcardSq]
        exact Nat.le_of_dvd Nat.card_pos (orderOf_dvd_natCard x)
      have hkne0 : k ≠ 0 := by
        intro hk0
        apply hx
        rw [← orderOf_eq_one_iff, hk, hk0, pow_zero]
      have hkne2 : k ≠ 2 := by
        intro hk2
        apply hcyclic
        apply isCyclic_of_orderOf_eq_card x
        rw [hk, hk2, hcardSq]
      have hk1 : k = 1 := by omega
      let X : Subgroup G := Subgroup.zpowers x
      have hXcard : Nat.card X = p := by
        dsimp [X]
        rw [Nat.card_zpowers, hk, hk1, pow_one]
      have hXindex : X.index = p := by
        have hp : 0 < p := (Fact.out : p.Prime).pos
        apply Nat.eq_of_mul_eq_mul_left hp
        calc
          p * X.index = Nat.card X * X.index := by rw [hXcard]
          _ = Nat.card G := X.card_mul_index
          _ = p * p := by rw [hcardSq, pow_two]
      have hXcoatom : IsCoatom X :=
        isCoatom_of_index_eq_prime Fact.out hXindex
      obtain ⟨y, hy⟩ := SetLike.exists_of_lt hXcoatom.lt_top
      have hsup : X ⊔ Subgroup.zpowers y = ⊤ := by
        rcases hXcoatom.le_iff.mp le_sup_left with htop | heq
        · exact htop
        · exfalso
          apply hy.2
          rw [← heq]
          exact (show Subgroup.zpowers y ≤ X ⊔ Subgroup.zpowers y from
            le_sup_right) (Subgroup.mem_zpowers y)
      exact ⟨x, y, hsup⟩

/-- A commutative group generated by two elements is metacyclic. -/
theorem isMetacyclic_of_isMulCommutative_of_two_generators
    [IsMulCommutative G] (x y : G)
    (hgen : Subgroup.zpowers x ⊔ Subgroup.zpowers y = ⊤) :
    IsMetacyclic G := by
  let X : Subgroup G := Subgroup.zpowers x
  have hXnormal : X.Normal := by
    dsimp [X]
    infer_instance
  letI : X.Normal := hXnormal
  have hXcyclic : IsCyclic X := by
    dsimp [X]
    infer_instance
  let q : G →* G ⧸ X := QuotientGroup.mk' X
  have hmapGen := congrArg (Subgroup.map q) hgen
  have hqx : q x = 1 :=
    (QuotientGroup.eq_one_iff x).mpr (Subgroup.mem_zpowers x)
  have hmapY : (Subgroup.zpowers y).map q = ⊤ := by
    rw [Subgroup.map_sup, MonoidHom.map_zpowers,
      MonoidHom.map_zpowers, hqx, Subgroup.zpowers_one_eq_bot,
      bot_sup_eq, Subgroup.map_top_of_surjective q
        (QuotientGroup.mk'_surjective X)] at hmapGen
    simpa [MonoidHom.map_zpowers] using hmapGen
  have hQcyclic : IsCyclic (G ⧸ X) :=
    isCyclic_iff_exists_zpowers_eq_top.mpr ⟨q y, by
      simpa [MonoidHom.map_zpowers] using hmapY⟩
  exact isMetacyclic_of_normal_cyclic_quotient
    G X hXnormal hXcyclic hQcyclic

/-- The commutative branch of `BGsection4.v: p2_Ohm1_metacyclic`. -/
theorem isMetacyclic_of_isMulCommutative_of_omegaOne_card_le_prime_sq
    [IsMulCommutative G] (hG : IsPGroup p G)
    (hOmega : Nat.card (omegaOne p G) ≤ p ^ 2) :
    IsMetacyclic G := by
  classical
  let f : G →* G := powMonoidHom p
  have hRangeFrattini : f.range ≤ frattini G := by
    rintro _ ⟨x, rfl⟩
    exact IsPGroup.pow_prime_mem_frattini hG x
  have hIndex : (frattini G).index ≤ f.range.index :=
    Subgroup.index_antitone hRangeFrattini
  have hRangeIndex : f.range.index = Nat.card f.ker :=
    Subgroup.index_range
  have hOmegaKer : omegaOne p G = f.ker :=
    omegaOne_eq_powMonoidHom_ker p
  let Q := G ⧸ frattini G
  have hQcard : Nat.card Q ≤ p ^ 2 := by
    calc
      Nat.card Q = (frattini G).index := (frattini G).index_eq_card.symm
      _ ≤ f.range.index := hIndex
      _ = Nat.card f.ker := hRangeIndex
      _ = Nat.card (omegaOne p G) := by rw [hOmegaKer]
      _ ≤ p ^ 2 := hOmega
  have hQp : IsPGroup p Q := hG.to_quotient (frattini G)
  obtain ⟨xbar, ybar, hbar⟩ :=
    exists_zpowers_sup_zpowers_eq_top_of_isPGroup_card_le_prime_sq
      hQp hQcard
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (frattini G) xbar
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (frattini G) ybar
  let q : G →* Q := QuotientGroup.mk' (frattini G)
  let H : Subgroup G := Subgroup.zpowers x ⊔ Subgroup.zpowers y
  have hHmap : H.map q = ⊤ := by
    change (Subgroup.zpowers x ⊔ Subgroup.zpowers y).map q = ⊤
    rw [Subgroup.map_sup, MonoidHom.map_zpowers, MonoidHom.map_zpowers]
    simpa [q, Q] using hbar
  have hHsup : H ⊔ frattini G = ⊤ := by
    have hcomap := congrArg (Subgroup.comap q) hHmap
    rw [Subgroup.comap_map_eq] at hcomap
    have hqker : q.ker = frattini G := by
      dsimp [q]
      exact QuotientGroup.ker_mk' (frattini G)
    rw [hqker] at hcomap
    simpa [H] using hcomap
  have hHtop : H = ⊤ := frattini_nongenerating hHsup
  exact isMetacyclic_of_isMulCommutative_of_two_generators x y hHtop

end Submission.OddOrder.MathlibSupport
