import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.Tactic.Group

/-!
Power calculus for groups whose commutator subgroup is central.
-/

namespace Submission.OddOrder.MathlibSupport

open scoped commutatorElement IsMulCommutative

universe u

variable {G : Type u} [Group G]

/-- The subgroup generated by all `p^n`th powers. -/
def iteratedPowerSubgroup (p n : ℕ) (G : Type u) [Group G] : Subgroup G :=
  Subgroup.closure {x : G | ∃ y : G, y ^ (p ^ n) = x}

theorem pow_mem_iteratedPowerSubgroup (p n : ℕ) (x : G) :
    x ^ (p ^ n) ∈ iteratedPowerSubgroup p n G :=
  Subgroup.subset_closure ⟨x, rfl⟩

instance iteratedPowerSubgroup_characteristic (p n : ℕ) :
    (iteratedPowerSubgroup p n G).Characteristic := by
  rw [Subgroup.characteristic_iff_map_le]
  intro e
  rw [iteratedPowerSubgroup, MonoidHom.map_closure]
  apply Subgroup.closure_mono
  rintro _ ⟨x, ⟨y, rfl⟩, rfl⟩
  exact ⟨e y, by simp⟩

theorem commutatorElement_mem_center_of_commutator_le
    (hcentral : _root_.commutator G ≤ Subgroup.center G) (x y : G) :
    ⁅x, y⁆ ∈ Subgroup.center G :=
  hcentral (Subgroup.commutator_mem_commutator
    (H₁ := (⊤ : Subgroup G)) (H₂ := (⊤ : Subgroup G)) trivial trivial)

theorem commutatorElement_mul_left_of_commutator_le
    (hcentral : _root_.commutator G ≤ Subgroup.center G) (a b c : G) :
    ⁅a * b, c⁆ = ⁅a, c⁆ * ⁅b, c⁆ := by
  rw [_root_.commutatorElement_mul_left_eq_conj_mul]
  have hbc := Subgroup.mem_center_iff.mp
    (commutatorElement_mem_center_of_commutator_le hcentral b c) a
  calc
    a * ⁅b, c⁆ * a⁻¹ * ⁅a, c⁆ = ⁅b, c⁆ * ⁅a, c⁆ := by
      rw [hbc]
      group
    _ = ⁅a, c⁆ * ⁅b, c⁆ :=
      (Subgroup.mem_center_iff.mp
        (commutatorElement_mem_center_of_commutator_le hcentral b c) ⁅a, c⁆).symm

theorem commutatorElement_mul_right_of_commutator_le
    (hcentral : _root_.commutator G ≤ Subgroup.center G) (a b c : G) :
    ⁅a, b * c⁆ = ⁅a, b⁆ * ⁅a, c⁆ := by
  rw [_root_.commutatorElement_mul_right_eq_mul_conj]
  have hac := Subgroup.mem_center_iff.mp
    (commutatorElement_mem_center_of_commutator_le hcentral a c) b
  calc
    ⁅a, b⁆ * b * ⁅a, c⁆ * b⁻¹ = ⁅a, b⁆ * (b * ⁅a, c⁆) * b⁻¹ := by group
    _ = ⁅a, b⁆ * (⁅a, c⁆ * b) * b⁻¹ := by rw [hac]
    _ = ⁅a, b⁆ * ⁅a, c⁆ := by group

theorem commutatorElement_pow_left_of_commutator_le
    (hcentral : _root_.commutator G ≤ Subgroup.center G) (a b : G) :
    ∀ n : ℕ, ⁅a ^ n, b⁆ = ⁅a, b⁆ ^ n
  | 0 => by simp
  | n + 1 => by
      rw [pow_succ, commutatorElement_mul_left_of_commutator_le hcentral,
        commutatorElement_pow_left_of_commutator_le hcentral a b n, pow_succ]

theorem commutatorElement_pow_right_of_commutator_le
    (hcentral : _root_.commutator G ≤ Subgroup.center G) (a b : G) :
    ∀ n : ℕ, ⁅a, b ^ n⁆ = ⁅a, b⁆ ^ n
  | 0 => by simp
  | n + 1 => by
      rw [pow_succ, commutatorElement_mul_right_of_commutator_le hcentral,
        commutatorElement_pow_right_of_commutator_le hcentral a b n, pow_succ]

theorem commutatorElement_pow_pow_of_commutator_le
    (hcentral : _root_.commutator G ≤ Subgroup.center G)
    (a b : G) (m n : ℕ) :
    ⁅a ^ m, b ^ n⁆ = ⁅a, b⁆ ^ (m * n) := by
  rw [commutatorElement_pow_left_of_commutator_le hcentral,
    commutatorElement_pow_right_of_commutator_le hcentral, ← pow_mul]
  congr 1
  exact Nat.mul_comm n m

/-- If the next power subgroup is central, the current nonzero-level power
subgroup is abelian. -/
theorem iteratedPowerSubgroup_isMulCommutative_of_succ_le_center
    (hcentral : _root_.commutator G ≤ Subgroup.center G)
    (p n : ℕ) (hn : 0 < n)
    (hsucc : iteratedPowerSubgroup p (n + 1) G ≤ Subgroup.center G) :
    IsMulCommutative (iteratedPowerSubgroup p n G) := by
  apply Subgroup.isMulCommutative_closure
  rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
  rw [← commutatorElement_eq_one_iff_mul_comm]
  let a := p ^ n
  have haa : x ^ (a * a) ∈ iteratedPowerSubgroup p (n + 1) G := by
    obtain ⟨d, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn.ne'
    have hexp : p ^ (d + 1) * p ^ (d + 1) = p ^ d * p ^ (d + 1 + 1) := by
      rw [← pow_add p (d + 1) (d + 1), ← pow_add p d (d + 1 + 1)]
      congr 1
      omega
    rw [show a * a = p ^ d * p ^ (d + 1 + 1) by simpa [a] using hexp,
      pow_mul]
    exact pow_mem_iteratedPowerSubgroup p (d + 1 + 1) (x ^ (p ^ d))
  calc
    ⁅x ^ a, y ^ a⁆ = ⁅x, y⁆ ^ (a * a) :=
      commutatorElement_pow_pow_of_commutator_le hcentral x y a a
    _ = ⁅x ^ (a * a), y⁆ :=
      (commutatorElement_pow_left_of_commutator_le hcentral x y (a * a)).symm
    _ = 1 := commutatorElement_eq_one_iff_commute.mpr
      (Subgroup.mem_center_iff.mp (hsucc haa) y).symm

/-- If the commutator subgroup is the center and all `p`th powers are
central, then the center has exponent dividing `p`. -/
theorem center_pow_eq_one_of_commutator_eq_center_of_pow_mem_center
    (p : ℕ) (hcomm : _root_.commutator G = Subgroup.center G)
    (hpow : ∀ x : G, x ^ p ∈ Subgroup.center G)
    (z : Subgroup.center G) : z ^ p = 1 := by
  let f : Subgroup.center G →* Subgroup.center G :=
    { toFun := fun x ↦ x ^ p
      map_one' := one_pow p
      map_mul' := fun x y ↦ by
        exact mul_pow x y p }
  let P : Subgroup G := f.ker.map (Subgroup.center G).subtype
  have hcommP : _root_.commutator G ≤ P := by
    change ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ ≤ P
    rw [Subgroup.commutator_le]
    intro x _hx y _hy
    have hxyCenter : ⁅x, y⁆ ∈ Subgroup.center G := by
      rw [← hcomm]
      exact Subgroup.commutator_mem_commutator trivial trivial
    let xy : Subgroup.center G := ⟨⁅x, y⁆, hxyCenter⟩
    refine ⟨xy, ?_, rfl⟩
    change f xy = 1
    apply Subtype.ext
    change (⁅x, y⁆ : G) ^ p = 1
    rw [← commutatorElement_pow_left_of_commutator_le hcomm.le x y p]
    exact commutatorElement_eq_one_iff_commute.mpr
      (Subgroup.mem_center_iff.mp (hpow x) y).symm
  have hzP : (z : G) ∈ P := by
    apply hcommP
    simpa only [hcomm] using z.property
  rcases hzP with ⟨z', hz', hzz'⟩
  have hzpow : z' ^ p = 1 := MonoidHom.mem_ker.mp hz'
  apply Subtype.ext
  change (z : G) ^ p = 1
  rw [← hzz']
  exact congrArg Subtype.val hzpow

end Submission.OddOrder.MathlibSupport
