import Submission.OddOrder.MathlibSupport.CentralCommutatorPowers
import Submission.OddOrder.MathlibSupport.OmegaOneCyclicMaximal

/-!
The cyclic-factor calculation in the hard branch of Huppert's induction.
-/

namespace Submission.OddOrder.MathlibSupport

open scoped commutatorElement IsMulCommutative

universe u

variable {G : Type u} [Group G] [Finite G]
variable {p : ℕ} [Fact p.Prime]

/-- In a commutative group, the subgroup generated by the `p`th powers is
the range of the `p`th-power endomorphism. -/
theorem iteratedPowerSubgroup_one_eq_powMonoidHom_range
    {H : Type*} [Group H] [IsMulCommutative H] (p : ℕ) :
    iteratedPowerSubgroup p 1 H = (powMonoidHom p : H →* H).range := by
  apply le_antisymm
  · rw [iteratedPowerSubgroup, Subgroup.closure_le]
    rintro _ ⟨x, rfl⟩
    exact ⟨x, by simp⟩
  · rintro _ ⟨x, rfl⟩
    simpa using pow_mem_iteratedPowerSubgroup p 1 x

/-- The first power subgroup has index `p` in a nontrivial finite cyclic
`p`-group. -/
theorem index_iteratedPowerSubgroup_one_of_isCyclic_isPGroup
    {H : Type*} [Group H] [Finite H] [IsCyclic H]
    (hH : IsPGroup p H) (hne : Nat.card H ≠ 1) :
    (iteratedPowerSubgroup p 1 H).index = p := by
  letI : IsMulCommutative H := IsCyclic.isMulCommutative
  rw [iteratedPowerSubgroup_one_eq_powMonoidHom_range,
    IsCyclic.index_powMonoidHom_range, Nat.gcd_eq_right]
  exact hH.card_eq_or_dvd.resolve_left hne

/-- Let `A` be a nontrivial cyclic normal subgroup of a finite `p`-group.
Modulo the first power subgroup of `A`, its image has order `p` and hence is
central.  Thus the commutator of a generator of `A` with any ambient element
belongs to that power subgroup. -/
theorem commutatorElement_generator_mem_map_iteratedPowerSubgroup
    (hG : IsPGroup p G) (A : Subgroup G) [A.Normal] [IsCyclic A]
    (hne : Nat.card A ≠ 1) (a : A) (b : G) :
    ⁅(a : G), b⁆ ∈
      (iteratedPowerSubgroup p 1 A).map A.subtype := by
  classical
  let P0 : Subgroup A := iteratedPowerSubgroup p 1 A
  let P : Subgroup G := P0.map A.subtype
  have hPnormal : P.Normal := by
    dsimp [P, P0]
    infer_instance
  letI : P.Normal := hPnormal
  let q : G →* G ⧸ P := QuotientGroup.mk' P
  let Abar : Subgroup (G ⧸ P) := A.map q
  have hAbarNormal : Abar.Normal := by
    dsimp [Abar]
    exact Subgroup.Normal.map (show A.Normal from inferInstance) q
      (QuotientGroup.mk'_surjective P)
  letI : Abar.Normal := hAbarNormal
  let f : A →* G ⧸ P := q.comp A.subtype
  have hfRange : f.range = Abar := by
    dsimp [f, Abar]
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  have hP0map : P0.map A.subtype = P := rfl
  have hP0leA : P ≤ A := by
    dsimp [P]
    exact Subgroup.map_subtype_le P0
  have hfKer : f.ker = P0 := by
    ext x
    change ((x : G) : G ⧸ P) = 1 ↔ x ∈ P0
    rw [QuotientGroup.eq_one_iff]
    constructor
    · rintro ⟨y, hy, hyx⟩
      have hyx' : y = x := A.subtype_injective hyx
      simpa [hyx'] using hy
    · intro hx
      exact ⟨x, hx, rfl⟩
  have hAbarCard : Nat.card Abar = p := by
    calc
      Nat.card Abar = Nat.card f.range := by rw [hfRange]
      _ = f.ker.index := (Subgroup.index_ker f).symm
      _ = P0.index := by rw [hfKer]
      _ = p := index_iteratedPowerSubgroup_one_of_isCyclic_isPGroup
        (hG.to_subgroup A) hne
  have hQuotP : IsPGroup p (G ⧸ P) := hG.to_quotient P
  have hAbarCenter : Abar ≤ Subgroup.center (G ⧸ P) :=
    normal_le_center_of_card_eq_prime Fact.out hQuotP Abar hAbarCard
  have hqa : q (a : G) ∈ Abar := by
    exact ⟨a, a.property, rfl⟩
  have hcommOne : ⁅q (a : G), q b⁆ = 1 :=
    commutatorElement_eq_one_iff_commute.mpr
      (Subgroup.mem_center_iff.mp (hAbarCenter hqa) (q b)).symm
  have hker : ⁅(a : G), b⁆ ∈ q.ker := by
    rw [MonoidHom.mem_ker, map_commutatorElement]
    exact hcommOne
  have hqKer : q.ker = P := by
    dsimp [q]
    exact QuotientGroup.ker_mk' P
  rw [hqKer] at hker
  exact hker

end Submission.OddOrder.MathlibSupport
