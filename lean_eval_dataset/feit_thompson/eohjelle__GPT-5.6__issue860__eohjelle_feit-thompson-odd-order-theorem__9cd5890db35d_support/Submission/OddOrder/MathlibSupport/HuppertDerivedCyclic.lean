import Submission.OddOrder.MathlibSupport.HuppertCyclicFactor
import Submission.OddOrder.MathlibSupport.HuppertGenerators

/-!
The two-generator commutator calculation in the hard branch of Huppert's
metacyclicity induction.
-/

namespace Submission.OddOrder.MathlibSupport

open scoped commutatorElement IsMulCommutative

universe u

variable {G : Type u} [Group G] [Finite G]
variable {p : ℕ} [Fact p.Prime]

/- A central extension of a cyclic group is commutative. -/
omit [Finite G] in
theorem subgroup_isMulCommutative_of_central_cyclic_quotient
    (T X : Subgroup G) [T.Normal] [X.Normal]
    (_hTX : T ≤ X) (hTcenter : T ≤ Subgroup.center G)
    [IsCyclic (X ⧸ T.subgroupOf X)] :
    IsMulCommutative X := by
  let TX : Subgroup X := T.subgroupOf X
  letI : TX.Normal := by
    dsimp [TX]
    infer_instance
  let q : X →* X ⧸ TX := QuotientGroup.mk' TX
  have hkerCenter : q.ker ≤ Subgroup.center X := by
    rw [show q.ker = TX by
      dsimp [q]
      exact QuotientGroup.ker_mk' TX]
    intro t ht
    rw [Subgroup.mem_center_iff]
    intro x
    apply Subtype.ext
    exact Subgroup.mem_center_iff.mp (hTcenter ht) x
  exact MonoidHom.isMulCommutative_of_isCyclic_of_ker_le_center q hkerCenter

/-- In the hard branch of Huppert's central-extension argument, the derived
subgroup is generated by the commutator of the two lifted cyclic generators.

The hypotheses say that `T` is central, `X / T` and `G / X` are cyclic, and
the derived subgroup has exponent dividing `p`. -/
theorem commutator_eq_zpowers_of_huppert_cyclic_tower
    (hG : IsPGroup p G)
    (T X : Subgroup G) [T.Normal] [X.Normal]
    (hTX : T ≤ X) (hTcenter : T ≤ Subgroup.center G)
    [IsCyclic (X ⧸ T.subgroupOf X)] [IsCyclic (G ⧸ X)]
    (hnoncommutative : ¬ IsMulCommutative G)
    (hDerivedPow : ∀ d : G, d ∈ _root_.commutator G → d ^ p = 1) :
    ∃ x y : G,
      _root_.commutator G = Subgroup.zpowers ⁅x, y⁆ ∧
      ⁅x, y⁆ ∈ Subgroup.center G := by
  classical
  obtain ⟨x, y, hxX, hgenX, hgenG⟩ :=
    exists_two_generators_of_cyclic_tower T X hTX
  have hXcomm : IsMulCommutative X :=
    subgroup_isMulCommutative_of_central_cyclic_quotient
      T X hTX hTcenter
  letI : IsMulCommutative X := hXcomm
  have hDerivedX : _root_.commutator G ≤ X :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mp
      IsCyclic.isMulCommutative
  let r : G := ⁅x, y⁆
  have hrDerived : r ∈ _root_.commutator G := by
    dsimp [r]
    exact Subgroup.commutator_mem_commutator trivial trivial
  have hrX : r ∈ X := hDerivedX hrDerived

  let qT : G →* G ⧸ T := QuotientGroup.mk' T
  let Xbar : Subgroup (G ⧸ T) := X.map qT
  have hXbarNormal : Xbar.Normal := by
    dsimp [Xbar]
    exact Subgroup.Normal.map (show X.Normal from inferInstance) qT
      (QuotientGroup.mk'_surjective T)
  letI : Xbar.Normal := hXbarNormal
  have hgenXbarAmbient : Subgroup.zpowers (qT x) = Xbar := by
    have hmap := congrArg (Subgroup.map qT) hgenX
    have hqT : T.map qT = ⊥ := by
      apply le_antisymm
      · rintro _ ⟨t, ht, rfl⟩
        exact Subgroup.mem_bot.mpr ((QuotientGroup.eq_one_iff t).mpr ht)
      · exact bot_le
    simpa [Subgroup.map_sup, MonoidHom.map_zpowers, hqT] using hmap
  have hXbarCyclic : IsCyclic Xbar := by
    apply isCyclic_iff_exists_zpowers_eq_top.mpr
    let a : Xbar := ⟨qT x, by exact ⟨x, hxX, rfl⟩⟩
    refine ⟨a, ?_⟩
    apply Subgroup.map_injective Xbar.subtype_injective
    rw [MonoidHom.map_zpowers, ← MonoidHom.range_eq_map,
      Xbar.range_subtype]
    change Subgroup.zpowers (qT x) = Xbar
    exact hgenXbarAmbient
  letI : IsCyclic Xbar := hXbarCyclic
  have hXbarNeBot : Xbar ≠ ⊥ := by
    intro hbot
    have hmapY : (Subgroup.zpowers y).map qT = ⊤ := by
      have hmap := congrArg (Subgroup.map qT) hgenG
      rw [Subgroup.map_sup, MonoidHom.map_zpowers,
        Subgroup.map_top_of_surjective qT
          (QuotientGroup.mk'_surjective T), show X.map qT = ⊥ by
            exact hbot, sup_bot_eq] at hmap
      simpa [MonoidHom.map_zpowers] using hmap
    have hQTcyclic : IsCyclic (G ⧸ T) :=
      isCyclic_iff_exists_zpowers_eq_top.mpr ⟨qT y, by
        simpa [MonoidHom.map_zpowers] using hmapY⟩
    letI : IsCyclic (G ⧸ T) := hQTcyclic
    apply hnoncommutative
    apply MonoidHom.isMulCommutative_of_isCyclic_of_ker_le_center qT
    rw [show qT.ker = T by
      dsimp [qT]
      exact QuotientGroup.ker_mk' T]
    exact hTcenter
  have hXbarCardNeOne : Nat.card Xbar ≠ 1 := by
    intro hcard
    apply hXbarNeBot
    apply not_ne_iff.mp
    intro hne
    exact (Xbar.one_lt_card_iff_ne_bot.mpr hne).ne' hcard
  let a : Xbar := ⟨qT x, by exact ⟨x, hxX, rfl⟩⟩
  have hgenA : Subgroup.zpowers a = ⊤ := by
    apply Subgroup.map_injective Xbar.subtype_injective
    rw [MonoidHom.map_zpowers, ← MonoidHom.range_eq_map,
      Xbar.range_subtype]
    change Subgroup.zpowers (qT x) = Xbar
    exact hgenXbarAmbient
  have hcommPower :=
    commutatorElement_generator_mem_map_iteratedPowerSubgroup
      (hG.to_quotient T) Xbar hXbarCardNeOne a (qT y)
  have hcommPower' : qT r ∈
      (iteratedPowerSubgroup p 1 Xbar).map Xbar.subtype := by
    simpa [r, a, map_commutatorElement] using hcommPower
  rw [iteratedPowerSubgroup_one_eq_powMonoidHom_range] at hcommPower'
  obtain ⟨z, ⟨w, hw⟩, hzr⟩ := hcommPower'
  have hwZ : w ∈ Subgroup.zpowers a := by rw [hgenA]; trivial
  have hwPowers : w ∈ Submonoid.powers a :=
    (mem_powers_iff_mem_zpowers).2 hwZ
  obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff w a).mp hwPowers
  have hnval : (a : G ⧸ T) ^ n = (w : G ⧸ T) :=
    congrArg Subtype.val hn
  have hwval : (w : G ⧸ T) ^ p = (z : G ⧸ T) :=
    congrArg Subtype.val hw
  have hqRelation : qT r = qT (x ^ (p * n)) := by
    rw [map_pow]
    change qT r = (a : G ⧸ T) ^ (p * n)
    rw [mul_comm p n, pow_mul, hnval, hwval]
    exact hzr.symm
  let t : G := r * (x ^ (p * n))⁻¹
  have htT : t ∈ T := by
    apply (QuotientGroup.eq_one_iff t).mp
    change qT t = 1
    dsimp [t]
    rw [map_mul, map_inv, hqRelation, mul_inv_cancel]
  have hdecomp : r = t * x ^ (p * n) := by
    dsimp [t]
    group
  have hxr : Commute x r := by
    let xX : X := ⟨x, hxX⟩
    let rX : X := ⟨r, hrX⟩
    exact (congrArg Subtype.val (mul_comm xX rX))
  have htr : Commute t r :=
    (Subgroup.mem_center_iff.mp (hTcenter htT) r).symm
  have htx : Commute t x :=
    (Subgroup.mem_center_iff.mp (hTcenter htT) x).symm
  have hrPow : r ^ p = 1 := hDerivedPow r hrDerived
  have hyx : y * x * y⁻¹ = r⁻¹ * x := by
    dsimp [r]
    simp only [commutatorElement_def]
    group
  have hyr : y * r * y⁻¹ = r := by
    calc
      y * r * y⁻¹ = y * (t * x ^ (p * n)) * y⁻¹ := by rw [hdecomp]
      _ = (y * t * y⁻¹) * (y * x ^ (p * n) * y⁻¹) := by group
      _ = t * (y * x * y⁻¹) ^ (p * n) := by
        rw [Subgroup.mem_center_iff.mp (hTcenter htT) y]
        simp
      _ = t * (r⁻¹ * x) ^ (p * n) := by rw [hyx]
      _ = t * ((r⁻¹) ^ (p * n) * x ^ (p * n)) := by
        rw [(hxr.symm.inv_left).mul_pow]
      _ = t * x ^ (p * n) := by
        rw [pow_mul, inv_pow, hrPow, inv_one, one_pow, one_mul]
      _ = r := hdecomp.symm
  have hyrComm : Commute y r := by
    rw [Commute]
    calc
      y * r = (y * r * y⁻¹) * y := by group
      _ = r * y := by rw [hyr]
  have hrCenter : r ∈ Subgroup.center G := by
    rw [Subgroup.mem_center_iff]
    intro g
    let C : Subgroup G := Subgroup.centralizer ({r} : Set G)
    have hXC : X ≤ C := by
      intro z hz
      rw [Subgroup.mem_centralizer_iff]
      intro s hs
      simp only [Set.mem_singleton_iff] at hs
      subst s
      let zX : X := ⟨z, hz⟩
      let rX : X := ⟨r, hrX⟩
      exact (congrArg Subtype.val (mul_comm zX rX)).symm
    have hyC : y ∈ C := by
      rw [Subgroup.mem_centralizer_iff]
      intro s hs
      simp only [Set.mem_singleton_iff] at hs
      subst s
      exact hyrComm.eq.symm
    have htopC : (⊤ : Subgroup G) ≤ C := by
      rw [← hgenG]
      exact sup_le (Subgroup.zpowers_le.mpr hyC) hXC
    have hgC : g ∈ C := htopC trivial
    have hrg : r * g = g * r := by
      exact Subgroup.mem_centralizer_iff.mp hgC r (by simp)
    exact hrg.symm

  let R : Subgroup G := Subgroup.zpowers r
  have hRcenter : R ≤ Subgroup.center G :=
    Subgroup.zpowers_le.mpr hrCenter
  have hRnormal : R.Normal := by
    exact ⟨fun z hz g ↦ by
      have hgz : g * z = z * g :=
        Subgroup.mem_center_iff.mp (hRcenter hz) g
      simpa [hgz] using hz⟩
  letI : R.Normal := hRnormal
  have hRX : R ≤ X := Subgroup.zpowers_le.mpr hrX
  let qR : G →* G ⧸ R := QuotientGroup.mk' R
  let XR : Subgroup (G ⧸ R) := X.map qR
  have hqRr : qR r = 1 := (QuotientGroup.eq_one_iff r).mpr
    (Subgroup.mem_zpowers r)
  have hqxCenter : qR x ∈ Subgroup.center (G ⧸ R) := by
    rw [Subgroup.mem_center_iff]
    intro z
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective R z
    let C : Subgroup G := (Subgroup.centralizer ({qR x} : Set (G ⧸ R))).comap qR
    have hXC : X ≤ C := by
      intro x' hx'
      change qR x' ∈ Subgroup.centralizer ({qR x} : Set (G ⧸ R))
      rw [Subgroup.mem_centralizer_iff]
      intro s hs
      simp only [Set.mem_singleton_iff] at hs
      subst s
      let xX : X := ⟨x, hxX⟩
      let x'X : X := ⟨x', hx'⟩
      exact congrArg qR (congrArg Subtype.val (mul_comm x'X xX)).symm
    have hyC : y ∈ C := by
      change qR y ∈ Subgroup.centralizer ({qR x} : Set (G ⧸ R))
      rw [Subgroup.mem_centralizer_iff]
      intro s hs
      simp only [Set.mem_singleton_iff] at hs
      subst s
      rw [← commutatorElement_eq_one_iff_mul_comm, ← map_commutatorElement]
      exact hqRr
    have htopC : (⊤ : Subgroup G) ≤ C := by
      rw [← hgenG]
      exact sup_le (Subgroup.zpowers_le.mpr hyC) hXC
    have hgC : g ∈ C := htopC trivial
    have hcomm := Subgroup.mem_centralizer_iff.mp hgC (qR x) (by simp)
    exact hcomm.symm
  have hTRcenter : T.map qR ≤ Subgroup.center (G ⧸ R) := by
    rintro _ ⟨t0, ht0, rfl⟩
    rw [Subgroup.mem_center_iff]
    intro z
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective R z
    exact congrArg qR (Subgroup.mem_center_iff.mp (hTcenter ht0) g)
  have hXRcenter : XR ≤ Subgroup.center (G ⧸ R) := by
    have hmap := congrArg (Subgroup.map qR) hgenX
    have hmapEq : Subgroup.zpowers (qR x) ⊔ T.map qR = XR := by
      simpa [XR, Subgroup.map_sup, MonoidHom.map_zpowers] using hmap
    rw [← hmapEq]
    exact sup_le (Subgroup.zpowers_le.mpr hqxCenter) hTRcenter
  let phi : (G ⧸ R) →* (G ⧸ X) :=
    QuotientGroup.map R X (MonoidHom.id G) hRX
  have hphiKer : phi.ker ≤ XR := by
    intro z hz
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective R z
    have hgX : g ∈ X := by
      apply (QuotientGroup.eq_one_iff g).mp
      exact MonoidHom.mem_ker.mp hz
    exact ⟨g, hgX, rfl⟩
  have hQRcomm : IsMulCommutative (G ⧸ R) :=
    MonoidHom.isMulCommutative_of_isCyclic_of_ker_le_center phi
      (hphiKer.trans hXRcenter)
  have hDerivedR : _root_.commutator G ≤ R :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mp hQRcomm
  have hRDerived : R ≤ _root_.commutator G :=
    Subgroup.zpowers_le.mpr hrDerived
  refine ⟨x, y, le_antisymm hDerivedR hRDerived, hrCenter⟩

end Submission.OddOrder.MathlibSupport
