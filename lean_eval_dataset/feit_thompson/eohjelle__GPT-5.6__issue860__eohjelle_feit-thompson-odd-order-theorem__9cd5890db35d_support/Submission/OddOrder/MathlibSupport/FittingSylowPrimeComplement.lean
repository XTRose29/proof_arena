import Submission.OddOrder.MathlibSupport.Fitting

/-!
# The Fitting subgroup inside a Sylow subgroup and the `p′`-core

The prime-core definition of the finite Fitting subgroup immediately splits
its components relative to a fixed prime: the `p`-core lies in every Sylow
`p`-subgroup, while every other prime core lies in the ambient `p′`-core.
-/

namespace Submission.OddOrder.MathlibSupport

universe u

/-- The finite Fitting subgroup lies in the subgroup generated by a selected
Sylow `p`-subgroup and the ambient `p′`-core.  This does not assert that the
`p′`-core is a Hall subgroup. -/
theorem fittingCore_le_sylow_sup_pPrimeCore
    {G : Type u} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) :
    fittingCore G ≤ (P : Subgroup G) ⊔ pPrimeCore p G := by
  rw [fittingCore]
  apply iSup_le
  intro q
  letI : Fact (q : ℕ).Prime := ⟨q.property⟩
  by_cases hqp : (q : ℕ) = p
  · subst p
    exact (pCore_le_sylow P).trans le_sup_left
  · exact
      (pCore_le_pPrimeCore_of_ne (G := G) (p := p) (q := (q : ℕ))
        (fun hpq ↦ hqp hpq.symm)).trans le_sup_right

end Submission.OddOrder.MathlibSupport
