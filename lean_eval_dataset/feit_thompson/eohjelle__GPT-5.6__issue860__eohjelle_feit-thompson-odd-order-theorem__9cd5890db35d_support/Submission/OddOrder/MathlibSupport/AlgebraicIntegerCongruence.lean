import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-!
# Congruence modulo an algebraic integer

MathComp's `eqAmod` relation says that `x - y` belongs to the principal
ideal generated by `m` in the ring of algebraic integers.  We express that
without choosing a particular integral closure: an integral quotient
`z` witnesses `x - y = m * z`.

The elementary API below mirrors the closure rules used in Peterfalvi 1.10.
-/

namespace Submission.OddOrder.MathlibSupport

noncomputable section

open scoped BigOperators

universe u

variable {K : Type u} [CommRing K]

/-- Congruence modulo `m` with respect to the algebraic integers over `ℤ`.

This is the proposition-valued analogue of MathComp's
`(x == y %[mod m])%A`.  The existential formulation also gives the correct
meaning when `m = 0`: it then reduces to `x = y`. -/
def IsIntegralModEq (m x y : K) : Prop :=
  ∃ z : K, IsIntegral ℤ z ∧ x - y = m * z

namespace IsIntegralModEq

/-- Unfold a congruence into an integral factorization of the difference. -/
theorem iff_exists_integral_factor {m x y : K} :
    IsIntegralModEq m x y ↔
      ∃ z : K, IsIntegral ℤ z ∧ x - y = m * z :=
  Iff.rfl

/-- Every element is congruent to itself. -/
@[refl]
theorem refl (m x : K) : IsIntegralModEq m x x :=
  ⟨0, isIntegral_zero, by simp⟩

/-- Equality implies congruence modulo every modulus. -/
theorem of_eq {m x y : K} (hxy : x = y) : IsIntegralModEq m x y := by
  subst y
  exact refl m x

/-- Congruence is symmetric. -/
@[symm]
theorem symm {m x y : K} (hxy : IsIntegralModEq m x y) :
    IsIntegralModEq m y x := by
  obtain ⟨z, hz, hxy⟩ := hxy
  refine ⟨-z, hz.neg, ?_⟩
  calc
    y - x = -(x - y) := (neg_sub x y).symm
    _ = -(m * z) := congrArg Neg.neg hxy
    _ = m * (-z) := (mul_neg m z).symm

/-- Congruence is transitive. -/
@[trans]
theorem trans {m x y z : K}
    (hxy : IsIntegralModEq m x y) (hyz : IsIntegralModEq m y z) :
    IsIntegralModEq m x z := by
  obtain ⟨a, ha, hxy⟩ := hxy
  obtain ⟨b, hb, hyz⟩ := hyz
  refine ⟨a + b, ha.add hb, ?_⟩
  calc
    x - z = (x - y) + (y - z) := by abel
    _ = m * a + m * b := by rw [hxy, hyz]
    _ = m * (a + b) := (mul_add m a b).symm

/-- Modulo zero, congruence is equality. -/
@[simp]
theorem zero_modulus_iff {x y : K} :
    IsIntegralModEq 0 x y ↔ x = y := by
  constructor
  · rintro ⟨z, _hz, hxy⟩
    apply sub_eq_zero.mp
    simpa only [zero_mul] using hxy
  · exact of_eq

/-- Congruence to zero is an integral factorization by the modulus. -/
@[simp]
theorem zero_right_iff {m x : K} :
    IsIntegralModEq m x 0 ↔
      ∃ z : K, IsIntegral ℤ z ∧ x = m * z := by
  simp only [IsIntegralModEq, sub_zero]

/-- Congruences can be added. -/
theorem add {m x₁ x₂ y₁ y₂ : K}
    (hx : IsIntegralModEq m x₁ x₂)
    (hy : IsIntegralModEq m y₁ y₂) :
    IsIntegralModEq m (x₁ + y₁) (x₂ + y₂) := by
  obtain ⟨a, ha, hx⟩ := hx
  obtain ⟨b, hb, hy⟩ := hy
  refine ⟨a + b, ha.add hb, ?_⟩
  calc
    x₁ + y₁ - (x₂ + y₂) = (x₁ - x₂) + (y₁ - y₂) := by abel
    _ = m * a + m * b := by rw [hx, hy]
    _ = m * (a + b) := (mul_add m a b).symm

/-- A congruence is preserved by negation. -/
theorem neg {m x y : K} (hxy : IsIntegralModEq m x y) :
    IsIntegralModEq m (-x) (-y) := by
  obtain ⟨z, hz, hxy⟩ := hxy
  refine ⟨-z, hz.neg, ?_⟩
  calc
    -x - -y = -(x - y) := by abel
    _ = -(m * z) := congrArg Neg.neg hxy
    _ = m * (-z) := (mul_neg m z).symm

/-- Congruences can be subtracted. -/
theorem sub {m x₁ x₂ y₁ y₂ : K}
    (hx : IsIntegralModEq m x₁ x₂)
    (hy : IsIntegralModEq m y₁ y₂) :
    IsIntegralModEq m (x₁ - y₁) (x₂ - y₂) := by
  simpa only [sub_eq_add_neg] using hx.add hy.neg

/-- Adding the same term on the left preserves congruence. -/
theorem add_left (z : K) {m x y : K} (hxy : IsIntegralModEq m x y) :
    IsIntegralModEq m (z + x) (z + y) :=
  (refl m z).add hxy

/-- Adding the same term on the right preserves congruence. -/
theorem add_right {m x y : K} (hxy : IsIntegralModEq m x y) (z : K) :
    IsIntegralModEq m (x + z) (y + z) :=
  hxy.add (refl m z)

/-- Multiplication on the left by an algebraic integer preserves
congruence. -/
theorem mul_left {m x y z : K} (hxy : IsIntegralModEq m x y)
    (hz : IsIntegral ℤ z) : IsIntegralModEq m (z * x) (z * y) := by
  obtain ⟨a, ha, hxy⟩ := hxy
  refine ⟨z * a, hz.mul ha, ?_⟩
  calc
    z * x - z * y = z * (x - y) := (mul_sub z x y).symm
    _ = z * (m * a) := congrArg (z * ·) hxy
    _ = m * (z * a) := by ac_rfl

/-- Multiplication on the right by an algebraic integer preserves
congruence. -/
theorem mul_right {m x y z : K} (hxy : IsIntegralModEq m x y)
    (hz : IsIntegral ℤ z) : IsIntegralModEq m (x * z) (y * z) := by
  simpa only [mul_comm] using hxy.mul_left hz

/-- Products of congruent terms are congruent when the two cross
multipliers are algebraic integers. -/
theorem mul {m x₁ x₂ y₁ y₂ : K}
    (hx : IsIntegralModEq m x₁ x₂)
    (hy : IsIntegralModEq m y₁ y₂)
    (hx₁ : IsIntegral ℤ x₁) (hy₂ : IsIntegral ℤ y₂) :
    IsIntegralModEq m (x₁ * y₁) (x₂ * y₂) :=
  (hy.mul_left hx₁).trans (hx.mul_right hy₂)

/-- Powers of congruent algebraic integers are congruent. -/
theorem pow {m x y : K} (hxy : IsIntegralModEq m x y)
    (hx : IsIntegral ℤ x) (hy : IsIntegral ℤ y) (n : ℕ) :
    IsIntegralModEq m (x ^ n) (y ^ n) := by
  induction n with
  | zero => simpa only [pow_zero] using refl m 1
  | succ n ih =>
      simpa only [pow_succ] using ih.mul hxy (hx.pow n) hy

/-- Finite sums preserve termwise congruence. -/
theorem sum {ι : Type*} {m : K} {s : Finset ι} {f g : ι → K}
    (h : ∀ i ∈ s, IsIntegralModEq m (f i) (g i)) :
    IsIntegralModEq m (∑ i ∈ s, f i) (∑ i ∈ s, g i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact refl m 0
  | @insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi]
      exact (h i (Finset.mem_insert_self i s)).add
        (ih fun j hj ↦ h j (Finset.mem_insert_of_mem hj))

/-- Finite products preserve termwise congruence between algebraic
integers. -/
theorem prod {ι : Type*} {m : K} {s : Finset ι} {f g : ι → K}
    (hf : ∀ i ∈ s, IsIntegral ℤ (f i))
    (hg : ∀ i ∈ s, IsIntegral ℤ (g i))
    (h : ∀ i ∈ s, IsIntegralModEq m (f i) (g i)) :
    IsIntegralModEq m (∏ i ∈ s, f i) (∏ i ∈ s, g i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact refl m 1
  | @insert i s hi ih =>
      rw [Finset.prod_insert hi, Finset.prod_insert hi]
      exact (h i (Finset.mem_insert_self i s)).mul
        (ih (fun j hj ↦ hf j (Finset.mem_insert_of_mem hj))
          (fun j hj ↦ hg j (Finset.mem_insert_of_mem hj))
          (fun j hj ↦ h j (Finset.mem_insert_of_mem hj)))
        (hf i (Finset.mem_insert_self i s))
        (IsIntegral.prod g
          (fun j hj ↦ hg j (Finset.mem_insert_of_mem hj)))

/-- An integral multiple of the modulus is congruent to zero. -/
theorem modulus_mul (m : K) {z : K} (hz : IsIntegral ℤ z) :
    IsIntegralModEq m (m * z) 0 :=
  ⟨z, hz, by simp⟩

/-- An integral left multiple of the modulus is congruent to zero. -/
theorem mul_modulus (m : K) {z : K} (hz : IsIntegral ℤ z) :
    IsIntegralModEq m (z * m) 0 := by
  simpa only [mul_comm] using modulus_mul m hz

/-- Adding an integral multiple of the modulus does not change a congruence
class. -/
theorem modulus_mul_add (m y : K) {z : K} (hz : IsIntegral ℤ z) :
    IsIntegralModEq m (m * z + y) y := by
  simpa only [zero_add] using (modulus_mul m hz).add_right y

/-- Left-multiple form of `modulus_mul_add`. -/
theorem mul_modulus_add (m y : K) {z : K} (hz : IsIntegral ℤ z) :
    IsIntegralModEq m (z * m + y) y := by
  simpa only [mul_comm] using modulus_mul_add m y hz

end IsIntegralModEq

end

end Submission.OddOrder.MathlibSupport
