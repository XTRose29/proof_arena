import Submission.OddOrder.MathlibSupport.BaerSuzukiMaximalContradiction
import Submission.OddOrder.MathlibSupport.BaerSuzukiNormalCase
import Submission.OddOrder.MathlibSupport.BaerSuzukiSetGlobalNormalizer

/-!
The Baer-Suzuki theorem for finite groups.
-/

namespace Submission.OddOrder.MathlibSupport

universe u

/-- If every subgroup generated by `x` and one of its conjugates is a
p-group, then `x` belongs to the p-core. -/
theorem baer_suzuki {G : Type u} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime] {x : G}
    (hpairs : ConjugatePairsArePGroup p x) : x ∈ pCore p G := by
  let motive : ℕ → Prop := fun n =>
    ∀ {K : Type u} [Group K] [Finite K] {a : K},
      Nat.card K = n → ConjugatePairsArePGroup p a → a ∈ pCore p K
  suffices hmain : motive (Nat.card G) from hmain rfl hpairs
  exact Nat.strong_induction_on (p := motive) (Nat.card G) fun n ih => by
    intro K _ _ a hcard hpairsA
    have hpairsClass : ConjugacyPairsArePGroup p a :=
      conjugacyPairsArePGroup_of_conjugatePairsArePGroup hpairsA
    obtain ⟨P₀, haP₀⟩ :=
      exists_sylow_conjugacyClassGenerated_mem hpairsClass
    let E : Subgroup K := conjugacyClassGenerated a
    let P : Subgroup K := (P₀ : Subgroup E).map E.subtype
    have haP : a ∈ P := by
      exact ⟨⟨a, mem_conjugacyClassGenerated a⟩, haP₀, rfl⟩
    by_cases hclassP : conjugatesOf a ⊆ P
    · exact mem_pCore_of_conjugatesOf_le_sylow P₀ hclassP
    · obtain ⟨D, hD, haD, hDmax⟩ :=
        exists_maximal_isBaerSuzukiSetCandidate
          hpairsClass haP hclassP
      obtain ⟨y₀, hy₀class, hy₀P, hB, hdef⟩ :=
        exists_witness_maximal_isBaerSuzukiSetCandidate hD hDmax
      let B : Subgroup K := Subgroup.closure (Set.insert y₀ D)
      change IsPGroup p B at hB
      change D = ((P : Set K) ∩ (B : Set K)) ∩ conjugatesOf a at hdef
      have hself : D ⊆ Subgroup.normalizer D :=
        baerSuzukiSetCandidate_subset_normalizer hdef
      by_cases hDG : (⊤ : Subgroup K) ≤ Subgroup.normalizer D
      · exact mem_pCore_of_isBaerSuzukiSetCandidate_of_le_normalizer
          hD haD hDG
      · have ih' : ∀ {L : Type u} [Group L] [Finite L] {b : L},
            Nat.card L < Nat.card K → ConjugatePairsArePGroup p b →
              b ∈ pCore p L := by
          intro L _ _ b hL hpairsB
          apply ih (Nat.card L)
          · rw [← hcard]
            exact hL
          · rfl
          · exact hpairsB
        have hpN : IsPGroup p (normalizerConjugacyGenerated a D) :=
          normalizerConjugacyGenerated_isPGroup_of_card_induction
            hpairsClass hDG ih'
        have hy₀B : y₀ ∈ B :=
          Subgroup.subset_closure (Set.mem_insert y₀ D)
        have hDB : D ⊆ B := by
          intro d hd
          exact Subgroup.subset_closure (Set.mem_insert_of_mem y₀ hd)
        have hBE : B ≤ E := by
          rw [Subgroup.closure_le]
          intro z hz
          rcases hz with rfl | hz
          · exact conjugatesOf_subset_conjugacyClassGenerated a hy₀class
          · exact conjugatesOf_subset_conjugacyClassGenerated a (hD.1 hz).2
        obtain ⟨y₁, hy₁class, hy₁N, hy₁P⟩ :=
          exists_conjugate_mem_normalizer_not_sylow
            hy₀class hy₀P hy₀B hDB hB hdef hself
        obtain ⟨y₂, hy₂P, hy₂class, hy₂N, hy₂D⟩ :=
          exists_sylow_conjugate_mem_normalizer_not_candidate
            P₀ hy₀class hy₀P hy₀B hDB hBE hB hD.1 hself
        exact False.elim (false_of_maximal_isBaerSuzukiSetCandidate
          hD.1 hDmax hself hpN hy₁class hy₁N hy₁P
          hy₂P hy₂class hy₂N hy₂D)

end Submission.OddOrder.MathlibSupport
