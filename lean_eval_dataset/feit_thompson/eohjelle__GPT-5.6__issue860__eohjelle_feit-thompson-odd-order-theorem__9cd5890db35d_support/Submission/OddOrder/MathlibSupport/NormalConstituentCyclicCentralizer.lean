import Mathlib.Algebra.Group.Commute.Units
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Submission.OddOrder.MathlibSupport.CyclicQuotientGenerator
import Submission.OddOrder.MathlibSupport.NormalConstituentCorrectedCentralizer
import Submission.OddOrder.MathlibSupport.SubgroupAlgebraCentralizer

/-!
Upgrading a corrected translate from centralizing a normal subgroup to
centralizing an ambient group generated by that subgroup and the translate.
-/

namespace Submission.OddOrder.MathlibSupport

open scoped MonoidAlgebra

universe u v w

variable {k : Type u} {G : Type v} {V : Type w}
variable [Field k] [Group G] [AddCommGroup V] [Module k V]
variable [FiniteDimensional k V]

/-- A corrected translate that centralizes `N` centralizes the whole ambient
representation when its translate generates `G / N`. -/
theorem correctedTranslate_commutes_all_of_zpowers_sup_eq_top
    (rho : Representation k G V) (N : Subgroup G)
    (x : G) (a b : k[N])
    (hba : subgroupAlgebraEnd rho N b *
      subgroupAlgebraEnd rho N a = 1)
    (hN : ∀ y : N, Commute
      (rho x * subgroupAlgebraEnd rho N a) (rho (y : G)))
    (hgen : Subgroup.zpowers x ⊔ N = ⊤) :
    ∀ g : G, Commute
      (rho x * subgroupAlgebraEnd rho N a) (rho g) := by
  let T : Module.End k V := rho x * subgroupAlgebraEnd rho N a
  let A : Module.End k V := subgroupAlgebraEnd rho N a
  let B : Module.End k V := subgroupAlgebraEnd rho N b
  have hab : A * B = 1 := mul_eq_one_symm hba
  have hTB : Commute T B :=
    commute_subgroupAlgebraEnd_of_commute rho N T hN b
  have hTB_eq : T * B = rho x := by
    dsimp [T, A, B]
    calc
      (rho x * subgroupAlgebraEnd rho N a) *
          subgroupAlgebraEnd rho N b =
        rho x * (subgroupAlgebraEnd rho N a *
          subgroupAlgebraEnd rho N b) := mul_assoc _ _ _
      _ = rho x := by rw [hab, mul_one]
  have hTx : Commute T (rho x) := by
    rw [Commute]
    calc
      T * rho x = T * (T * B) := by rw [hTB_eq]
      _ = (T * T) * B := (mul_assoc _ _ _).symm
      _ = T * (T * B) := mul_assoc _ _ _
      _ = T * (B * T) := by rw [hTB.eq]
      _ = (T * B) * T := (mul_assoc _ _ _).symm
      _ = rho x * T := by rw [hTB_eq]
  let C : Subgroup G :=
    { carrier := {g | Commute T (rho g)}
      one_mem' := by simp
      mul_mem' := by
        intro g h hg hh
        change Commute T (rho (g * h))
        rw [rho.map_mul]
        exact hg.mul_right hh
      inv_mem' := by
        intro g hg
        change Commute T (rho g⁻¹)
        exact Commute.units_inv_right
          (u := rho.toHomUnits g) hg }
  have hxC : x ∈ C := hTx
  have hNC : N ≤ C := by
    intro g hg
    change Commute T (rho g)
    simpa [T] using hN ⟨g, hg⟩
  have hCtop : C = ⊤ := by
    apply top_unique
    rw [← hgen]
    exact sup_le (Subgroup.zpowers_le.mpr hxC) hNC
  intro g
  change g ∈ C
  rw [hCtop]
  exact Subgroup.mem_top g

end Submission.OddOrder.MathlibSupport
