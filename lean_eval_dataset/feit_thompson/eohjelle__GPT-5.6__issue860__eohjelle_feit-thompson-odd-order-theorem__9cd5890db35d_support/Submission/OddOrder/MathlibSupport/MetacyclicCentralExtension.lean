import Submission.OddOrder.MathlibSupport.CentralCommutatorPowers
import Submission.OddOrder.MathlibSupport.CyclicQuotientGenerator
import Submission.OddOrder.MathlibSupport.Metacyclic
import Submission.OddOrder.MathlibSupport.SubgroupCardinality

/-!
The easy central-extension branch in Huppert's metacyclicity induction,
isolated here for reuse by the cardinality-induction wrapper.
-/

namespace Submission.OddOrder.MathlibSupport

universe u

variable {G : Type u} [Group G] [Finite G]

/-- Functoriality of the subgroup generated by `p^n`th powers. -/
theorem map_iteratedPowerSubgroup_le
    {H K : Type*} [Group H] [Group K]
    (p n : ℕ) (f : H →* K) :
    (iteratedPowerSubgroup p n H).map f ≤ iteratedPowerSubgroup p n K := by
  rw [iteratedPowerSubgroup, MonoidHom.map_closure]
  apply Subgroup.closure_mono
  rintro _ ⟨x, ⟨y, rfl⟩, rfl⟩
  exact ⟨f y, by simp⟩

/-- Ambient form of monotonicity of power subgroups along subgroup
inclusions. -/
theorem map_iteratedPowerSubgroup_subtype_mono
    (p n : ℕ) {H K : Subgroup G} (hHK : H ≤ K) :
    (iteratedPowerSubgroup p n H).map H.subtype ≤
      (iteratedPowerSubgroup p n K).map K.subtype := by
  rintro _ ⟨x, hx, rfl⟩
  let f : H →* K := Subgroup.inclusion hHK
  refine ⟨f x, ?_, rfl⟩
  exact map_iteratedPowerSubgroup_le p n f ⟨x, hx, rfl⟩

/-- Let `T` be a central subgroup of order `p`.  If `G / T` is cyclic and
`T` lies in the subgroup generated by the `p`th powers of `G`, then `G` is
cyclic.  In `BGsection4.v: p2_Ohm1_metacyclic`, this is the branch where
`Mho^1(G')` is nontrivial after lifting the cyclic normal factor. -/
theorem isCyclic_of_central_prime_quotient_of_le_iteratedPowerSubgroup
    {p : ℕ} (T : Subgroup G) [T.Normal]
    (hTcenter : T ≤ Subgroup.center G) (hTcard : Nat.card T = p)
    [IsCyclic (G ⧸ T)]
    (hTpower : T ≤ iteratedPowerSubgroup p 1 G) :
    IsCyclic G := by
  classical
  obtain ⟨x, hxmod⟩ := exists_generator_mod_normal T
  have hTpow (t : T) : t ^ p = 1 := by
    rw [← hTcard]
    exact pow_card_eq_one'
  have hpow_mem (g : G) : g ^ p ∈ Subgroup.zpowers x := by
    obtain ⟨z, hz⟩ := hxmod g
    let t : T := ⟨g * (x ^ z)⁻¹, hz⟩
    have hdecomp : g = (t : G) * x ^ z := by
      dsimp [t]
      group
    have hcomm : Commute (t : G) (x ^ z) :=
      (Subgroup.mem_center_iff.mp (hTcenter t.property) (x ^ z)).symm
    rw [hdecomp, hcomm.mul_pow]
    have htPow : (t : G) ^ p = 1 :=
      congrArg Subtype.val (hTpow t)
    rw [htPow, one_mul]
    exact (Subgroup.zpowers x).pow_mem
      (Subgroup.mem_zpowers_iff.mpr ⟨z, rfl⟩) p
  have hpower_le : iteratedPowerSubgroup p 1 G ≤ Subgroup.zpowers x := by
    rw [iteratedPowerSubgroup, Subgroup.closure_le]
    rintro y ⟨g, rfl⟩
    simpa using hpow_mem g
  have hTle : T ≤ Subgroup.zpowers x := hTpower.trans hpower_le
  have hgen : Subgroup.zpowers x ⊔ T = ⊤ := by
    apply top_unique
    intro g _
    obtain ⟨z, hz⟩ := hxmod g
    have hmod : g * (x ^ z)⁻¹ ∈ Subgroup.zpowers x ⊔ T :=
      (le_sup_right : T ≤ Subgroup.zpowers x ⊔ T) hz
    have hpow : x ^ z ∈ Subgroup.zpowers x ⊔ T :=
      (le_sup_left : Subgroup.zpowers x ≤ Subgroup.zpowers x ⊔ T)
        (Subgroup.mem_zpowers_iff.mpr ⟨z, rfl⟩)
    simpa [mul_assoc] using (Subgroup.mul_mem _ hmod hpow)
  have hxTop : Subgroup.zpowers x = ⊤ := by
    rw [sup_eq_left.mpr hTle] at hgen
    exact hgen
  exact isCyclic_iff_exists_zpowers_eq_top.mpr ⟨x, hxTop⟩

/-- The nontrivial-power branch of the central-extension step in Huppert's
proof.  If the central kernel is contained in the first power subgroup of
the derived group, the lifted cyclic normal factor is already cyclic. -/
theorem isMetacyclic_of_central_prime_quotient_of_commutator_power
    {p : ℕ} (T : Subgroup G) (hTnormal : T.Normal)
    (hTcenter : T ≤ Subgroup.center G) (hTcard : Nat.card T = p)
    (hmeta : letI : T.Normal := hTnormal; IsMetacyclic (G ⧸ T))
    (hTpower : T ≤
      (iteratedPowerSubgroup p 1 (_root_.commutator G)).map
        (_root_.commutator G).subtype) :
    IsMetacyclic G := by
  classical
  obtain ⟨X, hXnormal, hTX, hInnerCyclic, hOuterCyclic⟩ :=
    exists_normal_over_of_quotient_isMetacyclic G T hTnormal hmeta
  letI : X.Normal := hXnormal
  let TX : Subgroup X := T.subgroupOf X
  have hTXnormal : TX.Normal := by
    dsimp [TX]
    infer_instance
  letI : TX.Normal := hTXnormal
  have hcommX : _root_.commutator G ≤ X := by
    exact Subgroup.Normal.quotient_commutative_iff_commutator_le.mp
      hOuterCyclic.isMulCommutative
  have hpowerMono :
      (iteratedPowerSubgroup p 1 (_root_.commutator G)).map
          (_root_.commutator G).subtype ≤
        (iteratedPowerSubgroup p 1 X).map X.subtype :=
    map_iteratedPowerSubgroup_subtype_mono p 1 hcommX
  have hTXpower : TX ≤ iteratedPowerSubgroup p 1 X := by
    intro t ht
    have htAmbient : (t : G) ∈ T := ht
    obtain ⟨x, hx, hxt⟩ := hpowerMono (hTpower htAmbient)
    have hxt' : x = t := X.subtype_injective hxt
    simpa [hxt'] using hx
  have hTXcenter : TX ≤ Subgroup.center X := by
    intro t ht
    rw [Subgroup.mem_center_iff]
    intro x
    apply Subtype.ext
    exact Subgroup.mem_center_iff.mp (hTcenter ht) x
  have hTXcard : Nat.card TX = p :=
    (natCard_subgroupOf_eq hTX).trans hTcard
  letI : IsCyclic (X ⧸ TX) := hInnerCyclic
  have hXcyclic : IsCyclic X :=
    isCyclic_of_central_prime_quotient_of_le_iteratedPowerSubgroup
      TX hTXcenter hTXcard hTXpower
  exact isMetacyclic_of_normal_cyclic_quotient
    G X hXnormal hXcyclic hOuterCyclic

end Submission.OddOrder.MathlibSupport
