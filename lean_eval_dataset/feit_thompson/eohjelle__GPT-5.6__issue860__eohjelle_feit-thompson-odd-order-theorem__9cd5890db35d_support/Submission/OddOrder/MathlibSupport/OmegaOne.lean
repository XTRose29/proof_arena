import Mathlib.GroupTheory.Exponent

/-!
The first omega subgroup, generated by the elements whose `p`th power is
trivial.
-/

namespace Submission.OddOrder.MathlibSupport

universe u

variable {G : Type u} [Group G]

/-- The first omega subgroup at `p`. For a finite `p`-group this is
MathComp's `'Ohm_1(G)`. -/
def omegaOne (p : ℕ) (G : Type u) [Group G] : Subgroup G :=
  Subgroup.closure {x : G | x ^ p = 1}

theorem mem_omegaOne_of_pow_eq_one (p : ℕ) {x : G} (hx : x ^ p = 1) :
    x ∈ omegaOne p G :=
  Subgroup.subset_closure hx

theorem omegaOne_le (p : ℕ) (H : Subgroup G)
    (hH : ∀ x : G, x ^ p = 1 → x ∈ H) :
    omegaOne p G ≤ H := by
  rw [omegaOne, Subgroup.closure_le]
  exact hH

/-- The subgroup of elements annihilated by `n`, provided those elements
are closed under multiplication. -/
def powOneSubgroup (n : ℕ)
    (hmul : ∀ x y : G, x ^ n = 1 → y ^ n = 1 → (x * y) ^ n = 1) :
    Subgroup G where
  carrier := {x : G | x ^ n = 1}
  one_mem' := one_pow n
  mul_mem' hx hy := hmul _ _ hx hy
  inv_mem' := fun {x} hx => by
    change x⁻¹ ^ n = 1
    rw [inv_pow, hx, inv_one]

@[simp]
theorem mem_powOneSubgroup (n : ℕ)
    (hmul : ∀ x y : G, x ^ n = 1 → y ^ n = 1 → (x * y) ^ n = 1)
    (x : G) :
    x ∈ powOneSubgroup n hmul ↔ x ^ n = 1 := by
  change (x ^ n = 1) ↔ x ^ n = 1
  rfl

theorem omegaOne_pow_eq_one_of_mul_closed (p : ℕ)
    (hmul : ∀ x y : G, x ^ p = 1 → y ^ p = 1 → (x * y) ^ p = 1)
    {x : G} (hx : x ∈ omegaOne p G) :
    x ^ p = 1 := by
  exact (omegaOne_le p (powOneSubgroup p hmul) fun _ hx => by
    change _ ^ p = 1
    exact hx) hx

theorem exponent_omegaOne_dvd (p : ℕ) [Finite (omegaOne p G)]
    (hpow : ∀ x : omegaOne p G, (x : G) ^ p = 1) :
    Monoid.exponent (omegaOne p G) ∣ p := by
  rw [Monoid.exponent_dvd]
  intro x
  rw [orderOf_dvd_iff_pow_eq_one]
  apply Subtype.ext
  exact hpow x

end Submission.OddOrder.MathlibSupport
