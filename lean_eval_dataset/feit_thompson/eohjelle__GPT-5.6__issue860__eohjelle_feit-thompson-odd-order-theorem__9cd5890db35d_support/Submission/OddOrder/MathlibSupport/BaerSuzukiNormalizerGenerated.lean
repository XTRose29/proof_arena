import Submission.OddOrder.MathlibSupport.BaerSuzukiSubgroupPairs
import Submission.OddOrder.MathlibSupport.PCore

/-!
The p-subgroup generated by normalizing conjugates in Baer-Suzuki.
-/

namespace Submission.OddOrder.MathlibSupport

variable {G : Type*} [Group G]

/-- The subgroup generated by conjugates of `x` that normalize the set `D`. -/
def normalizerConjugacyGenerated (x : G) (D : Set G) : Subgroup G :=
  Subgroup.closure (conjugatesOf x ∩ Subgroup.normalizer D)

/-- If every normalizing conjugate belongs to the p-core of the normalizer,
their ambient generated subgroup is a p-group. -/
theorem normalizerConjugacyGenerated_isPGroup_of_mem_pCore
    {p : ℕ} {x : G} {D : Set G}
    (hcore : ∀ (a : G) (_ha : a ∈ conjugatesOf x)
      (haN : a ∈ Subgroup.normalizer D),
      (⟨a, haN⟩ : Subgroup.normalizer D) ∈
        pCore p (Subgroup.normalizer D)) :
    IsPGroup p (normalizerConjugacyGenerated x D) := by
  let N : Subgroup G := Subgroup.normalizer D
  let Q : Subgroup G := (pCore p N).map N.subtype
  have hQp : IsPGroup p Q := pCore_isPGroup.map N.subtype
  apply IsPGroup.to_le hQp
  rw [normalizerConjugacyGenerated, Subgroup.closure_le]
  intro a ha
  exact ⟨⟨a, ha.2⟩, hcore a ha.1 ha.2, rfl⟩

end Submission.OddOrder.MathlibSupport
