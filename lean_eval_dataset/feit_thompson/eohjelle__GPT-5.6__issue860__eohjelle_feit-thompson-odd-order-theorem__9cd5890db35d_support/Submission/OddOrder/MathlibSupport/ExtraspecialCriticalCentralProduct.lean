import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.GroupTheory.FiniteAbelian.Duality
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed
import Submission.OddOrder.MathlibSupport.Centralizer
import Submission.OddOrder.MathlibSupport.ExtraspecialQuotientModule

/-!
The critical-extraspecial central-product theorem.

This is the result called `critical_extraspecial` in MathComp's
`solvable/maximal.v`, and cited as the coverage of Bender--Glauberman,
Lemma 4.15, immediately after `pi_Aut_rank2_pgroup` in `BGsection4.v`.
-/

namespace Submission.OddOrder.MathlibSupport

open scoped commutatorElement IsMulCommutative

universe u

private def centralDeviationHom {P : Type*} [Group P]
    (a : MulAut P)
    (hcentral : ∀ x : P, a x * x⁻¹ ∈ Subgroup.center P) :
    P →* Subgroup.center P where
  toFun x := ⟨a x * x⁻¹, hcentral x⟩
  map_one' := by
    apply Subtype.ext
    simp
  map_mul' x y := by
    apply Subtype.ext
    change a (x * y) * (x * y)⁻¹ =
      (a x * x⁻¹) * (a y * y⁻¹)
    rw [map_mul, mul_inv_rev]
    have hyx := Subgroup.mem_center_iff.mp (hcentral y) (a x)
    have hxy := Subgroup.mem_center_iff.mp (hcentral x) (a y * y⁻¹)
    calc
      a x * a y * (y⁻¹ * x⁻¹) =
          a x * (a y * y⁻¹) * x⁻¹ := by group
      _ = (a y * y⁻¹) * a x * x⁻¹ := by rw [hyx]
      _ = (a y * y⁻¹) * (a x * x⁻¹) := by group
      _ = (a x * x⁻¹) * (a y * y⁻¹) := hxy

private theorem center_le_ker_centralDeviationHom
    {P : Type*} [Group P] (hP : IsSpecial P)
    (a : MulAut P)
    (hcentral : ∀ x : P, a x * x⁻¹ ∈ Subgroup.center P) :
    Subgroup.center P ≤ (centralDeviationHom a hcentral).ker := by
  calc
    Subgroup.center P = _root_.commutator P :=
      hP.commutator_eq_center.symm
    _ ≤ (centralDeviationHom a hcentral).ker :=
      Abelianization.commutator_subset_ker
        (centralDeviationHom a hcentral)

private def centralDeviationQuotientHom
    {P : Type*} [Group P] (hP : IsSpecial P)
    (a : MulAut P)
    (hcentral : ∀ x : P, a x * x⁻¹ ∈ Subgroup.center P) :
    (P ⧸ Subgroup.center P) →* Subgroup.center P :=
  QuotientGroup.lift (Subgroup.center P) (centralDeviationHom a hcentral)
    (center_le_ker_centralDeviationHom hP a hcentral)

@[simp]
private theorem centralDeviationQuotientHom_mk
    {P : Type*} [Group P] (hP : IsSpecial P)
    (a : MulAut P)
    (hcentral : ∀ x : P, a x * x⁻¹ ∈ Subgroup.center P)
    (x : P) :
    centralDeviationQuotientHom hP a hcentral
        (QuotientGroup.mk' (Subgroup.center P) x) =
      ⟨a x * x⁻¹, hcentral x⟩ :=
  rfl

/-- If an extraspecial subgroup `S` of a finite `p`-group `R` satisfies
`[S, R] ≤ S'`, then `R` is generated by `S` and its centralizer in `R`.

This is MathComp's `critical_extraspecial`, covering
Bender--Glauberman, Lemma 4.15. -/
theorem extraspecial_sup_centralizerWithin_eq
    {G : Type u} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime] {R S : Subgroup G}
    (hR : IsPGroup p R) (hSR : S ≤ R) (hS : IsExtraspecial S)
    (hcomm : ⁅S, R⁆ ≤ (_root_.commutator S).map S.subtype) :
    S ⊔ centralizerWithin R S = R := by
  classical
  have hSp : IsPGroup p S :=
    (hR.to_subgroup (S.subgroupOf R)).of_equiv
      (Subgroup.subgroupOfEquivOfLe hSR)
  have hderivedLeS : (_root_.commutator S).map S.subtype ≤ S :=
    (Subgroup.map_le_range S.subtype (_root_.commutator S)).trans_eq
      S.range_subtype
  have hnorm : R ≤ Subgroup.normalizer (S : Set G) :=
    Subgroup.le_normalizer_iff_commutator_le_left.mpr
      (hcomm.trans hderivedLeS)

  letI : CommGroup (S ⧸ Subgroup.center S) :=
    hS.toIsSpecial.quotientCenterCommGroup
  letI : CommGroup (Subgroup.center S) := centerCommGroup
  letI : Fact (Nat.card (Subgroup.center S)).Prime := ⟨by
    rw [hS.center_card_eq hSp]
    exact Fact.out⟩
  letI : Nontrivial (Subgroup.center S) :=
    Finite.one_lt_card_iff_nontrivial.mp
      (Fact.out : (Nat.card (Subgroup.center S)).Prime).one_lt

  obtain ⟨z, hz⟩ := exists_ne (1 : Subgroup.center S)
  obtain ⟨chi, hchi⟩ :=
    CommGroup.exists_apply_ne_one_of_hasEnoughRootsOfUnity
      (Subgroup.center S) ℂ hz
  have hchiNe : chi ≠ 1 := by
    intro h
    apply hchi
    rw [h]
    rfl
  have hchiInj : Function.Injective chi := by
    rw [← chi.ker_eq_bot_iff]
    exact chi.ker.eq_bot_or_eq_top_of_prime_card.resolve_right fun htop ↦
      hchiNe (chi.ker_eq_top_iff.mp htop)
  let post : ((S ⧸ Subgroup.center S) →* Subgroup.center S) →
      ((S ⧸ Subgroup.center S) →* ℂˣ) := fun f ↦ chi.comp f
  have hpostInj : Function.Injective post := by
    intro f g hfg
    apply MonoidHom.ext
    intro x
    apply hchiInj
    exact DFunLike.congr_fun hfg x
  letI : Finite
      ((S ⧸ Subgroup.center S) →* Subgroup.center S) :=
    Finite.of_injective
      (fun f : (S ⧸ Subgroup.center S) →* Subgroup.center S ↦
        (f : (S ⧸ Subgroup.center S) → Subgroup.center S))
      DFunLike.coe_injective
  have hdualCard :
      Nat.card ((S ⧸ Subgroup.center S) →* ℂˣ) =
        Nat.card (S ⧸ Subgroup.center S) :=
    CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity
      (S ⧸ Subgroup.center S) ℂ
  have hhomLe :
      Nat.card ((S ⧸ Subgroup.center S) →* Subgroup.center S) ≤
        Nat.card (S ⧸ Subgroup.center S) := by
    rw [← hdualCard]
    exact Nat.card_le_card_of_injective post hpostInj
  have hpairSurjective : Function.Surjective
      hS.toIsSpecial.quotientCommutatorPairing :=
    (hS.toIsSpecial.quotientCommutatorPairing_injective
      |>.bijective_of_nat_card_le hhomLe).surjective

  apply le_antisymm
  · exact sup_le hSR (centralizerWithin_le_left R S)
  · intro r hrR
    let rn : Subgroup.normalizer (S : Set G) := ⟨r, hnorm hrR⟩
    let a : MulAut S := S.normalizerMonoidHom rn
    have hcentral (s : S) : a s * s⁻¹ ∈ Subgroup.center S := by
      have hrs : ⁅(r : G), (s : G)⁆ ∈ ⁅R, S⁆ :=
        Subgroup.commutator_mem_commutator hrR s.property
      have hrs' : ⁅(r : G), (s : G)⁆ ∈ ⁅S, R⁆ := by
        rw [Subgroup.commutator_comm S R]
        exact hrs
      have hambient : ((a s * s⁻¹ : S) : G) ∈
          (_root_.commutator S).map S.subtype := by
        simpa [a, rn, Subgroup.normalizerMonoidHom, HSMul.hSMul,
          commutatorElement_def, mul_assoc] using hcomm hrs'
      have hderived : a s * s⁻¹ ∈ _root_.commutator S := by
        have hpreimage : a s * s⁻¹ ∈
            ((_root_.commutator S).map S.subtype).comap S.subtype :=
          hambient
        simpa only [Subgroup.comap_map_eq_self_of_injective
          S.subtype_injective] using hpreimage
      rw [← hS.toIsSpecial.commutator_eq_center]
      exact hderived

    let d := centralDeviationQuotientHom
      hS.toIsSpecial a hcentral
    obtain ⟨q, hq⟩ := hpairSurjective d
    obtain ⟨t, ht⟩ :=
      QuotientGroup.mk'_surjective (Subgroup.center S) q
    have ha (s : S) : a s = t * s * t⁻¹ := by
      have heval := DFunLike.congr_fun hq
        (QuotientGroup.mk' (Subgroup.center S) s)
      rw [← ht] at heval
      have hdev : hS.toIsSpecial.commutatorPairing t s =
          ⟨a s * s⁻¹, hcentral s⟩ := by
        change hS.toIsSpecial.commutatorPairing t s =
          ⟨a s * s⁻¹, hcentral s⟩ at heval
        exact heval
      have hdev' := congrArg Subtype.val hdev
      change ⁅t, s⁆ = a s * s⁻¹ at hdev'
      calc
        a s = (a s * s⁻¹) * s := by group
        _ = ⁅t, s⁆ * s := by rw [← hdev']
        _ = t * s * t⁻¹ := by simp [commutatorElement_def, mul_assoc]

    let c : G := (t : G)⁻¹ * r
    have hcR : c ∈ R :=
      R.mul_mem (R.inv_mem (hSR t.property)) hrR
    have hc : c ∈ centralizerWithin R S := by
      refine ⟨hcR, ?_⟩
      intro s hsS
      let sS : S := ⟨s, hsS⟩
      have ha' := congrArg Subtype.val (ha sS)
      have hconj : r * s * r⁻¹ = (t : G) * s * (t : G)⁻¹ := by
        simpa [a, rn, sS, Subgroup.normalizerMonoidHom,
          HSMul.hSMul, mul_assoc] using ha'
      calc
        s * c = (t : G)⁻¹ * ((t : G) * s * (t : G)⁻¹) * r := by
          simp [c, mul_assoc]
        _ = (t : G)⁻¹ * (r * s * r⁻¹) * r := by rw [hconj]
        _ = c * s := by simp [c, mul_assoc]
    have htSup : (t : G) ∈ S ⊔ centralizerWithin R S :=
      (show S ≤ S ⊔ centralizerWithin R S from le_sup_left) t.property
    have hcSup : c ∈ S ⊔ centralizerWithin R S :=
      (show centralizerWithin R S ≤ S ⊔ centralizerWithin R S from
        le_sup_right) hc
    have hdecomp : r = (t : G) * c := by simp [c]
    rw [hdecomp]
    exact (S ⊔ centralizerWithin R S).mul_mem htSup hcSup

end Submission.OddOrder.MathlibSupport
