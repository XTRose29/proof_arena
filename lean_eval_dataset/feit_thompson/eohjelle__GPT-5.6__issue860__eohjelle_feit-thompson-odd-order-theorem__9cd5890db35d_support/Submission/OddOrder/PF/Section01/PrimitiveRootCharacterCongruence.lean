import Mathlib.Algebra.DirectSum.LinearMap
import Mathlib.Algebra.Ring.GeomSum
import Submission.OddOrder.MathlibSupport.AlgebraicIntegerCongruence
import Submission.OddOrder.MathlibSupport.CharacterValueCyclotomic

/-!
# Peterfalvi 1.10(a): character congruence at a primitive root

If `x` has order `p` and commutes with `y`, every virtual-character value at
`x * y` is congruent to its value at `y` modulo `1 - eps`, where `eps` is a
primitive `p`-th root of unity.

The source restricts to the abelian subgroup generated by `x` and `y` and
expands into its linear irreducible characters.  Here the same decomposition
is expressed directly as the primitive-root eigenspace decomposition of the
operator representing `x`; commutation makes every summand invariant under
the operator representing `y`.
-/

namespace Submission.OddOrder.PF

noncomputable section

open Module
open scoped BigOperators

universe u v w

private theorem trace_isIntegral_of_pow_eq_one
    {K : Type u} {V : Type v}
    [Field K] [IsAlgClosed K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (f : Module.End K V) (n : ℕ) (hn : 0 < n)
    (hpow : f ^ n = 1) :
    IsIntegral ℤ (LinearMap.trace K V f) := by
  rw [Module.End.trace_eq_sum_roots_charpoly_of_splits
    (IsAlgClosed.splits f.charpoly)]
  apply IsIntegral.multiset_sum
  intro mu hmu
  have hroot : f.charpoly.IsRoot mu :=
    (Polynomial.mem_roots
      (Polynomial.Monic.ne_zero (LinearMap.charpoly_monic f))).mp hmu
  have heigen : f.HasEigenvalue mu :=
    (Module.End.hasEigenvalue_iff_isRoot_charpoly f mu).mpr hroot
  obtain ⟨z, hz⟩ := heigen.exists_hasEigenvector
  have hpowScalar : mu ^ n = 1 := by
    have hzpow := hz.pow_apply n
    rw [hpow] at hzpow
    apply smul_left_injective K hz.2
    simpa using hzpow.symm
  exact IsIntegral.of_pow hn (hpowScalar ▸ isIntegral_one)

private theorem primitiveRoot_pow_modEq_one
    {K : Type u} [Field K]
    {p : ℕ} [NeZero p] {eps : K}
    (pr_eps : IsPrimitiveRoot eps p) (n : ℕ) :
    _root_.Submission.OddOrder.MathlibSupport.IsIntegralModEq
      (1 - eps) (eps ^ n) 1 := by
  let S : K := ∑ i ∈ Finset.range n, eps ^ i
  have heps : IsIntegral ℤ eps :=
    IsIntegral.of_pow (NeZero.pos p)
      (pr_eps.pow_eq_one ▸ isIntegral_one)
  have hS : IsIntegral ℤ S := by
    dsimp only [S]
    exact IsIntegral.sum (fun i ↦ eps ^ i)
      (fun i _ ↦ heps.pow i)
  refine ⟨-S, hS.neg, ?_⟩
  calc
    eps ^ n - 1 = -(1 - eps ^ n) := by ring
    _ = -(S * (1 - eps)) :=
      congrArg Neg.neg (geom_sum_mul_neg eps n).symm
    _ = (1 - eps) * (-S) := by ring

private theorem representation_character_mul_mod_primitiveRoot
    {K : Type u} {G : Type v} {V : Type w}
    [Field K] [IsAlgClosed K]
    [Group G] [Fintype G]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {p : ℕ} [NeZero p] {eps : K}
    (pr_eps : IsPrimitiveRoot eps p)
    (rho : Representation K G V) (x y : G)
    (hx : orderOf x = p) (hxy : Commute x y) :
    _root_.Submission.OddOrder.MathlibSupport.IsIntegralModEq
      (1 - eps) (rho.character (x * y)) (rho.character y) := by
  let epsUnit : Kˣ := Units.mk0 eps (pr_eps.ne_zero (NeZero.ne p))
  have pr_epsUnit : IsPrimitiveRoot epsUnit p := by
    apply IsPrimitiveRoot.coe_units_iff.mp
    simpa only [epsUnit, Units.val_mk0] using pr_eps
  let f : Module.End K V := rho x
  let g : Module.End K V := rho y
  have hxp : x ^ p = 1 := by
    simpa only [hx] using pow_orderOf_eq_one x
  have hpowf : f ^ p = 1 := by
    dsimp only [f]
    rw [← map_pow, hxp, map_one]
  let U : ZMod p → Submodule K V := fun i =>
    Module.End.eigenspace f
      (_root_.Submission.OddOrder.MathlibSupport.primitiveRootUnitWeight
        pr_epsUnit i : K)
  have hspan : ⨆ i, U i = ⊤ :=
    _root_.Submission.OddOrder.MathlibSupport.iSup_primitiveRootUnitWeight_eigenspace_eq_top
      pr_epsUnit f hpowf
  have hindependent : iSupIndep U := by
    change iSupIndep
      (Module.End.eigenspace f ∘
        fun i : ZMod p =>
          (_root_.Submission.OddOrder.MathlibSupport.primitiveRootUnitWeight
            pr_epsUnit i : K))
    exact (Module.End.eigenspaces_iSupIndep f).comp
      (Units.val_injective.comp
        (_root_.Submission.OddOrder.MathlibSupport.primitiveRootUnitWeight_injective
          pr_epsUnit))
  let hinternal : DirectSum.IsInternal U :=
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
      hindependent hspan
  have hcomm : Commute f g := by
    rw [commute_iff_eq]
    dsimp only [f, g]
    rw [← map_mul, ← map_mul, hxy.eq]
  have hgMaps (i : ZMod p) : Set.MapsTo g (U i) (U i) := by
    intro z hz
    apply Module.End.mem_eigenspace_iff.mpr
    have hzEigen := Module.End.mem_eigenspace_iff.mp hz
    calc
      f (g z) = g (f z) := by
        have hzComm := LinearMap.congr_fun hcomm.eq z
        simpa only [Module.End.mul_apply] using hzComm
      _ = g
          ((_root_.Submission.OddOrder.MathlibSupport.primitiveRootUnitWeight
            pr_epsUnit i : K) • z) := by rw [hzEigen]
      _ = (_root_.Submission.OddOrder.MathlibSupport.primitiveRootUnitWeight
            pr_epsUnit i : K) • g z := LinearMap.map_smul g _ _
  have hfgApply (i : ZMod p) (z : U i) :
      (f * g) (z : V) =
        (_root_.Submission.OddOrder.MathlibSupport.primitiveRootUnitWeight
          pr_epsUnit i : K) • g z := by
    rw [Module.End.mul_apply]
    exact Module.End.mem_eigenspace_iff.mp (hgMaps i z.property)
  have hfgMaps (i : ZMod p) : Set.MapsTo (f * g) (U i) (U i) := by
    intro z hz
    rw [hfgApply i ⟨z, hz⟩]
    exact (U i).smul_mem _ (hgMaps i hz)
  have hrestrict (i : ZMod p) :
      (f * g).restrict (hfgMaps i) =
        (_root_.Submission.OddOrder.MathlibSupport.primitiveRootUnitWeight
          pr_epsUnit i : K) • g.restrict (hgMaps i) := by
    ext z
    exact hfgApply i z
  have hgpow : g ^ Fintype.card G = 1 := by
    dsimp only [g]
    rw [← map_pow, pow_card_eq_one, map_one]
  have hgRestrictPow (i : ZMod p) :
      (g.restrict (hgMaps i)) ^ Fintype.card G = 1 := by
    rw [Module.End.pow_restrict]
    ext z
    change (g ^ Fintype.card G) (z : V) = z
    rw [hgpow]
    rfl
  have htraceIntegral (i : ZMod p) :
      IsIntegral ℤ
        (LinearMap.trace K (U i) (g.restrict (hgMaps i))) :=
    trace_isIntegral_of_pow_eq_one
      (g.restrict (hgMaps i)) (Fintype.card G) Fintype.card_pos
      (hgRestrictPow i)
  have hweight (i : ZMod p) :
      (_root_.Submission.OddOrder.MathlibSupport.primitiveRootUnitWeight
        pr_epsUnit i : K) = eps ^ i.val := by
    conv_lhs =>
      rw [← ZMod.natCast_zmod_val i,
        _root_.Submission.OddOrder.MathlibSupport.primitiveRootUnitWeight_natCast]
    rfl
  have htraceG :=
    LinearMap.trace_eq_sum_trace_restrict hinternal hgMaps
  have htraceFG :=
    LinearMap.trace_eq_sum_trace_restrict hinternal hfgMaps
  change
    _root_.Submission.OddOrder.MathlibSupport.IsIntegralModEq
      (1 - eps) (LinearMap.trace K V (rho (x * y)))
        (LinearMap.trace K V g)
  rw [map_mul, show rho x = f by rfl, show rho y = g by rfl,
    htraceFG, htraceG]
  apply _root_.Submission.OddOrder.MathlibSupport.IsIntegralModEq.sum
  intro i _
  have hroot := primitiveRoot_pow_modEq_one pr_eps i.val
  have hmod := hroot.mul_right (htraceIntegral i)
  rw [hrestrict i, map_smul, hweight]
  simpa only [smul_eq_mul, one_mul] using hmod

/-- Peterfalvi 1.10(a) over an algebraically closed field of characteristic zero. -/
theorem vchar_ker_mod_prim_of_isAlgClosed
    {K : Type u} [Field K] [IsAlgClosed K] [CharZero K]
    {G : Type v} [Group G] [Fintype G]
    {p : ℕ} {eps : K} (pr_eps : IsPrimitiveRoot eps p)
    (chi : VirtualCharacter G K) (x y : G)
    (hx : orderOf x = p) (hxy : Commute x y) :
    _root_.Submission.OddOrder.MathlibSupport.IsIntegralModEq
      (1 - eps)
      (VirtualCharacter.realize chi (x * y))
      (VirtualCharacter.realize chi y) := by
  have hp : 0 < p := by
    rw [← hx]
    exact orderOf_pos x
  letI : NeZero p := ⟨hp.ne'⟩
  have hirr (psi : IrreducibleCharacter G K) :
      _root_.Submission.OddOrder.MathlibSupport.IsIntegralModEq
        (1 - eps) (psi (x * y)) (psi y) := by
    rw [← psi.representation_character, ← psi.representation_character]
    exact representation_character_mul_mod_primitiveRoot
      pr_eps psi.representation.ρ x y hx hxy
  induction chi using Finsupp.induction with
  | zero =>
      simp only [VirtualCharacter.realize_zero, ClassFunction.zero_apply]
      exact
        _root_.Submission.OddOrder.MathlibSupport.IsIntegralModEq.refl
          (1 - eps) 0
  | single_add psi z chi hpsi hz ih =>
      have hsingle := (hirr psi).mul_left (isIntegral_intCast z)
      simpa only [VirtualCharacter.realize_add,
        VirtualCharacter.realize_single, ClassFunction.add_apply,
        ClassFunction.smul_apply, smul_eq_mul] using hsingle.add ih

/-- Peterfalvi 1.10(a), source `vchar_ker_mod_prim`. -/
theorem vchar_ker_mod_prim
    {K : Type u} [Field K] [Algebra ℚ K] [IsAlgClosure ℚ K]
    {G : Type v} [Group G] [Fintype G]
    {p : ℕ} {eps : K} (pr_eps : IsPrimitiveRoot eps p)
    (chi : VirtualCharacter G K) (x y : G)
    (hx : orderOf x = p) (hxy : Commute x y) :
    _root_.Submission.OddOrder.MathlibSupport.IsIntegralModEq
      (1 - eps)
      (VirtualCharacter.realize chi (x * y))
      (VirtualCharacter.realize chi y) := by
  letI : IsAlgClosed K := IsAlgClosure.isAlgClosed ℚ
  letI : CharZero K :=
    charZero_of_injective_algebraMap (algebraMap ℚ K).injective
  exact vchar_ker_mod_prim_of_isAlgClosed pr_eps chi x y hx hxy

end

end Submission.OddOrder.PF
