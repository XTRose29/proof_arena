/-!
# Peterfalvi Section 9: the type-P F-core context

This module contains the common context and the structural conclusions (9.2)--
(9.3) used by the later F-core kernel and character-theoretic phases.
-/

namespace Submission.OddOrder.PF

open Submission.OddOrder.BG.Section03
open Submission.OddOrder.BG.Section07
open Submission.OddOrder.BG.Section15
open Submission.OddOrder.BG.Section16
open Submission.OddOrder.MathlibSupport
open scoped IsMulCommutative Pointwise commutatorElement

noncomputable section

universe u

variable {G : Type u} [Group G] [Finite G] [IsMinSimpleOddGroup G]

/-! ## Context and source-facing predicates -/

/-- Normality of `K` inside the ambient subgroup `M`. -/
def PTypeNormalIn (K M : Subgroup G) : Prop :=
  K ≤ M ∧ (K.subgroupOf M).Normal

/-- A Frobenius product, formed in the subgroup generated by its factors. -/
abbrev PTypeFrobeniusProduct (K R : Subgroup G) : Prop :=
  let J := K ⊔ R
  IsFrobeniusDecomposition (K.subgroupOf J) (R.subgroupOf J)

/-- Peterfalvi (9.3), with `q = |W₁|` and `H = Fitting_core M`. -/
def TypeIIIVCoreConclusion
    (M U W₁ W₂ : Subgroup G) : Prop :=
  let H := Fitting_core M
  let q := Nat.card W₁
  if FTtype M = 2 then
    centralizerWithin H U = ⊥ ∧ Nat.card H = Nat.card W₂ ^ q
  else
    (Nat.card W₂).Prime ∧
      centralizerWithin H (U ⊔ W₁) = ⊥ ∧
      Nat.card H = Nat.card W₂ ^ q *
        Nat.card (centralizerWithin H U)

/-- The defining property of the lower term selected in the next phase. -/
def IsPTypeFCoreKernel
    (M U H₀ : Subgroup G) : Prop :=
  IsMinimalNormalFactor H₀ (Fitting_core M) M ∧
    centralizerWithin (Fitting_core M) U ≤ H₀

/-- The hypotheses common to the type-P part of Peterfalvi Section 9. -/
structure PTypeFCoreContext
    (M U W W₁ W₂ : Subgroup G) : Prop where
  maxM : M ∈ minSimple_max_groups (G := G)
  defW : IsInternalDirectProductIn W₁ W₂ W
  typeP : of_typeP M U W W₁ W₂ defW
  not_type5 : FTtype M ≠ 5

/-- Source-order constructor for the common type-P context. -/
def Ptype_Fcore_context
    {M U W W₁ W₂ : Subgroup G}
    (maxM : M ∈ minSimple_max_groups (G := G))
    (defW : IsInternalDirectProductIn W₁ W₂ W)
    (typeP : of_typeP M U W W₁ W₂ defW)
    (not_type5 : FTtype M ≠ 5) :
    PTypeFCoreContext M U W W₁ W₂ :=
  ⟨maxM, defW, typeP, not_type5⟩

private theorem subgroupOf_disjoint_of_ambient
    {A B K : Subgroup G} (hAK : A ≤ K) (hBK : B ≤ K)
    (hdis : Disjoint A B) :
    Disjoint (A.subgroupOf K) (B.subgroupOf K) := by
  rw [disjoint_iff]
  apply le_antisymm _ bot_le
  intro x hx
  apply Subgroup.mem_bot.mpr
  apply Subtype.ext
  apply Subgroup.mem_bot.mp
  rw [← disjoint_iff.mp hdis]
  exact hx

private theorem ptypeFCore_U_le_M
    {M U W W₁ W₂ : Subgroup G}
    (ctx : PTypeFCoreContext M U W W₁ W₂) : U ≤ M :=
  ctx.typeP.2.1.2.1.trans ctx.typeP.1.2.2.2.1

private theorem ptypeFCore_W₁_le_M
    {M U W W₁ W₂ : Subgroup G}
    (ctx : PTypeFCoreContext M U W W₁ W₂) : W₁ ≤ M :=
  ctx.typeP.1.2.1.1

private theorem ptypeFCore_common
    {M U W W₁ W₂ : Subgroup G}
    (ctx : PTypeFCoreContext M U W W₁ W₂) :
    of_typeII_IV M U W W₁ W₂ ctx.defW :=
  compl_of_typeII_IV M U W W₁ W₂ ctx.defW ctx.maxM
    ctx.typeP ctx.not_type5

/-! ## Peterfalvi (9.2)--(9.3) -/

/-- `PFsection9.v: Ptype_Fcore_sdprod`.

The F-core and the joined complement form the displayed semidirect product
of `M`. -/
theorem Ptype_Fcore_sdprod
    {M U W W₁ W₂ : Subgroup G}
    (ctx : PTypeFCoreContext M U W W₁ W₂) :
    IsInternalSemidirectProductIn (Fitting_core M) (U ⊔ W₁) M := by
  let F := Fitting_core M
  let D := derivedWithin M
  let J := U ⊔ W₁
  have hOuter : IsInternalSemidirectProductIn D W₁ M :=
    ctx.typeP.1.2.2.2
  have hInner : IsInternalSemidirectProductIn F U D :=
    ctx.typeP.2.1.2.2.2
  have hdisDU : Disjoint D W₁ :=
    FTContextInternal.ambient_disjoint_of_subgroupOf8
      hOuter.1 hOuter.2.1 hOuter.2.2.2.disjoint
  have hdisUW₁ : Disjoint U W₁ :=
    Disjoint.mono hInner.2.1 le_rfl hdisDU
  have hdisFU : Disjoint F U :=
    FTContextInternal.ambient_disjoint_of_subgroupOf8
      hInner.1 hInner.2.1 hInner.2.2.2.disjoint
  have hcardJ : Nat.card J = Nat.card U * Nat.card W₁ := by
    simpa [J, sup_comm, Nat.mul_comm] using
      natCard_sup_eq_mul_of_disjoint_of_le_normalizer
        (Disjoint.symm hdisUW₁) ctx.typeP.2.1.2.2.1
  have hcompUJ :
      (U.subgroupOf J).IsComplement' (W₁.subgroupOf J) := by
    apply Subgroup.isComplement'_of_card_mul_and_disjoint
    · simpa [MathlibSupport.natCard_subgroupOf_eq
          (show U ≤ J from le_sup_left),
        MathlibSupport.natCard_subgroupOf_eq
          (show W₁ ≤ J from le_sup_right)] using
        hcardJ.symm
    · exact subgroupOf_disjoint_of_ambient le_sup_left le_sup_right hdisUW₁
  have hdisFJ : Disjoint F J := by
    rw [disjoint_iff]
    apply le_antisymm _ bot_le
    intro x hx
    let xJ : J := ⟨x, hx.2⟩
    obtain ⟨⟨u, w⟩, huw⟩ := hcompUJ.2 xJ
    have huwG : (u : G) * (w : G) = x :=
      congrArg Subtype.val huw
    have hwD : (w : G) ∈ D := by
      have hxD : x ∈ D := hInner.1 hx.1
      have huD : (u : G) ∈ D := hInner.2.1 u.property
      have hwEq : (w : G) = (u : G)⁻¹ * x := by
        rw [← huwG]
        simp
      rw [hwEq]
      exact D.mul_mem (D.inv_mem huD) hxD
    have hwOne : (w : G) = 1 := by
      apply Subgroup.mem_bot.mp
      rw [← disjoint_iff.mp hdisDU]
      exact ⟨hwD, w.property⟩
    have hxU : x ∈ U := by
      rw [← huwG, hwOne, mul_one]
      exact u.property
    rw [← disjoint_iff.mp hdisFU]
    exact ⟨hx.1, hxU⟩
  have hFleM : F ≤ M := Fcore_sub M
  have hJleM : J ≤ M :=
    sup_le (ptypeFCore_U_le_M ctx) (ptypeFCore_W₁_le_M ctx)
  refine ⟨hFleM, hJleM, Fcore_normal M, ?_⟩
  have hdisSub : Disjoint (F.subgroupOf M) (J.subgroupOf M) :=
    subgroupOf_disjoint_of_ambient hFleM hJleM hdisFJ
  refine ⟨Subgroup.mul_injective_of_disjoint hdisSub, ?_⟩
  intro m
  obtain ⟨⟨d, w⟩, hdw⟩ := hOuter.2.2.2.2 m
  let dD : D := ⟨(d : G), d.property⟩
  obtain ⟨⟨f, u⟩, hfu⟩ := hInner.2.2.2.2 dD
  let j : J := ⟨(u : G) * (w : G),
    Subgroup.mul_mem_sup u.property w.property⟩
  let fM : F.subgroupOf M :=
    ⟨⟨(f : G), hFleM f.property⟩, f.property⟩
  let jM : J.subgroupOf M :=
    ⟨⟨(j : G), hJleM j.property⟩, j.property⟩
  refine ⟨⟨fM, jM⟩, ?_⟩
  apply Subtype.ext
  have hfuG : (f : G) * (u : G) = (d : G) :=
    congrArg (fun z : D ↦ (z : G)) hfu
  have hdwG : (d : G) * (w : G) = (m : G) :=
    congrArg (fun z : M ↦ (z : G)) hdw
  change (f : G) * ((u : G) * (w : G)) = (m : G)
  rw [← mul_assoc, hfuG, hdwG]

/-- `PFsection9.v: Ptype_Fcore_coprime`. -/
theorem Ptype_Fcore_coprime
    {M U W W₁ W₂ : Subgroup G}
    (ctx : PTypeFCoreContext M U W W₁ W₂) :
    Nat.Coprime (Nat.card (Fitting_core M)) (Nat.card ↑(U ⊔ W₁)) := by
  let pi := primeSupport (Nat.card (Fitting_core M))
  have hHall := Fcore_Hall M
  have hsd := Ptype_Fcore_sdprod ctx
  have hindex :
      ((Fitting_core M).subgroupOf M).index = Nat.card ↑(U ⊔ W₁) :=
    hsd.2.2.2.symm.index_eq_card.trans
      (MathlibSupport.natCard_subgroupOf_eq hsd.2.1)
  have hright : IsPiNumber piᶜ (Nat.card ↑(U ⊔ W₁)) := by
    rw [← hindex]
    exact hHall.isPiNumber_index
  simpa only [MathlibSupport.natCard_subgroupOf_eq (Fcore_sub M)] using
    hHall.isPiNumber_card.coprime_compl hright

/-- `PFsection9.v: Ptype_compl_Frobenius`. -/
theorem Ptype_compl_Frobenius
    {M U W W₁ W₂ : Subgroup G}
    (ctx : PTypeFCoreContext M U W W₁ W₂) :
    PTypeFrobeniusProduct U W₁ := by
  have hInner : IsInternalSemidirectProductIn
      (Fitting_core M) U (derivedWithin M) :=
    ctx.typeP.2.1.2.2.2
  have hdisFU : Disjoint (Fitting_core M) U :=
    FTContextInternal.ambient_disjoint_of_subgroupOf8
      hInner.1 hInner.2.1 hInner.2.2.2.disjoint
  have hPartner := ctx.typeP.2.2.2.1
  have hreg : IsSemiregularConjugation U W₁ := by
    intro w hw u hfix
    have hwG : (w : G) ≠ 1 := by
      intro hw1
      apply hw
      apply Subtype.ext
      exact hw1
    have hcomm : Commute (w : G) (u : G) := by
      rw [Commute]
      calc
        (w : G) * (u : G) =
            ((w : G) * (u : G) * (w : G)⁻¹) * (w : G) := by
              simp [mul_assoc]
        _ = (u : G) * (w : G) := by rw [hfix]
    have huCent :
        (u : G) ∈
          centralizerWithin (derivedWithin M) (Subgroup.zpowers (w : G)) := by
      refine mem_centralizerWithin.mpr ⟨hInner.2.1 u.property, ?_⟩
      intro z hz
      obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
      exact (hcomm.zpow_left n).eq
    have huW₂ : (u : G) ∈ W₂ := by
      rw [← hPartner.2.2.2.2 (w : G) ⟨w.property, hwG⟩]
      exact huCent
    have huBot : (u : G) ∈ (⊥ : Subgroup G) := by
      rw [← disjoint_iff.mp hdisFU]
      exact ⟨hPartner.2.2.1 huW₂, u.property⟩
    apply Subtype.ext
    exact Subgroup.mem_bot.mp huBot
  have hcommon := ptypeFCore_common ctx
  have hfrob :=
    hreg.isFrobeniusDecomposition_sup ctx.typeP.2.1.2.2.1
      hcommon.2.1 ctx.typeP.1.2.2.1
  rw [sup_comm W₁ U] at hfrob
  exact hfrob

private theorem frobeniusWielandtCard
    {M V U W : Subgroup G}
    (hfrob : PTypeFrobeniusProduct U W)
    (hVM : V ≤ M) (hVnormal : (V.subgroupOf M).Normal)
    (hUM : U ≤ M) (hWM : W ≤ M)
    (hcop : Nat.Coprime (Nat.card V) (Nat.card ↑(U ⊔ W)))
    (hsol : IsSolvable V) :
    Nat.card V *
        Nat.card (centralizerWithin V (U ⊔ W)) ^ Nat.card W =
      Nat.card (centralizerWithin V U) *
        Nat.card (centralizerWithin V W) ^ Nat.card W := by
  have hnorm : U ⊔ W ≤ Subgroup.normalizer (V : Set G) :=
    (sup_le hUM hWM).trans
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hVM).mp hVnormal)
  simpa [Nat.mul_comm] using
    (Frobenius_Wielandt_fixpoint hfrob hnorm hcop hsol).1

private theorem centralizerWithin_eq_bot_of_frobenius
    {H R J : Subgroup G} (hHJ : H ≤ J) (hRJ : R ≤ J)
    (hR : R ≠ ⊥)
    (hfrob : IsFrobeniusDecomposition
      (H.subgroupOf J) (R.subgroupOf J)) :
    centralizerWithin H R = ⊥ := by
  apply eq_bot_iff.mpr
  intro x hx
  obtain ⟨r, hr1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hR
  have hrR : (r : G) ∈ R := r.property
  let rJ : R.subgroupOf J := ⟨⟨(r : G), hRJ hrR⟩, hrR⟩
  let xJ : H.subgroupOf J := ⟨⟨x, hHJ hx.1⟩, hx.1⟩
  have hrJ : rJ ≠ 1 := by
    intro h
    apply hr1
    apply Subtype.ext
    simpa [rJ] using
      congrArg (fun z : R.subgroupOf J ↦ (((z : J) : G))) h
  have hcomm : (r : G) * x = x * r :=
    (mem_centralizerWithin.mp hx).2 r hrR
  have hfix :
      (rJ : J) * (xJ : J) * (rJ : J)⁻¹ = (xJ : J) := by
    apply Subtype.ext
    simpa [rJ, xJ, mul_assoc] using
      congrArg (fun z : G ↦ z * r⁻¹) hcomm
  have hxOne := hfrob.fixedPointFree rJ hrJ xJ hfix
  exact congrArg (fun z : H.subgroupOf J ↦ (((z : J) : G))) hxOne

private theorem le_centralizerWithin_sup
    {H A B X : Subgroup G}
    (hA : X ≤ centralizerWithin H A)
    (hB : X ≤ centralizerWithin H B) :
    X ≤ centralizerWithin H (A ⊔ B) := by
  intro x hx
  have hxA := hA hx
  have hxB := hB hx
  refine mem_centralizerWithin.mpr ⟨hxA.1, ?_⟩
  intro y hy
  have hAc : A ≤ Subgroup.centralizer ({x} : Set G) := by
    intro a ha
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact hxA.2 a ha
  have hBc : B ≤ Subgroup.centralizer ({x} : Set G) := by
    intro b hb
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact hxB.2 b hb
  have hyc := (sup_le hAc hBc) hy
  rw [Subgroup.mem_centralizer_singleton_iff] at hyc
  exact hyc

/-- `PFsection9.v: typeII_IV_core`, Peterfalvi (9.3). -/
theorem typeII_IV_core
    {M U W W₁ W₂ : Subgroup G}
    (ctx : PTypeFCoreContext M U W W₁ W₂) :
    TypeIIIVCoreConclusion M U W₁ W₂ := by
  let H := Fitting_core M
  let q := Nat.card W₁
  have hcop := Ptype_Fcore_coprime ctx
  have hsolH : IsSolvable H := by
    dsimp only [H]
    infer_instance
  have hfix :
      Nat.card H *
          Nat.card (centralizerWithin H (U ⊔ W₁)) ^ q =
        Nat.card (centralizerWithin H U) *
          Nat.card (centralizerWithin H W₁) ^ q :=
    frobeniusWielandtCard (Ptype_compl_Frobenius ctx)
      (Fcore_sub M) (Fcore_normal M)
      (ptypeFCore_U_le_M ctx) (ptypeFCore_W₁_le_M ctx)
      hcop hsolH
  have hcentW₁ : centralizerWithin H W₁ = W₂ := by
    simpa [H] using typeP_cent_core_compl M U W W₁ W₂ ctx.defW ctx.typeP
  rw [TypeIIIVCoreConclusion]
  by_cases htypeII : FTtype M = 2
  · rw [if_pos htypeII]
    have hII := compl_of_typeII M U W W₁ W₂ ctx.defW
      ctx.maxM ctx.typeP htypeII
    have hcoreEq : Fitting_core (derivedWithin M) = H := by
      simpa [H] using hII.2.2.2.2
    obtain ⟨U₀, hU₀⟩ := hII.2.2.2.1.2.2.2.2
    have hU₀le : U₀ ≤ U := hU₀.1
    have hU₀frob := hU₀.2.2.2
    change IsFrobeniusDecomposition
      ((Fitting_core (derivedWithin M)).subgroupOf
        (Fitting_core (derivedWithin M) ⊔ U₀))
      (U₀.subgroupOf (Fitting_core (derivedWithin M) ⊔ U₀)) at hU₀frob
    rw [hcoreEq] at hU₀frob
    have hcentU₀ : centralizerWithin H U₀ = ⊥ :=
      centralizerWithin_eq_bot_of_frobenius le_sup_left le_sup_right
        (by
          intro hbot
          apply hU₀frob.complement_ne_bot
          subst U₀
          simp)
        hU₀frob
    have hcentU : centralizerWithin H U = ⊥ := by
      apply le_bot_iff.mp
      exact (centralizerWithin_antitone_right hU₀le).trans_eq hcentU₀
    have hcentAll : centralizerWithin H (U ⊔ W₁) = ⊥ := by
      apply le_bot_iff.mp
      exact (centralizerWithin_antitone_right le_sup_left).trans_eq hcentU
    refine ⟨hcentU, ?_⟩
    simpa [H, q, hcentU, hcentAll, hcentW₁] using hfix
  · rw [if_neg htypeII]
    letI : Fintype G := Fintype.ofFinite G
    obtain ⟨T, hpair, xdefW, V, hTtypeP⟩ :=
      FTtypeP_pair_witness ctx.defW ctx.maxM ctx.typeP
    have hTtypeII : FTtype T = 2 :=
      hpair.one_type_two.resolve_left htypeII
    have hW₂prime : (Nat.card W₂).Prime :=
      (compl_of_typeII T V W W₂ W₁ xdefW hpair.T_maximal
        hTtypeP hTtypeII).1.2.2.1
    have hnotCentral : ¬ U ≤ Subgroup.centralizer (H : Set G) := by
      have hPctx := typeP_context M U W W₁ W₂ ctx.defW ctx.typeP
      simpa [H] using hPctx.nontrivial_not_le_centralizer
        (ptypeFCore_common ctx).2.1
    let C := centralizerWithin W₂ U
    have hCbot : C = ⊥ := by
      by_contra hCne
      have hcardC : Nat.card C = Nat.card W₂ := by
        rcases (Nat.dvd_prime hW₂prime).mp
            (Subgroup.card_dvd_of_le (centralizerWithin_le_left W₂ U)) with
          hcardOne | hcardEq
        · exact (Nat.ne_of_gt (C.one_lt_card_iff_ne_bot.mpr hCne)
            hcardOne).elim
        · exact hcardEq
      have hCW₂ : C = W₂ :=
        Subgroup.eq_of_le_of_card_ge
          (centralizerWithin_le_left W₂ U) hcardC.ge
      have hW₂centU : W₂ ≤ centralizerWithin H U := by
        rw [← hCW₂]
        exact centralizerWithin_mono_left ctx.typeP.2.2.2.1.2.2.1
      have hW₂centAll : W₂ ≤ centralizerWithin H (U ⊔ W₁) :=
        le_centralizerWithin_sup hW₂centU (by simpa [hcentW₁])
      have hcentAllEq : centralizerWithin H (U ⊔ W₁) = W₂ := by
        apply le_antisymm
        · exact (centralizerWithin_antitone_right le_sup_right).trans_eq hcentW₁
        · exact hW₂centAll
      have hcardHU : Nat.card H = Nat.card (centralizerWithin H U) := by
        apply Nat.mul_right_cancel (pow_pos hW₂prime.pos q)
        simpa [hcentAllEq, hcentW₁, Nat.mul_assoc] using hfix
      have hcentUEq : centralizerWithin H U = H :=
        Subgroup.eq_of_le_of_card_ge
          (centralizerWithin_le_left H U) hcardHU.symm.ge
      apply hnotCentral
      rw [Subgroup.le_centralizer_iff]
      intro h hh
      have hhCent : h ∈ centralizerWithin H U := by
        rw [hcentUEq]
        exact hh
      exact (mem_centralizerWithin.mp hhCent).2
    have hcentAll : centralizerWithin H (U ⊔ W₁) = ⊥ := by
      apply le_antisymm _ bot_le
      intro x hx
      have hxW₂ : x ∈ W₂ := by
        rw [← hcentW₁]
        exact (centralizerWithin_antitone_right le_sup_right) hx
      have hxC : x ∈ C :=
        ⟨hxW₂,
          (mem_centralizerWithin.mp
            ((centralizerWithin_antitone_right le_sup_left) hx)).2⟩
      rw [hCbot] at hxC
      exact hxC
    refine ⟨hW₂prime, hcentAll, ?_⟩
    simpa [H, q, hcentAll, hcentW₁, Nat.mul_comm, Nat.mul_assoc] using hfix

end

end Submission.OddOrder.PF
