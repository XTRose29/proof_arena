import Submission.OddOrder.PF.Section02.DadeSupportConjugation

/-!
# Peterfalvi 2.8: signalizers of nonempty subsets

For a nonempty subset `B` of the Dade set `A`, the intersection of the
pointwise signalizers is normalized by the setwise normalizer of `B` in `L`.
Together they form the internal semidirect product used in the character
expansion of the Dade isometry.
-/

namespace Submission.OddOrder.PF

open Submission.OddOrder.MathlibSupport

universe u

variable {Γ : Type u} [Group Γ]

/-- The subsets indexing the Dade expansion are the nonempty subsets of the
original Dade set. -/
def IsDadeSubset (A B : Set Γ) : Prop :=
  B ⊆ A ∧ B.Nonempty

/-- The signalizer of a subset is the intersection of its pointwise
signalizers.  The indexing by the subtype `B` deliberately preserves the
empty-intersection value `⊤`. -/
def Dade_set_signalizer
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : Set Γ) : Subgroup Γ :=
  ⨅ a : B, DadeSignalizer ddA a

/-- The subgroup generated by the set signalizer and the setwise normalizer
of `B` in `L`. -/
def Dade_set_normalizer
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : Set Γ) : Subgroup Γ :=
  Dade_set_signalizer ddA B ⊔
    (L ⊓ Subgroup.normalizer B)

private theorem setNormalizer_le_signalizerNormalizer
    {G L : Subgroup Γ} {A B : Set Γ}
    (ddA : DadeHypothesis G L A) :
    L ⊓ Subgroup.normalizer B ≤
      Subgroup.normalizer (Dade_set_signalizer ddA B : Set Γ) := by
  rw [Subgroup.le_normalizer_iff]
  intro x hx y hy
  change y ∈ ⨅ a : B, DadeSignalizer ddA a at hy
  change x * y * x⁻¹ ∈ ⨅ a : B, DadeSignalizer ddA a
  rw [Subgroup.mem_iInf] at hy ⊢
  intro a
  let b : Γ := x⁻¹ * (a : Γ) * x
  have hbB : b ∈ B := by
    exact (Subgroup.mem_set_normalizer_iff''.mp hx.2 (a : Γ)).mp a.property
  have hyb : y ∈ DadeSignalizer ddA b := hy ⟨b, hbB⟩
  have hxInvL : x⁻¹ ∈ L := L.inv_mem hx.1
  have hJ :
      DadeSignalizer ddA (x * b * x⁻¹) =
        (DadeSignalizer ddA b).map
          (MulAut.conj x).toMonoidHom := by
    simpa only [inv_inv] using DadeJ ddA b x⁻¹ hxInvL
  have hxy :
      x * y * x⁻¹ ∈
        (DadeSignalizer ddA b).map
          (MulAut.conj x).toMonoidHom := by
    exact Subgroup.mem_map_of_mem _ hyb
  have hxbx : x * b * x⁻¹ = (a : Γ) := by
    simp [b, mul_assoc]
  rw [hxbx] at hJ
  rwa [← hJ] at hxy

private theorem signalizer_disjoint_left
    [Finite Γ]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) {a : Γ} (ha : a ∈ A) :
    Disjoint (DadeSignalizer ddA a) L := by
  rw [disjoint_iff]
  apply le_antisymm _ bot_le
  intro x hx
  apply Subgroup.mem_bot.mpr
  have hsd := Dade_sdprod ddA ha
  have hxCL : x ∈ centralizerWithin L (Subgroup.zpowers a) :=
    ⟨hx.2, Dade_signalizer_cent ddA a hx.1⟩
  let xCG : centralizerWithin G (Subgroup.zpowers a) :=
    ⟨x, hsd.1 hx.1⟩
  have hxHsub :
      xCG ∈ (DadeSignalizer ddA a).subgroupOf
        (centralizerWithin G (Subgroup.zpowers a)) := hx.1
  have hxCLsub :
      xCG ∈ (centralizerWithin L (Subgroup.zpowers a)).subgroupOf
        (centralizerWithin G (Subgroup.zpowers a)) := hxCL
  have hxBot : xCG ∈ (DadeSignalizer ddA a).subgroupOf
      (centralizerWithin G (Subgroup.zpowers a)) ⊓
        (centralizerWithin L (Subgroup.zpowers a)).subgroupOf
          (centralizerWithin G (Subgroup.zpowers a)) :=
    ⟨hxHsub, hxCLsub⟩
  rw [disjoint_iff.mp hsd.2.2.2.disjoint] at hxBot
  have hxOne : xCG = 1 := Subgroup.mem_bot.mp hxBot
  exact congrArg (fun z : centralizerWithin G (Subgroup.zpowers a) ↦
    (z : Γ)) hxOne

private theorem setSignalizer_disjoint_setNormalizer
    [Finite Γ]
    {G L : Subgroup Γ} {A B : Set Γ}
    (ddA : DadeHypothesis G L A)
    (hBA : B ⊆ A) (hB : B.Nonempty) :
    Disjoint (Dade_set_signalizer ddA B)
      (L ⊓ Subgroup.normalizer B) := by
  obtain ⟨a, haB⟩ := hB
  apply (signalizer_disjoint_left ddA (hBA haB)).mono
  · exact iInf_le_of_le ⟨a, haB⟩ le_rfl
  · exact inf_le_left

/-- Peterfalvi 2.8: for every nonempty `B ⊆ A`, its set signalizer is a
normal complement to the setwise normalizer of `B` in the subgroup generated
by the two factors. -/
theorem Dade_set_sdprod
    [Finite Γ]
    {G L : Subgroup Γ} {A B : Set Γ}
    (ddA : DadeHypothesis G L A)
    (hBA : B ⊆ A) (hB : B.Nonempty) :
    IsInternalSemidirectProductIn
      (Dade_set_signalizer ddA B)
      (L ⊓ Subgroup.normalizer B)
      (Dade_set_normalizer ddA B) := by
  let N : Subgroup Γ := Dade_set_signalizer ddA B
  let H : Subgroup Γ := L ⊓ Subgroup.normalizer B
  let K : Subgroup Γ := Dade_set_normalizer ddA B
  have hK : K = N ⊔ H := rfl
  have hNK : N ≤ K := by rw [hK]; exact le_sup_left
  have hHK : H ≤ K := by rw [hK]; exact le_sup_right
  have hHnormN : H ≤ Subgroup.normalizer (N : Set Γ) := by
    simpa only [N, H] using setNormalizer_le_signalizerNormalizer ddA
  have hKnormN : K ≤ Subgroup.normalizer (N : Set Γ) := by
    rw [hK]
    exact sup_le Subgroup.le_normalizer hHnormN
  have hNnormal : (N.subgroupOf K).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hNK).mpr hKnormN
  have hdis : Disjoint N H := by
    simpa only [N, H] using
      setSignalizer_disjoint_setNormalizer ddA hBA hB
  have hdisSub : Disjoint (N.subgroupOf K) (H.subgroupOf K) := by
    rw [disjoint_iff]
    apply le_antisymm _ bot_le
    intro x hx
    apply Subgroup.mem_bot.mpr
    apply Subtype.ext
    apply Subgroup.mem_bot.mp
    have hxAmbient : (x : Γ) ∈ N ⊓ H := hx
    rw [disjoint_iff.mp hdis] at hxAmbient
    exact hxAmbient
  have hsupSub : N.subgroupOf K ⊔ H.subgroupOf K = ⊤ := by
    rw [← Subgroup.subgroupOf_sup hNK hHK, ← hK]
    exact Subgroup.subgroupOf_self K
  have hcomp : (N.subgroupOf K).IsComplement' (H.subgroupOf K) := by
    letI : (N.subgroupOf K).Normal := hNnormal
    apply Subgroup.isComplement'_of_disjoint_and_mul_eq_univ hdisSub
    rw [← Subgroup.normal_mul (N.subgroupOf K) (H.subgroupOf K), hsupSub]
    rfl
  exact ⟨hNK, hHK, hNnormal, hcomp⟩

end Submission.OddOrder.PF
