import Submission.OddOrder.MathlibSupport.InternalSemidirectProjection
import Submission.OddOrder.PF.Section01.VirtualCharacterPullback
import Submission.OddOrder.PF.Section02.DadeSubsetOrbits

/-!
# The restriction terms in the Dade expansion

This file ports the opening of Coq `PFsection2.v`, section
`DadeExpansion` (source definitions `Dade_restrm`,
`Dade_cfun_restriction`, `Dade_transversal`, and lemmas
`Dade_restrictionE`, `Dade_restriction_vchar`).

For a nonempty subset `B` of the Dade set, Peterfalvi 2.8 identifies
`Dade_set_normalizer ddA B` as an internal semidirect product of its set
signalizer by the setwise normalizer in `L`.  Coq's `remgr` is the canonical
projection onto that right factor.  Here it is built from
`Subgroup.IsComplement'.rightProjection` and then included into `L`.

MathComp class functions on a subgroup are ambient functions extended by
zero outside the subgroup.  Our class functions are instead functions on the
subgroup type itself.  Consequently the membership indicator in source
`Dade_restrictionE` disappears: every argument of the Lean class function
already lies in `Dade_set_normalizer ddA B`.
-/

namespace Submission.OddOrder.PF

noncomputable section

open Submission.OddOrder.MathlibSupport

universe u v

variable {Γ : Type u} [Group Γ]

local instance dadeExpansionRestrictionInvertibleCard
    {G : Type u} {k : Type v} [Group G] [Fintype G]
    [Field k] [CharZero k] : Invertible (Nat.card G : k) :=
  invertibleOfNonzero (Nat.cast_ne_zero.mpr Nat.card_pos.ne')

/-- The normal factor in the set-normalizer semidirect product. -/
abbrev DadeSetSignalizer
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A) : Subgroup Γ :=
  Dade_set_signalizer ddA (B : Set Γ)

/-- The complement in the set-normalizer semidirect product. -/
abbrev DadeSetComplement
    {G L : Subgroup Γ} {A : Set Γ}
    (_ddA : DadeHypothesis G L A) (B : DadeSubset A) : Subgroup Γ :=
  L ⊓ Subgroup.normalizer (B : Set Γ)

/-- The ambient subgroup generated by the two factors attached to `B`. -/
abbrev DadeSetNormalizer
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A) : Subgroup Γ :=
  Dade_set_normalizer ddA (B : Set Γ)

/-- Peterfalvi 2.8 supplies the internal semidirect-product structure used
by every restriction term in the expansion. -/
theorem Dade_set_sdprod_subtype
    [Finite Γ]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A) :
    IsInternalSemidirectProductIn
      (DadeSetSignalizer ddA B)
      (DadeSetComplement ddA B)
      (DadeSetNormalizer ddA B) :=
  Dade_set_sdprod ddA B.property.1 B.property.2

/-- Coq `Dade_restrm`, before inclusion of the complement into `L`: the
canonical projection from the set normalizer onto its right factor. -/
noncomputable def Dade_restrm_complement
    [Finite Γ]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A) :
    DadeSetNormalizer ddA B →*
      (DadeSetComplement ddA B).subgroupOf
        (DadeSetNormalizer ddA B) := by
  let hsd := Dade_set_sdprod_subtype ddA B
  letI : (DadeSetSignalizer ddA B).subgroupOf
      (DadeSetNormalizer ddA B) |>.Normal := hsd.2.2.1
  exact hsd.2.2.2.rightProjection

/-- Coq `Dade_restrm`: the right-factor projection, regarded as a
homomorphism into `L`.  The source used a conditional definition on all
ambient subsets; taking `B : DadeSubset A` records its `calP` hypothesis in
the type and removes the irrelevant trivial-morphism branch. -/
noncomputable def Dade_restrm
    [Finite Γ]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A) :
    DadeSetNormalizer ddA B →* L :=
  let hsd := Dade_set_sdprod_subtype ddA B
  (Subgroup.inclusion inf_le_left).comp
    ((Subgroup.subgroupOfEquivOfLe hsd.2.1).toMonoidHom.comp
      (Dade_restrm_complement ddA B))

/-- The projection is the identity on the setwise-normalizer complement. -/
@[simp]
theorem Dade_restrm_apply_complement
    [Finite Γ]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A)
    (x : DadeSetComplement ddA B) :
    Dade_restrm ddA B
        (⟨(x : Γ), (Dade_set_sdprod_subtype ddA B).2.1 x.property⟩ :
          DadeSetNormalizer ddA B) =
      Subgroup.inclusion inf_le_left x := by
  let hsd := Dade_set_sdprod_subtype ddA B
  dsimp only [IsInternalSemidirectProductIn] at hsd
  letI : (DadeSetSignalizer ddA B).subgroupOf
      (DadeSetNormalizer ddA B) |>.Normal := hsd.2.2.1
  let xK : DadeSetNormalizer ddA B :=
    ⟨(x : Γ), hsd.2.1 x.property⟩
  let xH : (DadeSetComplement ddA B).subgroupOf
      (DadeSetNormalizer ddA B) := ⟨xK, x.property⟩
  have hxproj : Dade_restrm_complement ddA B xK = xH := by
    unfold Dade_restrm_complement
    exact Subgroup.IsComplement'.rightProjection_apply_right _ xH
  change (Subgroup.inclusion inf_le_left)
      ((Subgroup.subgroupOfEquivOfLe hsd.2.1)
        (Dade_restrm_complement ddA B xK)) =
      Subgroup.inclusion inf_le_left x
  rw [hxproj]
  rfl

/-- The projection kills the set signalizer. -/
@[simp]
theorem Dade_restrm_apply_signalizer
    [Finite Γ]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A)
    (n : DadeSetSignalizer ddA B) :
    Dade_restrm ddA B
        (⟨(n : Γ), (Dade_set_sdprod_subtype ddA B).1 n.property⟩ :
          DadeSetNormalizer ddA B) = 1 := by
  let hsd := Dade_set_sdprod_subtype ddA B
  dsimp only [IsInternalSemidirectProductIn] at hsd
  letI : (DadeSetSignalizer ddA B).subgroupOf
      (DadeSetNormalizer ddA B) |>.Normal := hsd.2.2.1
  let nK : DadeSetNormalizer ddA B :=
    ⟨(n : Γ), hsd.1 n.property⟩
  let nN : (DadeSetSignalizer ddA B).subgroupOf
      (DadeSetNormalizer ddA B) := ⟨nK, n.property⟩
  have hnproj : Dade_restrm_complement ddA B nK = 1 := by
    unfold Dade_restrm_complement
    exact Subgroup.IsComplement'.rightProjection_apply_left _ nN
  change (Subgroup.inclusion inf_le_left)
      ((Subgroup.subgroupOfEquivOfLe hsd.2.1)
        (Dade_restrm_complement ddA B nK)) = 1
  rw [hnproj]
  rfl

/-- Coq `Dade_cfun_restriction`: pull a class function on `L` back along
the semidirect-product projection attached to `B`. -/
noncomputable def Dade_cfun_restriction
    [Finite Γ]
    {k : Type v} [Field k]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A)
    (alpha : ClassFunction L k) :
    ClassFunction (DadeSetNormalizer ddA B) k :=
  ClassFunction.comap (Dade_restrm ddA B) alpha

/-- Lean's subgroup-typed form of Coq `Dade_restrictionE`.  The source's
factor `(x \in 'M(B))` is implicit in the type of `x`. -/
@[simp]
theorem Dade_restrictionE
    [Finite Γ]
    {k : Type v} [Field k]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A)
    (alpha : ClassFunction L k) (x : DadeSetNormalizer ddA B) :
    Dade_cfun_restriction ddA B alpha x =
      alpha (Dade_restrm ddA B x) :=
  rfl

/-! The project-level virtual-character pullback currently identifies the
group and coefficient-field universes.  These private helpers give the same
construction with the two universes independent. -/

private theorem characterPairing_ofRepresentation_eq_finrank_hom_split
    {G : Type u} {k : Type v} [Group G] [Fintype G]
    [Field k] [CharZero k] (V W : FDRep k G) :
    characterPairing (ClassFunction.ofRepresentation V.ρ)
        (ClassFunction.ofRepresentation W.ρ) =
      (Module.finrank k (W ⟶ V) : k) := by
  letI : Invertible (Nat.card G : k) :=
    invertibleOfNonzero (Nat.cast_ne_zero.mpr Nat.card_pos.ne')
  letI : Invertible (Fintype.card G : k) := by
    rw [Fintype.card_eq_nat_card]
    infer_instance
  have hhom := FDRep.scalar_product_char_eq_finrank_equivariant W V
  have hcharV (g : G) :
      V.character g = Representation.character V.ρ g := rfl
  have hcharW (g : G) :
      W.character g = Representation.character W.ρ g := rfl
  simpa only [characterPairing, ClassFunction.ofRepresentation_apply,
    invOf_eq_inv, smul_eq_mul, Fintype.card_eq_nat_card,
    hcharV, hcharW] using hhom

private noncomputable def dadeVirtualCharacterOfFDRep
    {G : Type u} {k : Type v} [Group G] [Fintype G]
    [Field k] [IsAlgClosed k] [CharZero k]
    (V : FDRep k G) : VirtualCharacter G k :=
  Finsupp.equivFunOnFinite.symm fun chi : IrreducibleCharacter G k =>
    (Module.finrank k (chi.representation ⟶ V) : ℤ)

private theorem realize_dadeVirtualCharacterOfFDRep
    {G : Type u} {k : Type v} [Group G] [Fintype G]
    [Field k] [IsAlgClosed k] [CharZero k]
    (V : FDRep k G) :
    VirtualCharacter.realize (dadeVirtualCharacterOfFDRep V) =
      ClassFunction.ofRepresentation V.ρ := by
  rw [dadeVirtualCharacterOfFDRep,
    Finsupp.equivFunOnFinite_symm_eq_sum, map_sum]
  simp only [VirtualCharacter.realize_single, Int.cast_natCast]
  rw [← irreducibleCharacterExpansion_eq
    (ClassFunction.ofRepresentation V.ρ), irreducibleCharacterExpansion]
  apply Finset.sum_congr rfl
  intro chi _
  rw [characterPairing_comm, ← chi.ofRepresentation_representation]
  apply congrArg (fun a : k =>
    a • ClassFunction.ofRepresentation chi.representation.ρ)
  exact (characterPairing_ofRepresentation_eq_finrank_hom_split
    V chi.representation).symm

private noncomputable def dadeVirtualCharacterComap
    {H G : Type u} {k : Type v} [Group H] [Group G] [Fintype H]
    [Field k] [IsAlgClosed k] [CharZero k]
    (q : H →* G) : VirtualCharacter G k →+ VirtualCharacter H k :=
  Finsupp.liftAddHom fun chi : IrreducibleCharacter G k =>
    (smulAddHom ℤ (VirtualCharacter H k)).flip
      (dadeVirtualCharacterOfFDRep
        (FDRep.of (chi.representation.ρ.comp q)))

@[simp]
private theorem dadeVirtualCharacterComap_single
    {H G : Type u} {k : Type v} [Group H] [Group G] [Fintype H]
    [Field k] [IsAlgClosed k] [CharZero k]
    (q : H →* G) (chi : IrreducibleCharacter G k) (z : ℤ) :
    dadeVirtualCharacterComap q (Finsupp.single chi z) =
      z • dadeVirtualCharacterOfFDRep
        (FDRep.of (chi.representation.ρ.comp q)) := by
  rw [dadeVirtualCharacterComap, Finsupp.liftAddHom_apply_single]
  rfl

private theorem realize_dadeVirtualCharacterComap
    {H G : Type u} {k : Type v} [Group H] [Group G] [Fintype H]
    [Field k] [IsAlgClosed k] [CharZero k]
    (q : H →* G) (f : VirtualCharacter G k) :
    VirtualCharacter.realize (dadeVirtualCharacterComap q f) =
      ClassFunction.comap q (VirtualCharacter.realize f) := by
  classical
  induction f using Finsupp.induction with
  | zero => simp
  | single_add chi z f hchi hz ih =>
      have hsingle :
          VirtualCharacter.realize
              (dadeVirtualCharacterComap q (Finsupp.single chi z)) =
            ClassFunction.comap q
              (VirtualCharacter.realize (Finsupp.single chi z)) := by
        rw [dadeVirtualCharacterComap_single, map_zsmul,
          realize_dadeVirtualCharacterOfFDRep,
          VirtualCharacter.realize_single,
          ← Int.cast_smul_eq_zsmul k, map_smul]
        congr 1
        rw [← chi.ofRepresentation_representation]
        ext h
        rfl
      calc
        VirtualCharacter.realize
              (dadeVirtualCharacterComap q (Finsupp.single chi z + f)) =
            VirtualCharacter.realize
                (dadeVirtualCharacterComap q (Finsupp.single chi z)) +
              VirtualCharacter.realize (dadeVirtualCharacterComap q f) := by
                rw [map_add, map_add]
        _ = ClassFunction.comap q
              (VirtualCharacter.realize (Finsupp.single chi z)) +
            ClassFunction.comap q (VirtualCharacter.realize f) := by
              rw [hsingle, ih]
        _ = ClassFunction.comap q
              (VirtualCharacter.realize (Finsupp.single chi z + f)) := by
                rw [← map_add (ClassFunction.comap q),
                  map_add VirtualCharacter.realize]

/-- The virtual character whose realization is the Coq restriction term.
No irreducibility-preservation claim is made: pullback packages the entire
restricted representation in the irreducible-character lattice. -/
noncomputable def Dade_vchar_restriction
    [Fintype Γ]
    {k : Type v} [Field k] [IsAlgClosed k] [CharZero k]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A)
    (alpha : VirtualCharacter L k) :
    VirtualCharacter (DadeSetNormalizer ddA B) k := by
  letI : Fintype (DadeSetNormalizer ddA B) := Fintype.ofFinite _
  exact dadeVirtualCharacterComap (Dade_restrm ddA B) alpha

/-- Coq `Dade_restriction_vchar`: restriction along the projection sends a
virtual character of `L` to a virtual character of the set normalizer.  In
Lean, lattice membership is expressed by exhibiting the virtual character
whose realization is the restricted class function. -/
theorem Dade_restriction_vchar
    [Fintype Γ]
    {k : Type v} [Field k] [IsAlgClosed k] [CharZero k]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (B : DadeSubset A)
    (alpha : VirtualCharacter L k) :
    Dade_cfun_restriction ddA B (VirtualCharacter.realize alpha) =
      VirtualCharacter.realize (Dade_vchar_restriction ddA B alpha) := by
  letI : Fintype (DadeSetNormalizer ddA B) := Fintype.ofFinite _
  exact (realize_dadeVirtualCharacterComap
    (Dade_restrm ddA B) alpha).symm

/-- The orbit-indexed form of the restriction term.  This is the direct
consumer of Coq `Dade_transversal`: an orbit is represented by
`Dade_transversal omega`, rather than by membership in a separately chosen
set of representatives. -/
noncomputable def Dade_orbit_cfun_restriction
    [Finite Γ]
    {k : Type v} [Field k]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (alpha : ClassFunction L k)
    (omega : DadeSubsetOrbit ddA) :
    ClassFunction
      (DadeSetNormalizer ddA (Dade_transversal omega)) k :=
  Dade_cfun_restriction ddA (Dade_transversal omega) alpha

/-- The virtual-character version of the orbit representative term. -/
noncomputable def Dade_orbit_vchar_restriction
    [Fintype Γ]
    {k : Type v} [Field k] [IsAlgClosed k] [CharZero k]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (alpha : VirtualCharacter L k)
    (omega : DadeSubsetOrbit ddA) :
    VirtualCharacter
      (DadeSetNormalizer ddA (Dade_transversal omega)) k :=
  Dade_vchar_restriction ddA (Dade_transversal omega) alpha

/-- Every orbit-representative restriction term is realized by the
corresponding orbit-indexed virtual character. -/
theorem Dade_orbit_restriction_vchar
    [Fintype Γ]
    {k : Type v} [Field k] [IsAlgClosed k] [CharZero k]
    {G L : Subgroup Γ} {A : Set Γ}
    (ddA : DadeHypothesis G L A) (alpha : VirtualCharacter L k)
    (omega : DadeSubsetOrbit ddA) :
    Dade_orbit_cfun_restriction ddA
        (VirtualCharacter.realize alpha) omega =
      VirtualCharacter.realize
        (Dade_orbit_vchar_restriction ddA alpha omega) :=
  Dade_restriction_vchar ddA (Dade_transversal omega) alpha

end

end Submission.OddOrder.PF
