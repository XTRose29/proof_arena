/-! ## Basic properties of the sigma decomposition -/

/-- Conjugation of a set by an ambient element. -/
def conjugateSet (z : G) (X : Set G) : Set G :=
  (MulAut.conj z) '' X

private theorem isPiNumber_orderOf_of_mem_sigmaCore
    (M : Subgroup G) {x : G} (hx : x ∈ sigmaCore M) :
    IsPiNumber (sigmaPrimes M) (orderOf x) := by
  apply (sigmaCore_isPiNumber M).of_dvd
  exact (sigmaCore M).orderOf_dvd_natCard hx

private theorem isPiNumber_mono_of_disjoint
    {pi rho : Set ℕ} (hdis : Disjoint pi rho)
    {n : ℕ} (hn : IsPiNumber pi n) :
    IsPiNumber rhoᶜ n := by
  intro p hp hpn hpRho
  exact Set.disjoint_left.mp hdis (hn hp hpn) hpRho

private theorem sigmaComponent_complement_eq_of_disjoint
    {M L : Subgroup G} (hdis : Disjoint (sigmaPrimes M) (sigmaPrimes L))
    (x : G) :
    sigmaComponent L (sigmaComplementComponent M x) =
      sigmaComponent L x := by
  have hcomm := sigmaComponent_commute_complement M x
  have hsComplL : IsPiNumber (sigmaPrimes L)ᶜ
      (orderOf (sigmaComponent M x)) :=
    isPiNumber_mono_of_disjoint hdis
      (sigmaComponent_isPiNumber M x)
  calc
    sigmaComponent L (sigmaComplementComponent M x) =
        1 * sigmaComponent L (sigmaComplementComponent M x) := by simp
    _ = sigmaComponent L (sigmaComponent M x) *
        sigmaComponent L (sigmaComplementComponent M x) := by
      rw [sigmaComponent_eq_one_of_isPiNumber_compl L hsComplL]
    _ = sigmaComponent L
        (sigmaComponent M x * sigmaComplementComponent M x) :=
      (sigmaComponent_mul_of_commute L hcomm).symm
    _ = sigmaComponent L x := by rw [sigmaComponent_mul_complement]

/-- Source `mem_sigma_decomposition`. -/
theorem mem_sigma_decomposition
    {x : G} {M : Subgroup G}
    (hM : M ∈ minSimple_max_groups (G := G))
    (hxM : sigmaComponent M x ≠ 1) :
    sigmaComponent M x ∈ sigmaDecomposition x := by
  exact ⟨hxM, M, hM, rfl⟩

/-- Source `sigma_decompositionJ`: the decomposition is equivariant under
conjugation. -/
theorem sigma_decompositionJ (x z : G) :
    sigmaDecomposition ((MulAut.conj z) x) =
      conjugateSet z (sigmaDecomposition x) := by
  classical
  let e : G ≃* G := MulAut.conj z
  ext y
  constructor
  · rintro ⟨hy, L, hL, rfl⟩
    let M : Subgroup G := L.map e.symm.toMonoidHom
    have hM : M ∈ minSimple_max_groups (G := G) :=
      (mmaxJ L e.symm).mpr hL
    have hback : M.map e.toMonoidHom = L := by
      dsimp [M]
      simp [Subgroup.map_map]
    let c : G := sigmaComponent M x
    have hcmap : e c = sigmaComponent L (e x) := by
      rw [← hback]
      exact (sigmaComponent_conj M x z).symm
    refine ⟨c, ?_, hcmap⟩
    refine ⟨?_, M, hM, rfl⟩
    intro hc
    apply hy
    have heone : e c = 1 := by simp [hc]
    exact hcmap.symm.trans heone
  · rintro ⟨c, ⟨hc, M, hM, rfl⟩, rfl⟩
    refine ⟨?_, M.map e.toMonoidHom,
      (mmaxJ M e).mpr hM, ?_⟩
    · intro hmap
      exact hc (e.injective (by simpa using hmap))
    · simpa [e] using (sigmaComponent_conj M x z).symm

/-- Source `ell_sigmaJ`. -/
theorem ell_sigmaJ (x z : G) :
    sigmaLength ((MulAut.conj z) x) = sigmaLength x := by
  rw [sigmaLength, sigma_decompositionJ, sigmaLength, conjugateSet]
  exact Set.ncard_image_of_injective _ (MulAut.conj z).injective

/-- Source `sigma_mmaxJ`. -/
theorem sigma_mmaxJ
    (M : Subgroup G) (X : Set G) (z : G) :
    M.map (MulAut.conj z).toMonoidHom ∈
        sigmaMaximalOvergroups (conjugateSet z X) ↔
      M ∈ sigmaMaximalOvergroups X := by
  classical
  let e : G ≃* G := MulAut.conj z
  constructor
  · rintro ⟨hMmap, hXmap⟩
    refine ⟨(mmaxJ M e).mp hMmap, ?_⟩
    intro x hx
    have hex : e x ∈ conjugateSet z X := ⟨x, hx, rfl⟩
    have hecore := hXmap hex
    rw [sigmaCore_conj] at hecore
    simpa [e, mul_assoc] using (Subgroup.mem_map_equiv.mp hecore)
  · rintro ⟨hM, hXM⟩
    refine ⟨(mmaxJ M e).mpr hM, ?_⟩
    rintro _ ⟨x, hx, rfl⟩
    rw [sigmaCore_conj]
    exact Subgroup.mem_map_of_mem e.toMonoidHom (hXM hx)

/-- Source `card_sigma_mmaxJ`. -/
theorem card_sigma_mmaxJ (X : Set G) (z : G) :
    (sigmaMaximalOvergroups (conjugateSet z X)).ncard =
      (sigmaMaximalOvergroups X).ncard := by
  let e : G ≃* G := MulAut.conj z
  let f : Subgroup G → Subgroup G := fun M ↦ M.map e.toMonoidHom
  have hset : sigmaMaximalOvergroups (conjugateSet z X) =
      f '' sigmaMaximalOvergroups X := by
    ext L
    constructor
    · intro hL
      let M := L.comap e.toMonoidHom
      have hmap : M.map e.toMonoidHom = L := by
        exact Subgroup.map_comap_eq_self_of_surjective
          (f := e.toMonoidHom) e.surjective L
      refine ⟨M, ?_, ?_⟩
      · apply (sigma_mmaxJ M X z).mp
        simpa [e] using hmap.symm ▸ hL
      · simpa [f] using hmap
    · rintro ⟨M, hM, rfl⟩
      exact (sigma_mmaxJ M X z).mpr hM
  rw [hset]
  apply Set.ncard_image_of_injective
  intro A B hAB
  ext x
  constructor
  · intro hx
    have hex : e x ∈ f A := by
      exact Subgroup.mem_map_of_mem e.toMonoidHom hx
    rw [hAB] at hex
    simpa [f] using (Subgroup.mem_map_equiv.mp hex)
  · intro hx
    have hex : e x ∈ f B := by
      exact Subgroup.mem_map_of_mem e.toMonoidHom hx
    rw [← hAB] at hex
    simpa [f] using (Subgroup.mem_map_equiv.mp hex)

/-- Source `sigma_decomposition_constt'`: removing the `sigma(M)` factor
removes precisely that member of the global decomposition. -/
theorem sigma_decomposition_constt'
    {x : G} {M : Subgroup G}
    (hM : M ∈ minSimple_max_groups (G := G)) :
    sigmaDecomposition (sigmaComplementComponent M x) =
      sigmaDecomposition x \ {sigmaComponent M x} := by
  classical
  ext y
  constructor
  · rintro ⟨hy, L, hL, hyL⟩
    have hnotconj : ∀ z : G,
        L ≠ M.map (MulAut.conj z).toMonoidHom := by
      intro z hLM
      subst L
      have hsig : sigmaPrimes
          (M.map (MulAut.conj z).toMonoidHom) = sigmaPrimes M :=
        sigmaPrimes_conj M z
      have hcompPi := sigmaComplementComponent_isPiNumber M x
      have hone : sigmaComponent
          (M.map (MulAut.conj z).toMonoidHom)
          (sigmaComplementComponent M x) = 1 := by
        apply sigmaComponent_eq_one_of_isPiNumber_compl
        rw [hsig]
        exact hcompPi
      exact hy (hyL.trans hone)
    have hdis : Disjoint (sigmaPrimes M) (sigmaPrimes L) :=
      sigma_partition hM hL hnotconj
    have heq := sigmaComponent_complement_eq_of_disjoint hdis x
    refine ⟨?_, ?_⟩
    · exact ⟨hy, L, hL, hyL.trans heq⟩
    · intro hyM
      have hLM : sigmaComponent L x = sigmaComponent M x := by
        exact (hyL.trans heq).symm.trans hyM
      have hpiL := sigmaComponent_isPiNumber L x
      have hpiM := sigmaComponent_isPiNumber M x
      have hcross : IsPiNumber (sigmaPrimes L)ᶜ
          (orderOf (sigmaComponent M x)) :=
        isPiNumber_mono_of_disjoint hdis hpiM
      have hcross' : IsPiNumber (sigmaPrimes L)ᶜ
          (orderOf (sigmaComponent L x)) := by
        rwa [hLM]
      have hcop : (orderOf (sigmaComponent L x)).Coprime
          (orderOf (sigmaComponent L x)) :=
        hpiL.coprime_compl hcross'
      have honeOrder : orderOf (sigmaComponent L x) = 1 := by
        simpa using hcop
      exact hy ((hyL.trans heq).trans
        (orderOf_eq_one_iff.mp honeOrder))
  · rintro ⟨⟨hy, L, hL, hyL⟩, hyneM⟩
    have hnotconj : ∀ z : G,
        L ≠ M.map (MulAut.conj z).toMonoidHom := by
      intro z hLM
      subst L
      have hsig := sigmaPrimes_conj M z
      have hcompEq : sigmaComponent
          (M.map (MulAut.conj z).toMonoidHom) x =
          sigmaComponent M x := by
        change primeSetComponent
            (sigmaPrimes (M.map (MulAut.conj z).toMonoidHom)) x =
          primeSetComponent (sigmaPrimes M) x
        rw [hsig]
      exact hyneM (hyL.trans hcompEq)
    have hdis : Disjoint (sigmaPrimes M) (sigmaPrimes L) :=
      sigma_partition hM hL hnotconj
    have heq := sigmaComponent_complement_eq_of_disjoint hdis x
    exact ⟨hy, L, hL, hyL.trans heq.symm⟩

/-! ## General remarks about the sigma decomposition -/

/-- Source `sigma_mmax_exists`: every ambient prime divisor occurs in the
sigma set of some maximal subgroup. -/
theorem sigma_mmax_exists
    {p : ℕ} (hpG : p ∈ primeSupport (Nat.card G)) :
    ∃ M : Subgroup G,
      M ∈ minSimple_max_groups (G := G) ∧ p ∈ sigmaPrimes M := by
  letI : Fact p.Prime := ⟨hpG.1⟩
  let P : Sylow p G := Classical.choice Sylow.nonempty
  have hPne : (P : Subgroup G) ≠ ⊥ := P.ne_bot_of_dvd_card hpG.2
  have hPproper : (P : Subgroup G) < ⊤ :=
    mFT_pgroup_proper (P : Subgroup G) P.isPGroup'
  have hNproper : Subgroup.normalizer ((P : Subgroup G) : Set G) < ⊤ :=
    mFT_norm_proper (P : Subgroup G) hPne hPproper
  obtain ⟨M, hM, hNM⟩ :=
    mmax_exists (Subgroup.normalizer ((P : Subgroup G) : Set G)) hNproper
  have hPM : (P : Subgroup G) ≤ M :=
    (Subgroup.le_normalizer : (P : Subgroup G) ≤
      Subgroup.normalizer ((P : Subgroup G) : Set G)).trans hNM
  let PM : Sylow p M := P.subtype hPM
  have hamb : ambientSylow M PM = (P : Subgroup G) := by
    simpa [PM, ambientSylow] using
      Subgroup.map_subgroupOf_eq_of_le hPM
  refine ⟨M, hM, hpG.1, PM, ?_⟩
  rwa [hamb]

/-- Source `ell_sigma0P`. -/
theorem ell_sigma0P (x : G) :
    sigmaLength x = 0 ↔ x = 1 := by
  constructor
  · intro hlen
    by_contra hx
    have horder : orderOf x ≠ 1 := by
      simpa [orderOf_eq_one_iff] using hx
    obtain ⟨p, hp, hpord⟩ := Nat.exists_prime_and_dvd horder
    have hpG : p ∈ primeSupport (Nat.card G) :=
      ⟨hp, hpord.trans (orderOf_dvd_natCard x)⟩
    obtain ⟨M, hM, hpSigma⟩ := sigma_mmax_exists hpG
    have hcompNe : sigmaComponent M x ≠ 1 := by
      intro hcomp
      have hfac := sigmaComponent_mul_complement M x
      rw [hcomp, one_mul] at hfac
      have hcompl := sigmaComplementComponent_isPiNumber M x
      have hpord' : p ∣ orderOf (sigmaComplementComponent M x) := by
        simpa [hfac] using hpord
      exact hcompl hp hpord' hpSigma
    have hmem := mem_sigma_decomposition hM hcompNe
    have : (sigmaDecomposition x).ncard ≠ 0 :=
      Set.ncard_ne_zero_of_mem hmem
    exact this hlen
  · rintro rfl
    rw [sigmaLength]
    apply (Set.ncard_eq_zero (Set.toFinite _)).mpr
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro y hy
    rcases hy with ⟨hy, M, hM, rfl⟩
    have hone : sigmaComponent M (1 : G) = 1 := by
      apply sigmaComponent_eq_self_of_isPiNumber
      simpa using (IsPiNumber.one (pi := sigmaPrimes M))
    exact hy hone

/-- Source `sigma_decomposition_subG`. -/
theorem sigma_decomposition_subG
    {x : G} {H : Subgroup G} (hxH : x ∈ H) :
    sigmaDecomposition x ⊆ H := by
  rintro y ⟨_, M, _, rfl⟩
  have hpow := (primeSetComponent_spec (sigmaPrimes M) x).1
  exact (Subgroup.zpowers_le.mpr hxH) hpow

/-- A list is an enumeration of a set when it is duplicate-free and has
exactly the same members. -/
def EnumeratesSet {α : Type*} (l : List α) (S : Set α) : Prop :=
  l.Nodup ∧ ∀ x, x ∈ l ↔ x ∈ S

/-- Source `prod_sigma_decomposition`.  Since Lean's `Finset.prod` requires
a commutative target, the result supplies an arbitrary duplicate-free list
enumeration; all members are powers of `x`, so its product is independent
of the chosen enumeration. -/
theorem prod_sigma_decomposition (x : G) :
    ∃ l : List G,
      EnumeratesSet l (sigmaDecomposition x) ∧ l.prod = x := by
  classical
  let motive : ℕ → Prop := fun n ↦
    ∀ x : G, sigmaLength x = n →
      ∃ l : List G,
        EnumeratesSet l (sigmaDecomposition x) ∧ l.prod = x
  refine Nat.strong_induction_on (p := motive) (sigmaLength x) ?_ x rfl
  intro n ih x hxn
  by_cases hx : x = 1
  · subst x
    refine ⟨[], ?_, ?_⟩
    · refine ⟨List.nodup_nil, ?_⟩
      intro y
      simp only [List.not_mem_nil, false_iff]
      intro hy
      have hne : (sigmaDecomposition (1 : G)).ncard ≠ 0 :=
        Set.ncard_ne_zero_of_mem hy
      exact hne ((ell_sigma0P (1 : G)).mpr rfl)
    · simp
  have hlenPos : 0 < sigmaLength x :=
    Nat.pos_of_ne_zero fun h0 ↦ hx ((ell_sigma0P x).mp h0)
  have hdecompNonempty : (sigmaDecomposition x).Nonempty :=
    (Set.ncard_pos).mp hlenPos
  obtain ⟨y, hy⟩ := hdecompNonempty
  rcases hy with ⟨hyne, M, hM, hyM⟩
  let x' : G := sigmaComplementComponent M x
  have hdecomp' : sigmaDecomposition x' =
      sigmaDecomposition x \ {y} := by
    simpa [x', hyM] using sigma_decomposition_constt' (x := x) hM
  have hyMem : y ∈ sigmaDecomposition x :=
    ⟨hyne, M, hM, hyM⟩
  have hcard' : sigmaLength x' + 1 = sigmaLength x := by
    rw [sigmaLength, hdecomp', sigmaLength,
      Set.ncard_diff_singleton_of_mem hyMem]
    have hcardPos : 0 < (sigmaDecomposition x).ncard :=
      (Set.ncard_pos).mpr ⟨y, hyMem⟩
    omega
  have hlt : sigmaLength x' < n := by
    rw [← hxn, ← hcard']
    exact Nat.lt_succ_self _
  obtain ⟨l, hl, hprod⟩ := ih (sigmaLength x') hlt x' rfl
  refine ⟨y :: l, ?_, ?_⟩
  · refine ⟨List.nodup_cons.mpr ⟨?_, hl.1⟩, ?_⟩
    · intro hyl
      have hyx' := (hl.2 y).mp hyl
      rw [hdecomp'] at hyx'
      exact hyx'.2 rfl
    · intro z
      rw [List.mem_cons, hl.2, hdecomp']
      constructor
      · rintro (rfl | hz)
        · exact hyMem
        · exact hz.1
      · intro hz
        by_cases hzy : z = y
        · exact Or.inl hzy
        · exact Or.inr ⟨hz, hzy⟩
  · rw [List.prod_cons, hprod, hyM]
    exact sigmaComponent_mul_complement M x

/-- Source `ell1_decomposition`. -/
theorem ell1_decomposition {x : G} (hx : sigmaLength x = 1) :
    sigmaDecomposition x = {x} := by
  classical
  obtain ⟨y, hyset⟩ := Set.ncard_eq_one.mp hx
  obtain ⟨l, hl, hprod⟩ := prod_sigma_decomposition x
  have htoFinset : l.toFinset = {y} := by
    ext z
    simp only [List.mem_toFinset, Finset.mem_singleton]
    rw [hl.2, hyset]
    exact Set.mem_singleton_iff
  have hlen : l.length = 1 := by
    rw [← List.toFinset_card_of_nodup hl.1, htoFinset,
      Finset.card_singleton]
  obtain ⟨z, rfl⟩ := List.length_eq_one_iff.mp hlen
  have hzy : z = y := by
    have hz : z ∈ sigmaDecomposition x :=
      (hl.2 z).mp (by simp)
    simpa [hyset] using hz
  subst z
  simp only [List.prod_cons, List.prod_nil, mul_one] at hprod
  simpa [hprod] using hyset

/-- Source `Msigma_ell1`. -/
theorem Msigma_ell1
    {M : Subgroup G} {x : G}
    (hM : M ∈ minSimple_max_groups (G := G))
    (hxM : x ∈ sigmaCore M) (hx : x ≠ 1) :
    sigmaLength x = 1 := by
  have hxPi := isPiNumber_orderOf_of_mem_sigmaCore M hxM
  have hxComp : sigmaComponent M x = x :=
    sigmaComponent_eq_self_of_isPiNumber M hxPi
  have hxMem : x ∈ sigmaDecomposition x := by
    have hcompNe : sigmaComponent M x ≠ 1 := by
      intro h
      exact hx (hxComp.symm.trans h)
    simpa [hxComp] using mem_sigma_decomposition hM hcompNe
  have hsubset : sigmaDecomposition x ⊆ {x} := by
    rintro y ⟨hy, L, hL, rfl⟩
    by_cases hconj : ∃ z : G,
        L = M.map (MulAut.conj z).toMonoidHom
    · obtain ⟨z, rfl⟩ := hconj
      have hsig := sigmaPrimes_conj M z
      have heq : sigmaComponent
          (M.map (MulAut.conj z).toMonoidHom) x = x := by
        apply sigmaComponent_eq_self_of_isPiNumber
        rw [hsig]
        exact hxPi
      simpa [heq]
    · have hdis : Disjoint (sigmaPrimes M) (sigmaPrimes L) :=
        sigma_partition hM hL (by simpa [eq_comm] using hconj)
      have hxComplL : IsPiNumber (sigmaPrimes L)ᶜ (orderOf x) :=
        isPiNumber_mono_of_disjoint hdis hxPi
      have hone := sigmaComponent_eq_one_of_isPiNumber_compl L hxComplL
      exact (hy hone).elim
  have hset : sigmaDecomposition x = {x} :=
    Set.Subset.antisymm hsubset (by simpa using hxMem)
  rw [sigmaLength, hset, Set.ncard_singleton]

/-- Source `ell_sigma1P`. -/
theorem ell_sigma1P {x : G} :
    sigmaLength x = 1 ↔
      x ≠ 1 ∧
        (sigmaMaximalOvergroups
          (Subgroup.zpowers x : Set G)).Nonempty := by
  constructor
  · intro hxlen
    have hx : x ≠ 1 := by
      intro hx1
      subst x
      have hzero := (ell_sigma0P (1 : G)).mpr rfl
      omega
    have hxMem : x ∈ sigmaDecomposition x := by
      rw [ell1_decomposition hxlen]
      exact Set.mem_singleton x
    rcases hxMem with ⟨_, M, hM, hxComp⟩
    have hxPi : IsPiNumber (sigmaPrimes M) (orderOf x) := by
      rw [hxComp]
      exact sigmaComponent_isPiNumber M x
    have hZpi : IsPiNumber (sigmaPrimes M)
        (Nat.card (Subgroup.zpowers x)) := by
      rw [Nat.card_zpowers]
      exact hxPi
    have hZne : Subgroup.zpowers x ≠ ⊥ :=
      Subgroup.zpowers_ne_bot.mpr hx
    obtain ⟨z, hz⟩ := (sigma_Jsub hM hZpi hZne).1
    let L : Subgroup G := M.map (MulAut.conj z⁻¹).toMonoidHom
    refine ⟨hx, ?_⟩
    refine ⟨L, ?_⟩
    refine ⟨(mmaxJ M (MulAut.conj z⁻¹)).mpr hM, ?_⟩
    intro y hy
    have hymap : (MulAut.conj z) y ∈ sigmaCore M := by
      have hzpow : (MulAut.conj z) y ∈
          (Subgroup.zpowers x).map (MulAut.conj z).toMonoidHom :=
        Subgroup.mem_map_of_mem _ hy
      exact hz hzpow
    dsimp [L]
    have htarget :
        y ∈ (sigmaCore M).map (MulAut.conj z⁻¹).toMonoidHom := by
      have hback := Subgroup.mem_map_of_mem
        (MulAut.conj z⁻¹).toMonoidHom hymap
      simpa [mul_assoc] using hback
    exact (sigmaCore_conj M z⁻¹).symm ▸ htarget
  · rintro ⟨hx, M, hM, hZxM⟩
    apply Msigma_ell1 hM (hZxM (Subgroup.mem_zpowers x)) hx

/-- Source `ell_sigma_le1`. -/
theorem ell_sigma_le1 {x : G} :
    sigmaLength x ≤ 1 ↔
      (sigmaMaximalOvergroups
        (Subgroup.zpowers x : Set G)).Nonempty := by
  constructor
  · intro hxle
    rcases Nat.eq_zero_or_pos (sigmaLength x) with hzero | hpos
    · have hx1 := (ell_sigma0P x).mp hzero
      subst x
      obtain ⟨M, hM⟩ := any_mmax (G := G)
      refine ⟨M, hM, ?_⟩
      simpa using (bot_le : (⊥ : Subgroup G) ≤ sigmaCore M)
    · have hone : sigmaLength x = 1 := Nat.le_antisymm hxle hpos
      exact (ell_sigma1P (x := x)).mp hone |>.2
  · intro hnonempty
    by_cases hx : x = 1
    · rw [(ell_sigma0P x).mpr hx]
      omega
    · exact (ell_sigma1P (x := x)).mpr ⟨hx, hnonempty⟩ |>.le

/-! ## Basic properties of kappa and the maximal-group subclasses -/

private theorem centralizerWithin_map_mulEquiv_all
    (D A : Subgroup G) (e : G ≃* G) :
    (centralizerWithin D A).map e.toMonoidHom =
      centralizerWithin (D.map e.toMonoidHom)
        (A.map e.toMonoidHom) := by
  ext y
  rw [Subgroup.mem_map_equiv]
  constructor
  · intro hy
    refine ⟨Subgroup.mem_map_equiv.mpr hy.1, ?_⟩
    intro a ha
    have ha' : e.symm a ∈ A := Subgroup.mem_map_equiv.mp ha
    simpa using congrArg e (hy.2 (e.symm a) ha')
  · intro hy
    refine ⟨Subgroup.mem_map_equiv.mp hy.1, ?_⟩
    intro a ha
    have hea : e a ∈ A.map e.toMonoidHom := ⟨a, ha, rfl⟩
    simpa using congrArg e.symm (hy.2 (e a) hea)

private theorem kappaPrimes_conj_subset
    (M : Subgroup G) (z : G) :
    kappaPrimes M ⊆
      kappaPrimes (M.map (MulAut.conj z).toMonoidHom) := by
  classical
  let e : G ≃* G := MulAut.conj z
  intro p hp
  rcases hp with ⟨hpTau, P, hP, hcent⟩
  refine ⟨?_, P.map e.toMonoidHom, ?_, ?_⟩
  · rcases hpTau with hpTau1 | hpTau3
    · left
      change p ∈ tau1Primes (M.map (MulAut.conj z).toMonoidHom)
      rw [tau1J]
      exact hpTau1
    · right
      change p ∈ tau3Primes (M.map (MulAut.conj z).toMonoidHom)
      rw [tau3J]
      exact hpTau3
  · refine ⟨Subgroup.map_mono hP.1, ?_⟩
    exact hP.2.map_of_injective e.toMonoidHom e.injective
  · intro hbot
    apply hcent
    apply (Subgroup.map_eq_bot_iff_of_injective
      (f := e.toMonoidHom) (centralizerWithin (sigmaCore M) P)
      e.injective).mp
    rw [centralizerWithin_map_mulEquiv_all, ← sigmaCore_conj, hbot]

/-- Source `kappaJ`: membership in kappa is invariant under conjugation.
The prime is implicit so the result can be used directly with `.mp` and
`.mpr`, matching the other conjugation predicates in Sections 10--13. -/
theorem kappaJ (M : Subgroup G) (z : G) {p : ℕ} :
    p ∈ kappaPrimes (M.map (MulAut.conj z).toMonoidHom) ↔
      p ∈ kappaPrimes M := by
  constructor
  · intro hp
    let e : G ≃* G := MulAut.conj z
    have hback := kappaPrimes_conj_subset
      (M.map (MulAut.conj z).toMonoidHom) z⁻¹ hp
    have heinv : MulAut.conj z⁻¹ = e.symm := by
      ext x
      simp [e, mul_assoc]
    have hmapback :
        (M.map (MulAut.conj z).toMonoidHom).map
            (MulAut.conj z⁻¹).toMonoidHom = M := by
      rw [heinv]
      change (M.map e.toMonoidHom).map e.symm.toMonoidHom = M
      exact (Subgroup.map_symm_eq_iff_map_eq
        (K := M) (H := M.map e.toMonoidHom) (e := e)).mpr rfl
    rwa [hmapback] at hback
  · intro hp
    exact kappaPrimes_conj_subset M z hp

/-- Source `kappa_tau13`. -/
theorem kappa_tau13 {M : Subgroup G} {p : ℕ}
    (hp : p ∈ kappaPrimes M) :
    p ∈ tau1Primes M ∪ tau3Primes M :=
  hp.1

/-- Source `kappa_sigma'`: kappa and sigma are disjoint. -/
theorem kappa_sigma' (M : Subgroup G) :
    kappaPrimes M ⊆ (sigmaPrimes M)ᶜ := by
  intro p hp hpSigma
  rcases kappa_tau13 hp with hpTau1 | hpTau3
  · exact hpTau1.2.1 hpSigma
  · exact hpTau3.2.1 hpSigma

/-- Source `rank_kappa`.  Numerical rank one is represented by rank at
least one together with the absence of a rank-two elementary-abelian
subgroup. -/
theorem rank_kappa {M : Subgroup G} {p : ℕ}
    (hp : p ∈ kappaPrimes M) :
    HasElementaryAbelianRankAtLeast p 1 M ∧
      ¬ HasElementaryAbelianRankAtLeast p 2 M := by
  rcases kappa_tau13 hp with hpTau1 | hpTau3
  · exact ⟨hpTau1.2.2.1, hpTau1.2.2.2.1⟩
  · exact ⟨hpTau3.2.2.1, hpTau3.2.2.2.1⟩

/-- Source `kappa_pi`: a kappa prime divides the order of its maximal
subgroup. -/
theorem kappa_pi {M : Subgroup G} {p : ℕ}
    (hp : p ∈ kappaPrimes M) :
    p ∈ primeSupport (Nat.card M) := by
  have hpPrime : p.Prime := by
    rcases kappa_tau13 hp with hpTau1 | hpTau3
    · exact hpTau1.1
    · exact hpTau3.1
  rcases (rank_kappa hp).1 with ⟨A, hAM, hA⟩
  refine ⟨hpPrime, ?_⟩
  have hpA : p ∣ Nat.card A := by
    rw [hA.card_eq, pow_one]
  exact hpA.trans (Subgroup.card_dvd_of_le hAM)

private theorem rankOneLineIn_map_conj
    {p : ℕ} {M P : Subgroup G} (z : G)
    (hP : RankOneLineIn p M P) :
    RankOneLineIn p
      (M.map (MulAut.conj z).toMonoidHom)
      (P.map (MulAut.conj z).toMonoidHom) := by
  exact ⟨Subgroup.map_mono hP.1,
    hP.2.map_of_injective (MulAut.conj z).toMonoidHom
      (MulAut.conj z).injective⟩

private theorem exists_sylow_containing_rankOneLine
    {p : ℕ} [Fact p.Prime] {M P : Subgroup G}
    (hP : RankOneLineIn p M P) :
    ∃ S : Sylow p M, P ≤ ambientSylow M S := by
  let PM : Subgroup M := P.subgroupOf M
  have hPMp : IsPGroup p PM := hP.2.isPGroup.comap_subtype
  obtain ⟨S, hPMS⟩ := hPMp.exists_le_sylow
  refine ⟨S, ?_⟩
  intro x hx
  let xM : M := ⟨x, hP.1 hx⟩
  have hxPM : xM ∈ PM := hx
  exact ⟨xM, hPMS hxPM, rfl⟩

private theorem ambientSylow_isCyclic_of_no_rankTwo
    {p : ℕ} [Fact p.Prime] {M : Subgroup G}
    (hNoRank : ¬ HasElementaryAbelianRankAtLeast p 2 M)
    (S : Sylow p M) : IsCyclic (ambientSylow M S) := by
  have hNoRankAmbient :
      ¬ ∃ E : Subgroup (ambientSylow M S),
        IsElementaryAbelianOfRank p 2 E := by
    rintro ⟨E, hE⟩
    let EG : Subgroup G := E.map (ambientSylow M S).subtype
    have hEGM : EG ≤ M :=
      (Subgroup.map_subtype_le E).trans
        (Subgroup.map_subtype_le (S : Subgroup M))
    have hEG : IsElementaryAbelianOfRank p 2 EG :=
      hE.map_of_injective (ambientSylow M S).subtype
        (ambientSylow M S).subtype_injective
    exact hNoRank ⟨EG, hEGM, hEG⟩
  exact (odd_pgroup_isCyclic_iff_no_elementaryAbelian_rank_two
    (S.isPGroup'.map M.subtype) (mFT_odd (ambientSylow M S))).mpr
      hNoRankAmbient

private theorem rankOneLine_eq_sylowOmegaOne
    {p : ℕ} [Fact p.Prime] {M P : Subgroup G}
    (S : Sylow p M) (hScyclic : IsCyclic (ambientSylow M S))
    (hP : RankOneLineIn p M P)
    (hPS : P ≤ ambientSylow M S) :
    P = (omegaOne p (ambientSylow M S)).map
      (ambientSylow M S).subtype := by
  let A : Subgroup G :=
    (omegaOne p (ambientSylow M S)).map
      (ambientSylow M S).subtype
  have hPA : P ≤ A := by
    intro x hx
    let xS : ambientSylow M S := ⟨x, hPS hx⟩
    have hxpow : xS ^ p = 1 := by
      apply Subtype.ext
      simpa [xS] using congrArg Subtype.val
        (hP.2.pow_eq_one ⟨x, hx⟩)
    exact ⟨xS, mem_omegaOne_of_pow_eq_one p hxpow, rfl⟩
  have hSnontrivial : Nat.card (ambientSylow M S) ≠ 1 := by
    intro hcard
    have hAcardOne : Nat.card P = 1 := by
      apply Nat.eq_one_of_dvd_one
      rw [← hcard]
      exact Subgroup.card_dvd_of_le hPS
    rw [hP.2.card_eq, pow_one] at hAcardOne
    exact (Fact.out : p.Prime).ne_one hAcardOne
  letI : IsCyclic (ambientSylow M S) := hScyclic
  have hAmbientP : IsPGroup p (ambientSylow M S) :=
    S.isPGroup'.map M.subtype
  have hcardOmega : Nat.card (omegaOne p (ambientSylow M S)) = p :=
    card_omegaOne_of_isCyclic_isPGroup (Fact.out : p.Prime)
      hAmbientP hSnontrivial
  apply Subgroup.eq_of_le_of_card_ge hPA
  rw [hP.2.card_eq, pow_one]
  dsimp [A]
  rw [Subgroup.card_map_of_injective
      (K := omegaOne p (ambientSylow M S))
      (ambientSylow M S).subtype_injective, hcardOmega]

private theorem rankOneLines_conjugate_of_no_rankTwo
    {p : ℕ} [Fact p.Prime] {M P Q : Subgroup G}
    (hNoRank : ¬ HasElementaryAbelianRankAtLeast p 2 M)
    (hP : RankOneLineIn p M P) (hQ : RankOneLineIn p M Q) :
    ∃ m : M,
      P.map (MulAut.conj (m : G)).toMonoidHom = Q := by
  obtain ⟨S, hPS⟩ := exists_sylow_containing_rankOneLine hP
  obtain ⟨T, hQT⟩ := exists_sylow_containing_rankOneLine hQ
  obtain ⟨m, hm⟩ := MulAction.exists_smul_eq M S T
  let e : G ≃* G := MulAut.conj (m : G)
  have hST :
      (ambientSylow M S).map e.toMonoidHom = ambientSylow M T := by
    have hsmul : ((m • S : Sylow p M) : Subgroup M) =
        (T : Subgroup M) :=
      congrArg (fun U : Sylow p M ↦ (U : Subgroup M)) hm
    rw [ambientSylow, ambientSylow, ← hsmul]
    change ((S : Subgroup M).map M.subtype).map e.toMonoidHom =
      ((S : Subgroup M).map (MulAut.conj m).toMonoidHom).map M.subtype
    rw [Subgroup.map_map, Subgroup.map_map]
    congr 1
  have hPmapT : P.map e.toMonoidHom ≤ ambientSylow M T := by
    rw [← hST]
    exact Subgroup.map_mono hPS
  have hPmap : RankOneLineIn p M (P.map e.toMonoidHom) := by
    have hMmap : M.map e.toMonoidHom = M :=
      Subgroup.mem_normalizer_iff_map_conj_eq.mp
        (Subgroup.le_normalizer m.property)
    have htmp := rankOneLineIn_map_conj (z := (m : G)) hP
    change RankOneLineIn p (M.map e.toMonoidHom)
      (P.map e.toMonoidHom) at htmp
    rw [hMmap] at htmp
    exact htmp
  have hTcyclic := ambientSylow_isCyclic_of_no_rankTwo hNoRank T
  have hPomega := rankOneLine_eq_sylowOmegaOne T hTcyclic hPmap hPmapT
  have hQomega := rankOneLine_eq_sylowOmegaOne T hTcyclic hQ hQT
  exact ⟨m, hPomega.trans hQomega.symm⟩

/-- Source `kappa_nonregular`: once one rank-one line witnesses membership
in kappa, every rank-one line of that prime is nonregular. -/
theorem kappa_nonregular
    {M P : Subgroup G} {p : ℕ}
    (hp : p ∈ kappaPrimes M)
    (hP : RankOneLineIn p M P) :
    centralizerWithin (sigmaCore M) P ≠ ⊥ := by
  letI : Fact p.Prime := ⟨(kappa_pi hp).1⟩
  rcases hp with ⟨hpTau, Q, hQ, hQcent⟩
  obtain ⟨m, hm⟩ :=
    rankOneLines_conjugate_of_no_rankTwo
      (rank_kappa ⟨hpTau, Q, hQ, hQcent⟩).2 hP hQ
  let e : G ≃* G := MulAut.conj (m : G)
  have hMmap : M.map e.toMonoidHom = M :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (Subgroup.le_normalizer m.property)
  have hcoreMap : (sigmaCore M).map e.toMonoidHom = sigmaCore M := by
    rw [← sigmaCore_conj, hMmap]
  intro hPbot
  have hmapBot :
      (centralizerWithin (sigmaCore M) P).map e.toMonoidHom = ⊥ := by
    rw [hPbot, Subgroup.map_bot]
  rw [centralizerWithin_map_mulEquiv_all, hcoreMap, hm] at hmapBot
  exact hQcent hmapBot

private theorem hall_of_le_hall_of_hall
    {A B C : Subgroup G} {pi rho : Set ℕ}
    (hAB : A ≤ B) (hBC : B ≤ C)
    (hA : IsHall pi (A.subgroupOf B))
    (hB : IsHall rho (B.subgroupOf C))
    (hpi : pi ⊆ rho) :
    IsHall pi (A.subgroupOf C) := by
  constructor
  · simpa only [Submission.OddOrder.MathlibSupport.natCard_subgroupOf_eq
        (hAB.trans hBC),
      Submission.OddOrder.MathlibSupport.natCard_subgroupOf_eq hAB] using
      hA.isPiNumber_card
  · rw [← Subgroup.relIndex_mul_index
      (show A.subgroupOf C ≤ B.subgroupOf C from fun _ hx ↦ hAB hx)]
    apply IsPiNumber.mul
    · rw [Subgroup.relIndex_subgroupOf (H := A) hBC]
      change IsPiNumber piᶜ (A.subgroupOf B).index
      exact hA.isPiNumber_index
    · exact hB.isPiNumber_index.mono
        (Set.compl_subset_compl.mpr hpi)

/-- Complementary Hall subgroups have complementary cardinal factors. -/
private theorem hall_complement_card_mul_eq
    {K : Type u} [Group K] [Finite K]
    {pi : Set ℕ} {A B : Subgroup K}
    (hA : IsHall pi A) (hB : IsHall piᶜ B) :
    Nat.card B * Nat.card A = Nat.card K := by
  have hcopAB : Nat.Coprime (Nat.card A) (Nat.card B) :=
    hA.isPiNumber_card.coprime_compl hB.isPiNumber_card
  have hBindexPi : IsPiNumber pi B.index := by
    simpa only [compl_compl] using hB.isPiNumber_index
  have hcopIndex : Nat.Coprime B.index A.index :=
    hBindexPi.coprime_compl hA.isPiNumber_index
  have hAcard_dvd_Bindex : Nat.card A ∣ B.index := by
    apply hcopAB.dvd_of_dvd_mul_left
    rw [B.card_mul_index]
    exact A.card_subgroup_dvd_card
  have hBindex_dvd_Acard : B.index ∣ Nat.card A := by
    apply hcopIndex.dvd_of_dvd_mul_right
    rw [A.card_mul_index]
    exact B.index_dvd_card
  have hAcard : Nat.card A = B.index :=
    Nat.dvd_antisymm hAcard_dvd_Bindex hBindex_dvd_Acard
  rw [hAcard, Nat.mul_comm, B.index_mul_card]

/-- Source `ex_kappa_compl`.  Containments are explicit because Lean Hall
subgroups live in subgroup types. -/
theorem ex_kappa_compl
    {M K : Subgroup G}
    (hM : M ∈ minSimple_max_groups (G := G))
    (hKM : K ≤ M)
    (hK : IsHall (kappaPrimes M) (K.subgroupOf M)) :
    ∃ U : Subgroup G, KappaComplement M U K := by
  classical
  have hKsigmaCompl : IsPiNumber (sigmaPrimes M)ᶜ (Nat.card K) := by
    have h := hK.isPiNumber_card.mono (kappa_sigma' M)
    simpa [Submission.OddOrder.MathlibSupport.natCard_subgroupOf_eq hKM]
      using h
  obtain ⟨E, hKE, hEM, hEHall⟩ :=
    Submission.OddOrder.MathlibSupport.exists_ambient_isHall_ge_of_isSolvable
      hKM (mmax_sol hM)
      (sigmaPrimes M)ᶜ hKsigmaCompl
  have hEsol : IsSolvable E := sigma_compl_sol hEM hEHall
  obtain ⟨U, hUE, hUHallE⟩ :=
    Submission.OddOrder.MathlibSupport.exists_ambient_isHall_of_isSolvable hEsol
      (sigmaKappaPrimes M)ᶜ
  have hUM : U ≤ M := hUE.trans hEM
  have hUHallM :
      IsHall (sigmaKappaPrimes M)ᶜ (U.subgroupOf M) := by
    apply hall_of_le_hall_of_hall hUE hEM hUHallE hEHall
    intro p hp hpSigma
    exact hp (Or.inl hpSigma)
  have hKHallE : IsHall (kappaPrimes M) (K.subgroupOf E) := by
    constructor
    · simpa only [Submission.OddOrder.MathlibSupport.natCard_subgroupOf_eq hKE,
        Submission.OddOrder.MathlibSupport.natCard_subgroupOf_eq hKM] using
        hK.isPiNumber_card
    · change IsPiNumber (kappaPrimes M)ᶜ (K.relIndex E)
      apply hK.isPiNumber_index.of_dvd
      exact ⟨E.relIndex M,
        (K.relIndex_mul_relIndex E M hKE hEM).symm⟩
  have hEpi : IsPiNumber (sigmaPrimes M)ᶜ (Nat.card E) := by
    simpa only [
      Submission.OddOrder.MathlibSupport.natCard_subgroupOf_eq hEM] using
      hEHall.isPiNumber_card
  have hKHallSK :
      IsHall (sigmaKappaPrimes M) (K.subgroupOf E) := by
    constructor
    · exact hKHallE.isPiNumber_card.mono fun _ hp ↦ Or.inr hp
    · intro p hpPrime hpIndex hpSK
      change p ∈ sigmaPrimes M ∪ kappaPrimes M at hpSK
      rcases hpSK with hpSigma | hpKappa
      · exact hEpi hpPrime
          (hpIndex.trans (K.subgroupOf E).index_dvd_card) hpSigma
      · exact hKHallE.isPiNumber_index hpPrime hpIndex hpKappa
  have hprod : (E : Set G) = (U : Set G) * (K : Set G) := by
    let UE : Subgroup E := U.subgroupOf E
    let KE : Subgroup E := K.subgroupOf E
    have hcopCard : (Nat.card UE).Coprime (Nat.card KE) := by
      simpa [UE, KE] using
        (hKHallSK.isPiNumber_card.coprime_compl
          hUHallE.isPiNumber_card).symm
    have hdis : Disjoint UE KE :=
      Subgroup.disjoint_of_coprime_natCard hcopCard
    have hcompE : UE.IsComplement' KE :=
      Subgroup.isComplement'_of_card_mul_and_disjoint
        (by simpa [UE, KE] using
          hall_complement_card_mul_eq hKHallSK hUHallE) hdis
    apply Set.Subset.antisymm
    · intro e he
      obtain ⟨⟨u, k⟩, huk⟩ := hcompE.2 ⟨e, he⟩
      refine ⟨(u : E), u.property, (k : E), k.property, ?_⟩
      exact congrArg Subtype.val huk
    · rintro _ ⟨u, hu, k, hk, rfl⟩
      exact E.mul_mem (hUE hu) (hKE hk)
  exact ⟨U,
    { U_le_M := hUM
      hall_U := hUHallM
      K_le_M := hKM
      hall_K := hK
      product_is_group := ⟨E, hprod⟩ }⟩

/-- Source `FtypeP`. -/
theorem FtypeP {M : Subgroup G}
    (hM : M ∈ minSimple_max_groups (G := G)) :
    M ∈ typeFMaximalSubgroups (G := G) ↔
      kappaPrimes M = ∅ := by
  constructor
  · rintro ⟨_, hMcompl⟩
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro p hp
    have hpM := kappa_pi hp
    exact hMcompl hpM.1 hpM.2 hp
  · intro hkappa
    refine ⟨hM, ?_⟩
    intro p hp hpM hpKappa
    rw [hkappa] at hpKappa
    exact hpKappa.elim

/-- Source `PtypeP`. -/
theorem PtypeP {M : Subgroup G}
    (hM : M ∈ minSimple_max_groups (G := G)) :
    M ∈ typePMaximalSubgroups (G := G) ↔
      ∃ p : ℕ, p ∈ kappaPrimes M := by
  rw [typePMaximalSubgroups, Set.mem_diff]
  constructor
  · rintro ⟨_, hnotF⟩
    by_contra hnone
    apply hnotF
    apply (FtypeP hM).mpr
    apply Set.eq_empty_iff_forall_notMem.mpr
    simpa only [not_exists] using hnone
  · rintro ⟨p, hp⟩
    refine ⟨hM, ?_⟩
    intro hF
    have hempty := (FtypeP hM).mp hF
    rw [hempty] at hp
    exact hp.elim

/-- Source `trivg_kappa`. -/
theorem trivg_kappa
    {M K : Subgroup G}
    (hM : M ∈ minSimple_max_groups (G := G))
    (hKM : K ≤ M)
    (hK : IsHall (kappaPrimes M) (K.subgroupOf M)) :
    K = ⊥ ↔ M ∈ typeFMaximalSubgroups (G := G) := by
  constructor
  · intro hKbot
    apply (FtypeP hM).mpr
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro p hp
    have hpKcard : p ∣ Nat.card K := by
      have hpM := kappa_pi hp
      have hpProd : p ∣ Nat.card (K.subgroupOf M) *
          (K.subgroupOf M).index := by
        rw [(K.subgroupOf M).card_mul_index]
        exact hpM.2
      rcases hpM.1.dvd_mul.mp hpProd with hpCard | hpIndex
      · simpa [Submission.OddOrder.MathlibSupport.natCard_subgroupOf_eq hKM]
          using hpCard
      · exact (hK.isPiNumber_index hpM.1 hpIndex hp).elim
    rw [hKbot] at hpKcard
    have hpOne : p = 1 := Nat.eq_one_of_dvd_one (by simpa using hpKcard)
    exact (kappa_pi hp).1.ne_one hpOne
  · intro hF
    have hkappa : kappaPrimes M = ∅ := (FtypeP hM).mp hF
    apply Subgroup.eq_bot_of_card_eq
    have hKpi := hK.isPiNumber_card
    rw [Submission.OddOrder.MathlibSupport.natCard_subgroupOf_eq hKM] at hKpi
    apply Nat.eq_one_iff_not_exists_prime_dvd.mpr
    intro p hp hpd
    have hpEmpty := hKpi hp hpd
    rw [hkappa] at hpEmpty
    exact hpEmpty

/- This elementary observation is used below to exclude the degenerate
case in `trivg_kappa_compl`; it is the Lean form of the short argument
labelled "Could go in Section 10" in the Coq source. -/
/-- Source `not_sigma_mmax`. -/
theorem not_sigma_mmax {M : Subgroup G}
    (hM : M ∈ minSimple_max_groups (G := G)) :
    ¬ IsPiNumber (sigmaPrimes M) (Nat.card M) := by
  intro hMpi
  let S : Subgroup M := (sigmaCore M).subgroupOf M
  have htopPi : IsPiNumber (sigmaPrimes M)
      (Nat.card (⊤ : Subgroup M)) := by
    simpa using hMpi
  have htopS : (⊤ : Subgroup M) ≤ S :=
    normal_isPiNumber_le_isHall (Subgroup.normal_top) htopPi
      (Msigma_Hall hM)
  have hStop : S = ⊤ := top_unique htopS
  have hperfect : _root_.commutator M = ⊤ := by
    apply top_unique
    intro x hx
    have hxCore : (x : G) ∈ sigmaCore M := by
      have hxS : x ∈ S := by rw [hStop]; exact Subgroup.mem_top x
      exact hxS
    have hxDer := Msigma_der1 hM hxCore
    rcases hxDer with ⟨y, hy, hyx⟩
    have hyEq : y = x := by
      apply Subtype.ext
      exact hyx
    simpa [hyEq] using hy
  letI : IsSolvable M := mmax_sol hM
  letI : Nontrivial M :=
    (Subgroup.nontrivial_iff_ne_bot M).mpr (mmax_neq1 hM)
  exact (IsSolvable.commutator_lt_top_of_nontrivial M).ne hperfect

/-- Source `trivg_kappa_compl`. -/
theorem trivg_kappa_compl
    {M U K : Subgroup G}
    (hM : M ∈ minSimple_max_groups (G := G))
    (hCompl : KappaComplement M U K) :
    U = ⊥ ↔ M ∈ typeP1MaximalSubgroups (G := G) := by
  constructor
  · intro hUbot
    have hskM : IsPiNumber (sigmaKappaPrimes M) (Nat.card M) := by
      intro p hp hpM
      by_contra hpNot
      have hpIndex : p ∣ (U.subgroupOf M).index := by
        simpa [hUbot] using hpM
      exact hCompl.hall_U.isPiNumber_index hp hpIndex hpNot
    have hKne : K ≠ ⊥ := by
      intro hKbot
      have hF := (trivg_kappa hM hCompl.K_le_M hCompl.hall_K).mp hKbot
      have hkappa := (FtypeP hM).mp hF
      apply not_sigma_mmax hM
      simpa [sigmaKappaPrimes, hkappa] using hskM
    have hP : M ∈ typePMaximalSubgroups (G := G) := by
      apply (PtypeP hM).mpr
      by_contra hnone
      have hkappa : kappaPrimes M = ∅ :=
        Set.eq_empty_iff_forall_notMem.mpr (by
          simpa only [not_exists] using hnone)
      have hKbot := (trivg_kappa hM hCompl.K_le_M
        hCompl.hall_K).mpr ((FtypeP hM).mpr hkappa)
      exact hKne hKbot
    exact ⟨hP, hskM⟩
  · rintro ⟨hP, hskM⟩
    apply Subgroup.eq_bot_of_card_eq
    have hUpi := hCompl.hall_U.isPiNumber_card
    rw [Submission.OddOrder.MathlibSupport.natCard_subgroupOf_eq
      hCompl.U_le_M] at hUpi
    have hUsk : IsPiNumber (sigmaKappaPrimes M)
        (Nat.card U) :=
      hskM.of_dvd (Subgroup.card_dvd_of_le hCompl.U_le_M)
    simpa using hUsk.coprime_compl hUpi

/-- Source `FtypeJ`. -/
theorem FtypeJ (M : Subgroup G) (z : G) :
    M.map (MulAut.conj z).toMonoidHom ∈
        typeFMaximalSubgroups (G := G) ↔
      M ∈ typeFMaximalSubgroups (G := G) := by
  have hkappa :
      kappaPrimes (M.map (MulAut.conj z).toMonoidHom) = kappaPrimes M :=
    Set.ext fun _ ↦ kappaJ M z
  have hcard : Nat.card (M.map (MulAut.conj z).toMonoidHom) =
      Nat.card M :=
    Subgroup.card_map_of_injective (K := M) (MulAut.conj z).injective
  constructor
  · rintro ⟨hM, hpi⟩
    refine ⟨(mmaxJ M (MulAut.conj z)).mp hM, ?_⟩
    rw [hkappa, hcard] at hpi
    exact hpi
  · rintro ⟨hM, hpi⟩
    refine ⟨(mmaxJ M (MulAut.conj z)).mpr hM, ?_⟩
    rw [hkappa, hcard]
    exact hpi

/-- Source `PtypeJ`. -/
theorem PtypeJ (M : Subgroup G) (z : G) :
    M.map (MulAut.conj z).toMonoidHom ∈
        typePMaximalSubgroups (G := G) ↔
      M ∈ typePMaximalSubgroups (G := G) := by
  simp only [typePMaximalSubgroups, Set.mem_diff,
    mmaxJ M (MulAut.conj z), FtypeJ M z]

private theorem sigmaKappaPrimes_conj (M : Subgroup G) (z : G) :
    sigmaKappaPrimes (M.map (MulAut.conj z).toMonoidHom) =
      sigmaKappaPrimes M := by
  ext p
  simp only [sigmaKappaPrimes, Set.mem_union,
    sigmaPrimes_conj M z, kappaJ M z]

/-- Source `P1typeJ`. -/
theorem P1typeJ (M : Subgroup G) (z : G) :
    M.map (MulAut.conj z).toMonoidHom ∈
        typeP1MaximalSubgroups (G := G) ↔
      M ∈ typeP1MaximalSubgroups (G := G) := by
  have hprimes := sigmaKappaPrimes_conj M z
  have hcard : Nat.card (M.map (MulAut.conj z).toMonoidHom) =
      Nat.card M :=
    Subgroup.card_map_of_injective (K := M) (MulAut.conj z).injective
  constructor
  · rintro ⟨hP, hpi⟩
    refine ⟨(PtypeJ M z).mp hP, ?_⟩
    rw [hprimes, hcard] at hpi
    exact hpi
  · rintro ⟨hP, hpi⟩
    refine ⟨(PtypeJ M z).mpr hP, ?_⟩
    rw [hprimes, hcard]
    exact hpi

/-- Source `P2typeJ`. -/
theorem P2typeJ (M : Subgroup G) (z : G) :
    M.map (MulAut.conj z).toMonoidHom ∈
        typeP2MaximalSubgroups (G := G) ↔
      M ∈ typeP2MaximalSubgroups (G := G) := by
  simp only [typeP2MaximalSubgroups, Set.mem_diff,
    PtypeJ M z, P1typeJ M z]

/-! ## Bender--Glauberman Lemma 14.1 -/

/-- The ambient first omega subgroup of a Sylow subgroup of `M`. -/
def sylowOmegaOne (M : Subgroup G) {p : ℕ} (S : Sylow p M) :
    Subgroup G :=
  (omegaOne p (ambientSylow M S)).map (ambientSylow M S).subtype

/-- Proposition-valued form of the four conclusions of Lemma 14.1. -/
structure SigmaKappaPrimeFacts
    (M : Subgroup G) (p : ℕ) (S : Sylow p M) : Prop where
  maximal_type :
    M ∈ typeFMaximalSubgroups (G := G) ∪
      typeP2MaximalSubgroups (G := G)
  omega_card_bound : Nat.card (sylowOmegaOne M S) ≤ p ^ 2
  sigma_centralizer :
    centralizerWithin (sigmaCore M) (sylowOmegaOne M S) = ⊥
  sigma_nilpotent : Group.IsNilpotent (sigmaCore M)

private theorem prime_not_sigma_mem_tau2_or_tau13
    {M : Subgroup G} {p : ℕ}
    (hM : M ∈ minSimple_max_groups (G := G))
    (hpM : p ∈ primeSupport (Nat.card M))
    (hpSigma : p ∉ sigmaPrimes M) :
    p ∈ tau2Primes M ∨ p ∈ tau13Primes M := by
  letI : Fact p.Prime := ⟨hpM.1⟩
  obtain ⟨x, hxorder⟩ :=
    exists_prime_orderOf_dvd_card' (G := M) p hpM.2
  let X : Subgroup G := (Subgroup.zpowers x).map M.subtype
  have hXcard : Nat.card X = p := by
    dsimp only [X]
    rw [Subgroup.card_map_of_injective M.subtype_injective,
      Nat.card_zpowers, hxorder]
  have hXrank : IsElementaryAbelianOfRank p 1 X :=
    isElementaryAbelianOfRank_one_of_card_eq_prime hXcard
  have hRankOne : HasElementaryAbelianRankAtLeast p 1 M :=
    ⟨X, Subgroup.map_subtype_le _, hXrank⟩
  by_cases hRankTwo : HasElementaryAbelianRankAtLeast p 2 M
  · left
    refine ⟨hpM.1, hpSigma, hRankTwo, ?_⟩
    intro hRankThree
    exact hpSigma (alpha_sub_sigma hM ⟨hpM.1, hRankThree⟩)
  · right
    by_cases hpDer : p ∣ Nat.card (_root_.commutator M)
    · exact Or.inr ⟨hpM.1, hpSigma, hRankOne, hRankTwo, hpDer⟩
    · exact Or.inl ⟨hpM.1, hpSigma, hRankOne, hRankTwo, hpDer⟩

private theorem maximal_type_of_prime_outside_sigmaKappa
    {M : Subgroup G} {p : ℕ}
    (hM : M ∈ minSimple_max_groups (G := G))
    (hpM : p ∈ primeSupport (Nat.card M))
    (hpSigma : p ∉ sigmaPrimes M)
    (hpKappa : p ∉ kappaPrimes M) :
    M ∈ typeFMaximalSubgroups (G := G) ∪
      typeP2MaximalSubgroups (G := G) := by
  by_cases hF : M ∈ typeFMaximalSubgroups (G := G)
  · exact Or.inl hF
  · right
    have hP : M ∈ typePMaximalSubgroups (G := G) := ⟨hM, hF⟩
    refine ⟨hP, ?_⟩
    rintro ⟨_, hsk⟩
    have hpSK := hsk hpM.1 hpM.2
    rcases hpSK with hpS | hpK
    · exact hpSigma hpS
    · exact hpKappa hpK

set_option maxHeartbeats 800000 in
private theorem sigmaCore_nilpotent_of_regular_prime_line
    {M A : Subgroup G} {p : ℕ}
    (hp : p.Prime)
    (hM : M ∈ minSimple_max_groups (G := G))
    (hAM : A ≤ M)
    (hA : IsElementaryAbelianOfRank p 1 A)
    (hcent : centralizerWithin (sigmaCore M) A = ⊥) :
    Group.IsNilpotent (sigmaCore M) := by
  let L : Subgroup G := sigmaCore M ⊔ A
  have hLM : L ≤ M := sup_le (sigmaCore_le M) hAM
  let K : Subgroup L := (sigmaCore M).subgroupOf L
  let R : Subgroup L := A.subgroupOf L
  have hKnormal : K.Normal := by
    apply (Subgroup.normal_subgroupOf_iff_le_normalizer
      (show sigmaCore M ≤ L from le_sup_left)).mpr
    exact hLM.trans ((Subgroup.normal_subgroupOf_iff_le_normalizer
      (sigmaCore_le M)).mp (sigmaCore_normal M))
  letI : K.Normal := hKnormal
  have hdisAmbient : Disjoint (sigmaCore M) A := by
    rw [disjoint_iff]
    apply le_antisymm
    · intro x hx
      have hxcent : x ∈ centralizerWithin (sigmaCore M) A := by
        refine ⟨hx.1, ?_⟩
        intro a ha
        let xA : A := ⟨x, hx.2⟩
        let aA : A := ⟨a, ha⟩
        letI : IsMulCommutative A := hA.commutative
        exact congrArg Subtype.val (mul_comm aA xA)
      rw [hcent] at hxcent
      exact hxcent
    · exact bot_le
  have hdis : Disjoint K R := by
    rw [disjoint_iff]
    apply le_antisymm
    · intro x hx
      have hxAmbient : (x : G) ∈ sigmaCore M ⊓ A := hx
      have hxBot : (x : G) ∈ (⊥ : Subgroup G) := by
        rw [← disjoint_iff.mp hdisAmbient]
        exact hxAmbient
      simpa using hxBot
    · exact bot_le
  have hsup : K ⊔ R = ⊤ := by
    rw [← Subgroup.subgroupOf_sup (show sigmaCore M ≤ L from le_sup_left)
      (show A ≤ L from le_sup_right)]
    exact Subgroup.subgroupOf_self L
  have hcomp : K.IsComplement' R := by
    apply Subgroup.isComplement'_of_disjoint_and_mul_eq_univ hdis
    rw [← Subgroup.normal_mul K R, hsup]
    rfl
  have hRcard : Nat.card R = p := by
    rw [Submission.OddOrder.MathlibSupport.natCard_subgroupOf_eq
        (show A ≤ L from le_sup_right),
      hA.card_eq, pow_one]
  have hcentSub : centralizerWithin K R = ⊥ := by
    apply Subgroup.map_injective L.subtype_injective
    rw [Subgroup.map_bot]
    have hmap : (centralizerWithin K R).map L.subtype =
        centralizerWithin (sigmaCore M) A := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        refine ⟨hy.1, ?_⟩
        intro a ha
        let aL : L := ⟨a, (show A ≤ L from le_sup_right) ha⟩
        exact congrArg Subtype.val (hy.2 aL ha)
      · intro hx
        let xL : L := ⟨x, (show sigmaCore M ≤ L from le_sup_left) hx.1⟩
        refine ⟨xL, ⟨hx.1, ?_⟩, rfl⟩
        intro a ha
        apply Subtype.ext
        exact hx.2 a ha
    rw [hmap, hcent]
  have hLsol : IsSolvable L :=
    mFT_sol (lt_of_le_of_lt hLM (mmax_proper hM))
  have hKnil : Group.IsNilpotent K :=
    prime_Frobenius_sol_kernel_nil hcomp hKnormal hLsol
      (by simpa [hRcard] using hp) hcentSub
  exact Group.nilpotent_of_mulEquiv
    (Subgroup.subgroupOfEquivOfLe
      (show sigmaCore M ≤ L from le_sup_left))

/-- Source `sigma'_kappa'_facts`, Bender--Glauberman Lemma 14.1. -/
theorem sigma'_kappa'_facts
    {M : Subgroup G} {p : ℕ} (S : Sylow p M)
    (hM : M ∈ minSimple_max_groups (G := G))
    (hpM : p ∈ primeSupport (Nat.card M))
    (hpSigma : p ∉ sigmaPrimes M)
    (hpKappa : p ∉ kappaPrimes M) :
    SigmaKappaPrimeFacts M p S := by
  classical
  letI : Fact p.Prime := ⟨hpM.1⟩
  have hmaxType :=
    maximal_type_of_prime_outside_sigmaKappa hM hpM hpSigma hpKappa
  rcases prime_not_sigma_mem_tau2_or_tau13 hM hpM hpSigma with
    hpTau2 | hpTau13
  · rcases hpTau2.2.2.1 with ⟨A, hAM, hA⟩
    obtain ⟨m, hm⟩ :=
      exists_conjugate_le_sylow_map S hAM hA.isPGroup
    let A' : Subgroup G := A.map (MulAut.conj (m : G)).toMonoidHom
    have hA'S : A' ≤ ambientSylow M S := by
      rintro _ ⟨a, ha, rfl⟩
      exact hm a ha
    have hA'M : A' ≤ M :=
      hA'S.trans (Subgroup.map_subtype_le (S : Subgroup M))
    have hA' : IsElementaryAbelianOfRank p 2 A' :=
      hA.map_of_injective (MulAut.conj (m : G)).toMonoidHom
        (MulAut.conj (m : G)).injective
    have hctx := tau2_context hM hpTau2 hA'M hA'
    have hOmega : sylowOmegaOne M S = A' := by
      exact hctx.omegaOne_eq S hA'S
    refine
      { maximal_type := hmaxType
        omega_card_bound := ?_
        sigma_centralizer := ?_
        sigma_nilpotent := tau2_Msigma_nil hM hpTau2 }
    · rw [hOmega, hA'.card_eq]
    · rw [hOmega]
      exact hctx.centralizerWithin_eq_bot
  · have hRank : HasElementaryAbelianRankAtLeast p 1 M ∧
        ¬ HasElementaryAbelianRankAtLeast p 2 M := by
      rcases hpTau13 with hpTau1 | hpTau3
      · exact ⟨hpTau1.2.2.1, hpTau1.2.2.2.1⟩
      · exact ⟨hpTau3.2.2.1, hpTau3.2.2.2.1⟩
    have hScyclic := ambientSylow_isCyclic_of_no_rankTwo hRank.2 S
    letI : IsCyclic (ambientSylow M S) := hScyclic
    have hAmbientP : IsPGroup p (ambientSylow M S) :=
      S.isPGroup'.map M.subtype
    have hSambientNe : Nat.card (ambientSylow M S) ≠ 1 := by
      have hSne : (S : Subgroup M) ≠ ⊥ := S.ne_bot_of_dvd_card hpM.2
      have hambNe : ambientSylow M S ≠ ⊥ := by
        intro hbot
        apply hSne
        apply Subgroup.map_injective M.subtype_injective
        simpa [ambientSylow] using hbot
      exact ((ambientSylow M S).one_lt_card_iff_ne_bot.mpr hambNe).ne'
    have hOmegaIntrinsic :
        Nat.card (omegaOne p (ambientSylow M S)) = p :=
      card_omegaOne_of_isCyclic_isPGroup hpM.1 hAmbientP hSambientNe
    have hOmegaCard : Nat.card (sylowOmegaOne M S) = p := by
      rw [sylowOmegaOne,
        Subgroup.card_map_of_injective
          (K := omegaOne p (ambientSylow M S))
          (ambientSylow M S).subtype_injective,
        hOmegaIntrinsic]
    have hOmegaM : sylowOmegaOne M S ≤ M :=
      (Subgroup.map_subtype_le _).trans
        (Subgroup.map_subtype_le (S : Subgroup M))
    have hOmegaRank :
        IsElementaryAbelianOfRank p 1 (sylowOmegaOne M S) :=
      isElementaryAbelianOfRank_one_of_card_eq_prime hOmegaCard
    have hcent :
        centralizerWithin (sigmaCore M) (sylowOmegaOne M S) = ⊥ := by
      by_contra hne
      exact hpKappa ⟨hpTau13, sylowOmegaOne M S,
        ⟨hOmegaM, hOmegaRank⟩, hne⟩
    refine
      { maximal_type := hmaxType
        omega_card_bound := ?_
        sigma_centralizer := hcent
        sigma_nilpotent :=
          sigmaCore_nilpotent_of_regular_prime_line
            hpM.1 hM hOmegaM hOmegaRank hcent }
    rw [hOmegaCard]
    simpa [pow_two] using Nat.le_mul_self p

/-- Source `notP1type_Msigma_nil`: sigma cores are nilpotent for maximal
subgroups of type F or type P2. -/
theorem notP1type_Msigma_nil {M : Subgroup G}
    (hMtype :
      M ∈ typeFMaximalSubgroups (G := G) ∪
        typeP2MaximalSubgroups (G := G)) :
    Group.IsNilpotent (sigmaCore M) := by
  classical
  have hM : M ∈ minSimple_max_groups (G := G) := by
    rcases hMtype with hF | hP2
    · exact hF.1
    · exact hP2.1.1
  have hnotSK :
      ¬ IsPiNumber (sigmaKappaPrimes M) (Nat.card M) := by
    intro hsk
    rcases hMtype with hF | hP2
    · apply not_sigma_mmax hM
      intro p hp hpM
      rcases hsk hp hpM with hpSigma | hpKappa
      · exact hpSigma
      · exact (hF.2 hp hpM hpKappa).elim
    · exact hP2.2 ⟨hP2.1, hsk⟩
  simp only [IsPiNumber] at hnotSK
  push_neg at hnotSK
  obtain ⟨p, hp, hpMcard, hpNotSK⟩ := hnotSK
  letI : Fact p.Prime := ⟨hp⟩
  let S : Sylow p M := Classical.choice Sylow.nonempty
  have hpSigma : p ∉ sigmaPrimes M := fun h ↦ hpNotSK (Or.inl h)
  have hpKappa : p ∉ kappaPrimes M := fun h ↦ hpNotSK (Or.inr h)
  exact (sigma'_kappa'_facts S hM ⟨hp, hpMcard⟩
    hpSigma hpKappa).sigma_nilpotent

end

