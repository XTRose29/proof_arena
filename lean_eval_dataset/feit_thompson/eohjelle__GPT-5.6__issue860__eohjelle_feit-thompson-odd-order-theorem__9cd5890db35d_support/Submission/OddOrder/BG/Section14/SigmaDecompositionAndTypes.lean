/-! ## Prime-set components of finite-order elements -/

/-- A candidate for the `pi`-component of `x`.  Membership in `zpowers x`
records that the factor is intrinsic to the cyclic group generated by `x`;
the other two fields split the prime support of its order. -/
def IsPrimeSetComponent
    {G : Type u} [Group G] (pi : Set ℕ) (x y : G) : Prop :=
  y ∈ Subgroup.zpowers x ∧
    IsPiNumber pi (orderOf y) ∧
    IsPiNumber piᶜ (orderOf (y⁻¹ * x))

private theorem isPiNumber_orderOf_subgroup_element
    {G : Type u} [Group G] [Finite G]
    {pi : Set ℕ} {H : Subgroup G} (hH : IsPiNumber pi (Nat.card H))
    (x : H) : IsPiNumber pi (orderOf (x : G)) := by
  intro p hp hpx
  apply hH hp
  exact hpx.trans (H.orderOf_dvd_natCard x.property)

/-- Every element of a finite group has a `pi`-component.  The proof takes
the two complementary Hall factors of its cyclic subgroup. -/
private theorem exists_primeSetComponent
    {G : Type u} [Group G] [Finite G]
    (pi : Set ℕ) (x : G) :
    ∃ y : G, IsPrimeSetComponent pi x y := by
  classical
  let C : Subgroup G := Subgroup.zpowers x
  letI : CommGroup C := IsCyclic.commGroup
  have hCsol : IsSolvable C :=
    _root_.isSolvable_of_comm fun a b : C ↦ mul_comm a b
  obtain ⟨H, hHHall⟩ :=
    Submission.OddOrder.MathlibSupport.exists_isHall_of_isSolvable hCsol pi
  letI : H.Normal := by infer_instance
  obtain ⟨K, hcomp⟩ := hHHall.exists_right_complement
  let xC : C := ⟨x, Subgroup.mem_zpowers x⟩
  obtain ⟨⟨h, k⟩, hhk⟩ := hcomp.2 xC
  let y : G := ((h : H) : C)
  refine ⟨y, ?_, ?_, ?_⟩
  · exact (h : C).property
  · have hh := isPiNumber_orderOf_subgroup_element
        hHHall.isPiNumber_card h
    simpa [y, orderOf_injective C.subtype C.subtype_injective] using hh
  · have hKpi : IsPiNumber piᶜ (Nat.card K) := by
      rw [← hcomp.symm.index_eq_card]
      exact hHHall.isPiNumber_index
    have hkpi : IsPiNumber piᶜ (orderOf (((k : K) : C) : G)) :=
      by
        have hk := isPiNumber_orderOf_subgroup_element hKpi k
        simpa [orderOf_injective C.subtype C.subtype_injective] using hk
    have hyx : y⁻¹ * x = (((k : K) : C) : G) := by
      apply congrArg Subtype.val at hhk
      change y * (((k : K) : C) : G) = x at hhk
      calc
        y⁻¹ * x = y⁻¹ * (y * (((k : K) : C) : G)) := by rw [hhk]
        _ = (((k : K) : C) : G) := by simp
    simpa [hyx] using hkpi

private theorem isPiNumber_orderOf_inv
    {G : Type u} [Group G] {pi : Set ℕ} {x : G}
    (hx : IsPiNumber pi (orderOf x)) :
    IsPiNumber pi (orderOf x⁻¹) := by
  simpa using hx

private theorem isPiNumber_orderOf_mul_of_commute
    {G : Type u} [Group G] {pi : Set ℕ} {x y : G}
    (hxy : Commute x y)
    (hx : IsPiNumber pi (orderOf x))
    (hy : IsPiNumber pi (orderOf y)) :
    IsPiNumber pi (orderOf (x * y)) := by
  apply (hx.mul hy).of_dvd
  exact hxy.orderOf_mul_dvd_mul_orderOf

/-- The prime-set component is unique inside the cyclic subgroup generated
by the element. -/
private theorem primeSetComponent_unique
    {G : Type u} [Group G] [Finite G]
    {pi : Set ℕ} {x y z : G}
    (hy : IsPrimeSetComponent pi x y)
    (hz : IsPrimeSetComponent pi x z) : y = z := by
  have hcomm : ∀ a ∈ Subgroup.zpowers x,
      ∀ b ∈ Subgroup.zpowers x, Commute a b := by
    rintro a ⟨m, rfl⟩ b ⟨n, rfl⟩
    exact Commute.zpow_zpow (Commute.refl x) m n
  let d : G := y⁻¹ * z
  have hdPi : IsPiNumber pi (orderOf d) := by
    apply isPiNumber_orderOf_mul_of_commute
    · exact (hcomm y hy.1 z hz.1).inv_left
    · exact isPiNumber_orderOf_inv hy.2.1
    · exact hz.2.1
  have hdEq : d = (y⁻¹ * x) * (z⁻¹ * x)⁻¹ := by
    have hyz := hcomm y hy.1 z hz.1
    have hyx := hcomm y hy.1 x (Subgroup.mem_zpowers x)
    dsimp [d]
    rw [mul_inv_rev]
    simp only [inv_inv]
    calc
      y⁻¹ * z = y⁻¹ * (x * x⁻¹) * z := by simp [mul_assoc]
      _ = (y⁻¹ * x) * (x⁻¹ * z) := by simp [mul_assoc]
  have hdCompl : IsPiNumber piᶜ (orderOf d) := by
    rw [hdEq]
    apply isPiNumber_orderOf_mul_of_commute
    · have hleft : y⁻¹ * x ∈ Subgroup.zpowers x :=
        (Subgroup.zpowers x).mul_mem
          ((Subgroup.zpowers x).inv_mem hy.1)
          (Subgroup.mem_zpowers x)
      have hright : (z⁻¹ * x)⁻¹ ∈ Subgroup.zpowers x :=
        (Subgroup.zpowers x).inv_mem
          ((Subgroup.zpowers x).mul_mem
            ((Subgroup.zpowers x).inv_mem hz.1)
            (Subgroup.mem_zpowers x))
      exact hcomm _ hleft _ hright
    · exact hy.2.2
    · exact isPiNumber_orderOf_inv hz.2.2
  have hcop : (orderOf d).Coprime (orderOf d) :=
    hdPi.coprime_compl hdCompl
  have hdOrder : orderOf d = 1 := by simpa using hcop
  have hdOne : d = 1 := orderOf_eq_one_iff.mp hdOrder
  dsimp [d] at hdOne
  exact inv_mul_eq_one.mp hdOne

/-- The canonical `pi`-component of a finite-order element. -/
noncomputable def primeSetComponent
    {G : Type u} [Group G] [Finite G]
    (pi : Set ℕ) (x : G) : G :=
  Classical.choose (exists_primeSetComponent pi x)

theorem primeSetComponent_spec
    {G : Type u} [Group G] [Finite G]
    (pi : Set ℕ) (x : G) :
    IsPrimeSetComponent pi x (primeSetComponent pi x) :=
  Classical.choose_spec (exists_primeSetComponent pi x)

/-- A commuting `pi`/`pi'` factorization identifies the canonical
`pi`-component.  Unlike `primeSetComponent_unique`, the proposed factor
need not be supplied as a power of `x`: that follows implicitly from the
coprime commuting factorization.  This is the form needed to transport the
source `consttM` rule to commuting ambient elements. -/
private theorem primeSetComponent_eq_of_commuting_decomposition
    {G : Type u} [Group G] [Finite G]
    {pi : Set ℕ} {x y c : G}
    (hyc : Commute y c) (hfac : y * c = x)
    (hy : IsPiNumber pi (orderOf y))
    (hc : IsPiNumber piᶜ (orderOf c)) :
    primeSetComponent pi x = y := by
  let z : G := primeSetComponent pi x
  have hz := primeSetComponent_spec pi x
  have hyx : Commute y x := by
    rw [← hfac]
    exact (Commute.refl y).mul_right hyc
  have hzy : Commute z y := by
    change Commute (primeSetComponent pi x) y
    rcases hz.1 with ⟨n, hn⟩
    rw [← hn]
    exact hyx.symm.zpow_left n
  let d : G := z⁻¹ * y
  have hdPi : IsPiNumber pi (orderOf d) := by
    apply isPiNumber_orderOf_mul_of_commute hzy.inv_left
    · exact isPiNumber_orderOf_inv hz.2.1
    · exact hy
  have hzcMem : z⁻¹ * x ∈ Subgroup.zpowers x :=
    (Subgroup.zpowers x).mul_mem
      ((Subgroup.zpowers x).inv_mem hz.1)
      (Subgroup.mem_zpowers x)
  have hcx : Commute c x := by
    rw [← hfac]
    exact hyc.symm.mul_right (Commute.refl c)
  have hzcComm : Commute (z⁻¹ * x) c⁻¹ := by
    rcases hzcMem with ⟨n, hn⟩
    rw [← hn]
    exact hcx.symm.inv_right.zpow_left n
  have hdEq : d = (z⁻¹ * x) * c⁻¹ := by
    dsimp [d]
    rw [← hfac]
    simp [mul_assoc]
  have hdCompl : IsPiNumber piᶜ (orderOf d) := by
    rw [hdEq]
    apply isPiNumber_orderOf_mul_of_commute hzcComm
    · exact hz.2.2
    · exact isPiNumber_orderOf_inv hc
  have hcop : (orderOf d).Coprime (orderOf d) :=
    hdPi.coprime_compl hdCompl
  have hdOrder : orderOf d = 1 := by simpa using hcop
  have hdOne : d = 1 :=
    orderOf_eq_one_iff.mp hdOrder
  change z = y
  dsimp [d] at hdOne
  exact inv_mul_eq_one.mp hdOne

/-- The complementary factor to `primeSetComponent`. -/
def primeSetComplementComponent
    {G : Type u} [Group G] [Finite G]
    (pi : Set ℕ) (x : G) : G :=
  (primeSetComponent pi x)⁻¹ * x

theorem primeSetComponent_mul_complement
    {G : Type u} [Group G] [Finite G]
    (pi : Set ℕ) (x : G) :
    primeSetComponent pi x * primeSetComplementComponent pi x = x := by
  simp [primeSetComplementComponent]

theorem primeSetComponent_commute_complement
    {G : Type u} [Group G] [Finite G]
    (pi : Set ℕ) (x : G) :
    Commute (primeSetComponent pi x)
      (primeSetComplementComponent pi x) := by
  have hx := (primeSetComponent_spec pi x).1
  have hcomm : Commute (primeSetComponent pi x) x := by
    rcases hx with ⟨n, hn⟩
    rw [← hn]
    exact Commute.zpow_left (Commute.refl x) n
  simpa [primeSetComplementComponent] using
    (Commute.refl (primeSetComponent pi x)).inv_right.mul_right hcomm

theorem primeSetComponent_isPiNumber
    {G : Type u} [Group G] [Finite G]
    (pi : Set ℕ) (x : G) :
    IsPiNumber pi (orderOf (primeSetComponent pi x)) :=
  (primeSetComponent_spec pi x).2.1

theorem primeSetComplementComponent_isPiNumber
    {G : Type u} [Group G] [Finite G]
    (pi : Set ℕ) (x : G) :
    IsPiNumber piᶜ (orderOf (primeSetComplementComponent pi x)) :=
  (primeSetComponent_spec pi x).2.2

theorem primeSetComponent_eq_self_of_isPiNumber
    {G : Type u} [Group G] [Finite G]
    {pi : Set ℕ} {x : G}
    (hx : IsPiNumber pi (orderOf x)) :
    primeSetComponent pi x = x := by
  apply primeSetComponent_unique (primeSetComponent_spec pi x)
  refine ⟨Subgroup.mem_zpowers x, hx, ?_⟩
  simpa using (IsPiNumber.one (pi := piᶜ))

theorem primeSetComponent_eq_one_of_isPiNumber_compl
    {G : Type u} [Group G] [Finite G]
    {pi : Set ℕ} {x : G}
    (hx : IsPiNumber piᶜ (orderOf x)) :
    primeSetComponent pi x = 1 := by
  apply primeSetComponent_unique (primeSetComponent_spec pi x)
  refine ⟨Subgroup.one_mem _, ?_, ?_⟩
  · simpa using (IsPiNumber.one (pi := pi))
  · simpa using hx

theorem primeSetComponent_conj
    {G : Type u} [Group G] [Finite G]
    (pi : Set ℕ) (x z : G) :
    primeSetComponent pi ((MulAut.conj z) x) =
      (MulAut.conj z) (primeSetComponent pi x) := by
  apply primeSetComponent_unique
    (primeSetComponent_spec pi ((MulAut.conj z) x))
  have hs := primeSetComponent_spec pi x
  refine ⟨?_, ?_, ?_⟩
  · rcases hs.1 with ⟨n, hn⟩
    exact ⟨n, by simpa using congrArg (MulAut.conj z) hn⟩
  · rw [show orderOf ((MulAut.conj z) (primeSetComponent pi x)) =
      orderOf (primeSetComponent pi x) from
        orderOf_injective (MulAut.conj z).toMonoidHom
          (MulAut.conj z).injective _]
    exact hs.2.1
  · have hmap : ((MulAut.conj z) (primeSetComponent pi x))⁻¹ *
        (MulAut.conj z) x =
        (MulAut.conj z) ((primeSetComponent pi x)⁻¹ * x) := by
      simp only [map_mul, map_inv]
    rw [hmap]
    rw [show orderOf ((MulAut.conj z)
        ((primeSetComponent pi x)⁻¹ * x)) =
      orderOf ((primeSetComponent pi x)⁻¹ * x) from
        orderOf_injective (MulAut.conj z).toMonoidHom
          (MulAut.conj z).injective _]
    exact hs.2.2

theorem primeSetComponent_mul_of_commute
    {G : Type u} [Group G] [Finite G]
    {pi : Set ℕ} {a b : G} (hab : Commute a b) :
    primeSetComponent pi (a * b) =
      primeSetComponent pi a * primeSetComponent pi b := by
  let aPi := primeSetComponent pi a
  let aC := primeSetComplementComponent pi a
  let bPi := primeSetComponent pi b
  let bC := primeSetComplementComponent pi b
  have hfacA := primeSetComponent_mul_complement pi a
  have hfacB := primeSetComponent_mul_complement pi b
  have hallComm : ∀ u ∈ Subgroup.zpowers a,
      ∀ v ∈ Subgroup.zpowers b, Commute u v := by
    rintro u ⟨m, rfl⟩ v ⟨n, rfl⟩
    exact hab.zpow_zpow m n
  have haPiMem : aPi ∈ Subgroup.zpowers a :=
    (primeSetComponent_spec pi a).1
  have hbPiMem : bPi ∈ Subgroup.zpowers b :=
    (primeSetComponent_spec pi b).1
  have haCMem : aC ∈ Subgroup.zpowers a :=
    (Subgroup.zpowers a).mul_mem
      ((Subgroup.zpowers a).inv_mem haPiMem)
      (Subgroup.mem_zpowers a)
  have hbCMem : bC ∈ Subgroup.zpowers b :=
    (Subgroup.zpowers b).mul_mem
      ((Subgroup.zpowers b).inv_mem hbPiMem)
      (Subgroup.mem_zpowers b)
  have haPi_bC : Commute aPi bC :=
    hallComm _ haPiMem _ hbCMem
  have hbPi_aC : Commute bPi aC :=
    (hallComm _ haCMem _ hbPiMem).symm
  have hcandidateComm : Commute (aPi * bPi) (aC * bC) := by
    apply Commute.mul_left
    · exact (primeSetComponent_commute_complement pi a).mul_right
        haPi_bC
    · exact hbPi_aC.mul_right
        (primeSetComponent_commute_complement pi b)
  have hcandidateFac : (aPi * bPi) * (aC * bC) = a * b := by
    calc
      (aPi * bPi) * (aC * bC) =
          (aPi * aC) * (bPi * bC) :=
        hbPi_aC.mul_mul_mul_comm aPi bC
      _ = a * b := by rw [hfacA, hfacB]
  have hcandidatePi : IsPiNumber pi (orderOf (aPi * bPi)) := by
    apply isPiNumber_orderOf_mul_of_commute
        (hallComm _ haPiMem _ hbPiMem)
    · exact primeSetComponent_isPiNumber pi a
    · exact primeSetComponent_isPiNumber pi b
  have hcandidateCompl : IsPiNumber piᶜ (orderOf (aC * bC)) := by
    apply isPiNumber_orderOf_mul_of_commute
        (hallComm _ haCMem _ hbCMem)
    · exact primeSetComplementComponent_isPiNumber pi a
    · exact primeSetComplementComponent_isPiNumber pi b
  exact primeSetComponent_eq_of_commuting_decomposition
    hcandidateComm hcandidateFac hcandidatePi hcandidateCompl

/-! ## The sigma decomposition and signalizers -/

variable {G : Type u} [Group G] [Finite G] [IsMinSimpleOddGroup G]

/-- The `sigma(M)`-component of `x`. -/
def sigmaComponent (M : Subgroup G) (x : G) : G :=
  primeSetComponent (sigmaPrimes M) x

/-- The complementary `sigma(M)'`-component of `x`. -/
def sigmaComplementComponent (M : Subgroup G) (x : G) : G :=
  primeSetComplementComponent (sigmaPrimes M) x

theorem sigmaComponent_mul_complement (M : Subgroup G) (x : G) :
    sigmaComponent M x * sigmaComplementComponent M x = x :=
  primeSetComponent_mul_complement (sigmaPrimes M) x

theorem sigmaComponent_commute_complement (M : Subgroup G) (x : G) :
    Commute (sigmaComponent M x) (sigmaComplementComponent M x) :=
  primeSetComponent_commute_complement (sigmaPrimes M) x

theorem sigmaComponent_isPiNumber (M : Subgroup G) (x : G) :
    IsPiNumber (sigmaPrimes M) (orderOf (sigmaComponent M x)) :=
  primeSetComponent_isPiNumber (sigmaPrimes M) x

theorem sigmaComplementComponent_isPiNumber (M : Subgroup G) (x : G) :
    IsPiNumber (sigmaPrimes M)ᶜ
      (orderOf (sigmaComplementComponent M x)) :=
  primeSetComplementComponent_isPiNumber (sigmaPrimes M) x

theorem sigmaComponent_eq_self_of_isPiNumber
    (M : Subgroup G) {x : G}
    (hx : IsPiNumber (sigmaPrimes M) (orderOf x)) :
    sigmaComponent M x = x :=
  primeSetComponent_eq_self_of_isPiNumber hx

theorem sigmaComponent_eq_one_of_isPiNumber_compl
    (M : Subgroup G) {x : G}
    (hx : IsPiNumber (sigmaPrimes M)ᶜ (orderOf x)) :
    sigmaComponent M x = 1 :=
  primeSetComponent_eq_one_of_isPiNumber_compl hx

theorem sigmaComponent_conj (M : Subgroup G) (x z : G) :
    sigmaComponent (M.map (MulAut.conj z).toMonoidHom)
        ((MulAut.conj z) x) =
      (MulAut.conj z) (sigmaComponent M x) := by
  rw [sigmaComponent, sigmaPrimes_conj, sigmaComponent]
  exact primeSetComponent_conj (sigmaPrimes M) x z

theorem sigmaComponent_mul_of_commute
    (M : Subgroup G) {a b : G} (hab : Commute a b) :
    sigmaComponent M (a * b) =
      sigmaComponent M a * sigmaComponent M b :=
  primeSetComponent_mul_of_commute hab

theorem sigmaComponent_mul_eq_right_of_compl_left_of_sigma_right
    (M : Subgroup G) {a b : G} (hab : Commute a b)
    (ha : IsPiNumber (sigmaPrimes M)ᶜ (orderOf a))
    (hb : IsPiNumber (sigmaPrimes M) (orderOf b)) :
    sigmaComponent M (a * b) = b := by
  rw [sigmaComponent_mul_of_commute M hab,
    sigmaComponent_eq_one_of_isPiNumber_compl M ha,
    sigmaComponent_eq_self_of_isPiNumber M hb, one_mul]

theorem sigmaComplementComponent_mul_eq_left_of_compl_left_of_sigma_right
    (M : Subgroup G) {a b : G} (hab : Commute a b)
    (ha : IsPiNumber (sigmaPrimes M)ᶜ (orderOf a))
    (hb : IsPiNumber (sigmaPrimes M) (orderOf b)) :
    sigmaComplementComponent M (a * b) = a := by
  change (sigmaComponent M (a * b))⁻¹ * (a * b) = a
  rw [sigmaComponent_mul_eq_right_of_compl_left_of_sigma_right M hab ha hb]
  simpa [hab.eq, mul_assoc]

/-- The nonidentity sigma-components of `x`, as the maximal subgroup varies. -/
def sigmaDecomposition (x : G) : Set G :=
  {y | y ≠ 1 ∧
    ∃ M : Subgroup G,
      M ∈ minSimple_max_groups (G := G) ∧ y = sigmaComponent M x}

/-- The number of distinct nonidentity sigma-components of `x`. -/
def sigmaLength (x : G) : ℕ := (sigmaDecomposition x).ncard

/-- Maximal subgroups whose sigma core contains `X`. -/
def sigmaMaximalOvergroups (X : Set G) : Set (Subgroup G) :=
  {M | M ∈ minSimple_max_groups (G := G) ∧ X ⊆ sigmaCore M}

private noncomputable def chooseSubgroupOrBot
    (S : Set (Subgroup G)) : Subgroup G :=
  by
    classical
    exact if hS : S.Nonempty then Classical.choose hS else ⊥

/-- The maximal subgroup selected from the centralizer of `x` when more
than one sigma-maximal subgroup contains `zpowers x`; otherwise `bot`. -/
noncomputable def ftSignalizerBase (x : G) : Subgroup G :=
  if 1 < (sigmaMaximalOvergroups
      (Subgroup.zpowers x : Set G)).ncard then
    chooseSubgroupOrBot
      (minSimple_max_groups_of (G := G)
        (Subgroup.centralizer (Subgroup.zpowers x : Set G) : Set G))
  else ⊥

/-- The centralizer of `x` in the sigma core of its signalizer base. -/
def ftSignalizer (x : G) : Subgroup G :=
  centralizerWithin (sigmaCore (ftSignalizerBase x))
    (Subgroup.zpowers x)

/-- The union of the signalizer cosets based at nonidentity elements of
`sigmaCore M`. -/
def sigmaCover (M : Subgroup G) : Set G :=
  {g | ∃ x : G, x ∈ sigmaCore M ∧ x ≠ 1 ∧
    ∃ r : G, r ∈ ftSignalizer x ∧ g = x * r}

/-! ## Kappa and the four preliminary maximal-group types -/

/-- The union of the `tau1` and `tau3` prime classes. -/
def tau13Primes (M : Subgroup G) : Set ℕ :=
  tau1Primes M ∪ tau3Primes M

/-- The primes of `tau13(M)` whose rank-one subgroups do not act regularly
on `sigmaCore M`. -/
def kappaPrimes (M : Subgroup G) : Set ℕ :=
  {p | p ∈ tau13Primes M ∧
    ∃ P : Subgroup G,
      RankOneLineIn p M P ∧
        centralizerWithin (sigmaCore M) P ≠ ⊥}

/-- The combined sigma--kappa set of primes. -/
def sigmaKappaPrimes (M : Subgroup G) : Set ℕ :=
  sigmaPrimes M ∪ kappaPrimes M

/-- A source `kappa_complement`: `U` is a `(sigma union kappa)'` Hall
factor, `K` is a `kappa` Hall factor, and their pointwise product is the
carrier of a subgroup. -/
structure KappaComplement (M U K : Subgroup G) : Prop where
  U_le_M : U ≤ M
  hall_U : IsHall (sigmaKappaPrimes M)ᶜ (U.subgroupOf M)
  K_le_M : K ≤ M
  hall_K : IsHall (kappaPrimes M) (K.subgroupOf M)
  product_is_group :
    ∃ E : Subgroup G, (E : Set G) = (U : Set G) * (K : Set G)

/-- Maximal subgroups of Frobenius type. -/
def typeFMaximalSubgroups : Set (Subgroup G) :=
  {M | M ∈ minSimple_max_groups (G := G) ∧
    IsPiNumber (kappaPrimes M)ᶜ (Nat.card M)}

/-- Maximal subgroups with nonempty kappa set. -/
def typePMaximalSubgroups : Set (Subgroup G) :=
  minSimple_max_groups (G := G) \ typeFMaximalSubgroups

/-- Type-P maximal subgroups supported on `sigma union kappa`. -/
def typeP1MaximalSubgroups : Set (Subgroup G) :=
  {M | M ∈ typePMaximalSubgroups (G := G) ∧
    IsPiNumber (sigmaKappaPrimes M) (Nat.card M)}

/-- The remaining type-P maximal subgroups. -/
def typeP2MaximalSubgroups : Set (Subgroup G) :=
  typePMaximalSubgroups (G := G) \
    typeP1MaximalSubgroups (G := G)

/-! Exact source-name aliases. -/

abbrev sigma_decomposition := @sigmaDecomposition
abbrev sigma_length := @sigmaLength
