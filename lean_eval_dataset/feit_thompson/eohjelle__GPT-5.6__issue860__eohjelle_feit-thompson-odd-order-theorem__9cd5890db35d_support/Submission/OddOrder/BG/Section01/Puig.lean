import Mathlib

/-!
The elementary Puig-series construction from `BGsection1.v`.

This module ports `generated_by`, `norm_abelian`, `p_norm_abelian`,
`Puig_succ`, `Puig_at`, `Puig_inf`, and `Puig`, together with the elementary
properties through `Puig1`.  Suprema of subgroups are the mathlib-native form
of MathComp's subgroup generated by a union.
-/

namespace Submission.OddOrder.BG.Section01

open scoped IsMulCommutative

variable {G : Type*} [Group G]

/-- A subgroup is abelian, expressed without installing a local typeclass. -/
def IsAbelianSubgroup (A : Subgroup G) : Prop :=
  ∀ x y : A, x * y = y * x

/-- `A` is abelian and normalized by `D`. -/
def NormalizedAbelian (D A : Subgroup G) : Prop :=
  D ≤ Subgroup.normalizer A ∧ IsAbelianSubgroup A

/-- `A` is an abelian `p`-group normalized by `D`. -/
def PNormalizedAbelian (p : ℕ) (D A : Subgroup G) : Prop :=
  IsPGroup p A ∧ NormalizedAbelian D A

/-- `E` is the supremum of a family of subgroups satisfying `P`. -/
def GeneratedBy (P : Subgroup G → Prop) (E : Subgroup G) : Prop :=
  ∃ S : Set (Subgroup G), (∀ A ∈ S, P A) ∧ sSup S = E

namespace GeneratedBy

variable {P Q : Subgroup G → Prop} {E : Subgroup G}

theorem mono_pred (hPQ : ∀ A, P A → Q A) (hE : GeneratedBy P E) :
    GeneratedBy Q E := by
  obtain ⟨S, hSP, hSE⟩ := hE
  exact ⟨S, fun A hA => hPQ A (hSP A hA), hSE⟩

theorem le_of_forall_le (hE : GeneratedBy P E) {K : Subgroup G}
    (hPK : ∀ A, P A → A ≤ K) : E ≤ K := by
  obtain ⟨S, hSP, rfl⟩ := hE
  exact sSup_le fun A hA => hPK A (hSP A hA)

end GeneratedBy

theorem normalizedAbelian_mono_left {D1 D2 A : Subgroup G} (hD : D1 ≤ D2)
    (hA : NormalizedAbelian D2 A) : NormalizedAbelian D1 A :=
  ⟨hD.trans hA.1, hA.2⟩

/-- One step of the Puig series inside `D`, normalized by `E`. -/
def puigSucc (D E : Subgroup G) : Subgroup G :=
  sSup {A : Subgroup G | A ≤ D ∧ NormalizedAbelian E A}

/-- The `n`th term of the Puig series, starting from the trivial subgroup. -/
def puigAt (n : ℕ) (D : Subgroup G) : Subgroup G :=
  (puigSucc D)^[n] ⊥

/-- The even terminal-index candidate used in the finite Puig series. -/
noncomputable def puigInf (D : Subgroup G) : Subgroup G :=
  puigAt (2 * Nat.card D) D

/-- The odd terminal-index candidate, the Puig subgroup. -/
noncomputable def puig (D : Subgroup G) : Subgroup G :=
  puigAt (2 * Nat.card D + 1) D

@[simp]
theorem puigAt_zero (D : Subgroup G) : puigAt 0 D = ⊥ := by
  simp [puigAt]

theorem puigAt_succ (n : ℕ) (D : Subgroup G) :
    puigAt (n + 1) D = puigSucc D (puigAt n D) := by
  simp [puigAt, Function.iterate_succ_apply']

theorem puig_def (D : Subgroup G) :
    puig D = puigSucc D (puigInf D) := by
  rw [puig, puigInf, puigAt_succ]

theorem puigGenerated (D E : Subgroup G) :
    GeneratedBy (NormalizedAbelian E) (puigSucc D E) := by
  refine ⟨{A : Subgroup G | A ≤ D ∧ NormalizedAbelian E A}, ?_, rfl⟩
  exact fun A hA => hA.2

theorem puigMax {D E K : Subgroup G}
    (hgen : GeneratedBy (NormalizedAbelian D) E) (hEK : E ≤ K) :
    E ≤ puigSucc K D := by
  obtain ⟨S, hSnorm, hSE⟩ := hgen
  rw [← hSE]
  apply sSup_le
  intro A hAS
  apply le_sSup
  exact ⟨(le_sSup hAS).trans (hSE.le.trans hEK), hSnorm A hAS⟩

theorem normalizedGenerated_mono {D1 D2 E : Subgroup G} (hD : D1 ≤ D2)
    (hgen : GeneratedBy (NormalizedAbelian D2) E) :
    GeneratedBy (NormalizedAbelian D1) E :=
  hgen.mono_pred fun _ => normalizedAbelian_mono_left hD

theorem puigSucc_le (D E : Subgroup G) : puigSucc D E ≤ D :=
  sSup_le fun _ hA => hA.1

theorem puigAt_le (n : ℕ) (D : Subgroup G) : puigAt n D ≤ D := by
  cases n with
  | zero => simp
  | succ n =>
      rw [puigAt_succ]
      exact puigSucc_le D (puigAt n D)

theorem puigInf_le (D : Subgroup G) : puigInf D ≤ D :=
  puigAt_le _ _

theorem puig_le (D : Subgroup G) : puig D ≤ D :=
  puigAt_le _ _

/-- This is the mathlib form of `BGsection1.Puig1`. -/
theorem puigAt_one (D : Subgroup G) : puigAt 1 D = D := by
  rw [show 1 = 0 + 1 by rfl, puigAt_succ, puigAt_zero]
  apply le_antisymm (puigSucc_le D ⊥)
  intro x hx
  apply Subgroup.mem_sSup_of_mem (s := Subgroup.zpowers x)
  · exact ⟨Subgroup.zpowers_le.mpr hx, bot_le, fun a b => mul_comm a b⟩
  · exact Subgroup.mem_zpowers x

end Submission.OddOrder.BG.Section01
