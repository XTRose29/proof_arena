import Submission.OddOrder.BG.Section01.PStability
import Submission.OddOrder.MathlibSupport.PElement

/-!
Quadratic p-elements for the Appendix A p-stability argument.

The predicate is the Lean form of the local `p_xp` definition in
`BGappendixAB.odd_p_stable`.
-/

namespace Submission.OddOrder.BG.AppendixAB

open Submission.OddOrder.MathlibSupport

variable {G : Type*} [Group G] {p : ℕ}

/-- A p-element `x` that centralizes the commutator of `E` with the cyclic
subgroup generated by `x`. -/
def IsQuadraticPElement (p : ℕ) (E : Subgroup G) (x : G) : Prop :=
  IsPElement p x ∧
    x ∈ Subgroup.centralizer
      ((⁅E, Subgroup.zpowers x⁆ : Subgroup G) : Set G)

theorem isQuadraticPElement_one (E : Subgroup G) :
    IsQuadraticPElement p E (1 : G) := by
  refine ⟨IsPElement.one, ?_⟩
  rw [Subgroup.zpowers_one_eq_bot, Subgroup.commutator_bot_right]
  exact Subgroup.one_mem _

/-- The quadratic-action premise in p-stability makes every element of `A`
a quadratic p-element on `E`. -/
theorem isQuadraticPElement_of_mem_isPGroup_of_commutator_commutator_eq_bot
    {E A : Subgroup G} {x : G} (hA : IsPGroup p A) (hx : x ∈ A)
    (hquadratic : ⁅⁅E, A⁆, A⁆ = ⊥) : IsQuadraticPElement p E x := by
  have hxP : IsPElement p (⟨x, hx⟩ : A) := hA ⟨x, hx⟩
  refine ⟨hxP.map A.subtype, ?_⟩
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  have hcyclic : Subgroup.zpowers x ≤ A := Subgroup.zpowers_le.mpr hx
  have hyEA : y ∈ ⁅E, A⁆ :=
    Subgroup.commutator_mono le_rfl hcyclic hy
  have hEAcentralizesA : ⁅E, A⁆ ≤ Subgroup.centralizer (A : Set G) := by
    rw [← Subgroup.commutator_eq_bot_iff_le_centralizer]
    exact hquadratic
  have hyCentralizesA := Subgroup.mem_centralizer_iff.mp
    (hEAcentralizesA hyEA) x hx
  exact hyCentralizesA.symm

theorem commutator_commutator_zpowers_eq_bot_of_isQuadraticPElement
    {E : Subgroup G} {x : G} (hx : IsQuadraticPElement p E x) :
    ⁅⁅E, Subgroup.zpowers x⁆, Subgroup.zpowers x⁆ = ⊥ := by
  have hcyclic : Subgroup.zpowers x ≤
      Subgroup.centralizer
        ((⁅E, Subgroup.zpowers x⁆ : Subgroup G) : Set G) :=
    Subgroup.zpowers_le.mpr hx.2
  have hbot : ⁅Subgroup.zpowers x, ⁅E, Subgroup.zpowers x⁆⁆ = ⊥ :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hcyclic
  rw [Subgroup.commutator_comm]
  exact hbot

end Submission.OddOrder.BG.AppendixAB
