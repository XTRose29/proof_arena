import Submission.OddOrder.BG.AppendixAB.QuadraticConjugation
import Submission.OddOrder.MathlibSupport.Cardinality

/-!
Two-generator subgroup support for the Appendix A induction.
-/

namespace Submission.OddOrder.BG.AppendixAB

open Submission.OddOrder.MathlibSupport

variable {G : Type*} [Group G]

/-- The subgroup generated by two elements. -/
def pairGenerated (x y : G) : Subgroup G :=
  Subgroup.zpowers x ⊔ Subgroup.zpowers y

theorem mem_pairGenerated_left (x y : G) : x ∈ pairGenerated x y :=
  (le_sup_left : Subgroup.zpowers x ≤ pairGenerated x y)
    (Subgroup.mem_zpowers x)

theorem mem_pairGenerated_right (x y : G) : y ∈ pairGenerated x y :=
  (le_sup_right : Subgroup.zpowers y ≤ pairGenerated x y)
    (Subgroup.mem_zpowers y)

theorem pairGenerated_le_iff {x y : G} {H : Subgroup G} :
    pairGenerated x y ≤ H ↔ x ∈ H ∧ y ∈ H := by
  rw [pairGenerated, sup_le_iff, Subgroup.zpowers_le, Subgroup.zpowers_le]

theorem pairGenerated_map_equiv {K : Type*} [Group K] (e : G ≃* K)
    (x y : G) :
    (pairGenerated x y).map e.toMonoidHom = pairGenerated (e x) (e y) := by
  rw [pairGenerated, pairGenerated, Subgroup.map_sup,
    MonoidHom.map_zpowers, MonoidHom.map_zpowers]
  rfl

theorem pairGenerated_comm (x y : G) :
    pairGenerated x y = pairGenerated y x := by
  rw [pairGenerated, pairGenerated, sup_comm]

theorem pairGenerated_le_normalizer {E : Subgroup G} {x y : G}
    (hx : x ∈ Subgroup.normalizer (E : Set G))
    (hy : y ∈ Subgroup.normalizer (E : Set G)) :
    pairGenerated x y ≤ Subgroup.normalizer (E : Set G) :=
  pairGenerated_le_iff.mpr ⟨hx, hy⟩

theorem pairGenerated_isPGroup_of_mem {p : ℕ} {P : Subgroup G} {x y : G}
    (hP : IsPGroup p P) (hx : x ∈ P) (hy : y ∈ P) :
    IsPGroup p (pairGenerated x y) :=
  IsPGroup.to_le hP (pairGenerated_le_iff.mpr ⟨hx, hy⟩)

theorem odd_natCard_pairGenerated [Finite G] {x y : G}
    (hG : Odd (Nat.card G)) : Odd (Nat.card (pairGenerated x y)) :=
  odd_natCard_subgroup (pairGenerated x y) hG

end Submission.OddOrder.BG.AppendixAB
