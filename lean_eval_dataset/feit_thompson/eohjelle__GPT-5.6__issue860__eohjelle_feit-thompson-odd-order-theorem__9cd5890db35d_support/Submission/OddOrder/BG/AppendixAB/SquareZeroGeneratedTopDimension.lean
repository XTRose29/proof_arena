import Submission.OddOrder.BG.AppendixAB.SquareZeroPairGenerated
import Mathlib.RepresentationTheory.Irreducible

/-!
The square-zero dimension bound when the pair generates the whole group.
-/

namespace Submission.OddOrder.BG.AppendixAB

open Submission.OddOrder.MathlibSupport

variable {D V G : Type*} [Field D] [AddCommGroup V] [Module D V] [Group G]

/-- An irreducible representation generated by a square-zero pair has
dimension at most two. -/
theorem finrank_le_two_of_square_zero_pair_generates_top
    (rho : Representation D G V) (x y : G)
    (X Y : Module.End D V) (a : D)
    (hgen : pairGenerated x y = ⊤)
    (hrhoX : rho x = 1 + X) (hrhoY : rho y = 1 + Y)
    (hX : X * X = 0) (hY : Y * Y = 0)
    (hA : anticommutator X Y = a • (1 : Module.End D V))
    (hXne : X ≠ 0) [Representation.IsIrreducible rho] :
    Module.finrank D V ≤ 2 := by
  obtain ⟨u, hu⟩ : ∃ u : V, X u ≠ 0 := by
    by_contra h
    push Not at h
    apply hXne
    ext v
    exact h v
  let W := squareZeroPairSpan X Y u
  have hx : x ∈ representationSubmoduleStabilizer rho W :=
    mem_stabilizer_of_one_add_square_zero rho W x X hrhoX hX
      (squareZeroPairSpan_stable_left X Y u a hX hA)
  have hy : y ∈ representationSubmoduleStabilizer rho W :=
    mem_stabilizer_of_one_add_square_zero rho W y Y hrhoY hY
      (squareZeroPairSpan_stable_right X Y u hY)
  have hle : pairGenerated x y ≤ representationSubmoduleStabilizer rho W :=
    pairGenerated_le_iff.mpr ⟨hx, hy⟩
  let sigma : Subrepresentation rho :=
    { toSubmodule := W
      apply_mem_toSubmodule g {v} hv := by
        have hg : g ∈ pairGenerated x y := by rw [hgen]; trivial
        exact (hle hg).1 hv }
  have hsigma_ne_bot : sigma ≠ ⊥ := by
    intro hsigma
    have hXu : X u ∈ sigma.toSubmodule := by
      exact Submodule.subset_span (Set.mem_insert _ _)
    rw [hsigma] at hXu
    exact hu hXu
  have hsigma_top : sigma = ⊤ :=
    (eq_bot_or_eq_top sigma).resolve_left hsigma_ne_bot
  have hspan_top : squareZeroPairSpan X Y u = ⊤ := by
    change sigma.toSubmodule = ⊤
    rw [hsigma_top]
    rfl
  rw [← finrank_top D V, ← hspan_top]
  exact finrank_squareZeroPairSpan_le_two X Y u

end Submission.OddOrder.BG.AppendixAB
