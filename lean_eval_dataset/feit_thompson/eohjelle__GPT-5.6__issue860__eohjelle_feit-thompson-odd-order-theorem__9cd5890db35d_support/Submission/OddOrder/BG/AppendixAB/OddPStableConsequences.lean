import Submission.OddOrder.BG.AppendixAB.OddPStable
import Submission.OddOrder.BG.AppendixAB.PStableGenerated
import Submission.OddOrder.BG.AppendixAB.PStablePCore
import Submission.OddOrder.BG.AppendixAB.PStablePuigPCore
import Submission.OddOrder.BG.Section01.AbelianConstrainedSolvable

/-!
Odd-order specializations of the downstream p-stability consequences.
-/

namespace Submission.OddOrder.BG.AppendixAB

open Submission.OddOrder.BG.Section01
open Submission.OddOrder.MathlibSupport

variable {G : Type*} [Group G] [Finite G]

/-- A finite solvable odd-order group is p-abelian-constrained. -/
theorem odd_isPAbelianConstrained {p : ℕ} [Fact p.Prime]
    [IsSolvable G] (hodd : Odd (Nat.card G)) :
    IsPAbelianConstrained p G :=
  solvable_isPAbelianConstrained_of_isPStable (odd_isPStable hodd)

/-- Odd-order form of Bender-Glauberman A.5.1 for one normalized abelian
p-subgroup. -/
theorem odd_pNormalizedAbelian_quotient_le_pCore
    {p : ℕ} [Fact p.Prime] {P A : Subgroup G} [P.Normal]
    (hodd : Odd (Nat.card G)) (hP : IsPGroup p P)
    (hA : PNormalizedAbelian p P A) :
    A.map (QuotientGroup.mk' (Subgroup.centralizer (P : Set G))) ≤
      pCore p (G ⧸ Subgroup.centralizer (P : Set G)) :=
  pNormalizedAbelian_quotient_le_pCore_of_isPStable
    (odd_isPStable hodd) hP hA

/-- Odd-order form of Bender-Glauberman A.5.1 for a subgroup generated by
normalized abelian p-subgroups. -/
theorem odd_abelianGenerated_quotient_le_pCore
    {p : ℕ} [Fact p.Prime] {P X : Subgroup G} [P.Normal]
    (hodd : Odd (Nat.card G)) (hP : IsPGroup p P)
    (hgen : GeneratedBy (PNormalizedAbelian p P) X) :
    X.map (QuotientGroup.mk' (Subgroup.centralizer (P : Set G))) ≤
      pCore p (G ⧸ Subgroup.centralizer (P : Set G)) :=
  abelianGenerated_quotient_le_pCore_of_isPStable
    (odd_isPStable hodd) hP hgen

/-- Odd-order solvable form of Bender-Glauberman A.5.2. -/
theorem odd_abelianGeneratedConstrained
    {p : ℕ} [Fact p.Prime] [IsSolvable G]
    (hodd : Odd (Nat.card G)) : AbelianGeneratedConstrained p G :=
  abelianGeneratedConstrained_of_isPStable (odd_isPStable hodd)

/-- A.5.2 specialized to the p-core of a finite solvable odd-order group. -/
theorem odd_abelianGenerated_pCore_le_pCore
    {p : ℕ} [Fact p.Prime] [IsSolvable G] {X : Subgroup G}
    (hodd : Odd (Nat.card G))
    (hgen : GeneratedBy (PNormalizedAbelian p (pCore p G)) X)
    (hprimeCore : pPrimeCore p G = ⊥) :
    X ≤ pCore p G :=
  abelianGenerated_pCore_le_pCore_of_isPStable
    (odd_isPStable hodd) hgen hprimeCore

/-- Odd-order solvable form of the B.3 Puig comparison. -/
theorem odd_pCore_sylow_puig_sub
    {p : ℕ} [Fact p.Prime] [IsSolvable G]
    (hodd : Odd (Nat.card G)) (S : Sylow p G)
    (hprimeCore : pPrimeCore p G = ⊥) :
    puigInf (S : Subgroup G) ≤ puigInf (pCore p G) ∧
      puig (pCore p G) ≤ puig (S : Subgroup G) :=
  pCore_sylow_puig_sub_of_isPStable S (odd_isPStable hodd) hprimeCore

end Submission.OddOrder.BG.AppendixAB
