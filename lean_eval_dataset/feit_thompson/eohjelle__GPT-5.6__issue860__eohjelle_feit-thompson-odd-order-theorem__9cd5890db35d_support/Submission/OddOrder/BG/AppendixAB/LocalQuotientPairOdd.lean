import Submission.OddOrder.BG.AppendixAB.LocalQuotientPairHom
import Mathlib.GroupTheory.Index

/-!
Oddness of the local quotient pair inherited from the ambient pair-generated
subgroup.
-/

namespace Submission.OddOrder.BG.AppendixAB

variable {G : Type*} [Group G]

/-- The local quotient pair has odd cardinality whenever the subgroup
generated by its two ambient lifts has odd cardinality. -/
theorem odd_natCard_localQuotientPair_of_pairGenerated
    (E : Subgroup G) {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G))
    (hodd : Odd (Nat.card (pairGenerated x y))) :
    Odd (Nat.card (localQuotientPair E hxN hyN)) := by
  let H := pairGenerated x y
  let N := Subgroup.normalizer (E : Set G)
  have hHN : H ≤ N := pairGenerated_le_normalizer hxN hyN
  have hsource : Odd (Nat.card (H.subgroupOf N)) := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hHN).toEquiv]
    exact hodd
  exact hsource.of_dvd_nat (Subgroup.card_dvd_of_surjective
    (pairGeneratedToLocalQuotient E hxN hyN)
    (pairGeneratedToLocalQuotient_surjective E hxN hyN))

end Submission.OddOrder.BG.AppendixAB
