import Submission.OddOrder.BG.AppendixAB.TwoGenerator
import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
Commutativity of groups generated by a commuting pair.
-/

namespace Submission.OddOrder.BG.AppendixAB

open scoped IsMulCommutative

variable {G : Type*} [Group G]

theorem pairGenerated_eq_closure_pair (x y : G) :
    pairGenerated x y = Subgroup.closure {x, y} := by
  rw [pairGenerated, Subgroup.zpowers_eq_closure,
    Subgroup.zpowers_eq_closure, ← Subgroup.closure_union]
  congr 1

theorem pairGenerated_isMulCommutative {x y : G} (hxy : Commute x y) :
    IsMulCommutative (pairGenerated x y) := by
  rw [pairGenerated_eq_closure_pair]
  apply Subgroup.isMulCommutative_closure
  intro a ha b hb
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
  rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
  · rfl
  · exact hxy.eq
  · exact hxy.eq.symm
  · rfl

theorem isMulCommutative_of_pairGenerated_eq_top {x y : G}
    (hgen : pairGenerated x y = ⊤) (hxy : Commute x y) :
    IsMulCommutative G := by
  letI : IsMulCommutative (pairGenerated x y) :=
    pairGenerated_isMulCommutative hxy
  refine ⟨⟨fun a b ↦ ?_⟩⟩
  have ha : a ∈ pairGenerated x y := by rw [hgen]; trivial
  have hb : b ∈ pairGenerated x y := by rw [hgen]; trivial
  let ap : pairGenerated x y := ⟨a, ha⟩
  let bp : pairGenerated x y := ⟨b, hb⟩
  exact congrArg Subtype.val (mul_comm ap bp)

end Submission.OddOrder.BG.AppendixAB
