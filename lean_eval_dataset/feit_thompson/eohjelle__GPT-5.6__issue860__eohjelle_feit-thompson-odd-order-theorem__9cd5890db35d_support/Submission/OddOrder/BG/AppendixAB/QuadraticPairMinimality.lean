import Submission.OddOrder.BG.AppendixAB.QuadraticPairInductionStep
import Submission.OddOrder.BG.AppendixAB.MinimalQuadraticSubgroup
import Submission.OddOrder.MathlibSupport.MinimalNormalUnder
import Submission.OddOrder.MathlibSupport.StableFactor

/-!
Minimality forced by a nontrivial cross-prime action in the quadratic-pair
induction.
-/

namespace Submission.OddOrder.BG.AppendixAB

open Submission.OddOrder.MathlibSupport

universe u

variable {G : Type u} [Group G] [Finite G]

/-- If a q-subgroup of the acting pair does not centralize `E`, then `E` is
minimal normal under the subgroup generated by `E`, `x`, and `y`. -/
theorem isMinimalNormalUnder_pairExtension_of_crossPrime_not_centralizer
    {p q : ℕ} [Fact p.Prime] [Fact q.Prime] (hpq : p ≠ q)
    {E A : Subgroup G} {x y : G}
    (hxNE : x ∈ Subgroup.normalizer (E : Set G))
    (hyNE : y ∈ Subgroup.normalizer (E : Set G))
    (hodd : Odd (Nat.card (pairGenerated x y)))
    (hE : IsPGroup p E)
    (hx : IsQuadraticPElement p E x)
    (hy : IsQuadraticPElement p E y)
    (hAxy : A ≤ pairGenerated x y) (hAq : IsPGroup q A)
    (hAnot : ¬A ≤ Subgroup.centralizer (E : Set G))
    (hIH : OddQuadraticLocalPrincipleBelow.{u} p (Nat.card E)) :
    IsMinimalNormalUnder E (pairExtension E x y) := by
  have hEne : E ≠ ⊥ := by
    intro hEbot
    apply hAnot
    intro a _ha
    rw [Subgroup.mem_centralizer_iff]
    intro e he
    have heOne : e = 1 := by
      rw [hEbot] at he
      exact Subgroup.mem_bot.mp he
    subst e
    simp
  refine ⟨hEne, ?_, ?_⟩
  · exact sup_le Subgroup.le_normalizer
      (pairGenerated_le_normalizer hxNE hyNE)
  · intro D hDE hD hDinv
    by_cases hED : E ≤ D
    · exact hED
    have hJND : pairExtension E x y ≤
        Subgroup.normalizer (D : Set G) :=
      Subgroup.le_normalizer_iff.mpr hDinv
    have hEND : E ≤ Subgroup.normalizer (D : Set G) :=
      (le_pairExtension E x y).trans hJND
    have hxND : x ∈ Subgroup.normalizer (D : Set G) :=
      hJND (pairGenerated_le_pairExtension E x y
        (mem_pairGenerated_left x y))
    have hyND : y ∈ Subgroup.normalizer (D : Set G) :=
      hJND (pairGenerated_le_pairExtension E x y
        (mem_pairGenerated_right x y))
    have hcardD : Nat.card D < Nat.card E := by
      have hcardLe : Nat.card D ≤ Nat.card E :=
        Subgroup.card_le_of_le hDE
      apply lt_of_le_of_ne hcardLe
      intro hcardEq
      apply hED
      have hEq : D = E :=
        Subgroup.eq_of_le_of_card_ge hDE hcardEq.ge
      rw [hEq]
    have hDp : IsPGroup p D := hE.to_le hDE
    have hlocalD : IsPGroup p (localQuotientPair D hxND hyND) :=
      hIH G D x y hxND hyND hcardD hodd hDp
        (hx.of_le hDE) (hy.of_le hDE)
    have hAD : A ≤ Subgroup.centralizer (D : Set G) :=
      crossPrime_subgroup_le_centralizer_of_localQuotientPair_isPGroup
        hpq hxND hyND hAxy hAq hlocalD
    have hcomm : ⁅A, E⁆ ≤ D :=
      commutator_le_of_quadraticPair_invariantQuotient
        hpq hDE hD hEND hxND hyND hxNE hyNE hodd hE hx hy
          hAxy hAq hIH
    have hcoprime : Nat.Coprime (Nat.card E) (Nat.card A) :=
      IsPGroup.coprime_card_of_ne p q hpq E A hE hAq
    exfalso
    apply hAnot
    exact stableFactor_centralizes hAD hDE hcomm hcoprime

end Submission.OddOrder.BG.AppendixAB
