import Submission.OddOrder.BG.AppendixAB.TwoGenerator
import Submission.OddOrder.MathlibSupport.SquareZeroPairSpan
import Mathlib.RepresentationTheory.Subrepresentation

/-!
Stability of the square-zero pair span under the group generated by the pair.
-/

namespace Submission.OddOrder.BG.AppendixAB

open Submission.OddOrder.MathlibSupport

variable {D V G : Type*} [Field D] [AddCommGroup V] [Module D V] [Group G]

/-- The group elements preserving a submodule in both directions. -/
def representationSubmoduleStabilizer
    (rho : Representation D G V) (W : Submodule D V) : Subgroup G where
  carrier := {g | W ≤ W.comap (rho g) ∧ W ≤ W.comap (rho g⁻¹)}
  one_mem' := by
    constructor <;> intro v hv
    · simpa using hv
    · simpa using hv
  mul_mem' := by
    intro x y hx hy
    constructor
    · intro v hv
      change rho (x * y) v ∈ W
      rw [map_mul]
      exact hx.1 (hy.1 hv)
    · intro v hv
      change rho (x * y)⁻¹ v ∈ W
      rw [mul_inv_rev, map_mul]
      exact hy.2 (hx.2 hv)
  inv_mem' := by
    intro x hx
    change W ≤ W.comap (rho x⁻¹) ∧ W ≤ W.comap (rho (x⁻¹)⁻¹)
    constructor
    · exact hx.2
    · simpa only [inv_inv] using hx.1

@[simp]
theorem mem_representationSubmoduleStabilizer
    (rho : Representation D G V) (W : Submodule D V) (g : G) :
    g ∈ representationSubmoduleStabilizer rho W ↔
      W ≤ W.comap (rho g) ∧ W ≤ W.comap (rho g⁻¹) :=
  Iff.rfl

theorem representation_inv_eq_one_sub_of_sq_zero
    (rho : Representation D G V) (x : G) (X : Module.End D V)
    (hrho : rho x = 1 + X) (hX : X * X = 0) :
    rho x⁻¹ = 1 - X := by
  have hleft : (1 - X) * rho x = 1 := by
    rw [hrho]
    calc
      (1 - X) * (1 + X) = 1 - X * X := by noncomm_ring
      _ = 1 := by rw [hX, sub_zero]
  calc
    rho x⁻¹ = 1 * rho x⁻¹ := by rw [one_mul]
    _ = ((1 - X) * rho x) * rho x⁻¹ := by rw [hleft]
    _ = (1 - X) * (rho x * rho x⁻¹) := by rw [mul_assoc]
    _ = 1 - X := by rw [← map_mul]; simp

theorem mem_stabilizer_of_one_add_square_zero
    (rho : Representation D G V) (W : Submodule D V)
    (x : G) (X : Module.End D V)
    (hrho : rho x = 1 + X) (hX : X * X = 0)
    (hstable : W ≤ W.comap X) :
    x ∈ representationSubmoduleStabilizer rho W := by
  have hplus : W ≤ W.comap (1 + X) := by
    intro v hv
    change v + X v ∈ W
    exact W.add_mem hv (hstable hv)
  have hminus : W ≤ W.comap (1 - X) := by
    intro v hv
    change v - X v ∈ W
    exact W.sub_mem hv (hstable hv)
  constructor
  · simpa only [hrho] using hplus
  · rw [representation_inv_eq_one_sub_of_sq_zero rho x X hrho hX]
    exact hminus

/-- The square-zero pair span as a subrepresentation of the representation
restricted to the pair-generated group. -/
def squareZeroPairSubrepresentation
    (rho : Representation D G V) (x y : G)
    (X Y : Module.End D V) (u : V) (a : D)
    (hrhoX : rho x = 1 + X) (hrhoY : rho y = 1 + Y)
    (hX : X * X = 0) (hY : Y * Y = 0)
    (hA : anticommutator X Y = a • (1 : Module.End D V)) :
    Subrepresentation (rho.comp (pairGenerated x y).subtype) where
  toSubmodule := squareZeroPairSpan X Y u
  apply_mem_toSubmodule g {v} hv := by
    let W := squareZeroPairSpan X Y u
    have hx : x ∈ representationSubmoduleStabilizer rho W :=
      mem_stabilizer_of_one_add_square_zero rho W x X hrhoX hX
        (squareZeroPairSpan_stable_left X Y u a hX hA)
    have hy : y ∈ representationSubmoduleStabilizer rho W :=
      mem_stabilizer_of_one_add_square_zero rho W y Y hrhoY hY
        (squareZeroPairSpan_stable_right X Y u hY)
    have hle : pairGenerated x y ≤ representationSubmoduleStabilizer rho W :=
      pairGenerated_le_iff.mpr ⟨hx, hy⟩
    exact (hle g.2).1 hv

@[simp]
theorem squareZeroPairSubrepresentation_toSubmodule
    (rho : Representation D G V) (x y : G)
    (X Y : Module.End D V) (u : V) (a : D)
    (hrhoX : rho x = 1 + X) (hrhoY : rho y = 1 + Y)
    (hX : X * X = 0) (hY : Y * Y = 0)
    (hA : anticommutator X Y = a • (1 : Module.End D V)) :
    (squareZeroPairSubrepresentation rho x y X Y u a hrhoX hrhoY hX hY hA).toSubmodule =
      squareZeroPairSpan X Y u :=
  rfl

end Submission.OddOrder.BG.AppendixAB
