import Submission.OddOrder.BG.AppendixAB.QuadraticCentralIntertwining
import Submission.OddOrder.BG.AppendixAB.SchurTwoDimensionalBranch
import Submission.OddOrder.MathlibSupport.PairGeneratedSubtype

/-!
The noncommuting local quadratic-pair branch of odd p-stability.
-/

namespace Submission.OddOrder.BG.AppendixAB

open scoped IsMulCommutative MonoidAlgebra
open Submission.OddOrder.BG.Section01
open Submission.OddOrder.MathlibSupport

variable {G : Type*} [Group G]

/-- The subgroup generated by the images of a normalizing pair in
`N(E) / C(E)`. -/
def localQuotientPair (E : Subgroup G) {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G)) :
    Subgroup
      ((Subgroup.normalizer (E : Set G)) ⧸ normalizerCentralizer E) :=
  pairGenerated
    (QuotientGroup.mk' (normalizerCentralizer E) ⟨x, hxN⟩)
    (QuotientGroup.mk' (normalizerCentralizer E) ⟨y, hyN⟩)

/-- The left generator inside the local quotient pair. -/
def localQuotientPairLeft (E : Subgroup G) {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G)) :
    localQuotientPair E hxN hyN :=
  ⟨QuotientGroup.mk' (normalizerCentralizer E) ⟨x, hxN⟩,
    mem_pairGenerated_left _ _⟩

/-- The right generator inside the local quotient pair. -/
def localQuotientPairRight (E : Subgroup G) {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G)) :
    localQuotientPair E hxN hyN :=
  ⟨QuotientGroup.mk' (normalizerCentralizer E) ⟨y, hyN⟩,
    mem_pairGenerated_right _ _⟩

/-- The faithful conjugation representation restricted to the local quotient
pair. -/
def localQuotientPairRepresentation
    (E : Subgroup G) (p : ℕ) [IsMulCommutative E]
    [Module (ZMod p) (Additive E)] {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G)) :
    Representation (ZMod p) (localQuotientPair E hxN hyN) (Additive E) :=
  localSubgroupConjugationRepresentation E p (localQuotientPair E hxN hyN)

@[simp]
theorem localQuotientPairRepresentation_left_apply
    (E : Subgroup G) (p : ℕ) [IsMulCommutative E]
    [Module (ZMod p) (Additive E)] {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G)) (v : Additive E) :
    localQuotientPairRepresentation E p hxN hyN
        (localQuotientPairLeft E hxN hyN) v =
      normalizerConjugationRepresentation E p ⟨x, hxN⟩ v := by
  exact centralizerQuotientConjugationRepresentation_mk_apply
    E p ⟨x, hxN⟩ v

@[simp]
theorem localQuotientPairRepresentation_right_apply
    (E : Subgroup G) (p : ℕ) [IsMulCommutative E]
    [Module (ZMod p) (Additive E)] {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G)) (v : Additive E) :
    localQuotientPairRepresentation E p hxN hyN
        (localQuotientPairRight E hxN hyN) v =
      normalizerConjugationRepresentation E p ⟨y, hyN⟩ v := by
  exact centralizerQuotientConjugationRepresentation_mk_apply
    E p ⟨y, hyN⟩ v

/-- The two distinguished elements generate the local quotient pair. -/
theorem pairGenerated_localQuotientPair_eq_top
    (E : Subgroup G) {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G)) :
    pairGenerated (localQuotientPairLeft E hxN hyN)
      (localQuotientPairRight E hxN hyN) = ⊤ := by
  rw [pairGenerated_subtype]
  change (localQuotientPair E hxN hyN).comap
    (localQuotientPair E hxN hyN).subtype = ⊤
  ext z
  simp

/-- A quadratic left generator has square-zero deviation in the restricted
local representation. -/
theorem localQuotientPair_left_deviation_sq_zero
    (E : Subgroup G) (p : ℕ) [IsMulCommutative E]
    [Module (ZMod p) (Additive E)] {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G))
    (hx : IsQuadraticPElement p E x) :
    let rho := localQuotientPairRepresentation E p hxN hyN
    let xQ := localQuotientPairLeft E hxN hyN
    (rho xQ - 1) * (rho xQ - 1) = 0 := by
  dsimp only
  have heq :
      localQuotientPairRepresentation E p hxN hyN
          (localQuotientPairLeft E hxN hyN) =
        normalizerConjugationRepresentation E p ⟨x, hxN⟩ := by
    apply LinearMap.ext
    exact localQuotientPairRepresentation_left_apply E p hxN hyN
  rw [heq]
  simpa [conjugationDeviation] using
    conjugationDeviation_mul_self_eq_zero E p hxN hx

/-- A quadratic right generator has square-zero deviation in the restricted
local representation. -/
theorem localQuotientPair_right_deviation_sq_zero
    (E : Subgroup G) (p : ℕ) [IsMulCommutative E]
    [Module (ZMod p) (Additive E)] {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G))
    (hy : IsQuadraticPElement p E y) :
    let rho := localQuotientPairRepresentation E p hxN hyN
    let yQ := localQuotientPairRight E hxN hyN
    (rho yQ - 1) * (rho yQ - 1) = 0 := by
  dsimp only
  have heq :
      localQuotientPairRepresentation E p hxN hyN
          (localQuotientPairRight E hxN hyN) =
        normalizerConjugationRepresentation E p ⟨y, hyN⟩ := by
    apply LinearMap.ext
    exact localQuotientPairRepresentation_right_apply E p hxN hyN
  rw [heq]
  simpa [conjugationDeviation] using
    conjugationDeviation_mul_self_eq_zero E p hyN hy

/-- The canonical central intertwiner is the anticommutator of the two local
deviations. -/
theorem localQuotientPair_centralIntertwining_toLinearMap
    (E : Subgroup G) (p : ℕ) [IsMulCommutative E]
    [Module (ZMod p) (Additive E)] {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G))
    (hx : IsQuadraticPElement p E x)
    (hy : IsQuadraticPElement p E y) :
    let rho := localQuotientPairRepresentation E p hxN hyN
    let xQ := localQuotientPairLeft E hxN hyN
    let yQ := localQuotientPairRight E hxN hyN
    (quadraticCentralIntertwining E p hxN hyN hx hy).toLinearMap =
      anticommutator (rho xQ - 1) (rho yQ - 1) := by
  dsimp only
  have hxrep :
      localQuotientPairRepresentation E p hxN hyN
          (localQuotientPairLeft E hxN hyN) =
        normalizerConjugationRepresentation E p ⟨x, hxN⟩ := by
    apply LinearMap.ext
    exact localQuotientPairRepresentation_left_apply E p hxN hyN
  have hyrep :
      localQuotientPairRepresentation E p hxN hyN
          (localQuotientPairRight E hxN hyN) =
        normalizerConjugationRepresentation E p ⟨y, hyN⟩ := by
    apply LinearMap.ext
    exact localQuotientPairRepresentation_right_apply E p hxN hyN
  rw [quadraticCentralIntertwining_toLinearMap]
  simp only [quadraticAnticommutator, conjugationDeviation]
  rw [hxrep, hyrep]

/-- In the noncommuting branch, a quadratic pair has p-primary local
commutator. -/
theorem local_commutator_isPGroup_of_noncommuting_quadratic_pair
    [Finite G] (E : Subgroup G) (p : ℕ) [Fact p.Prime]
    [IsMulCommutative E] [Module (ZMod p) (Additive E)]
    [Finite (Additive E)] {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G))
    (hx : IsQuadraticPElement p E x)
    (hy : IsQuadraticPElement p E y)
    [Representation.IsIrreducible
      (localQuotientPairRepresentation E p hxN hyN)]
    (hodd : Odd (Nat.card (localQuotientPair E hxN hyN)))
    (hnotcomm : ¬Commute
      (localQuotientPairRepresentation E p hxN hyN
        (localQuotientPairLeft E hxN hyN))
      (localQuotientPairRepresentation E p hxN hyN
        (localQuotientPairRight E hxN hyN))) :
    IsPGroup p (_root_.commutator (localQuotientPair E hxN hyN)) := by
  let Q := localQuotientPair E hxN hyN
  let rho := localQuotientPairRepresentation E p hxN hyN
  let xQ := localQuotientPairLeft E hxN hyN
  let yQ := localQuotientPairRight E hxN hyN
  let A := quadraticCentralIntertwining E p hxN hyN hx hy
  letI : Representation.IsIrreducible
      (localSubgroupConjugationRepresentation E p Q) :=
    (inferInstance : Representation.IsIrreducible
      (localQuotientPairRepresentation E p hxN hyN))
  have hgen : pairGenerated xQ yQ = ⊤ :=
    pairGenerated_localQuotientPair_eq_top E hxN hyN
  have hX : (rho xQ - 1) * (rho xQ - 1) = 0 :=
    localQuotientPair_left_deviation_sq_zero E p hxN hyN hx
  have hY : (rho yQ - 1) * (rho yQ - 1) = 0 :=
    localQuotientPair_right_deviation_sq_zero E p hxN hyN hy
  have hA : A.toLinearMap = anticommutator (rho xQ - 1) (rho yQ - 1) :=
    localQuotientPair_centralIntertwining_toLinearMap
      E p hxN hyN hx hy
  have hXne : rho xQ - 1 ≠ 0 := by
    intro hzero
    apply hnotcomm
    have hxone : rho xQ = 1 := sub_eq_zero.mp hzero
    rw [hxone]
    exact Commute.one_left _
  have hdim :
      letI : Field (Module.End (ZMod p)[Q] rho.asModule) :=
        finiteSchurField rho
      Module.finrank (Module.End (ZMod p)[Q] rho.asModule) rho.asModule = 2 :=
    schurPair_finrank_eq_two rho xQ yQ hgen hX hY A hA hXne hnotcomm
  exact local_commutator_isPGroup_of_schur_finrank_eq_two
    E p Q hdim hodd

end Submission.OddOrder.BG.AppendixAB
