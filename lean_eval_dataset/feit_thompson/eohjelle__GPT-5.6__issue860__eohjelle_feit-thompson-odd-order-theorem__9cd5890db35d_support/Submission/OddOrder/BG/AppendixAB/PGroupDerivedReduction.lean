import Submission.OddOrder.BG.AppendixAB.TwoGenerator
import Submission.OddOrder.MathlibSupport.PElementCyclic
import Submission.OddOrder.MathlibSupport.PGroupExtension
import Submission.OddOrder.MathlibSupport.PairGeneratedSubtype

/-!
Reduction of a two-generator p-group conclusion to its derived subgroup.
-/

namespace Submission.OddOrder.BG.AppendixAB

open Submission.OddOrder.MathlibSupport

variable {H : Type*} [Group H] [Finite H]

/-- A finite group generated by two p-elements is a p-group once its
commutator subgroup is a p-group. -/
theorem isPGroup_of_pairGenerated_eq_top_of_commutator_isPGroup
    {p : ℕ} [Fact p.Prime] {x y : H}
    (hgen : pairGenerated x y = ⊤)
    (hx : IsPElement p x) (hy : IsPElement p y)
    (hder : IsPGroup p (_root_.commutator H)) : IsPGroup p H := by
  let D : Subgroup H := _root_.commutator H
  let q : H →* H ⧸ D := QuotientGroup.mk' D
  letI : IsMulCommutative (H ⧸ D) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr le_rfl
  have hqx : IsPElement p (q x) := hx.map q
  have hqy : IsPElement p (q y) := hy.map q
  have hpairQ : IsPGroup p (pairGenerated (q x) (q y)) := by
    rw [pairGenerated]
    exact hqx.zpowers_isPGroup.to_sup_of_normal_right
      hqy.zpowers_isPGroup
  have hpairTop : pairGenerated (q x) (q y) = ⊤ := by
    calc
      pairGenerated (q x) (q y) = (pairGenerated x y).map q :=
        (pairGenerated_map_hom q x y).symm
      _ = (⊤ : Subgroup H).map q := congrArg (fun S : Subgroup H => S.map q) hgen
      _ = ⊤ := Subgroup.map_top_of_surjective q
        (QuotientGroup.mk'_surjective D)
  rw [hpairTop] at hpairQ
  have hquotient : IsPGroup p (H ⧸ D) :=
    hpairQ.of_equiv Subgroup.topEquiv
  exact isPGroup_of_normal_subgroup_and_quotient D hder hquotient

end Submission.OddOrder.BG.AppendixAB
