import Submission.OddOrder.BG.AppendixAB.LocalRestrictionKernelStableFactor
import Submission.OddOrder.MathlibSupport.SubgroupConjugationFactor

/-!
Cyclic factor actions attached to elements of a generated pair.
-/

namespace Submission.OddOrder.BG.AppendixAB

open Submission.OddOrder.MathlibSupport
open scoped commutatorElement

variable {G : Type*} [Group G]

/-- The ambient cyclic subgroup generated by an element of `pairGenerated`
normalizes every subgroup normalized by both generators. -/
theorem zpowers_coe_pairGenerated_le_normalizer
    (E : Subgroup G) {x y : G}
    (hxN : x ∈ Subgroup.normalizer (E : Set G))
    (hyN : y ∈ Subgroup.normalizer (E : Set G))
    (g : pairGenerated x y) :
    Subgroup.zpowers (g : G) ≤ Subgroup.normalizer (E : Set G) := by
  rw [Subgroup.zpowers_le]
  exact pairGenerated_le_normalizer hxN hyN g.property

/-- The conjugation action of a cyclic subgroup lifted from the generated
pair on the factor `E/(M ∩ E)`. -/
noncomputable def pairGeneratedCyclicFactorHom
    (M E : Subgroup G) [(M.subgroupOf E).Normal] {x y : G}
    (hxNE : x ∈ Subgroup.normalizer (E : Set G))
    (hyNE : y ∈ Subgroup.normalizer (E : Set G))
    (hxNM : x ∈ Subgroup.normalizer (M : Set G))
    (hyNM : y ∈ Subgroup.normalizer (M : Set G))
    (g : pairGenerated x y) :
    Subgroup.zpowers (g : G) →* MulAut (E ⧸ M.subgroupOf E) :=
  subgroupConjugationFactorHom M E (Subgroup.zpowers (g : G))
    (zpowers_coe_pairGenerated_le_normalizer E hxNE hyNE g)
    (zpowers_coe_pairGenerated_le_normalizer M hxNM hyNM g)

/-- Triviality of the cyclic factor action is exactly the commutator bound
needed by the stable-factor lemma. -/
theorem pairGeneratedCyclicFactorHom_ker_eq_top_iff
    (M E : Subgroup G) [(M.subgroupOf E).Normal] {x y : G}
    (hxNE : x ∈ Subgroup.normalizer (E : Set G))
    (hyNE : y ∈ Subgroup.normalizer (E : Set G))
    (hxNM : x ∈ Subgroup.normalizer (M : Set G))
    (hyNM : y ∈ Subgroup.normalizer (M : Set G))
    (g : pairGenerated x y) :
    (pairGeneratedCyclicFactorHom M E hxNE hyNE hxNM hyNM g).ker = ⊤ ↔
      ⁅Subgroup.zpowers (g : G), E⁆ ≤ M :=
  subgroupConjugationFactorHom_ker_eq_top_iff M E
    (Subgroup.zpowers (g : G))
      (zpowers_coe_pairGenerated_le_normalizer E hxNE hyNE g)
      (zpowers_coe_pairGenerated_le_normalizer M hxNM hyNM g)

section Finite

variable [Finite G]

/-- A cross-prime restriction-kernel element is trivial if every one of its
cyclic lifts acts trivially on `E/(M ∩ E)`. -/
theorem localDerivedRestrictionKernel_eq_one_of_cyclic_factor_action
    {p q : ℕ} [Fact p.Prime] [Fact q.Prime] (hqp : q ≠ p)
    {M E : Subgroup G} (hME : M ≤ E) [(M.subgroupOf E).Normal]
    (hE : IsPGroup p E) {x y : G}
    (hxNE : x ∈ Subgroup.normalizer (E : Set G))
    (hyNE : y ∈ Subgroup.normalizer (E : Set G))
    (hxNM : x ∈ Subgroup.normalizer (M : Set G))
    (hyNM : y ∈ Subgroup.normalizer (M : Set G))
    (a : localDerivedRestrictionKernel hME hxNE hyNE hxNM hyNM)
    (haorder : orderOf a = q)
    (hfactor : ∀ g : pairGenerated x y,
      pairGeneratedLocalQuotientHom E hxNE hyNE g =
        ((a : _root_.commutator (localQuotientPair E hxNE hyNE)) :
          localQuotientPair E hxNE hyNE) →
      (pairGeneratedCyclicFactorHom M E hxNE hyNE hxNM hyNM g).ker = ⊤) :
    a = 1 := by
  apply localDerivedRestrictionKernel_eq_one_of_cyclic_factor
    hqp hME hE hxNE hyNE hxNM hyNM a haorder
  intro g hga
  exact (pairGeneratedCyclicFactorHom_ker_eq_top_iff
    M E hxNE hyNE hxNM hyNM g).mp (hfactor g hga)

/-- The local restriction kernel is p-primary when all cross-prime cyclic
lifts have trivial factor action. -/
theorem localDerivedRestrictionKernel_isPGroup_of_cyclic_factor_action
    {p : ℕ} [Fact p.Prime]
    {M E : Subgroup G} (hME : M ≤ E) [(M.subgroupOf E).Normal]
    (hE : IsPGroup p E) {x y : G}
    (hxNE : x ∈ Subgroup.normalizer (E : Set G))
    (hyNE : y ∈ Subgroup.normalizer (E : Set G))
    (hxNM : x ∈ Subgroup.normalizer (M : Set G))
    (hyNM : y ∈ Subgroup.normalizer (M : Set G))
    (hfactor : ∀ (q : ℕ), q.Prime → q ≠ p →
      ∀ a : localDerivedRestrictionKernel hME hxNE hyNE hxNM hyNM,
        orderOf a = q →
        ∀ g : pairGenerated x y,
          pairGeneratedLocalQuotientHom E hxNE hyNE g =
            ((a : _root_.commutator (localQuotientPair E hxNE hyNE)) :
              localQuotientPair E hxNE hyNE) →
          (pairGeneratedCyclicFactorHom M E hxNE hyNE hxNM hyNM g).ker = ⊤) :
    IsPGroup p
      (localDerivedRestrictionKernel hME hxNE hyNE hxNM hyNM) := by
  apply localDerivedRestrictionKernel_isPGroup_of_prime_order_elements
  intro q hq hqp a haorder
  letI : Fact q.Prime := ⟨hq⟩
  exact localDerivedRestrictionKernel_eq_one_of_cyclic_factor_action
    hqp hME hE hxNE hyNE hxNM hyNM a haorder
      (hfactor q hq hqp a haorder)

/-- A p-primary result on the smaller local derived subgroup lifts across a
trivial cyclic factor action. -/
theorem local_commutator_isPGroup_of_cyclic_factor_action
    {p : ℕ} [Fact p.Prime]
    {M E : Subgroup G} (hME : M ≤ E) [(M.subgroupOf E).Normal]
    (hE : IsPGroup p E) {x y : G}
    (hxNE : x ∈ Subgroup.normalizer (E : Set G))
    (hyNE : y ∈ Subgroup.normalizer (E : Set G))
    (hxNM : x ∈ Subgroup.normalizer (M : Set G))
    (hyNM : y ∈ Subgroup.normalizer (M : Set G))
    (hsmall : IsPGroup p
      (_root_.commutator (localQuotientPair M hxNM hyNM)))
    (hfactor : ∀ (q : ℕ), q.Prime → q ≠ p →
      ∀ a : localDerivedRestrictionKernel hME hxNE hyNE hxNM hyNM,
        orderOf a = q →
        ∀ g : pairGenerated x y,
          pairGeneratedLocalQuotientHom E hxNE hyNE g =
            ((a : _root_.commutator (localQuotientPair E hxNE hyNE)) :
              localQuotientPair E hxNE hyNE) →
          (pairGeneratedCyclicFactorHom M E hxNE hyNE hxNM hyNM g).ker = ⊤) :
    IsPGroup p
      (_root_.commutator (localQuotientPair E hxNE hyNE)) := by
  apply local_commutator_isPGroup_of_restriction
    hME hxNE hyNE hxNM hyNM hsmall
  exact localDerivedRestrictionKernel_isPGroup_of_cyclic_factor_action
    hME hE hxNE hyNE hxNM hyNM hfactor

end Finite

end Submission.OddOrder.BG.AppendixAB
