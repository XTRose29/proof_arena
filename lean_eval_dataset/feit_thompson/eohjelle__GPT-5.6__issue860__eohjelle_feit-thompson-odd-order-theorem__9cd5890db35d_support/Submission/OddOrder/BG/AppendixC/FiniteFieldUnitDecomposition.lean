import Mathlib.GroupTheory.Complement
import Submission.OddOrder.BG.AppendixC.Arithmetic
import Submission.OddOrder.BG.AppendixC.FiniteFieldUnitAction

/-!
# The full unit-group decomposition in Bender--Glauberman Appendix C

This file ports `BGappendixC.v`, lines 181--204 (Remark VIII).  The
faithful image of `U` in the unit group of the Appendix C finite field and
the units coming from the prime field form complementary subgroups.  Thus
every nonzero field element factors uniquely as one of the `U`-scalars
times a prime-field scalar.
-/

namespace Submission.OddOrder.BG.AppendixC

noncomputable section

universe u v

variable {G : Type u} [Group G]

/-- The subgroup of `Fˣ` obtained by embedding the units of its prime
field.  This is Coq's subgroup `[set u | uval u \in Fp]`. -/
def primeFieldUnitRange (p : ℕ) (F : Type v)
    [CommRing F] [Algebra (ZMod p) F] : Subgroup Fˣ :=
  (Units.map (algebraMap (ZMod p) F).toMonoidHom).range

namespace FiniteFieldImage

variable {P P0 U : Subgroup G} (h : FiniteFieldImage P P0 U)

/-- The embedded prime-field unit group has order `p - 1`. -/
theorem natCard_primeFieldUnitRange
    (p : ℕ) [Fact p.Prime] [Algebra (ZMod p) h.F] :
    Nat.card (primeFieldUnitRange p h.F) = p - 1 := by
  let f : (ZMod p)ˣ →* h.Fˣ :=
    Units.map (algebraMap (ZMod p) h.F).toMonoidHom
  have hf : Function.Injective f :=
    Units.map_injective (algebraMap (ZMod p) h.F).injective
  calc
    Nat.card (primeFieldUnitRange p h.F) = Nat.card (ZMod p)ˣ :=
      (Nat.card_congr (f.ofInjective hf).toEquiv).symm
    _ = p - 1 := by rw [Nat.card_units, Nat.card_zmod]

/-- The image of the faithful unit action has the same cardinality as
`U`. -/
theorem natCard_psi_range : Nat.card h.psi.range = Nat.card U :=
  (Nat.card_congr (h.psi.ofInjective h.psi_injective).toEquiv).symm

/-- A unit coming from the prime field has value in the additive line
generated by `1`. -/
theorem val_mem_primeAdditiveLine_of_mem_primeFieldUnitRange
    {p : ℕ} [Fact p.Prime] [Algebra (ZMod p) h.F]
    {a : h.Fˣ} (ha : a ∈ primeFieldUnitRange p h.F) :
    (a : h.F) ∈ primeAdditiveLine h.F := by
  rcases ha with ⟨b, rfl⟩
  change algebraMap (ZMod p) h.F (b : ZMod p) ∈
    AddSubgroup.zmultiples (1 : h.F)
  rw [← ZMod.natCast_zmod_val (b : ZMod p), map_natCast]
  simpa using
    (AddSubgroup.intCast_mem_zmultiples_one
      (R := h.F) (k := ((b : ZMod p).val : ℤ)))

/-- For a nonzero field element, belonging to the prime additive line is
equivalent to its associated unit coming from the prime field. -/
theorem mk0_mem_primeFieldUnitRange_iff
    {p : ℕ} [Fact p.Prime] [Algebra (ZMod p) h.F]
    (x : h.F) (hx : x ≠ 0) :
    Units.mk0 x hx ∈ primeFieldUnitRange p h.F ↔
      x ∈ primeAdditiveLine h.F := by
  constructor
  · exact h.val_mem_primeAdditiveLine_of_mem_primeFieldUnitRange
  · intro hxline
    rcases AddSubgroup.mem_zmultiples_iff.mp hxline with ⟨k, hk⟩
    let c : ZMod p := k
    have hcmap : algebraMap (ZMod p) h.F c = x := by
      change algebraMap (ZMod p) h.F (k : ZMod p) = x
      rw [map_intCast]
      simpa using hk
    have hc0 : c ≠ 0 := by
      intro hc
      apply hx
      rw [← hcmap, hc, map_zero]
    let cu : (ZMod p)ˣ := Units.mk0 c hc0
    refine ⟨cu, ?_⟩
    apply Units.ext
    simpa [cu] using hcmap

/-- Bender--Glauberman Appendix C, Remark VIII (`BGappendixC.v: defFU`).

The field-unit image of `U` and the embedded prime-field units are an
internal direct product.  `Subgroup.IsComplement'` says precisely that
multiplication from the two subgroups to `h.Fˣ` is bijective. -/
theorem finiteFieldUnitDecomposition
    {p q : ℕ} [Fact p.Prime] [Algebra (ZMod p) h.F]
    (hcardF : Nat.card h.F = p ^ q)
    (hcardU : Nat.card U = nU p q)
    (hcop : (nU p q).Coprime (p - 1)) :
    h.psi.range.IsComplement' (primeFieldUnitRange p h.F) := by
  apply Subgroup.isComplement'_of_coprime
  · calc
      Nat.card h.psi.range * Nat.card (primeFieldUnitRange p h.F) =
          nU p q * (p - 1) := by
            rw [h.natCard_psi_range, hcardU,
              h.natCard_primeFieldUnitRange p]
      _ = p ^ q - 1 :=
        nU_mul_sub_one p q (Fact.out : p.Prime).one_lt.le
      _ = Nat.card h.Fˣ := by rw [Nat.card_units, hcardF]
  · rw [h.natCard_psi_range, hcardU,
      h.natCard_primeFieldUnitRange p]
    exact hcop

/-- Source-name alias for Remark VIII. -/
theorem defFU
    {p q : ℕ} [Fact p.Prime] [Algebra (ZMod p) h.F]
    (hcardF : Nat.card h.F = p ^ q)
    (hcardU : Nat.card U = nU p q)
    (hcop : (nU p q).Coprime (p - 1)) :
    h.psi.range.IsComplement' (primeFieldUnitRange p h.F) :=
  h.finiteFieldUnitDecomposition hcardF hcardU hcop

end FiniteFieldImage

end

end Submission.OddOrder.BG.AppendixC
