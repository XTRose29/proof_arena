import Mathlib.Algebra.Group.Subgroup.ZPowers.Lemmas
import Mathlib.FieldTheory.Finite.Basic
import Submission.OddOrder.MathlibSupport.SubgroupConjugationQuotientAction

/-!
# The finite-field image in Bender--Glauberman Appendix C

This is the data-carrying Lean version of the external `finFieldImage`
hypothesis at the start of `BGappendixC.v`.  The group `P` is identified,
additively, with a finite field.  The subgroup `P0` is the inverse image of
the additive line generated by `1`, and `U` embeds in the unit group of the
field.  The embedding is compatible with the source convention
`x ^ u = u⁻¹ * x * u` for conjugation.

Normalization of `P` by `U` comes from the separate semidirect-product
hypothesis in the source.  It is therefore supplied to the equivariance law
when that law is used, rather than being folded into the finite-field-image
data.
-/

namespace Submission.OddOrder.BG.AppendixC

open Submission.OddOrder.MathlibSupport

universe u v

variable {G : Type u} [Group G]

/-- The additive subgroup generated by `1` in a field.  For a finite field
this is the additive group of its prime subfield. -/
def primeAdditiveLine (F : Type*) [Field F] : AddSubgroup F :=
  AddSubgroup.zmultiples (1 : F)

/-- Right conjugation in the convention used by MathComp's `x ^ u`.

The project-wide subgroup conjugation action is left conjugation, so the
source operation is its action by `u⁻¹`. -/
def rightConjugate (P U : Subgroup G)
    (hUP : U ≤ Subgroup.normalizer (P : Set G))
    (x : P) (u : U) : P :=
  letI := subgroupConjugationAction P U hUP
  u⁻¹ • x

/-- Coercing source-style right conjugation back to the ambient group gives
the expected expression `u⁻¹ * x * u`. -/
theorem coe_rightConjugate (P U : Subgroup G)
    (hUP : U ≤ Subgroup.normalizer (P : Set G))
    (x : P) (u : U) :
    ((rightConjugate P U hUP x u : P) : G) =
      (u : G)⁻¹ * (x : G) * (u : G) := by
  letI := subgroupConjugationAction P U hUP
  change ((u⁻¹ • x : P) : G) = (u : G)⁻¹ * (x : G) * (u : G)
  simpa using
    (coe_subgroupConjugationAction_smul P U hUP (u⁻¹) x)

/-- The external finite-field realization assumed in Appendix C.

This packages exactly the mathematical content of Coq's `finFieldImage`:
an additive isomorphism from `P` to a finite field, the description of
`P0`, a faithful homomorphism from `U` to the field units, and compatibility
with conjugation. -/
structure FiniteFieldImage (P P0 U : Subgroup G) where
  /-- The finite field realizing the additive group `P`. -/
  F : Type v
  [fieldF : Field F]
  [fintypeF : Fintype F]
  /-- The additive realization of the multiplicative group `P`. -/
  sigma : Additive P ≃+ F
  /-- The distinguished subgroup lies in `P`. -/
  p0_le : P0 ≤ P
  /-- `P0` is the inverse image of the prime-subfield additive line. -/
  primeLine_comap :
    (primeAdditiveLine F).comap sigma.toAddMonoidHom =
      (P0.subgroupOf P).toAddSubgroup
  /-- The unit-valued action of `U`. -/
  psi : U →* Fˣ
  /-- The unit-valued action is faithful. -/
  psi_injective : Function.Injective psi
  /-- Equivariance for MathComp's right-conjugation convention. -/
  conjugation_compatibility :
    ∀ (hUP : U ≤ Subgroup.normalizer (P : Set G)) (x : P) (u : U),
      sigma (Additive.ofMul (rightConjugate P U hUP x u)) =
        sigma (Additive.ofMul x) * (psi u : F)

namespace FiniteFieldImage

attribute [instance] fieldF fintypeF

variable {P P0 U : Subgroup G} (h : FiniteFieldImage P P0 U)

/-- The field value underlying the unit-valued homomorphism `psi`. -/
def psiValue (u : U) : h.F :=
  h.psi u

/-- The additive realization is injective. -/
theorem sigma_injective : Function.Injective h.sigma :=
  h.sigma.injective

/-- The additive realization fills the finite field. -/
theorem sigma_surjective : Function.Surjective h.sigma :=
  h.sigma.surjective

/-- The additive realization preserves cardinality. -/
theorem natCard_P_eq_field : Nat.card P = Nat.card h.F :=
  Nat.card_congr h.sigma.toEquiv

/-- Membership in `P0` is detected by the prime-subfield additive line. -/
theorem mem_p0_iff_sigma_mem_primeAdditiveLine (x : P) :
    (x : G) ∈ P0 ↔
      h.sigma (Additive.ofMul x) ∈ primeAdditiveLine h.F := by
  change Additive.ofMul x ∈ (P0.subgroupOf P).toAddSubgroup ↔ _
  rw [← h.primeLine_comap]
  rfl

/-! ### The elementary `sigma` identities -/

@[simp]
theorem sigma_one :
    h.sigma (Additive.ofMul (1 : P)) = 0 :=
  h.sigma.map_zero

@[simp]
theorem sigma_mul (x y : P) :
    h.sigma (Additive.ofMul (x * y)) =
      h.sigma (Additive.ofMul x) + h.sigma (Additive.ofMul y) :=
  h.sigma.map_add _ _

@[simp]
theorem sigma_inv (x : P) :
    h.sigma (Additive.ofMul x⁻¹) = -h.sigma (Additive.ofMul x) :=
  h.sigma.map_neg _

@[simp]
theorem sigma_pow (x : P) (n : ℕ) :
    h.sigma (Additive.ofMul (x ^ n)) =
      n • h.sigma (Additive.ofMul x) := by
  change h.sigma (n • Additive.ofMul x) =
    n • h.sigma (Additive.ofMul x)
  exact h.sigma.toAddMonoidHom.map_nsmul _ _

/-! ### The elementary `psi` identities -/

@[simp]
theorem psiValue_one : h.psiValue 1 = 1 := by
  simp [psiValue]

@[simp]
theorem psiValue_mul (u v : U) :
    h.psiValue (u * v) = h.psiValue u * h.psiValue v := by
  simp [psiValue]

@[simp]
theorem psiValue_inv (u : U) :
    h.psiValue u⁻¹ = (h.psiValue u)⁻¹ := by
  simp [psiValue]

@[simp]
theorem psiValue_pow (u : U) (n : ℕ) :
    h.psiValue (u ^ n) = (h.psiValue u) ^ n := by
  simp [psiValue]

/-- Unit values are nonzero. -/
theorem psiValue_ne_zero (u : U) : h.psiValue u ≠ 0 :=
  Units.ne_zero (h.psi u)

/-- Faithfulness remains visible after forgetting from units to the field. -/
theorem psiValue_injective : Function.Injective h.psiValue := by
  intro u v huv
  apply h.psi_injective
  exact Units.ext huv

/-! ### The distinguished preimage of `1` -/

/-- The element of `P` whose field image is `1`. -/
def onePreimage : P :=
  Additive.toMul (h.sigma.symm 1)

@[simp]
theorem sigma_onePreimage :
    h.sigma (Additive.ofMul h.onePreimage) = 1 := by
  simp [onePreimage]

/-- The prime-line preimage is additively generated by the distinguished
preimage of `1`. -/
theorem p0_toAddSubgroup_eq_zmultiples_onePreimage :
    (P0.subgroupOf P).toAddSubgroup =
      AddSubgroup.zmultiples (Additive.ofMul h.onePreimage) := by
  calc
    (P0.subgroupOf P).toAddSubgroup =
        (primeAdditiveLine h.F).comap h.sigma.toAddMonoidHom :=
      h.primeLine_comap.symm
    _ = ((AddSubgroup.zmultiples (Additive.ofMul h.onePreimage)).map
          h.sigma.toAddMonoidHom).comap h.sigma.toAddMonoidHom := by
      rw [AddMonoidHom.map_zmultiples]
      have hone :
          h.sigma.toAddMonoidHom (Additive.ofMul h.onePreimage) = 1 :=
        h.sigma_onePreimage
      rw [hone]
      rfl
    _ = AddSubgroup.zmultiples (Additive.ofMul h.onePreimage) :=
      AddSubgroup.comap_map_eq_self_of_injective h.sigma.injective _

/-- The distinguished preimage of `1` belongs to `P0`. -/
theorem onePreimage_mem_p0 : (h.onePreimage : G) ∈ P0 := by
  change Additive.ofMul h.onePreimage ∈
    (P0.subgroupOf P).toAddSubgroup
  rw [h.p0_toAddSubgroup_eq_zmultiples_onePreimage]
  exact AddSubgroup.mem_zmultiples _

/-- The distinguished preimage is nonidentity. -/
theorem onePreimage_ne_one : h.onePreimage ≠ 1 := by
  intro hs
  have hzeroOne : (0 : h.F) = 1 := by
    simpa [hs] using h.sigma_onePreimage
  exact zero_ne_one hzeroOne

/-! ### Conjugation compatibility -/

/-- The stored equivariance law, exposed with the normalization hypothesis
that comes from the semidirect-product decomposition in Appendix C. -/
theorem sigma_rightConjugate
    (hUP : U ≤ Subgroup.normalizer (P : Set G)) (x : P) (u : U) :
    h.sigma (Additive.ofMul (rightConjugate P U hUP x u)) =
      h.sigma (Additive.ofMul x) * h.psiValue u :=
  h.conjugation_compatibility hUP x u

/-- If `sigma s = 1`, the unit value `psi u` is the field image of the
right conjugate `s ^ u`; this is `psiE` in the Coq source. -/
theorem psiValue_eq_sigma_rightConjugate
    (hUP : U ≤ Subgroup.normalizer (P : Set G))
    (s : P) (hs : h.sigma (Additive.ofMul s) = 1) (u : U) :
    h.psiValue u =
      h.sigma (Additive.ofMul (rightConjugate P U hUP s u)) := by
  simpa [hs] using (h.sigma_rightConjugate hUP s u).symm

end FiniteFieldImage

end Submission.OddOrder.BG.AppendixC
