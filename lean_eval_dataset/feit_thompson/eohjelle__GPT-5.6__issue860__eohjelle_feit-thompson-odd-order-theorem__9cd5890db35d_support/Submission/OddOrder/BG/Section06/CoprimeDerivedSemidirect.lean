import Submission.OddOrder.MathlibSupport.Centralizer
import Submission.OddOrder.MathlibSupport.ComplementQuotient

/-!
Bender--Glauberman Lemma 6.3(a).

The small norm argument below is the abelian coprime-action ingredient used
after passing to the abelianization of the normal factor.
-/

namespace Submission.OddOrder.BG.Section06

open Submission.OddOrder.MathlibSupport
open scoped BigOperators IsMulCommutative commutatorElement

universe u v

section ActionNorm

variable (R : Type u) (A : Type v)
variable [Group R] [CommGroup A] [Fintype R] [MulDistribMulAction R A]

/-- The multiplicative norm of a finite group action on a commutative group. -/
noncomputable def actionNormHom : A →* A where
  toFun a := ∏ r : R, r • a
  map_one' := by simp
  map_mul' a b := by simp [Finset.prod_mul_distrib]

/-- The subgroup generated by the action differences `(r • a) * a⁻¹`. -/
def actionCommutator : Subgroup A :=
  Subgroup.closure {x | ∃ r : R, ∃ a : A, (r • a) * a⁻¹ = x}

theorem actionNormHom_smul (r : R) (a : A) :
    actionNormHom R A (r • a) = actionNormHom R A a := by
  change (∏ x : R, x • (r • a)) = ∏ x : R, x • a
  exact Fintype.prod_equiv (Equiv.mulRight r)
    (fun x : R ↦ x • (r • a)) (fun x : R ↦ x • a)
    (fun x ↦ (mul_smul x r a).symm)

theorem actionCommutator_le_actionNormHom_ker :
    actionCommutator R A ≤ (actionNormHom R A).ker := by
  rw [actionCommutator, Subgroup.closure_le]
  rintro x ⟨r, a, rfl⟩
  change actionNormHom R A ((r • a) * a⁻¹) = 1
  rw [map_mul, map_inv, actionNormHom_smul, mul_inv_cancel]

theorem fixed_eq_one_of_actionCommutator_eq_top
    (hcop : (Nat.card A).Coprime (Nat.card R))
    (hperfect : actionCommutator R A = ⊤)
    (a : A) (hfix : ∀ r : R, r • a = a) :
    a = 1 := by
  have haNorm : actionNormHom R A a = 1 := by
    rw [← MonoidHom.mem_ker]
    exact actionCommutator_le_actionNormHom_ker R A
      (by rw [hperfect]; exact Subgroup.mem_top a)
  have haPow : a ^ Nat.card R = 1 := by
    rw [← haNorm]
    simp [actionNormHom, hfix]
  apply (powCoprime hcop).injective
  simp only [powCoprime_apply, haPow, one_pow]

end ActionNorm

section ConjugationNorm

variable {X : Type u} [Group X] [Finite X]
variable {A R : Subgroup X}

/-- A fixed point of a perfect coprime action on an abelian normal factor is
trivial.  This is the multiplicative norm argument in the proof of Bender--
Glauberman Lemma 6.3(a). -/
theorem fixed_eq_one_of_abelian_perfect_coprime_conjugation
    [IsMulCommutative A]
    (hnorm : R ≤ Subgroup.normalizer (A : Set X))
    (hcop : (Nat.card A).Coprime (Nat.card R))
    (hperfect : ⁅R, A⁆ = A)
    (a : A)
    (hfix : ∀ r : R, (r : X) * (a : X) * (r : X)⁻¹ = (a : X)) :
    a = 1 := by
  letI : Fintype R := Fintype.ofFinite R
  let act : R →* MulAut A :=
    A.normalizerMonoidHom.comp (Subgroup.inclusion hnorm)
  letI : MulDistribMulAction R A :=
    MulDistribMulAction.compHom A act
  have hsmul (r : R) (b : A) :
      ((r • b : A) : X) = (r : X) * (b : X) * (r : X)⁻¹ := by
    rfl
  have hmap : (actionCommutator R A).map A.subtype = ⁅R, A⁆ := by
    apply le_antisymm
    · rw [Subgroup.map_le_iff_le_comap, actionCommutator, Subgroup.closure_le]
      rintro x ⟨r, b, rfl⟩
      change ((r • b : A) : X) * (b : X)⁻¹ ∈ ⁅R, A⁆
      rw [hsmul]
      exact Subgroup.commutator_mem_commutator r.property b.property
    · rw [Subgroup.commutator_le]
      intro r hr b hb
      let rr : R := ⟨r, hr⟩
      let bb : A := ⟨b, hb⟩
      exact ⟨(rr • bb) * bb⁻¹, Subgroup.subset_closure ⟨rr, bb, rfl⟩, by
        change ((rr • bb : A) : X) * (bb : X)⁻¹ = ⁅r, b⁆
        rw [hsmul]
        rfl⟩
  have hactionPerfect : actionCommutator R A = ⊤ := by
    apply Subgroup.map_injective A.subtype_injective
    rw [hmap, hperfect, ← MonoidHom.range_eq_map, A.range_subtype]
  apply fixed_eq_one_of_actionCommutator_eq_top R A hcop hactionPerfect a
  intro r
  exact Subtype.ext (by simpa only [hsmul] using hfix r)

end ConjugationNorm

section DerivedSemidirect

variable {G : Type u} [Group G] [Finite G]
variable {K H : Subgroup G}

omit [Finite G] in
/-- If a solvable normal factor of an internal semidirect product is already
contained in the ambient derived subgroup, the mixed commutator is the whole
normal factor.  Coprimality is not needed for this half of Lemma 6.3(a). -/
theorem commutator_eq_left_of_isComplement_of_solvable_of_le_commutator
    [IsSolvable K]
    (hKH : K.IsComplement' H)
    (hnormK : H ≤ Subgroup.normalizer (K : Set G))
    (hKder : K ≤ _root_.commutator G) :
    ⁅K, H⁆ = K := by
  classical
  letI : K.Normal := by
    rw [← Subgroup.normalizer_eq_top_iff]
    apply top_unique
    rw [← hKH.sup_eq_top]
    exact sup_le Subgroup.le_normalizer hnormK
  let R : Subgroup G := ⁅K, H⁆
  have hRK : R ≤ K := by
    exact Subgroup.le_normalizer_iff_commutator_le_left.mp hnormK
  letI : R.Normal := by
    rw [← Subgroup.normalizer_eq_top_iff]
    apply top_unique
    rw [← hKH.sup_eq_top]
    exact sup_le
      (Subgroup.normalizer_commutator_ge_left K H)
      (Subgroup.normalizer_commutator_ge_right K H)
  let q : G →* G ⧸ R := QuotientGroup.mk' R
  let Kq : Subgroup (G ⧸ R) := K.map q
  let Hq : Subgroup (G ⧸ R) := H.map q
  letI : Kq.Normal :=
    Subgroup.Normal.map (inferInstance : K.Normal) q
      (QuotientGroup.mk'_surjective R)
  have hcomp : Kq.IsComplement' Hq := by
    simpa [Kq, Hq, q] using hKH.quotient_isComplement hRK
  have hcross : ⁅Kq, Hq⁆ = ⊥ := by
    dsimp [Kq, Hq]
    rw [← Subgroup.map_commutator, Subgroup.map_eq_bot_iff]
    simpa [q, QuotientGroup.ker_mk', R]
  letI : Hq.Normal := by
    rw [← Subgroup.normalizer_eq_top_iff]
    apply top_unique
    rw [← hcomp.sup_eq_top]
    apply sup_le
    · exact Subgroup.le_normalizer_iff_commutator_le_right.mpr
        (by rw [hcross]; exact bot_le)
    · exact Subgroup.le_normalizer
  let e : (G ⧸ R) ⧸ Hq ≃* Kq := hcomp.QuotientMulEquiv
  let f : (G ⧸ R) →* Kq :=
    e.toMonoidHom.comp (QuotientGroup.mk' Hq)
  have hfK (k : Kq) : f (k : G ⧸ R) = k := by
    dsimp [f, e]
    change hcomp.leftQuotientEquiv (QuotientGroup.mk' Hq (k : G ⧸ R)) = k
    apply hcomp.leftQuotientEquiv.symm.injective
    simp only [Equiv.symm_apply_apply]
    rfl
  have hfrange : f.range = ⊤ := by
    rw [MonoidHom.range_eq_top]
    intro k
    exact ⟨(k : G ⧸ R), hfK k⟩
  have hmapDer : (_root_.commutator G).map q =
      _root_.commutator (G ⧸ R) := by
    rw [map_commutator_eq, MonoidHom.range_eq_top.mpr
      (QuotientGroup.mk'_surjective R)]
    rfl
  have hKqDer : Kq ≤ _root_.commutator (G ⧸ R) := by
    rintro x ⟨k, hk, rfl⟩
    rw [← hmapDer]
    exact ⟨k, hKder hk, rfl⟩
  have hKqPerfect : _root_.commutator Kq = ⊤ := by
    rw [eq_top_iff]
    intro k _
    have hkDer : (k : G ⧸ R) ∈ _root_.commutator (G ⧸ R) :=
      hKqDer k.property
    have hfkDer : f (k : G ⧸ R) ∈
        (_root_.commutator (G ⧸ R)).map f :=
      Subgroup.mem_map_of_mem f hkDer
    rw [map_commutator_eq, hfrange] at hfkDer
    simpa [hfK k, _root_.commutator_def] using hfkDer
  letI : IsSolvable Kq :=
    solvable_of_surjective (f := q.subgroupMap K)
      (q.subgroupMap_surjective K)
  have hKqBot : Kq = ⊥ := by
    by_contra hne
    letI : Nontrivial Kq :=
      (Subgroup.nontrivial_iff_ne_bot Kq).mpr hne
    exact (IsSolvable.commutator_lt_top_of_nontrivial Kq).ne hKqPerfect
  apply le_antisymm hRK
  have hKR : K ≤ q.ker :=
    (Subgroup.map_eq_bot_iff K).mp hKqBot
  simpa [q, QuotientGroup.ker_mk'] using hKR

/-- `BGsection6.coprime_der1_sdprod`, Bender--Glauberman Lemma 6.3(a).

MathComp's `K ><| H = G` is represented by the complement condition together
with the explicit normalization hypothesis. -/
theorem coprime_der1_sdprod
    [IsSolvable K]
    (hKH : K.IsComplement' H)
    (hnormK : H ≤ Subgroup.normalizer (K : Set G))
    (hcop : (Nat.card K).Coprime (Nat.card H))
    (hKder : K ≤ _root_.commutator G) :
    ⁅K, H⁆ = K ∧ centralizerWithin K H ≤ ⁅K, K⁆ := by
  classical
  have hperfect : ⁅K, H⁆ = K :=
    commutator_eq_left_of_isComplement_of_solvable_of_le_commutator
      hKH hnormK hKder
  refine ⟨hperfect, ?_⟩
  letI : K.Normal := by
    rw [← Subgroup.normalizer_eq_top_iff]
    apply top_unique
    rw [← hKH.sup_eq_top]
    exact sup_le Subgroup.le_normalizer hnormK
  let N : Subgroup G := ⁅K, K⁆
  letI : N.Normal := by
    dsimp [N]
    infer_instance
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  let Kq : Subgroup (G ⧸ N) := K.map q
  let Hq : Subgroup (G ⧸ N) := H.map q
  letI : Kq.Normal :=
    Subgroup.Normal.map (inferInstance : K.Normal) q
      (QuotientGroup.mk'_surjective N)
  have hKqComm : ⁅Kq, Kq⁆ = ⊥ := by
    dsimp [Kq]
    rw [← Subgroup.map_commutator, Subgroup.map_eq_bot_iff]
    simpa [q, QuotientGroup.ker_mk', N]
  letI : IsMulCommutative Kq := by
    have hcent : Kq ≤ Subgroup.centralizer (Kq : Set (G ⧸ N)) :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mp hKqComm
    refine ⟨⟨fun x y ↦ ?_⟩⟩
    apply Subtype.ext
    exact hcent y.property x x.property
  have hperfectq : ⁅Hq, Kq⁆ = Kq := by
    dsimp [Hq, Kq]
    rw [← Subgroup.map_commutator, Subgroup.commutator_comm H K,
      hperfect]
  have hcopq : (Nat.card Kq).Coprime (Nat.card Hq) := by
    have hKdiv : Nat.card Kq ∣ Nat.card K :=
      Subgroup.card_map_dvd K q
    have hHdiv : Nat.card Hq ∣ Nat.card H :=
      Subgroup.card_map_dvd H q
    exact (hcop.coprime_dvd_left hKdiv).coprime_dvd_right hHdiv
  have hnormKq : Hq ≤ Subgroup.normalizer (Kq : Set (G ⧸ N)) := by
    rw [Kq.normalizer_eq_top]
    exact le_top
  intro c hc
  let cq : Kq := ⟨q c, ⟨c, hc.1, rfl⟩⟩
  have hfix : ∀ r : Hq,
      (r : G ⧸ N) * (cq : G ⧸ N) * (r : G ⧸ N)⁻¹ =
        (cq : G ⧸ N) := by
    intro r
    rcases r.property with ⟨r₀, hr₀, hr⟩
    have hcomm : r₀ * c = c * r₀ :=
      (mem_centralizerWithin.mp hc).2 r₀ hr₀
    change (r : G ⧸ N) * q c * (r : G ⧸ N)⁻¹ = q c
    rw [← hr]
    calc
      q r₀ * q c * (q r₀)⁻¹ = q (r₀ * c * r₀⁻¹) := by simp
      _ = q c := by rw [hcomm]; simp
  have hcq : cq = 1 :=
    fixed_eq_one_of_abelian_perfect_coprime_conjugation
      hnormKq hcopq hperfectq cq hfix
  change c ∈ N
  apply (QuotientGroup.eq_one_iff c).mp
  exact congrArg Subtype.val hcq

end DerivedSemidirect

end Submission.OddOrder.BG.Section06
