import Submission.OddOrder.MathlibSupport.SubgroupCardinality
import Submission.OddOrder.MathlibSupport.WielandtFixpoint
import Submission.OddOrder.MathlibSupport.OmegaOneCyclicMaximal

/-!
# The cyclic last-power factor in the abelian `tau2` branch

This file isolates the finite-abelian calculation in the central Sylow
branch of `BGsection12.v: FTtypeF_complement`.  If a finite abelian
`p`-group has first omega subgroup of rank two and its last nonzero power
subgroup is proper in omega one, then that last power subgroup has order
`p`.  For an element witnessing the exponent of the ambient group it is
therefore generated by the last nonzero power of that element.  Equivalently,
it is the image of omega one in the witness's cyclic subgroup.

The statements use `abelianPowerSubgroup` and `abelianOmegaOne` from the
Wielandt fixed-point development.  They contain no Section 12 group-theory
hypotheses, so the selected-Sylow assembly can reuse them directly.
-/

namespace Submission.OddOrder.BG.Section12

open Submission.OddOrder.MathlibSupport
open scoped IsMulCommutative

noncomputable section

universe u

variable {E : Type u} [Group E] [Finite E] [IsMulCommutative E]
variable {p : ℕ} [Fact p.Prime]

/-- The subgroup of `p ^ n`th powers in an abelian group is characteristic.

This is the range formulation of the familiar fact that every automorphism
preserves power subgroups. -/
instance abelianPowerSubgroup_characteristic (p n : ℕ) :
    (abelianPowerSubgroup p n E).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro e
  exact MulEquiv.map_range_powMonoidHom e (p ^ n)

/-- The last power of an exponent witness has order `p`. -/
private theorem orderOf_lastPower_exponentWitness
    (n : ℕ) (hexp : Monoid.exponent E = p ^ (n + 1))
    {z : E} (hz : orderOf z = Monoid.exponent E) :
    orderOf (z ^ (p ^ n)) = p := by
  have hpow_ne : p ^ n ≠ 0 :=
    pow_ne_zero n (Fact.out : p.Prime).ne_zero
  have hpow_dvd : p ^ n ∣ orderOf z := by
    rw [hz, hexp, pow_succ]
    exact dvd_mul_right _ _
  rw [orderOf_pow_of_dvd hpow_ne hpow_dvd, hz, hexp]
  simp [pow_succ, (Fact.out : p.Prime).ne_zero]

/-- In a finite abelian `p`-group whose omega-one subgroup has rank two, a
proper last nonzero power subgroup is generated by the last power of every
exponent witness.

This is the cardinality argument behind the proper
`'Mho^(n-1)(S) < 'Ohm_1(S)` branch of Coq Theorem 12.12. -/
theorem lastPower_eq_zpowers_of_rankTwo_proper
    (hE : IsPGroup p E)
    (n : ℕ) (hexp : Monoid.exponent E = p ^ (n + 1))
    (hOmega :
      IsElementaryAbelianOfRank p 2 (abelianOmegaOne p E))
    (hproper :
      abelianPowerSubgroup p n E < abelianOmegaOne p E)
    {z : E} (hz : orderOf z = Monoid.exponent E) :
    abelianPowerSubgroup p n E =
      Subgroup.zpowers (z ^ (p ^ n)) := by
  let L : Subgroup E := abelianPowerSubgroup p n E
  let w : E := z ^ (p ^ n)
  have hwL : w ∈ L := by
    exact ⟨z, rfl⟩
  have hwOrder : orderOf w = p := by
    simpa [w] using
      orderOf_lastPower_exponentWitness n hexp hz
  have hLcard_lt : Nat.card L < p ^ 2 := by
    have hcard := natCard_subgroup_lt_of_lt hproper
    simpa only [L, hOmega.card_eq] using hcard
  have hLp : IsPGroup p L := hE.to_subgroup L
  obtain ⟨m, hm⟩ := hLp.exists_card_eq
  have hp_dvd_L : p ∣ Nat.card L := by
    rw [← hwOrder]
    exact L.orderOf_dvd_natCard hwL
  have hm_ne_zero : m ≠ 0 := by
    intro hm0
    rw [hm, hm0, pow_zero] at hp_dvd_L
    exact (Fact.out : p.Prime).ne_one (Nat.dvd_one.mp hp_dvd_L)
  have hm_lt_two : m < 2 := by
    apply (Nat.pow_lt_pow_iff_right
      (Fact.out : p.Prime).one_lt).mp
    simpa only [hm] using hLcard_lt
  have hm_one : m = 1 := by omega
  have hLcard : Nat.card L = p := by
    simpa [hm_one] using hm
  have hzpowers_le : Subgroup.zpowers w ≤ L :=
    Subgroup.zpowers_le.mpr hwL
  have hzpowers_eq : Subgroup.zpowers w = L :=
    Subgroup.eq_of_le_of_card_ge hzpowers_le (by
      rw [hLcard, Nat.card_zpowers, hwOrder])
  simpa [L, w] using hzpowers_eq.symm

/-- In a cyclic group generated by an element of order `p ^ (n + 1)`,
omega one is generated by the element's `p ^ n`th power.  The equality is
stated after mapping the intrinsic omega subgroup back to the ambient
group. -/
theorem map_omegaOne_zpowers_eq_zpowers_lastPower
    (n : ℕ) {z : E} (hz : orderOf z = p ^ (n + 1)) :
    (omegaOne p (Subgroup.zpowers z)).map
        (Subgroup.zpowers z).subtype =
      Subgroup.zpowers (z ^ (p ^ n)) := by
  let X : Subgroup E := Subgroup.zpowers z
  let w : E := z ^ (p ^ n)
  have hXcard : Nat.card X = p ^ (n + 1) := by
    dsimp [X]
    rw [Nat.card_zpowers, hz]
  have hXp : IsPGroup p X := IsPGroup.of_card hXcard
  have hXcard_ne_one : Nat.card X ≠ 1 := by
    rw [hXcard]
    exact (one_lt_pow₀ (Fact.out : p.Prime).one_lt
      (Nat.succ_ne_zero n)).ne'
  letI : IsCyclic X := by
    dsimp [X]
    infer_instance
  have hOmegaCard : Nat.card (omegaOne p X) = p :=
    card_omegaOne_of_isCyclic_isPGroup
      (Fact.out : p.Prime) hXp hXcard_ne_one
  have hMapCard :
      Nat.card ((omegaOne p X).map X.subtype) = p := by
    rw [Subgroup.card_map_of_injective X.subtype_injective,
      hOmegaCard]
  have hpow_ne : p ^ n ≠ 0 :=
    pow_ne_zero n (Fact.out : p.Prime).ne_zero
  have hpow_dvd : p ^ n ∣ orderOf z := by
    rw [hz, pow_succ]
    exact dvd_mul_right _ _
  have hwOrder : orderOf w = p := by
    dsimp [w]
    rw [orderOf_pow_of_dvd hpow_ne hpow_dvd, hz]
    simp [pow_succ, (Fact.out : p.Prime).ne_zero]
  let wX : X := ⟨w, by
    dsimp [w, X]
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers z) (p ^ n)⟩
  have hwXpow : wX ^ p = 1 := by
    apply Subtype.ext
    change (z ^ (p ^ n)) ^ p = 1
    rw [← pow_mul, ← pow_succ, ← hz, pow_orderOf_eq_one]
  have hwOmega : wX ∈ omegaOne p X :=
    mem_omegaOne_of_pow_eq_one p hwXpow
  have hwMap : w ∈ (omegaOne p X).map X.subtype :=
    ⟨wX, hwOmega, rfl⟩
  have hzpowers_le :
      Subgroup.zpowers w ≤ (omegaOne p X).map X.subtype :=
    Subgroup.zpowers_le.mpr hwMap
  have hzpowers_eq_map :
      Subgroup.zpowers w = (omegaOne p X).map X.subtype :=
    Subgroup.eq_of_le_of_card_ge hzpowers_le (by
      rw [hMapCard, Nat.card_zpowers, hwOrder])
  simpa [X, w] using hzpowers_eq_map.symm

/-- For an exponent witness in the proper rank-two branch, its cyclic
omega-one subgroup maps onto the ambient last power subgroup.

The first conjunct records the concrete generator as well.  Keeping both
equalities together avoids repeating the cyclic-subgroup coercion and
cardinality calculation at the Section 12 call site. -/
theorem map_omegaOne_zpowers_exponentWitness
    (hE : IsPGroup p E)
    (n : ℕ) (hexp : Monoid.exponent E = p ^ (n + 1))
    (hOmega :
      IsElementaryAbelianOfRank p 2 (abelianOmegaOne p E))
    (hproper :
      abelianPowerSubgroup p n E < abelianOmegaOne p E)
    {z : E} (hz : orderOf z = Monoid.exponent E) :
    abelianPowerSubgroup p n E =
        Subgroup.zpowers (z ^ (p ^ n)) ∧
      (omegaOne p (Subgroup.zpowers z)).map
          (Subgroup.zpowers z).subtype =
        abelianPowerSubgroup p n E := by
  let L : Subgroup E := abelianPowerSubgroup p n E
  let X : Subgroup E := Subgroup.zpowers z
  let w : E := z ^ (p ^ n)
  have hlast : L = Subgroup.zpowers w := by
    simpa [L, w] using
      lastPower_eq_zpowers_of_rankTwo_proper hE n hexp hOmega
        hproper hz
  refine ⟨by simpa [L, w] using hlast, ?_⟩
  have hcyclicOmega :
      (omegaOne p (Subgroup.zpowers z)).map
          (Subgroup.zpowers z).subtype =
        Subgroup.zpowers w := by
    simpa [w] using
      map_omegaOne_zpowers_eq_zpowers_lastPower
        (E := E) n (hz.trans hexp)
  calc
    (omegaOne p (Subgroup.zpowers z)).map
          (Subgroup.zpowers z).subtype =
        Subgroup.zpowers w := hcyclicOmega
    _ = L := hlast.symm
    _ = abelianPowerSubgroup p n E := rfl

end

end Submission.OddOrder.BG.Section12
