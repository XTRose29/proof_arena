import Submission.OddOrder.BG.Section07.UniqueMaximal
import Submission.OddOrder.MathlibSupport.Hall

/-!
# Bender--Glauberman, Section 7: normalized prime-set subgroups

This file ports the opening block under Hypothesis 7.1 in `BGsection7.v`.
MathComp's `pi.-group Y` is represented by `IsPiNumber pi (Nat.card Y)`.
-/

namespace Submission.OddOrder.BG.Section07

open Submission.OddOrder.MathlibSupport

universe u

variable {G : Type u} [Group G] [Finite G]

/-- A `pi`-subgroup normalized by `A`, inside `X`. -/
def normed_pgroups (X : Subgroup G) (A : Set G) (pi : Set ℕ) :
    Set (Subgroup G) :=
  {Y | Y ≤ X ∧ IsPiNumber pi (Nat.card Y) ∧
    A ⊆ Subgroup.normalizer (Y : Set G)}

/-- The predicate whose maximal elements form `max_normed_pgroups`. -/
def IsNormedPiCandidate (A : Set G) (pi : Set ℕ) (Y : Subgroup G) : Prop :=
  IsPiNumber pi (Nat.card Y) ∧ A ⊆ Subgroup.normalizer (Y : Set G)

/-- The maximal `pi`-subgroups normalized by `A`. -/
def max_normed_pgroups (A : Set G) (pi : Set ℕ) : Set (Subgroup G) :=
  {Y | Maximal (IsNormedPiCandidate A pi) Y}

/-- The `pi`-core of `X`: the subgroup generated by all normal `pi`-subgroups
of `X`.  This is the prime-set analogue of `pCore`. -/
def primeSetCore (pi : Set ℕ) (X : Subgroup G) : Subgroup G :=
  sSup {K : Subgroup G |
    K ≤ X ∧ (K.subgroupOf X).Normal ∧ IsPiNumber pi (Nat.card K)}

/-- Hypothesis 7.1: every relevant `pi(A)'`-subgroup lies in the
`pi(A)'`-core of the proper overgroup. -/
structure NormedConstrained (A : Subgroup G) : Prop where
  nontrivial : A ≠ ⊥
  proper : A < ⊤
  constrained :
    ∀ (X Y : Subgroup G), A ≤ X → X < ⊤ →
      Y ∈ normed_pgroups X (A : Set G)
        (primeSupport (Nat.card A))ᶜ →
      Y ≤ primeSetCore (primeSupport (Nat.card A))ᶜ X

/-- Every normalized `pi`-subgroup is contained in a maximal one. -/
theorem max_normed_exists (A : Set G) (pi : Set ℕ) (X : Subgroup G)
    (hXpi : IsPiNumber pi (Nat.card X))
    (hXA : A ⊆ Subgroup.normalizer (X : Set G)) :
    ∃ Y : Subgroup G,
      Y ∈ max_normed_pgroups A pi ∧ X ≤ Y := by
  have hX : IsNormedPiCandidate A pi X := ⟨hXpi, hXA⟩
  rcases Finite.exists_le_maximal hX with ⟨Y, hXY, hY⟩
  exact ⟨Y, hY, hXY⟩

/-- Membership in `max_normed_pgroups` includes both defining conditions. -/
theorem mem_max_normed {A : Set G} {pi : Set ℕ} {X : Subgroup G}
    (hX : X ∈ max_normed_pgroups A pi) :
    IsPiNumber pi (Nat.card X) ∧
      A ⊆ Subgroup.normalizer (X : Set G) :=
  hX.prop

private theorem subgroup_map_symm_map (H : Subgroup G) (e : G ≃* G) :
    (H.map e.toMonoidHom).map e.symm.toMonoidHom = H := by
  ext x
  simp

private theorem subgroup_symm_map_map (H : Subgroup G) (e : G ≃* G) :
    (H.map e.symm.toMonoidHom).map e.toMonoidHom = H := by
  simpa using subgroup_map_symm_map H e.symm

private theorem IsNormedPiCandidate.map
    (A Y : Subgroup G) (pi : Set ℕ) (e : G ≃* G)
    (hA : A.map e.toMonoidHom = A)
    (hY : IsNormedPiCandidate (A : Set G) pi Y) :
    IsNormedPiCandidate (A : Set G) pi (Y.map e.toMonoidHom) := by
  constructor
  · rw [Subgroup.card_map_of_injective e.injective]
    exact hY.1
  · have hnorm : A ≤ Subgroup.normalizer (Y : Set G) := hY.2
    have hmapped : A.map e.toMonoidHom ≤
        (Subgroup.normalizer (Y : Set G)).map e.toMonoidHom :=
      Subgroup.map_mono hnorm
    rw [hA, Subgroup.map_equiv_normalizer_eq Y e] at hmapped
    exact hmapped

private theorem mem_max_normed_map
    (A Q : Subgroup G) (pi : Set ℕ) (e : G ≃* G)
    (hA : A.map e.toMonoidHom = A)
    (hQ : Q ∈ max_normed_pgroups (A : Set G) pi) :
    Q.map e.toMonoidHom ∈ max_normed_pgroups (A : Set G) pi := by
  have hAinv : A.map e.symm.toMonoidHom = A := by
    calc
      A.map e.symm.toMonoidHom =
          (A.map e.toMonoidHom).map e.symm.toMonoidHom := by rw [hA]
      _ = A := subgroup_map_symm_map A e
  refine ⟨IsNormedPiCandidate.map A Q pi e hA hQ.prop, ?_⟩
  intro Y hY hQY
  let Y₀ : Subgroup G := Y.map e.symm.toMonoidHom
  have hY₀ : IsNormedPiCandidate (A : Set G) pi Y₀ :=
    IsNormedPiCandidate.map A Y pi e.symm hAinv hY
  have hQY₀ : Q ≤ Y₀ := by
    have hmapped : (Q.map e.toMonoidHom).map e.symm.toMonoidHom ≤
        Y.map e.symm.toMonoidHom :=
      Subgroup.map_mono hQY
    rw [subgroup_map_symm_map Q e] at hmapped
    exact hmapped
  have hY₀Q : Y₀ ≤ Q := hQ.2 hY₀ hQY₀
  have hmapped : Y₀.map e.toMonoidHom ≤ Q.map e.toMonoidHom :=
    Subgroup.map_mono hY₀Q
  change (Y.map e.symm.toMonoidHom).map e.toMonoidHom ≤
    Q.map e.toMonoidHom at hmapped
  rw [subgroup_symm_map_map Y e] at hmapped
  exact hmapped

/-- The normalizer of `P` acts on the maximal `pi`-subgroups normalized by
`P`.  This is `norm_acts_max_norm`. -/
theorem norm_acts_max_norm (P Q : Subgroup G) (pi : Set ℕ) (x : G)
    (hx : x ∈ Subgroup.normalizer (P : Set G)) :
    Q.map (MulAut.conj x).toMonoidHom ∈
        max_normed_pgroups (P : Set G) pi ↔
      Q ∈ max_normed_pgroups (P : Set G) pi := by
  let e : G ≃* G := MulAut.conj x
  have hP : P.map e.toMonoidHom = P :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp hx
  constructor
  · intro hQ
    have hPinv : P.map e.symm.toMonoidHom = P := by
      calc
        P.map e.symm.toMonoidHom =
            (P.map e.toMonoidHom).map e.symm.toMonoidHom := by rw [hP]
        _ = P := subgroup_map_symm_map P e
    have hback := mem_max_normed_map P (Q.map e.toMonoidHom) pi e.symm hPinv hQ
    change (Q.map e.toMonoidHom).map e.symm.toMonoidHom ∈
      max_normed_pgroups (P : Set G) pi at hback
    rw [subgroup_map_symm_map Q e] at hback
    exact hback
  · exact mem_max_normed_map P Q pi e hP

/-- If the trivial subgroup is maximal among the normalized `pi`-subgroups,
then it is the only maximal one. -/
theorem trivg_max_norm (P : Subgroup G) (pi : Set ℕ)
    (hbot : (⊥ : Subgroup G) ∈ max_normed_pgroups (P : Set G) pi) :
    max_normed_pgroups (P : Set G) pi = {⊥} := by
  ext Q
  constructor
  · intro hQ
    have hEq : (⊥ : Subgroup G) = Q := hbot.eq_of_le hQ.prop bot_le
    simpa [hEq]
  · intro hQ
    have hEq : Q = (⊥ : Subgroup G) := Set.mem_singleton_iff.mp hQ
    simpa [hEq] using hbot

/-- Enlarging the normalizing subgroup from `A` to `P` preserves a unique
maximal normalized `pi`-subgroup when `P` already normalizes it. -/
theorem max_normed_uniq (A P Q : Subgroup G) (pi : Set ℕ)
    (hAuniq : max_normed_pgroups (A : Set G) pi = {Q})
    (hAP : A ≤ P) (hPQ : P ≤ Subgroup.normalizer (Q : Set G)) :
    max_normed_pgroups (P : Set G) pi = {Q} := by
  have hQmaxA : Q ∈ max_normed_pgroups (A : Set G) pi := by
    rw [hAuniq]
    exact Set.mem_singleton Q
  have hQpi : IsPiNumber pi (Nat.card Q) := hQmaxA.prop.1
  have hQcandP : IsNormedPiCandidate (P : Set G) pi Q := ⟨hQpi, hPQ⟩
  have hQmaxP : Q ∈ max_normed_pgroups (P : Set G) pi := by
    refine ⟨hQcandP, ?_⟩
    intro X hX hQX
    have hXcandA : IsNormedPiCandidate (A : Set G) pi X :=
      ⟨hX.1, hAP.trans hX.2⟩
    exact hQmaxA.2 hXcandA hQX
  ext X
  constructor
  · intro hXmaxP
    have hXcandA : IsNormedPiCandidate (A : Set G) pi X :=
      ⟨hXmaxP.prop.1, hAP.trans hXmaxP.prop.2⟩
    rcases max_normed_exists (A : Set G) pi X hXcandA.1 hXcandA.2 with
      ⟨Y, hYmaxA, hXY⟩
    have hYQ : Y = Q := by
      rw [hAuniq] at hYmaxA
      exact Set.mem_singleton_iff.mp hYmaxA
    have hXQ : X ≤ Q := by simpa [hYQ] using hXY
    have hXeqQ : X = Q := hXmaxP.eq_of_le hQcandP hXQ
    simpa [hXeqQ]
  · intro hX
    have hXeqQ : X = Q := Set.mem_singleton_iff.mp hX
    simpa [hXeqQ] using hQmaxP

end Submission.OddOrder.BG.Section07
