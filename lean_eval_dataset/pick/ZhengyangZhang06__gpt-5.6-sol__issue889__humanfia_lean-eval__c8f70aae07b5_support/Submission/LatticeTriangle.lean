import Mathlib
import Submission.TriangleArea

open LeanEval.Geometry.PicksTheorem
open MeasureTheory

namespace Submission.LatticeTriangle

/-- Coordinatewise casting commutes with addition. -/
@[simp]
theorem toPlane_add (z w : ℤ × ℤ) :
    toPlane (z + w) = toPlane z + toPlane w := by
  ext <;> simp [toPlane]

/-- Coordinatewise casting commutes with negation. -/
@[simp]
theorem toPlane_neg (z : ℤ × ℤ) :
    toPlane (-z) = -toPlane z := by
  ext <;> simp [toPlane]

/-- Coordinatewise casting commutes with subtraction. -/
@[simp]
theorem toPlane_sub (z w : ℤ × ℤ) :
    toPlane (z - w) = toPlane z - toPlane w := by
  ext <;> simp [toPlane]

/-- Coordinatewise casting as an injective integer-linear map. -/
def toPlaneIntLinear : (ℤ × ℤ) →ₗ[ℤ] (ℝ × ℝ) where
  toFun := toPlane
  map_add' := toPlane_add
  map_smul' c z := by
    ext <;> simp [toPlane]

theorem toPlaneIntLinear_injective :
    Function.Injective toPlaneIntLinear := by
  intro z w h
  change toPlane z = toPlane w at h
  apply Prod.ext
  · have hfst : (z.1 : ℝ) = (w.1 : ℝ) := by
      simpa [toPlane] using congrArg Prod.fst h
    exact_mod_cast hfst
  · have hsnd : (z.2 : ℝ) = (w.2 : ℝ) := by
      simpa [toPlane] using congrArg Prod.snd h
    exact_mod_cast hsnd

/-- The affine triangle canonically associated to a simple lattice
three-polygon. -/
noncomputable def triangle (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    Affine.Triangle ℝ (ℝ × ℝ) :=
  (latPoly v).toTriangle ℝ
    (Submission.Triangle.hasNondegenerateVertices_of_isSimple
      (latPoly v) hsimple)

@[simp]
theorem triangle_points (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (i : Fin 3) :
    (triangle v hsimple).points i = toPlane (v i) :=
  rfl

/-- The two integer edge vectors based at vertex `0`. -/
def edgeInt (v : Fin 3 → ℤ × ℤ) : Fin 2 → ℤ × ℤ :=
  ![v 1 - v 0, v 2 - v 0]

@[simp]
theorem edgeInt_zero (v : Fin 3 → ℤ × ℤ) :
    edgeInt v 0 = v 1 - v 0 :=
  rfl

@[simp]
theorem edgeInt_one (v : Fin 3 → ℤ × ℤ) :
    edgeInt v 1 = v 2 - v 0 :=
  rfl

/-- Casting the integer edge vectors gives the real edge basis. -/
@[simp]
theorem toPlane_edgeInt (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (i : Fin 2) :
    toPlane (edgeInt v i) =
      Submission.TriangleArea.edgeBasis (triangle v hsimple) i := by
  fin_cases i <;>
    simp [edgeInt, Submission.TriangleArea.edgeBasis_zero,
      Submission.TriangleArea.edgeBasis_one]

/-- The two integer edge vectors are linearly independent over `ℤ`. -/
theorem edgeInt_linearIndependent (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    LinearIndependent ℤ (edgeInt v) := by
  apply LinearIndependent.of_comp toPlaneIntLinear
  have h :=
    (Submission.TriangleArea.edgeBasis
      (triangle v hsimple)).linearIndependent.restrict_scalars' ℤ
  change
    LinearIndependent ℤ
      (fun i => toPlane (edgeInt v i))
  rw [show
    (fun i => toPlane (edgeInt v i)) =
      Submission.TriangleArea.edgeBasis
        (triangle v hsimple) by
      funext i
      exact toPlane_edgeInt v hsimple i]
  exact h

/-- The integer sublattice generated by the two edge vectors. -/
def edgeLattice (v : Fin 3 → ℤ × ℤ) :
    Submodule ℤ (ℤ × ℤ) :=
  Submodule.span ℤ (Set.range (edgeInt v))

/-- The edge vectors give a basis of their generated integer sublattice. -/
noncomputable def edgeLatticeBasis (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    Module.Basis (Fin 2) ℤ (edgeLattice v) :=
  Module.Basis.span (edgeInt_linearIndependent v hsimple)

@[simp]
theorem edgeLatticeBasis_apply (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (i : Fin 2) :
    (edgeLatticeBasis v hsimple i : ℤ × ℤ) = edgeInt v i := by
  exact Module.Basis.coe_span_apply
    (edgeInt_linearIndependent v hsimple) i

/-- The signed integer determinant of the two edge vectors. -/
noncomputable def edgeDet (v : Fin 3 → ℤ × ℤ) : ℤ :=
  (Module.Basis.finTwoProd ℤ).det (edgeInt v)

/-- The index of the edge sublattice is the absolute edge determinant. -/
theorem edgeLattice_index (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    (edgeLattice v).toAddSubgroup.index =
      (edgeDet v).natAbs := by
  rw [AddSubgroup.index_eq_natAbs_det
    (Module.Basis.finTwoProd ℤ)
    (edgeLattice v).toAddSubgroup
    (edgeLatticeBasis v hsimple)]
  apply congrArg Int.natAbs
  apply congrArg ((Module.Basis.finTwoProd ℤ).det)
  funext i
  exact edgeLatticeBasis_apply v hsimple i

/-- The abstract real determinant used in the area formula is the cast of
the signed integer determinant. -/
theorem det_triangleLinearMap (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    LinearMap.det
        (Submission.TriangleArea.triangleLinearMap
          (triangle v hsimple)) =
      (edgeDet v : ℝ) := by
  rw [← LinearMap.det_toMatrix (Module.Basis.finTwoProd ℝ),
    Matrix.det_fin_two]
  simp [LinearMap.toMatrix_apply,
    Submission.TriangleArea.triangleLinearMap,
    edgeDet, Module.Basis.det_apply, Matrix.det_fin_two,
    Module.Basis.toMatrix_apply, edgeInt, toPlane]

/-- Integer points in the half-open fundamental parallelogram generated by
the two edge vectors. -/
def fundamentalPoints (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) : Set (ℤ × ℤ) :=
  {z |
    toPlane z ∈
      ZSpan.fundamentalDomain
        (Submission.TriangleArea.edgeBasis
          (triangle v hsimple))}

/-- These fundamental-parallelogram lattice points form a finite set. -/
theorem finite_fundamentalPoints (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    (fundamentalPoints v hsimple).Finite := by
  exact
    Submission.Helpers.finite_latticePoints_of_isBounded
      (ZSpan.fundamentalDomain_isBounded
        (Submission.TriangleArea.edgeBasis
          (triangle v hsimple)))

/-- Casting the integer edge lattice into the real plane gives the
integer span of the real edge basis. -/
theorem map_edgeLattice (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    (edgeLattice v).map toPlaneIntLinear =
      Submodule.span ℤ
        (Set.range
          (Submission.TriangleArea.edgeBasis
            (triangle v hsimple))) := by
  rw [edgeLattice, Submodule.map_span]
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_range]
  constructor
  · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, toPlane_edgeInt v hsimple i |>.symm⟩
  · rintro ⟨i, rfl⟩
    exact
      ⟨edgeInt v i, ⟨i, rfl⟩,
        toPlane_edgeInt v hsimple i⟩

/-- Every element of the real edge lattice is the cast of an element of
the integer edge lattice. -/
theorem exists_edgeLattice_of_mem_realSpan
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) {x : ℝ × ℝ}
    (hx :
      x ∈ Submodule.span ℤ
        (Set.range
          (Submission.TriangleArea.edgeBasis
            (triangle v hsimple)))) :
    ∃ z : edgeLattice v, toPlane z = x := by
  rw [← map_edgeLattice v hsimple] at hx
  rcases hx with ⟨z, hz, hzx⟩
  exact ⟨⟨z, hz⟩, hzx⟩

/-- The half-open fundamental parallelogram is a complete, unique set of
representatives for the quotient by the edge sublattice. -/
theorem fundamentalPoints_isComplement
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    AddSubgroup.IsComplement
      (fundamentalPoints v hsimple)
      (edgeLattice v).toAddSubgroup := by
  constructor
  · rintro ⟨q₁, l₁⟩ ⟨q₂, l₂⟩ heq
    change
      (q₁ : ℤ × ℤ) + l₁ =
        (q₂ : ℤ × ℤ) + l₂ at heq
    let b :=
      Submission.TriangleArea.edgeBasis
        (triangle v hsimple)
    let y : ℝ × ℝ := toPlane ((l₂ : ℤ × ℤ) - l₁)
    have hy :
        y ∈ Submodule.span ℤ (Set.range b) := by
      rw [← map_edgeLattice v hsimple]
      exact
        ⟨(l₂ : ℤ × ℤ) - l₁,
          (edgeLattice v).sub_mem l₂.property l₁.property,
          rfl⟩
    have hcast :
        toPlane q₁ = y + toPlane q₂ := by
      have hz :
          (q₁ : ℤ × ℤ) =
            ((l₂ : ℤ × ℤ) - l₁) + q₂ := by
        calc
          (q₁ : ℤ × ℤ) =
              (q₁ + l₁) - l₁ := by abel
          _ = (q₂ + l₂) - l₁ := by
            rw [heq]
          _ = (l₂ - l₁) + q₂ := by abel
      rw [hz, toPlane_add]
    have hq₁ :
        ZSpan.fract b (toPlane q₁) = toPlane q₁ :=
      ZSpan.fract_eq_self.mpr q₁.property
    have hq₂ :
        ZSpan.fract b (toPlane q₂) = toPlane q₂ :=
      ZSpan.fract_eq_self.mpr q₂.property
    have hqcast : toPlane q₁ = toPlane q₂ := by
      calc
        toPlane q₁ =
            ZSpan.fract b (toPlane q₁) := hq₁.symm
        _ = ZSpan.fract b (y + toPlane q₂) := by
          rw [hcast]
        _ = ZSpan.fract b (toPlane q₂) :=
          ZSpan.fract_zSpan_add b (toPlane q₂) hy
        _ = toPlane q₂ := hq₂
    have hq : q₁ = q₂ := by
      apply Subtype.ext
      exact toPlaneIntLinear_injective hqcast
    subst q₂
    have hl : l₁ = l₂ := by
      apply Subtype.ext
      exact add_left_cancel heq
    exact Prod.ext rfl hl
  · intro z
    let b :=
      Submission.TriangleArea.edgeBasis
        (triangle v hsimple)
    obtain ⟨l, hl⟩ :=
      exists_edgeLattice_of_mem_realSpan v hsimple
        (Subtype.property (ZSpan.floor b (toPlane z)))
    let q : ℤ × ℤ := z - l
    have hqcast :
        toPlane q = ZSpan.fract b (toPlane z) := by
      rw [ZSpan.fract_apply, ← hl]
      simp [q]
    have hq : q ∈ fundamentalPoints v hsimple := by
      change
        toPlane q ∈ ZSpan.fundamentalDomain b
      rw [hqcast]
      exact ZSpan.fract_mem_fundamentalDomain b _
    refine
      ⟨⟨⟨q, hq⟩,
          ⟨l, l.property⟩⟩, ?_⟩
    simp [q]

/-- The number of lattice points in the half-open fundamental
parallelogram is the absolute determinant. -/
theorem ncard_fundamentalPoints (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    (fundamentalPoints v hsimple).ncard =
      (edgeDet v).natAbs := by
  rw [(fundamentalPoints_isComplement v hsimple).ncard_left,
    edgeLattice_index v hsimple]

/-- Coordinates of an integer vector in the real edge basis. -/
noncomputable def coords (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (z : ℤ × ℤ) :
    ℝ × ℝ :=
  Submission.TriangleArea.edgeCoords
    (triangle v hsimple) (toPlane z)

@[simp]
theorem coords_zero (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    coords v hsimple 0 = 0 := by
  unfold coords
  calc
    Submission.TriangleArea.edgeCoords
        (triangle v hsimple) (toPlane 0) =
      Submission.TriangleArea.edgeCoords
        (triangle v hsimple)
        (Submission.TriangleArea.triangleLinearMap
          (triangle v hsimple) (0, 0)) := by
            congr 1
            simp [toPlane,
              Submission.TriangleArea.triangleLinearMap]
    _ = (0, 0) :=
      Submission.TriangleArea.edgeCoords_triangleLinearMap
        (triangle v hsimple) (0, 0)
    _ = 0 := rfl

@[simp]
theorem coords_edgeInt_zero (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    coords v hsimple (edgeInt v 0) = (1, 0) := by
  change
    Submission.TriangleArea.edgeCoords
        (triangle v hsimple) (toPlane (edgeInt v 0)) =
      (1, 0)
  rw [toPlane_edgeInt v hsimple 0]
  rw [show
    Submission.TriangleArea.edgeBasis
        (triangle v hsimple) 0 =
      Submission.TriangleArea.triangleLinearMap
        (triangle v hsimple) (1, 0) by
      simp [Submission.TriangleArea.triangleLinearMap]]
  exact
    Submission.TriangleArea.edgeCoords_triangleLinearMap
      (triangle v hsimple) (1, 0)

@[simp]
theorem coords_edgeInt_one (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    coords v hsimple (edgeInt v 1) = (0, 1) := by
  change
    Submission.TriangleArea.edgeCoords
        (triangle v hsimple) (toPlane (edgeInt v 1)) =
      (0, 1)
  rw [toPlane_edgeInt v hsimple 1]
  rw [show
    Submission.TriangleArea.edgeBasis
        (triangle v hsimple) 1 =
      Submission.TriangleArea.triangleLinearMap
        (triangle v hsimple) (0, 1) by
      simp [Submission.TriangleArea.triangleLinearMap]]
  exact
    Submission.TriangleArea.edgeCoords_triangleLinearMap
      (triangle v hsimple) (0, 1)

theorem coords_add (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (z w : ℤ × ℤ) :
    coords v hsimple (z + w) =
      coords v hsimple z + coords v hsimple w := by
  apply Prod.ext <;>
    simp [coords, Submission.TriangleArea.edgeCoords]

theorem coords_neg (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (z : ℤ × ℤ) :
    coords v hsimple (-z) = -coords v hsimple z := by
  apply Prod.ext <;>
    simp [coords, Submission.TriangleArea.edgeCoords]

theorem coords_sub (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (z w : ℤ × ℤ) :
    coords v hsimple (z - w) =
      coords v hsimple z - coords v hsimple w := by
  simp only [sub_eq_add_neg, coords_add, coords_neg]

@[simp]
theorem coords_vertex_one_sub_zero
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    coords v hsimple (v 1 - v 0) = (1, 0) := by
  simpa only [edgeInt_zero] using
    coords_edgeInt_zero v hsimple

@[simp]
theorem coords_vertex_two_sub_zero
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    coords v hsimple (v 2 - v 0) = (0, 1) := by
  simpa only [edgeInt_one] using
    coords_edgeInt_one v hsimple

/-- The lattice points in the open lower triangle of the fundamental
parallelogram. -/
def lowerPoints (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) : Set (ℤ × ℤ) :=
  {z |
    coords v hsimple z ∈
      Submission.TriangleArea.standardInterior}

/-- The lattice points in the open upper triangle of the fundamental
parallelogram. -/
def upperPoints (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) : Set (ℤ × ℤ) :=
  {z |
    0 < (coords v hsimple z).1 ∧
    (coords v hsimple z).1 < 1 ∧
    0 < (coords v hsimple z).2 ∧
    (coords v hsimple z).2 < 1 ∧
    1 < (coords v hsimple z).1 +
      (coords v hsimple z).2}

/-- Interior lattice points on the first coordinate edge. -/
def xAxisPoints (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) : Set (ℤ × ℤ) :=
  {z |
    (coords v hsimple z).1 ∈ Set.Ioo 0 1 ∧
      (coords v hsimple z).2 = 0}

/-- Interior lattice points on the second coordinate edge. -/
def yAxisPoints (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) : Set (ℤ × ℤ) :=
  {z |
    (coords v hsimple z).1 = 0 ∧
      (coords v hsimple z).2 ∈ Set.Ioo 0 1}

/-- Interior lattice points on the diagonal edge. -/
def diagonalPoints (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) : Set (ℤ × ℤ) :=
  {z |
    0 < (coords v hsimple z).1 ∧
      0 < (coords v hsimple z).2 ∧
      (coords v hsimple z).1 +
        (coords v hsimple z).2 = 1}

/-- Membership in the fundamental parallelogram in terms of its two
coordinates. -/
theorem mem_fundamentalPoints_iff (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (z : ℤ × ℤ) :
    z ∈ fundamentalPoints v hsimple ↔
      (coords v hsimple z).1 ∈ Set.Ico 0 1 ∧
      (coords v hsimple z).2 ∈ Set.Ico 0 1 := by
  change
    (∀ i,
      (Submission.TriangleArea.edgeBasis
        (triangle v hsimple)).repr (toPlane z) i ∈
          Set.Ico 0 1) ↔ _
  constructor
  · intro h
    exact ⟨h 0, h 1⟩
  · rintro ⟨h₀, h₁⟩ i
    fin_cases i
    · exact h₀
    · exact h₁

theorem lowerPoints_subset_fundamentalPoints
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    lowerPoints v hsimple ⊆ fundamentalPoints v hsimple := by
  intro z hz
  rw [mem_fundamentalPoints_iff]
  change
    0 < (coords v hsimple z).1 ∧
      0 < (coords v hsimple z).2 ∧
      (coords v hsimple z).1 +
        (coords v hsimple z).2 < 1 at hz
  constructor <;>
    constructor <;> linarith

theorem upperPoints_subset_fundamentalPoints
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    upperPoints v hsimple ⊆ fundamentalPoints v hsimple := by
  intro z hz
  rw [mem_fundamentalPoints_iff]
  exact
    ⟨⟨hz.1.le, hz.2.1⟩,
      ⟨hz.2.2.1.le, hz.2.2.2.1⟩⟩

theorem xAxisPoints_subset_fundamentalPoints
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    xAxisPoints v hsimple ⊆ fundamentalPoints v hsimple := by
  intro z hz
  rw [mem_fundamentalPoints_iff]
  exact
    ⟨⟨hz.1.1.le, hz.1.2⟩,
      by simp [hz.2]⟩

theorem yAxisPoints_subset_fundamentalPoints
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    yAxisPoints v hsimple ⊆ fundamentalPoints v hsimple := by
  intro z hz
  rw [mem_fundamentalPoints_iff]
  exact
    ⟨by simp [hz.1],
      ⟨hz.2.1.le, hz.2.2⟩⟩

theorem diagonalPoints_subset_fundamentalPoints
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    diagonalPoints v hsimple ⊆
      fundamentalPoints v hsimple := by
  intro z hz
  rw [mem_fundamentalPoints_iff]
  change
    0 < (coords v hsimple z).1 ∧
      0 < (coords v hsimple z).2 ∧
      (coords v hsimple z).1 +
        (coords v hsimple z).2 = 1 at hz
  constructor <;>
    constructor <;> linarith

/-- Central reflection of the fundamental parallelogram. -/
def reflect (v : Fin 3 → ℤ × ℤ)
    (z : ℤ × ℤ) : ℤ × ℤ :=
  edgeInt v 0 + edgeInt v 1 - z

@[simp]
theorem reflect_reflect (v : Fin 3 → ℤ × ℤ)
    (z : ℤ × ℤ) :
    reflect v (reflect v z) = z := by
  simp [reflect]

/-- Reflection replaces each edge coordinate by its complement to `1`. -/
theorem coords_reflect (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (z : ℤ × ℤ) :
    coords v hsimple (reflect v z) =
      (1 - (coords v hsimple z).1,
        1 - (coords v hsimple z).2) := by
  rw [reflect, coords_sub, coords_add,
    coords_edgeInt_zero, coords_edgeInt_one]
  apply Prod.ext <;> simp

/-- Reflection bijects the upper open triangle with the lower one. -/
theorem reflect_bijOn_upper_lower
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    Set.BijOn (reflect v)
      (upperPoints v hsimple)
      (lowerPoints v hsimple) := by
  refine ⟨?_, ?_, ?_⟩
  · intro z hz
    rw [lowerPoints,
      Submission.TriangleArea.standardInterior]
    change
      0 < (coords v hsimple (reflect v z)).1 ∧
        0 < (coords v hsimple (reflect v z)).2 ∧
        (coords v hsimple (reflect v z)).1 +
          (coords v hsimple (reflect v z)).2 < 1
    rw [coords_reflect]
    constructor
    · linarith [hz.2.1]
    constructor
    · linarith [hz.2.2.2.1]
    · linarith [hz.2.2.2.2]
  · intro z _ w _ hzw
    calc
      z = reflect v (reflect v z) := (reflect_reflect v z).symm
      _ = reflect v (reflect v w) := by rw [hzw]
      _ = w := reflect_reflect v w
  · intro z hz
    refine ⟨reflect v z, ?_, reflect_reflect v z⟩
    change
      0 < (coords v hsimple (reflect v z)).1 ∧
        (coords v hsimple (reflect v z)).1 < 1 ∧
        0 < (coords v hsimple (reflect v z)).2 ∧
        (coords v hsimple (reflect v z)).2 < 1 ∧
        1 <
          (coords v hsimple (reflect v z)).1 +
            (coords v hsimple (reflect v z)).2
    rw [coords_reflect]
    change
      0 < (coords v hsimple z).1 ∧
        0 < (coords v hsimple z).2 ∧
        (coords v hsimple z).1 +
          (coords v hsimple z).2 < 1 at hz
    constructor
    · linarith [hz.2.2]
    constructor
    · linarith [hz.1]
    constructor
    · linarith [hz.2.2]
    constructor
    · linarith [hz.2.1]
    · linarith [hz.2.2]

theorem ncard_upperPoints_eq_lowerPoints
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    (upperPoints v hsimple).ncard =
      (lowerPoints v hsimple).ncard :=
  (reflect_bijOn_upper_lower v hsimple).ncard_eq

/-- Edge coordinates distinguish integer vectors. -/
theorem coords_injective (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    Function.Injective (coords v hsimple) := by
  intro z w hzw
  apply toPlaneIntLinear_injective
  change toPlane z = toPlane w
  have :=
    congrArg
      (Submission.TriangleArea.triangleLinearMap
        (triangle v hsimple)) hzw
  simpa [coords] using this

/-- The half-open parallelogram partitions into its origin, three open
edges, and two open triangles. -/
theorem fundamentalPoints_partition
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    fundamentalPoints v hsimple =
      {0} ∪
        (xAxisPoints v hsimple ∪
          (yAxisPoints v hsimple ∪
            (diagonalPoints v hsimple ∪
              (lowerPoints v hsimple ∪
                upperPoints v hsimple)))) := by
  ext z
  constructor
  · intro hz
    have hc := (mem_fundamentalPoints_iff v hsimple z).mp hz
    by_cases hzero₀ : (coords v hsimple z).1 = 0
    · by_cases hzero₁ : (coords v hsimple z).2 = 0
      · left
        have hcoord :
            coords v hsimple z =
              coords v hsimple 0 := by
          apply Prod.ext
          · simp [hzero₀]
          · simp [hzero₁]
        exact (coords_injective v hsimple hcoord)
      · right
        right
        left
        exact
          ⟨hzero₀,
            ⟨lt_of_le_of_ne hc.2.1
                (Ne.symm hzero₁),
              hc.2.2⟩⟩
    · have hpos₀ :
          0 < (coords v hsimple z).1 :=
        lt_of_le_of_ne hc.1.1 (Ne.symm hzero₀)
      by_cases hzero₁ : (coords v hsimple z).2 = 0
      · right
        left
        exact
          ⟨⟨hpos₀, hc.1.2⟩, hzero₁⟩
      · have hpos₁ :
            0 < (coords v hsimple z).2 :=
          lt_of_le_of_ne hc.2.1 (Ne.symm hzero₁)
        rcases lt_trichotomy
          ((coords v hsimple z).1 +
            (coords v hsimple z).2) 1 with
          hsum | hsum | hsum
        · right
          right
          right
          right
          left
          exact ⟨hpos₀, hpos₁, hsum⟩
        · right
          right
          right
          left
          exact ⟨hpos₀, hpos₁, hsum⟩
        · right
          right
          right
          right
          right
          exact
            ⟨hpos₀, hc.1.2, hpos₁, hc.2.2,
              hsum⟩
  · rintro (rfl | hz)
    · rw [mem_fundamentalPoints_iff]
      simp
    · rcases hz with hx | hy | hd | hl | hu
      · exact xAxisPoints_subset_fundamentalPoints
          v hsimple hx
      · exact yAxisPoints_subset_fundamentalPoints
          v hsimple hy
      · exact diagonalPoints_subset_fundamentalPoints
          v hsimple hd
      · exact lowerPoints_subset_fundamentalPoints
          v hsimple hl
      · exact upperPoints_subset_fundamentalPoints
          v hsimple hu

/-- Cardinal form of the six-piece fundamental-parallelogram partition. -/
theorem ncard_fundamentalPoints_partition
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    (fundamentalPoints v hsimple).ncard =
      1 +
        (xAxisPoints v hsimple).ncard +
        (yAxisPoints v hsimple).ncard +
        (diagonalPoints v hsimple).ncard +
        2 * (lowerPoints v hsimple).ncard := by
  let X := xAxisPoints v hsimple
  let Y := yAxisPoints v hsimple
  let D := diagonalPoints v hsimple
  let L := lowerPoints v hsimple
  let U := upperPoints v hsimple
  have hQfin := finite_fundamentalPoints v hsimple
  have hXfin : X.Finite :=
    hQfin.subset (xAxisPoints_subset_fundamentalPoints v hsimple)
  have hYfin : Y.Finite :=
    hQfin.subset (yAxisPoints_subset_fundamentalPoints v hsimple)
  have hDfin : D.Finite :=
    hQfin.subset (diagonalPoints_subset_fundamentalPoints v hsimple)
  have hLfin : L.Finite :=
    hQfin.subset (lowerPoints_subset_fundamentalPoints v hsimple)
  have hUfin : U.Finite :=
    hQfin.subset (upperPoints_subset_fundamentalPoints v hsimple)
  have hO :
      Disjoint ({0} : Set (ℤ × ℤ))
        (X ∪ (Y ∪ (D ∪ (L ∪ U)))) := by
    rw [Set.disjoint_left]
    intro z hz hzrest
    simp only [Set.mem_singleton_iff] at hz
    subst z
    rcases hzrest with hx | hy | hd | hl | hu <;>
      simp [X, Y, D, L, U, xAxisPoints, yAxisPoints,
        diagonalPoints, lowerPoints, upperPoints,
        Submission.TriangleArea.standardInterior] at *
  have hX :
      Disjoint X (Y ∪ (D ∪ (L ∪ U))) := by
    rw [Set.disjoint_left]
    intro z hx hzrest
    rcases hzrest with hy | hd | hl | hu
    · change
        (coords v hsimple z).1 ∈ Set.Ioo 0 1 ∧
          (coords v hsimple z).2 = 0 at hx
      change
        (coords v hsimple z).1 = 0 ∧
          (coords v hsimple z).2 ∈ Set.Ioo 0 1 at hy
      exact (ne_of_gt hx.1.1) hy.1
    · change
        (coords v hsimple z).1 ∈ Set.Ioo 0 1 ∧
          (coords v hsimple z).2 = 0 at hx
      change
        0 < (coords v hsimple z).1 ∧
          0 < (coords v hsimple z).2 ∧ _ at hd
      linarith
    · change
        (coords v hsimple z).1 ∈ Set.Ioo 0 1 ∧
          (coords v hsimple z).2 = 0 at hx
      change
        0 < (coords v hsimple z).1 ∧
          0 < (coords v hsimple z).2 ∧ _ at hl
      linarith
    · change
        (coords v hsimple z).1 ∈ Set.Ioo 0 1 ∧
          (coords v hsimple z).2 = 0 at hx
      change
        0 < (coords v hsimple z).1 ∧ _ ∧
          0 < (coords v hsimple z).2 ∧ _ at hu
      linarith
  have hY :
      Disjoint Y (D ∪ (L ∪ U)) := by
    rw [Set.disjoint_left]
    intro z hy hzrest
    rcases hzrest with hd | hl | hu
    · change
        (coords v hsimple z).1 = 0 ∧
          (coords v hsimple z).2 ∈ Set.Ioo 0 1 at hy
      change
        0 < (coords v hsimple z).1 ∧ _ at hd
      linarith
    · change
        (coords v hsimple z).1 = 0 ∧
          (coords v hsimple z).2 ∈ Set.Ioo 0 1 at hy
      change
        0 < (coords v hsimple z).1 ∧ _ at hl
      linarith
    · change
        (coords v hsimple z).1 = 0 ∧
          (coords v hsimple z).2 ∈ Set.Ioo 0 1 at hy
      change
        0 < (coords v hsimple z).1 ∧ _ at hu
      linarith
  have hD :
      Disjoint D (L ∪ U) := by
    rw [Set.disjoint_left]
    intro z hd hzrest
    rcases hzrest with hl | hu
    · change
        _ ∧ _ ∧
          (coords v hsimple z).1 +
            (coords v hsimple z).2 = 1 at hd
      change
        _ ∧ _ ∧
          (coords v hsimple z).1 +
            (coords v hsimple z).2 < 1 at hl
      linarith
    · change
        _ ∧ _ ∧
          (coords v hsimple z).1 +
            (coords v hsimple z).2 = 1 at hd
      change
        _ ∧ _ ∧ _ ∧ _ ∧
          1 <
            (coords v hsimple z).1 +
              (coords v hsimple z).2 at hu
      linarith
  have hL : Disjoint L U := by
    rw [Set.disjoint_left]
    intro z hl hu
    change
      _ ∧ _ ∧
        (coords v hsimple z).1 +
          (coords v hsimple z).2 < 1 at hl
    change
      _ ∧ _ ∧ _ ∧ _ ∧
        1 <
          (coords v hsimple z).1 +
            (coords v hsimple z).2 at hu
    linarith
  rw [fundamentalPoints_partition v hsimple,
    Set.ncard_union_eq hO
      (hs := Set.finite_singleton 0)
      (ht := hXfin.union
        (hYfin.union
          (hDfin.union (hLfin.union hUfin)))),
    Set.ncard_union_eq hX
      (hs := hXfin)
      (ht := hYfin.union (hDfin.union (hLfin.union hUfin))),
    Set.ncard_union_eq hY
      (hs := hYfin)
      (ht := hDfin.union (hLfin.union hUfin)),
    Set.ncard_union_eq hD
      (hs := hDfin)
      (ht := hLfin.union hUfin),
    Set.ncard_union_eq hL
      (hs := hLfin) (ht := hUfin),
    Set.ncard_singleton,
    ncard_upperPoints_eq_lowerPoints v hsimple]
  dsimp [X, Y, D, L, U]
  omega

/-- The lattice points selected by the challenge's triangle interior. -/
def interiorLatticeSet (v : Fin 3 → ℤ × ℤ) :
    Set (ℤ × ℤ) :=
  {z |
    toPlane z ∈
      inside ((latPoly v).boundary (R := ℝ))}

/-- The lattice points on the challenge's triangle boundary. -/
def boundaryLatticeSet (v : Fin 3 → ℤ × ℤ) :
    Set (ℤ × ℤ) :=
  {z |
    toPlane z ∈
      (latPoly v).boundary (R := ℝ)}

/-- The bounded-component interior predicate is the lower standard-triangle
coordinate predicate after translating vertex `0` to the origin. -/
theorem mem_interiorLatticeSet_iff
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (z : ℤ × ℤ) :
    z ∈ interiorLatticeSet v ↔
      z - v 0 ∈ lowerPoints v hsimple := by
  let t := triangle v hsimple
  have ht : t.toPolygon = latPoly v := by
    simp [t, triangle]
  change
    toPlane z ∈
      inside ((latPoly v).boundary (R := ℝ)) ↔ _
  rw [← ht,
    Submission.Triangle.inside_toPolygon_boundary_eq_interior,
    Submission.TriangleArea.mem_interior_iff_edgeCoords]
  simp [lowerPoints, coords, t]

/-- In edge coordinates, the translated triangle boundary is the standard
triangle boundary. -/
theorem mem_boundaryLatticeSet_iff
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) (z : ℤ × ℤ) :
    z ∈ boundaryLatticeSet v ↔
      Submission.TriangleArea.edgeCoords
        (triangle v hsimple) (toPlane (z - v 0)) ∈
          Submission.TriangleArea.standardBoundary := by
  let t := triangle v hsimple
  have ht : t.toPolygon = latPoly v := by
    simp [t, triangle]
  change
    toPlane z ∈
      (latPoly v).boundary (R := ℝ) ↔ _
  rw [← ht,
    Submission.TriangleArea.mem_toPolygon_boundary_iff_edgeCoords]
  simp [t]

/-- Translated lattice points on the triangle boundary. -/
def boundaryOriginPoints (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    Set (ℤ × ℤ) :=
  {z |
    coords v hsimple z ∈
      Submission.TriangleArea.standardBoundary}

theorem translate_interior_bijOn_lower
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    Set.BijOn (fun z : ℤ × ℤ => z - v 0)
      (interiorLatticeSet v)
      (lowerPoints v hsimple) := by
  refine ⟨?_, ?_, ?_⟩
  · intro z hz
    exact
      (mem_interiorLatticeSet_iff v hsimple z).mp hz
  · intro z _ w _ h
    apply_fun (fun q => q + v 0) at h
    simpa using h
  · intro z hz
    refine ⟨z + v 0, ?_, by simp⟩
    rw [mem_interiorLatticeSet_iff]
    simpa using hz

theorem translate_boundary_bijOn_origin
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    Set.BijOn (fun z : ℤ × ℤ => z - v 0)
      (boundaryLatticeSet v)
      (boundaryOriginPoints v hsimple) := by
  refine ⟨?_, ?_, ?_⟩
  · intro z hz
    exact
      (mem_boundaryLatticeSet_iff v hsimple z).mp hz
  · intro z _ w _ h
    apply_fun (fun q => q + v 0) at h
    simpa using h
  · intro z hz
    refine ⟨z + v 0, ?_, by simp⟩
    rw [mem_boundaryLatticeSet_iff]
    simpa [boundaryOriginPoints, coords] using hz

theorem ncard_lowerPoints_eq_interiorPts
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    (lowerPoints v hsimple).ncard = interiorPts v := by
  rw [← (translate_interior_bijOn_lower v hsimple).ncard_eq]
  rfl

theorem ncard_boundaryOriginPoints_eq_boundaryPts
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    (boundaryOriginPoints v hsimple).ncard =
      boundaryPts v := by
  rw [← (translate_boundary_bijOn_origin v hsimple).ncard_eq]
  rfl

/-- The three triangle vertices after translating vertex `0` to the
origin. -/
def originVertices (v : Fin 3 → ℤ × ℤ) :
    Set (ℤ × ℤ) :=
  {0, edgeInt v 0, edgeInt v 1}

/-- The translated boundary partitions into its three vertices and the
relative interiors of its three edges. -/
theorem boundaryOriginPoints_partition
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    boundaryOriginPoints v hsimple =
      originVertices v ∪
        (xAxisPoints v hsimple ∪
          (yAxisPoints v hsimple ∪
            diagonalPoints v hsimple)) := by
  ext z
  constructor
  · intro hz
    change
      coords v hsimple z ∈
        Submission.TriangleArea.standardBoundary at hz
    rcases hz with
      ⟨⟨h₀, h₁, hsum⟩, hedge⟩
    by_cases hz₀ : (coords v hsimple z).1 = 0
    · by_cases hz₁ : (coords v hsimple z).2 = 0
      · left
        left
        apply coords_injective v hsimple
        apply Prod.ext <;> simp [hz₀, hz₁]
      · have hpos₁ :
            0 < (coords v hsimple z).2 :=
          lt_of_le_of_ne h₁ (Ne.symm hz₁)
        by_cases hone₁ : (coords v hsimple z).2 = 1
        · left
          right
          right
          apply coords_injective v hsimple
          apply Prod.ext <;> simp [hz₀, hone₁]
        · right
          right
          left
          exact
            ⟨hz₀,
              ⟨hpos₁,
                lt_of_le_of_ne (by linarith)
                  hone₁⟩⟩
    · have hpos₀ :
          0 < (coords v hsimple z).1 :=
        lt_of_le_of_ne h₀ (Ne.symm hz₀)
      by_cases hz₁ : (coords v hsimple z).2 = 0
      · by_cases hone₀ : (coords v hsimple z).1 = 1
        · left
          right
          left
          apply coords_injective v hsimple
          apply Prod.ext <;> simp [hz₁, hone₀]
        · right
          left
          exact
            ⟨⟨hpos₀,
                lt_of_le_of_ne (by linarith)
                  hone₀⟩, hz₁⟩
      · have hpos₁ :
            0 < (coords v hsimple z).2 :=
          lt_of_le_of_ne h₁ (Ne.symm hz₁)
        right
        right
        right
        refine ⟨hpos₀, hpos₁, ?_⟩
        rcases hedge with hedge | hedge | hedge
        · exact False.elim (hz₀ hedge)
        · exact False.elim (hz₁ hedge)
        · exact hedge
  · rintro (hz | hx | hy | hd)
    · rcases hz with rfl | rfl | rfl
      · simp [boundaryOriginPoints,
          Submission.TriangleArea.standardBoundary,
          Submission.TriangleArea.standardClosedInterior]
      · simp [boundaryOriginPoints,
          Submission.TriangleArea.standardBoundary,
          Submission.TriangleArea.standardClosedInterior]
      · simp [boundaryOriginPoints,
          Submission.TriangleArea.standardBoundary,
          Submission.TriangleArea.standardClosedInterior]
    · change
        (coords v hsimple z).1 ∈ Set.Ioo 0 1 ∧
          (coords v hsimple z).2 = 0 at hx
      exact
        ⟨⟨hx.1.1.le, by simp [hx.2],
            by linarith [hx.1.2]⟩,
          Or.inr (Or.inl hx.2)⟩
    · change
        (coords v hsimple z).1 = 0 ∧
          (coords v hsimple z).2 ∈ Set.Ioo 0 1 at hy
      exact
        ⟨⟨by simp [hy.1], hy.2.1.le,
            by linarith [hy.2.2]⟩,
          Or.inl hy.1⟩
    · change
        0 < (coords v hsimple z).1 ∧
          0 < (coords v hsimple z).2 ∧
          (coords v hsimple z).1 +
            (coords v hsimple z).2 = 1 at hd
      exact
        ⟨⟨hd.1.le, hd.2.1.le, hd.2.2.le⟩,
          Or.inr (Or.inr hd.2.2)⟩

/-- Cardinal form of the translated boundary partition. -/
theorem ncard_boundaryOriginPoints_partition
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    (boundaryOriginPoints v hsimple).ncard =
      3 +
        (xAxisPoints v hsimple).ncard +
        (yAxisPoints v hsimple).ncard +
        (diagonalPoints v hsimple).ncard := by
  let V := originVertices v
  let X := xAxisPoints v hsimple
  let Y := yAxisPoints v hsimple
  let D := diagonalPoints v hsimple
  have hQfin := finite_fundamentalPoints v hsimple
  have hXfin : X.Finite :=
    hQfin.subset (xAxisPoints_subset_fundamentalPoints v hsimple)
  have hYfin : Y.Finite :=
    hQfin.subset (yAxisPoints_subset_fundamentalPoints v hsimple)
  have hDfin : D.Finite :=
    hQfin.subset (diagonalPoints_subset_fundamentalPoints v hsimple)
  have hVfin : V.Finite := by
    simp [V, originVertices]
  have hV :
      Disjoint V (X ∪ (Y ∪ D)) := by
    rw [Set.disjoint_left]
    intro z hz hzrest
    rcases hz with rfl | rfl | rfl
    · rcases hzrest with hx | hy | hd <;>
        simp [X, Y, D, xAxisPoints, yAxisPoints,
          diagonalPoints] at *
    · rcases hzrest with hx | hy | hd
      · change
          (coords v hsimple (edgeInt v 0)).1 ∈ Set.Ioo 0 1 ∧
            (coords v hsimple (edgeInt v 0)).2 = 0 at hx
        simp at hx
      · change
          (coords v hsimple (edgeInt v 0)).1 = 0 ∧ _ at hy
        simp at hy
      · change
          _ ∧ _ ∧
            (coords v hsimple (edgeInt v 0)).1 +
              (coords v hsimple (edgeInt v 0)).2 = 1 at hd
        simp at hd
    · rcases hzrest with hx | hy | hd
      · change
          (coords v hsimple (edgeInt v 1)).1 ∈ Set.Ioo 0 1 ∧ _ at hx
        simp at hx
      · change
          _ ∧
            (coords v hsimple (edgeInt v 1)).2 ∈ Set.Ioo 0 1 at hy
        simp at hy
      · change
          _ ∧ _ ∧
            (coords v hsimple (edgeInt v 1)).1 +
              (coords v hsimple (edgeInt v 1)).2 = 1 at hd
        simp at hd
  have hX : Disjoint X (Y ∪ D) := by
    rw [Set.disjoint_left]
    intro z hx hzrest
    rcases hzrest with hy | hd
    · change
        (coords v hsimple z).1 ∈ Set.Ioo 0 1 ∧
          (coords v hsimple z).2 = 0 at hx
      change
        (coords v hsimple z).1 = 0 ∧ _ at hy
      exact (ne_of_gt hx.1.1) hy.1
    · change
        _ ∧ (coords v hsimple z).2 = 0 at hx
      change
        _ ∧ 0 < (coords v hsimple z).2 ∧ _ at hd
      linarith
  have hY : Disjoint Y D := by
    rw [Set.disjoint_left]
    intro z hy hd
    change
      (coords v hsimple z).1 = 0 ∧ _ at hy
    change
      0 < (coords v hsimple z).1 ∧ _ at hd
    linarith
  have hli := edgeInt_linearIndependent v hsimple
  have hzero₀ : edgeInt v 0 ≠ 0 :=
    hli.ne_zero 0
  have hzero₁ : edgeInt v 1 ≠ 0 :=
    hli.ne_zero 1
  have hne : edgeInt v 0 ≠ edgeInt v 1 :=
    hli.injective.ne (by decide)
  rw [boundaryOriginPoints_partition v hsimple,
    Set.ncard_union_eq hV
      (hs := hVfin)
      (ht := hXfin.union (hYfin.union hDfin)),
    Set.ncard_union_eq hX
      (hs := hXfin)
      (ht := hYfin.union hDfin),
    Set.ncard_union_eq hY
      (hs := hYfin) (ht := hDfin)]
  have hVcard : V.ncard = 3 := by
    have hzero :
        (0 : ℤ × ℤ) ∉
          ({edgeInt v 0, edgeInt v 1} :
            Set (ℤ × ℤ)) := by
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
      exact ⟨Ne.symm hzero₀, Ne.symm hzero₁⟩
    have hedge :
        edgeInt v 0 ∉
          ({edgeInt v 1} : Set (ℤ × ℤ)) := by
      simpa only [Set.mem_singleton_iff] using hne
    change
      ({0, edgeInt v 0, edgeInt v 1} :
        Set (ℤ × ℤ)).ncard = 3
    rw [Set.ncard_insert_of_notMem hzero
        (hs := (Set.finite_singleton (edgeInt v 1)).insert
          (edgeInt v 0)),
      Set.ncard_insert_of_notMem hedge
        (hs := Set.finite_singleton (edgeInt v 1)),
      Set.ncard_singleton]
  rw [hVcard]
  dsimp [X, Y, D]
  omega

/-- The fundamental-parallelogram count is the numerical Pick identity for
the lattice triangle. -/
theorem fundamental_count_identity
    (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    (fundamentalPoints v hsimple).ncard + 2 =
      2 * interiorPts v + boundaryPts v := by
  have hQ :=
    ncard_fundamentalPoints_partition v hsimple
  have hI :=
    ncard_lowerPoints_eq_interiorPts v hsimple
  have hB₀ :=
    ncard_boundaryOriginPoints_eq_boundaryPts v hsimple
  have hB :=
    ncard_boundaryOriginPoints_partition v hsimple
  omega

/-- Pick's theorem for a simple lattice triangle. -/
theorem pick_three (v : Fin 3 → ℤ × ℤ)
    (hsimple : IsSimple (latPoly v)) :
    area ((latPoly v).boundary (R := ℝ)) =
      (interiorPts v : ℝ) +
        (boundaryPts v : ℝ) / 2 - 1 := by
  let t := triangle v hsimple
  have ht : t.toPolygon = latPoly v := by
    simp [t, triangle]
  have hdet :
      |(edgeDet v : ℝ)| =
        ((edgeDet v).natAbs : ℝ) := by
    simp only [Nat.cast_natAbs, Int.cast_abs]
  have hcount :
      ((fundamentalPoints v hsimple).ncard : ℝ) + 2 =
        2 * (interiorPts v : ℝ) +
          (boundaryPts v : ℝ) := by
    exact_mod_cast fundamental_count_identity v hsimple
  calc
    area ((latPoly v).boundary (R := ℝ)) =
        area (t.toPolygon.boundary (R := ℝ)) := by
          rw [ht]
    _ =
        |LinearMap.det
          (Submission.TriangleArea.triangleLinearMap t)| / 2 :=
      Submission.TriangleArea.area_toPolygon_boundary_eq_det t
    _ = ((edgeDet v).natAbs : ℝ) / 2 := by
      rw [det_triangleLinearMap v hsimple, hdet]
    _ =
        ((fundamentalPoints v hsimple).ncard : ℝ) / 2 := by
      rw [ncard_fundamentalPoints v hsimple]
    _ =
        (interiorPts v : ℝ) +
          (boundaryPts v : ℝ) / 2 - 1 := by
      linarith

end Submission.LatticeTriangle
