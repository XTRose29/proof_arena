import ChallengeDeps

namespace LeanEval.Analysis

noncomputable section

lemma isOrthProj_iff_isStarProjection
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {P : H →L[ℂ] H} : IsOrthProj P ↔ IsStarProjection P := by
  constructor
  · rintro ⟨hidem, hself⟩
    exact ⟨hidem, hself⟩
  · intro h
    exact ⟨h.isIdempotentElem, h.isSelfAdjoint⟩

lemma FrameFunction.map_zero
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) : f.μ 0 = 0 := by
  have hzero : IsOrthProj (0 : H →L[ℂ] H) :=
    isOrthProj_iff_isStarProjection.mpr (IsStarProjection.zero (H →L[ℂ] H))
  have hadd := f.additive 0 0 hzero hzero (by simp)
  simpa using hadd

lemma FrameFunction.map_one_sub
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {P : H →L[ℂ] H} (hP : IsOrthProj P) :
    f.μ (1 - P) = 1 - f.μ P := by
  have hstar : IsStarProjection P := isOrthProj_iff_isStarProjection.mp hP
  have hcomp : IsOrthProj (1 - P) :=
    isOrthProj_iff_isStarProjection.mpr hstar.one_sub
  have hadd := f.additive P (1 - P) hP hcomp hstar.mul_one_sub_self
  rw [show P + (1 - P) = 1 by noncomm_ring] at hadd
  rw [f.normalized] at hadd
  linarith

lemma FrameFunction.map_le_one
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {P : H →L[ℂ] H} (hP : IsOrthProj P) :
    f.μ P ≤ 1 := by
  have hstar : IsStarProjection P := isOrthProj_iff_isStarProjection.mp hP
  have hnonneg := f.nonneg (1 - P) (isOrthProj_iff_isStarProjection.mpr hstar.one_sub)
  rw [f.map_one_sub hP] at hnonneg
  linarith

/-- The value of a projection-valued frame function on the ray generated by a unit vector. -/
noncomputable def FrameFunction.unitValue
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x : H) : ℝ :=
  f.μ (InnerProductSpace.rankOne ℂ x x)

lemma FrameFunction.unitValue_nonneg
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {x : H} (hx : ‖x‖ = 1) :
    0 ≤ f.unitValue x := by
  exact f.nonneg _ <| isOrthProj_iff_isStarProjection.mpr <|
    InnerProductSpace.isStarProjection_rankOne_self hx

lemma FrameFunction.unitValue_le_one
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {x : H} (hx : ‖x‖ = 1) :
    f.unitValue x ≤ 1 := by
  exact f.map_le_one <| isOrthProj_iff_isStarProjection.mpr <|
    InnerProductSpace.isStarProjection_rankOne_self hx

lemma FrameFunction.unitValue_eq_of_rankOne_eq
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {x y : H}
    (hxy : InnerProductSpace.rankOne ℂ x x = InnerProductSpace.rankOne ℂ y y) :
    f.unitValue x = f.unitValue y := by
  exact congrArg f.μ hxy

lemma rankOne_smul_self_of_norm_eq_one
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (c : ℂ) (x : H) (hc : ‖c‖ = 1) :
    InnerProductSpace.rankOne ℂ (c • x) (c • x) =
      InnerProductSpace.rankOne ℂ x x := by
  ext z
  simp only [InnerProductSpace.rankOne_apply, inner_smul_left, smul_smul]
  have hcc : starRingEnd ℂ c * c = 1 := by
    rw [← Complex.normSq_eq_conj_mul_self, Complex.normSq_eq_norm_sq, hc]
    norm_num
  rw [mul_comm (starRingEnd ℂ c) (inner ℂ x z), mul_assoc, hcc, mul_one]

lemma FrameFunction.unitValue_smul_of_norm_eq_one
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (c : ℂ) (x : H) (hc : ‖c‖ = 1) :
    f.unitValue (c • x) = f.unitValue x := by
  exact f.unitValue_eq_of_rankOne_eq (rankOne_smul_self_of_norm_eq_one c x hc)

lemma rankOne_real_rotation_pair_sum
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (e d : H) (c s : ℝ) (hcs : c ^ 2 + s ^ 2 = 1) :
    InnerProductSpace.rankOne ℂ ((c : ℂ) • e + (s : ℂ) • d)
          ((c : ℂ) • e + (s : ℂ) • d) +
        InnerProductSpace.rankOne ℂ ((s : ℂ) • e - (c : ℂ) • d)
          ((s : ℂ) • e - (c : ℂ) • d) =
      InnerProductSpace.rankOne ℂ e e + InnerProductSpace.rankOne ℂ d d := by
  ext z
  simp only [InnerProductSpace.rankOne_apply, inner_add_left, inner_sub_left,
    inner_smul_left, Complex.conj_ofReal, smul_add, smul_sub, smul_smul,
    add_apply]
  have hcs' : (c : ℂ) ^ 2 + (s : ℂ) ^ 2 = 1 := by exact_mod_cast hcs
  match_scalars
  · linear_combination (inner ℂ e z) * hcs'
  · linear_combination (inner ℂ d z) * hcs'

lemma rankOne_complex_rotation_pair_sum
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (e d : H) (a b : ℂ)
    (hab : starRingEnd ℂ a * a + starRingEnd ℂ b * b = 1) :
    InnerProductSpace.rankOne ℂ (a • e + b • d) (a • e + b • d) +
        InnerProductSpace.rankOne ℂ ((-starRingEnd ℂ b) • e + (starRingEnd ℂ a) • d)
          ((-starRingEnd ℂ b) • e + (starRingEnd ℂ a) • d) =
      InnerProductSpace.rankOne ℂ e e + InnerProductSpace.rankOne ℂ d d := by
  ext z
  simp only [InnerProductSpace.rankOne_apply, inner_add_left, inner_smul_left,
    map_neg, starRingEnd_apply, star_star, smul_add, smul_smul, add_apply]
  simp only [starRingEnd_apply] at hab
  match_scalars
  · linear_combination (inner ℂ e z) * hab
  · linear_combination (inner ℂ d z) * hab

lemma FrameFunction.unitValue_pair_sum_eq
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {x y x' y' : H}
    (hx : ‖x‖ = 1) (hy : ‖y‖ = 1) (hxy : inner ℂ x y = 0)
    (hx' : ‖x'‖ = 1) (hy' : ‖y'‖ = 1) (hxy' : inner ℂ x' y' = 0)
    (hsum : InnerProductSpace.rankOne ℂ x x + InnerProductSpace.rankOne ℂ y y =
      InnerProductSpace.rankOne ℂ x' x' + InnerProductSpace.rankOne ℂ y' y') :
    f.unitValue x + f.unitValue y = f.unitValue x' + f.unitValue y' := by
  let P : H →L[ℂ] H := InnerProductSpace.rankOne ℂ x x
  let Q : H →L[ℂ] H := InnerProductSpace.rankOne ℂ y y
  let P' : H →L[ℂ] H := InnerProductSpace.rankOne ℂ x' x'
  let Q' : H →L[ℂ] H := InnerProductSpace.rankOne ℂ y' y'
  have hP : IsOrthProj P := isOrthProj_iff_isStarProjection.mpr <|
    InnerProductSpace.isStarProjection_rankOne_self hx
  have hQ : IsOrthProj Q := isOrthProj_iff_isStarProjection.mpr <|
    InnerProductSpace.isStarProjection_rankOne_self hy
  have hP' : IsOrthProj P' := isOrthProj_iff_isStarProjection.mpr <|
    InnerProductSpace.isStarProjection_rankOne_self hx'
  have hQ' : IsOrthProj Q' := isOrthProj_iff_isStarProjection.mpr <|
    InnerProductSpace.isStarProjection_rankOne_self hy'
  have hPQ : P * Q = 0 := by
    rw [ContinuousLinearMap.mul_def, InnerProductSpace.rankOne_comp_rankOne, hxy, zero_smul]
  have hP'Q' : P' * Q' = 0 := by
    rw [ContinuousLinearMap.mul_def, InnerProductSpace.rankOne_comp_rankOne, hxy', zero_smul]
  change f.μ P + f.μ Q = f.μ P' + f.μ Q'
  rw [← f.additive P Q hP hQ hPQ, ← f.additive P' Q' hP' hQ' hP'Q']
  exact congrArg f.μ hsum

lemma FrameFunction.unitValue_real_rotation_pair_sum
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (f : FrameFunction H) {e d : H}
    (he : ‖e‖ = 1) (hd : ‖d‖ = 1) (hed : inner ℂ e d = 0)
    (c s : ℝ) (hcs : c ^ 2 + s ^ 2 = 1) :
    f.unitValue ((c : ℂ) • e + (s : ℂ) • d) +
        f.unitValue ((s : ℂ) • e - (c : ℂ) • d) =
      f.unitValue e + f.unitValue d := by
  let u : H := (c : ℂ) • e + (s : ℂ) • d
  let v : H := (s : ℂ) • e - (c : ℂ) • d
  have hu_sq : ‖u‖ ^ 2 = 1 := by
    rw [show ‖u‖ ^ 2 = ‖(c : ℂ) • e‖ ^ 2 +
        2 * RCLike.re (inner ℂ ((c : ℂ) • e) ((s : ℂ) • d)) +
        ‖(s : ℂ) • d‖ ^ 2 by
      exact norm_add_sq (𝕜 := ℂ) ((c : ℂ) • e) ((s : ℂ) • d)]
    simp only [inner_smul_left, inner_smul_right, Complex.conj_ofReal, hed,
      mul_zero, norm_smul, he, hd, mul_one, Complex.norm_real,
      Real.norm_eq_abs]
    norm_num
    nlinarith [sq_abs c, sq_abs s]
  have hv_sq : ‖v‖ ^ 2 = 1 := by
    rw [show ‖v‖ ^ 2 = ‖(s : ℂ) • e‖ ^ 2 -
        2 * RCLike.re (inner ℂ ((s : ℂ) • e) ((c : ℂ) • d)) +
        ‖(c : ℂ) • d‖ ^ 2 by
      exact norm_sub_sq (𝕜 := ℂ) ((s : ℂ) • e) ((c : ℂ) • d)]
    simp only [inner_smul_left, inner_smul_right, Complex.conj_ofReal, hed,
      mul_zero, norm_smul, he, hd, mul_one, Complex.norm_real,
      Real.norm_eq_abs]
    norm_num
    nlinarith [sq_abs c, sq_abs s]
  have hu : ‖u‖ = 1 := by nlinarith [norm_nonneg u]
  have hv : ‖v‖ = 1 := by nlinarith [norm_nonneg v]
  have hde : inner ℂ d e = 0 := inner_eq_zero_symm.mp hed
  have huv : inner ℂ u v = 0 := by
    simp only [u, v, inner_sub_right, inner_add_left, inner_smul_left,
      inner_smul_right, Complex.conj_ofReal, hed, hde, mul_zero,
      inner_self_eq_norm_sq_to_K]
    rw [he, hd]
    norm_num
    ring
  change f.unitValue u + f.unitValue v = f.unitValue e + f.unitValue d
  symm
  apply f.unitValue_pair_sum_eq he hd hed hu hv huv
  exact (rankOne_real_rotation_pair_sum e d c s hcs).symm

lemma FrameFunction.unitValue_complex_rotation_pair_sum
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (f : FrameFunction H) {e d : H}
    (he : ‖e‖ = 1) (hd : ‖d‖ = 1) (hed : inner ℂ e d = 0)
    (a b : ℂ) (hab : ‖a‖ ^ 2 + ‖b‖ ^ 2 = 1) :
    f.unitValue (a • e + b • d) +
        f.unitValue ((-starRingEnd ℂ b) • e + (starRingEnd ℂ a) • d) =
      f.unitValue e + f.unitValue d := by
  let u : H := a • e + b • d
  let v : H := (-starRingEnd ℂ b) • e + (starRingEnd ℂ a) • d
  have hu_sq : ‖u‖ ^ 2 = 1 := by
    rw [show ‖u‖ ^ 2 = ‖a • e‖ ^ 2 +
        2 * RCLike.re (inner ℂ (a • e) (b • d)) + ‖b • d‖ ^ 2 by
      exact norm_add_sq (𝕜 := ℂ) (a • e) (b • d)]
    simp only [inner_smul_left, inner_smul_right, hed, mul_zero,
      norm_smul, he, hd, mul_one]
    norm_num
    nlinarith
  have hv_sq : ‖v‖ ^ 2 = 1 := by
    rw [show ‖v‖ ^ 2 = ‖(-starRingEnd ℂ b) • e‖ ^ 2 +
        2 * RCLike.re (inner ℂ ((-starRingEnd ℂ b) • e)
          ((starRingEnd ℂ a) • d)) +
        ‖(starRingEnd ℂ a) • d‖ ^ 2 by
      exact norm_add_sq (𝕜 := ℂ) ((-starRingEnd ℂ b) • e)
        ((starRingEnd ℂ a) • d)]
    simp only [inner_smul_left, inner_smul_right, map_neg,
      hed, mul_zero, norm_smul, norm_neg, he, hd, mul_one]
    norm_num
    nlinarith
  have hu : ‖u‖ = 1 := by nlinarith [norm_nonneg u]
  have hv : ‖v‖ = 1 := by nlinarith [norm_nonneg v]
  have hde : inner ℂ d e = 0 := inner_eq_zero_symm.mp hed
  have huv : inner ℂ u v = 0 := by
    simp only [u, v, inner_add_left, inner_add_right, inner_smul_left,
      inner_smul_right, hed, hde,
      mul_zero, inner_self_eq_norm_sq_to_K]
    rw [he, hd]
    norm_num
    ring
  have habC : starRingEnd ℂ a * a + starRingEnd ℂ b * b = 1 := by
    rw [← Complex.normSq_eq_conj_mul_self, ← Complex.normSq_eq_conj_mul_self,
      Complex.normSq_eq_norm_sq, Complex.normSq_eq_norm_sq]
    exact_mod_cast hab
  change f.unitValue u + f.unitValue v = f.unitValue e + f.unitValue d
  apply f.unitValue_pair_sum_eq hu hv huv he hd hed
  exact rankOne_complex_rotation_pair_sum e d a b habC

/-- The degree-two homogeneous extension of a frame function from unit rays to all vectors. -/
noncomputable def FrameFunction.homogeneousValue
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x : H) : ℝ := by
  classical
  exact if x = 0 then 0 else
    ‖x‖ ^ 2 * f.unitValue (((‖x‖ : ℂ)⁻¹) • x)

lemma FrameFunction.norm_inv_smul
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (_f : FrameFunction H) {x : H} (hx : x ≠ 0) :
    ‖((‖x‖ : ℂ)⁻¹) • x‖ = 1 := by
  have hnorm : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
  simp [norm_smul, hnorm]

@[simp] lemma FrameFunction.homogeneousValue_zero
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) : f.homogeneousValue 0 = 0 := by
  simp [FrameFunction.homogeneousValue]

lemma FrameFunction.homogeneousValue_nonneg
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x : H) : 0 ≤ f.homogeneousValue x := by
  by_cases hx : x = 0
  · simp [hx]
  · rw [FrameFunction.homogeneousValue, if_neg hx]
    exact mul_nonneg (sq_nonneg _) <| f.unitValue_nonneg (f.norm_inv_smul hx)

lemma FrameFunction.homogeneousValue_le_norm_sq
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x : H) : f.homogeneousValue x ≤ ‖x‖ ^ 2 := by
  by_cases hx : x = 0
  · simp [hx]
  · rw [FrameFunction.homogeneousValue, if_neg hx]
    nlinarith [f.unitValue_le_one (f.norm_inv_smul hx), sq_nonneg ‖x‖,
      f.unitValue_nonneg (f.norm_inv_smul hx)]

lemma FrameFunction.continuousAt_homogeneousValue_zero
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) : ContinuousAt f.homogeneousValue 0 := by
  rw [Metric.continuousAt_iff]
  intro ε hε
  refine ⟨min 1 ε, lt_min zero_lt_one hε, ?_⟩
  intro y hy
  have hynorm : ‖y‖ < min 1 ε := by simpa [dist_zero_right] using hy
  have hy_one : ‖y‖ < 1 := hynorm.trans_le (min_le_left _ _)
  have hy_eps : ‖y‖ < ε := hynorm.trans_le (min_le_right _ _)
  rw [f.homogeneousValue_zero, Real.dist_eq, sub_zero,
    abs_of_nonneg (f.homogeneousValue_nonneg y)]
  exact (f.homogeneousValue_le_norm_sq y).trans_lt <| by
    nlinarith [norm_nonneg y]

lemma FrameFunction.homogeneousValue_of_norm_eq_one
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {x : H} (hx : ‖x‖ = 1) :
    f.homogeneousValue x = f.unitValue x := by
  have hx0 : x ≠ 0 := by
    apply norm_ne_zero_iff.mp
    rw [hx]
    exact one_ne_zero
  rw [FrameFunction.homogeneousValue, if_neg hx0, hx]
  simp

lemma FrameFunction.homogeneousValue_real_rotation_pair_sum
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (f : FrameFunction H) {e d : H}
    (he : ‖e‖ = 1) (hd : ‖d‖ = 1) (hed : inner ℂ e d = 0)
    (c s : ℝ) (hcs : c ^ 2 + s ^ 2 = 1) :
    f.homogeneousValue ((c : ℂ) • e + (s : ℂ) • d) +
        f.homogeneousValue ((s : ℂ) • e - (c : ℂ) • d) =
      f.homogeneousValue e + f.homogeneousValue d := by
  let u : H := (c : ℂ) • e + (s : ℂ) • d
  let v : H := (s : ℂ) • e - (c : ℂ) • d
  have hu_sq : ‖u‖ ^ 2 = 1 := by
    rw [show ‖u‖ ^ 2 = ‖(c : ℂ) • e‖ ^ 2 +
        2 * RCLike.re (inner ℂ ((c : ℂ) • e) ((s : ℂ) • d)) +
        ‖(s : ℂ) • d‖ ^ 2 by
      exact norm_add_sq (𝕜 := ℂ) ((c : ℂ) • e) ((s : ℂ) • d)]
    simp only [inner_smul_left, inner_smul_right, Complex.conj_ofReal, hed,
      mul_zero, norm_smul, he, hd, mul_one, Complex.norm_real,
      Real.norm_eq_abs]
    norm_num
    nlinarith [sq_abs c, sq_abs s]
  have hv_sq : ‖v‖ ^ 2 = 1 := by
    rw [show ‖v‖ ^ 2 = ‖(s : ℂ) • e‖ ^ 2 -
        2 * RCLike.re (inner ℂ ((s : ℂ) • e) ((c : ℂ) • d)) +
        ‖(c : ℂ) • d‖ ^ 2 by
      exact norm_sub_sq (𝕜 := ℂ) ((s : ℂ) • e) ((c : ℂ) • d)]
    simp only [inner_smul_left, inner_smul_right, Complex.conj_ofReal, hed,
      mul_zero, norm_smul, he, hd, mul_one, Complex.norm_real,
      Real.norm_eq_abs]
    norm_num
    nlinarith [sq_abs c, sq_abs s]
  have hu : ‖u‖ = 1 := by nlinarith [norm_nonneg u]
  have hv : ‖v‖ = 1 := by nlinarith [norm_nonneg v]
  change f.homogeneousValue u + f.homogeneousValue v =
    f.homogeneousValue e + f.homogeneousValue d
  rw [f.homogeneousValue_of_norm_eq_one hu,
    f.homogeneousValue_of_norm_eq_one hv,
    f.homogeneousValue_of_norm_eq_one he,
    f.homogeneousValue_of_norm_eq_one hd]
  exact f.unitValue_real_rotation_pair_sum he hd hed c s hcs

lemma FrameFunction.homogeneousValue_complex_rotation_pair_sum
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (f : FrameFunction H) {e d : H}
    (he : ‖e‖ = 1) (hd : ‖d‖ = 1) (hed : inner ℂ e d = 0)
    (a b : ℂ) (hab : ‖a‖ ^ 2 + ‖b‖ ^ 2 = 1) :
    f.homogeneousValue (a • e + b • d) +
        f.homogeneousValue ((-starRingEnd ℂ b) • e + (starRingEnd ℂ a) • d) =
      f.homogeneousValue e + f.homogeneousValue d := by
  let u : H := a • e + b • d
  let v : H := (-starRingEnd ℂ b) • e + (starRingEnd ℂ a) • d
  have hu_sq : ‖u‖ ^ 2 = 1 := by
    rw [show ‖u‖ ^ 2 = ‖a • e‖ ^ 2 +
        2 * RCLike.re (inner ℂ (a • e) (b • d)) + ‖b • d‖ ^ 2 by
      exact norm_add_sq (𝕜 := ℂ) (a • e) (b • d)]
    simp only [inner_smul_left, inner_smul_right, hed, mul_zero,
      norm_smul, he, hd, mul_one]
    norm_num
    nlinarith
  have hv_sq : ‖v‖ ^ 2 = 1 := by
    rw [show ‖v‖ ^ 2 = ‖(-starRingEnd ℂ b) • e‖ ^ 2 +
        2 * RCLike.re (inner ℂ ((-starRingEnd ℂ b) • e)
          ((starRingEnd ℂ a) • d)) +
        ‖(starRingEnd ℂ a) • d‖ ^ 2 by
      exact norm_add_sq (𝕜 := ℂ) ((-starRingEnd ℂ b) • e)
        ((starRingEnd ℂ a) • d)]
    simp only [inner_smul_left, inner_smul_right, map_neg,
      hed, mul_zero, norm_smul, norm_neg, he, hd, mul_one]
    norm_num
    nlinarith
  have hu : ‖u‖ = 1 := by nlinarith [norm_nonneg u]
  have hv : ‖v‖ = 1 := by nlinarith [norm_nonneg v]
  change f.homogeneousValue u + f.homogeneousValue v =
    f.homogeneousValue e + f.homogeneousValue d
  rw [f.homogeneousValue_of_norm_eq_one hu,
    f.homogeneousValue_of_norm_eq_one hv,
    f.homogeneousValue_of_norm_eq_one he,
    f.homogeneousValue_of_norm_eq_one hd]
  exact f.unitValue_complex_rotation_pair_sum he hd hed a b hab

lemma FrameFunction.homogeneousValue_smul
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (c : ℂ) (x : H) :
    f.homogeneousValue (c • x) = ‖c‖ ^ 2 * f.homogeneousValue x := by
  by_cases hc : c = 0
  · simp [hc]
  by_cases hx : x = 0
  · simp [hx]
  have hnc : ‖c‖ ≠ 0 := norm_ne_zero_iff.mpr hc
  have hnx : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
  have hcx : c • x ≠ 0 := smul_ne_zero hc hx
  let phase : ℂ := c / (‖c‖ : ℂ)
  have hphase : ‖phase‖ = 1 := by
    simp [phase, hnc]
  have hunit : ((‖c • x‖ : ℂ)⁻¹) • (c • x) =
      phase • (((‖x‖ : ℂ)⁻¹) • x) := by
    rw [norm_smul]
    simp only [smul_smul]
    congr 1
    simp only [phase, div_eq_mul_inv, Complex.ofReal_mul]
    field_simp
  rw [FrameFunction.homogeneousValue, if_neg hcx,
    FrameFunction.homogeneousValue, if_neg hx, hunit,
    f.unitValue_smul_of_norm_eq_one phase _ hphase, norm_smul]
  ring

lemma FrameFunction.homogeneousValue_parallelogram_smul
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (c : ℂ) (x : H) :
    f.homogeneousValue (x + c • x) + f.homogeneousValue (x - c • x) =
      2 * f.homogeneousValue x + 2 * f.homogeneousValue (c • x) := by
  rw [show x + c • x = (1 + c) • x by module,
    show x - c • x = (1 - c) • x by module,
    f.homogeneousValue_smul,
    f.homogeneousValue_smul, f.homogeneousValue_smul]
  have hnorm := parallelogram_law_with_norm ℂ (1 : ℂ) c
  norm_num at hnorm ⊢
  nlinarith [f.homogeneousValue_nonneg x]

lemma FrameFunction.homogeneousValue_parallelogram_of_orthonormal
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {x y : H}
    (hx : ‖x‖ = 1) (hy : ‖y‖ = 1) (hxy : inner ℂ x y = 0) :
    f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
      2 * f.homogeneousValue x + 2 * f.homogeneousValue y := by
  let a : ℂ := (Real.sqrt 2 : ℂ)⁻¹
  let u : H := a • (x + y)
  let v : H := a • (x - y)
  have hsqrt : Real.sqrt 2 ≠ 0 := by positivity
  have hsqrt_pos : 0 < Real.sqrt 2 := Real.sqrt_pos.2 (by norm_num)
  have hsqrt_sq : (Real.sqrt 2) ^ 2 = 2 := by norm_num
  have hnorm_add_sq : ‖x + y‖ ^ 2 = 2 := by
    calc
      ‖x + y‖ ^ 2 = ‖x + y‖ * ‖x + y‖ := by ring
      _ = ‖x‖ * ‖x‖ + ‖y‖ * ‖y‖ :=
        norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero x y hxy
      _ = 2 := by rw [hx, hy]; norm_num
  have hnorm_sub_sq : ‖x - y‖ ^ 2 = 2 := by
    rw [norm_sub_sq (𝕜 := ℂ), hx, hy, hxy]
    norm_num
  have hnorm_add : ‖x + y‖ = Real.sqrt 2 := by
    calc
      ‖x + y‖ = Real.sqrt (‖x + y‖ ^ 2) :=
        (Real.sqrt_sq (norm_nonneg (x + y))).symm
      _ = Real.sqrt 2 := by rw [hnorm_add_sq]
  have hnorm_sub : ‖x - y‖ = Real.sqrt 2 := by
    calc
      ‖x - y‖ = Real.sqrt (‖x - y‖ ^ 2) :=
        (Real.sqrt_sq (norm_nonneg (x - y))).symm
      _ = Real.sqrt 2 := by rw [hnorm_sub_sq]
  have hu : ‖u‖ = 1 := by
    change ‖a • (x + y)‖ = 1
    rw [norm_smul, hnorm_add]
    simp only [a, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hsqrt_pos]
    exact inv_mul_cancel₀ hsqrt
  have hv : ‖v‖ = 1 := by
    change ‖a • (x - y)‖ = 1
    rw [norm_smul, hnorm_sub]
    simp only [a, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hsqrt_pos]
    exact inv_mul_cancel₀ hsqrt
  have huv : inner ℂ u v = 0 := by
    have hyx : inner ℂ y x = 0 := by
      exact inner_eq_zero_symm.mp hxy
    have hinner : inner ℂ (x + y) (x - y) = 0 := by
      rw [inner_sub_right, inner_add_left, inner_add_left, hxy, hyx,
        inner_self_eq_norm_sq_to_K, inner_self_eq_norm_sq_to_K, hx, hy]
      norm_num
    change inner ℂ (a • (x + y)) (a • (x - y)) = 0
    rw [inner_smul_left, inner_smul_right, hinner]
    simp
  have hsum : InnerProductSpace.rankOne ℂ x x + InnerProductSpace.rankOne ℂ y y =
      InnerProductSpace.rankOne ℂ u u + InnerProductSpace.rankOne ℂ v v := by
    have ha : starRingEnd ℂ a * a = (2 : ℂ)⁻¹ := by
      simp only [a, map_inv₀, Complex.conj_ofReal]
      have hsqrtC : (Real.sqrt 2 : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hsqrt
      field_simp
      exact_mod_cast hsqrt_sq.symm
    ext z
    change inner ℂ x z • x + inner ℂ y z • y =
      inner ℂ (a • (x + y)) z • (a • (x + y)) +
        inner ℂ (a • (x - y)) z • (a • (x - y))
    simp only [inner_smul_left, inner_add_left, inner_sub_left,
      smul_add, smul_sub, smul_smul]
    let X : ℂ := inner ℂ x z
    let Y : ℂ := inner ℂ y z
    have hp : (starRingEnd ℂ a * X + starRingEnd ℂ a * Y) * a =
        (2 : ℂ)⁻¹ * (X + Y) := by
      calc
        _ = (starRingEnd ℂ a * a) * (X + Y) := by ring
        _ = (2 : ℂ)⁻¹ * (X + Y) := by rw [ha]
    have hm : (starRingEnd ℂ a * X - starRingEnd ℂ a * Y) * a =
        (2 : ℂ)⁻¹ * (X - Y) := by
      calc
        _ = (starRingEnd ℂ a * a) * (X - Y) := by ring
        _ = (2 : ℂ)⁻¹ * (X - Y) := by rw [ha]
    change X • x + Y • y =
      ((starRingEnd ℂ a * X + starRingEnd ℂ a * Y) * a) • x +
          ((starRingEnd ℂ a * X + starRingEnd ℂ a * Y) * a) • y +
        (((starRingEnd ℂ a * X - starRingEnd ℂ a * Y) * a) • x -
          ((starRingEnd ℂ a * X - starRingEnd ℂ a * Y) * a) • y)
    rw [hp, hm]
    module
  have hpair := f.unitValue_pair_sum_eq hx hy hxy hu hv huv hsum
  have hqx := f.homogeneousValue_of_norm_eq_one hx
  have hqy := f.homogeneousValue_of_norm_eq_one hy
  have hqu := f.homogeneousValue_of_norm_eq_one hu
  have hqv := f.homogeneousValue_of_norm_eq_one hv
  have hxu : (Real.sqrt 2 : ℂ) • u = x + y := by
    simp [u, a, hsqrt]
  have hyv : (Real.sqrt 2 : ℂ) • v = x - y := by
    simp [v, a, hsqrt]
  have hqadd : f.homogeneousValue (x + y) = 2 * f.homogeneousValue u := by
    rw [← hxu, f.homogeneousValue_smul]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hsqrt_pos, hsqrt_sq]
  have hqsub : f.homogeneousValue (x - y) = 2 * f.homogeneousValue v := by
    rw [← hyv, f.homogeneousValue_smul]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hsqrt_pos, hsqrt_sq]
  rw [← hqx, ← hqy, ← hqu, ← hqv] at hpair
  rw [hqadd, hqsub]
  linarith

lemma FrameFunction.homogeneousValue_parallelogram_of_orthogonal_of_norm_eq
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {x y : H} (hxy : inner ℂ x y = 0) (hnorm : ‖x‖ = ‖y‖) :
    f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
      2 * f.homogeneousValue x + 2 * f.homogeneousValue y := by
  by_cases hx : x = 0
  · have hy : y = 0 := by
      apply norm_eq_zero.mp
      simpa [hx] using hnorm.symm
    simp [hx, hy]
  have hr : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
  let r : ℂ := (‖x‖ : ℂ)
  let u : H := r⁻¹ • x
  let v : H := r⁻¹ • y
  have hu : ‖u‖ = 1 := by
    simp [u, r, norm_smul, hr]
  have hv : ‖v‖ = 1 := by
    change ‖r⁻¹ • y‖ = 1
    rw [norm_smul, hnorm.symm]
    simp [r, hr]
  have huv : inner ℂ u v = 0 := by
    simp [u, v, hxy]
  have hpara := f.homogeneousValue_parallelogram_of_orthonormal hu hv huv
  have hru : r • u = x := by simp [r, u, hr]
  have hrv : r • v = y := by simp [r, v, hr]
  have hadd : r • (u + v) = x + y := by rw [smul_add, hru, hrv]
  have hsub : r • (u - v) = x - y := by rw [smul_sub, hru, hrv]
  have hqadd : f.homogeneousValue (x + y) =
      ‖r‖ ^ 2 * f.homogeneousValue (u + v) := by
    rw [← hadd, f.homogeneousValue_smul]
  have hqsub : f.homogeneousValue (x - y) =
      ‖r‖ ^ 2 * f.homogeneousValue (u - v) := by
    rw [← hsub, f.homogeneousValue_smul]
  have hqx : f.homogeneousValue x = ‖r‖ ^ 2 * f.homogeneousValue u := by
    rw [← hru, f.homogeneousValue_smul]
  have hqy : f.homogeneousValue y = ‖r‖ ^ 2 * f.homogeneousValue v := by
    rw [← hrv, f.homogeneousValue_smul]
  rw [hqadd, hqsub, hqx, hqy]
  calc
    ‖r‖ ^ 2 * f.homogeneousValue (u + v) +
        ‖r‖ ^ 2 * f.homogeneousValue (u - v) =
      ‖r‖ ^ 2 * (f.homogeneousValue (u + v) + f.homogeneousValue (u - v)) := by ring
    _ = ‖r‖ ^ 2 * (2 * f.homogeneousValue u + 2 * f.homogeneousValue v) := by rw [hpara]
    _ = 2 * (‖r‖ ^ 2 * f.homogeneousValue u) +
        2 * (‖r‖ ^ 2 * f.homogeneousValue v) := by ring

lemma exists_unit_orthogonal_pair
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (hdim : 3 ≤ Module.finrank ℂ H) (x y : H) :
    ∃ z : H, ‖z‖ = 1 ∧ inner ℂ x z = 0 ∧ inner ℂ y z = 0 := by
  classical
  let s : Finset H := {x, y}
  let K : Submodule ℂ H := Submodule.span ℂ (s : Set H)
  have hKdim : Module.finrank ℂ K ≤ 2 := by
    apply (finrank_span_finset_le_card s).trans
    by_cases hxy : x = y
    · simp [s, hxy]
    · simp [s, hxy]
  have hsum := K.finrank_add_finrank_orthogonal
  have hKperp : 0 < Module.finrank ℂ Kᗮ := by omega
  letI : Nontrivial Kᗮ := Module.nontrivial_of_finrank_pos hKperp
  obtain ⟨w, hw⟩ : ∃ w : Kᗮ, w ≠ 0 := exists_ne 0
  have hwcoe : (w : H) ≠ 0 := fun h ↦ hw (Submodule.coe_eq_zero.mp h)
  have hwnorm : ‖(w : H)‖ ≠ 0 := norm_ne_zero_iff.mpr hwcoe
  let z : H := ((‖(w : H)‖ : ℂ)⁻¹) • (w : H)
  refine ⟨z, ?_, ?_, ?_⟩
  · simp [z, norm_smul, hwnorm]
  · have hxK : x ∈ K := Submodule.subset_span (by simp [s])
    have hxw : inner ℂ x (w : H) = 0 :=
      Submodule.inner_right_of_mem_orthogonal hxK w.2
    simp [z, hxw]
  · have hyK : y ∈ K := Submodule.subset_span (by simp [s])
    have hyw : inner ℂ y (w : H) = 0 :=
      Submodule.inner_right_of_mem_orthogonal hyK w.2
    simp [z, hyw]

lemma exists_orthogonal_pair_with_norm
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (hdim : 3 ≤ Module.finrank ℂ H) (x y : H) (r : ℝ) (hr : 0 ≤ r) :
    ∃ z : H, ‖z‖ = r ∧ inner ℂ x z = 0 ∧ inner ℂ y z = 0 := by
  obtain ⟨u, hu, hxu, hyu⟩ := exists_unit_orthogonal_pair hdim x y
  refine ⟨(r : ℂ) • u, ?_, ?_, ?_⟩
  · rw [norm_smul, hu, mul_one, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hr]
  · simp [hxu]
  · simp [hyu]

/-- The error term in the quadratic functional equation. -/
def quadraticDefect {H : Type*} [AddCommGroup H] (q : H → ℝ) (x y : H) : ℝ :=
  q (x + y) + q (x - y) - 2 * q x - 2 * q y

lemma quadraticDefect_eq_zero_iff
    {H : Type*} [AddCommGroup H] (q : H → ℝ) (x y : H) :
    quadraticDefect q x y = 0 ↔
      q (x + y) + q (x - y) = 2 * q x + 2 * q y := by
  unfold quadraticDefect
  constructor <;> intro h <;> linarith

lemma FrameFunction.quadraticDefect_eq_zero_of_smul
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (c : ℂ) (x : H) :
    quadraticDefect f.homogeneousValue x (c • x) = 0 := by
  rw [quadraticDefect_eq_zero_iff]
  exact f.homogeneousValue_parallelogram_smul c x

lemma FrameFunction.quadraticDefect_eq_zero_of_orthogonal_of_norm_eq
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {x y : H} (hxy : inner ℂ x y = 0)
    (hnorm : ‖x‖ = ‖y‖) : quadraticDefect f.homogeneousValue x y = 0 := by
  rw [quadraticDefect_eq_zero_iff]
  exact f.homogeneousValue_parallelogram_of_orthogonal_of_norm_eq hxy hnorm

lemma FrameFunction.quadraticDefect_swap_real_coefficients
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (f : FrameFunction H) {e d : H}
    (he : ‖e‖ = 1) (hd : ‖d‖ = 1) (hed : inner ℂ e d = 0)
    (c s : ℝ) (hcs : c ^ 2 + s ^ 2 = 1) :
    quadraticDefect f.homogeneousValue ((c : ℂ) • e) ((s : ℂ) • d) =
      -quadraticDefect f.homogeneousValue ((s : ℂ) • e) ((c : ℂ) • d) := by
  have hplus := f.homogeneousValue_real_rotation_pair_sum he hd hed c s hcs
  have hminus :=
    f.homogeneousValue_real_rotation_pair_sum he hd hed c (-s) (by nlinarith)
  have hneg :
      f.homogeneousValue (-((s : ℂ) • e) - (c : ℂ) • d) =
        f.homogeneousValue ((s : ℂ) • e + (c : ℂ) • d) := by
    rw [show -((s : ℂ) • e) - (c : ℂ) • d =
      (-1 : ℂ) • ((s : ℂ) • e + (c : ℂ) • d) by module,
      f.homogeneousValue_smul]
    norm_num
  push_cast at hminus
  simp only [neg_smul] at hminus
  rw [hneg] at hminus
  have hminus' :
      f.homogeneousValue ((c : ℂ) • e - (s : ℂ) • d) +
          f.homogeneousValue ((s : ℂ) • e + (c : ℂ) • d) =
        f.homogeneousValue e + f.homogeneousValue d := by
    simpa only [sub_eq_add_neg] using hminus
  have hbase :
      c ^ 2 * f.homogeneousValue e + s ^ 2 * f.homogeneousValue d +
          s ^ 2 * f.homogeneousValue e + c ^ 2 * f.homogeneousValue d =
        f.homogeneousValue e + f.homogeneousValue d := by
    calc
      _ = (c ^ 2 + s ^ 2) *
          (f.homogeneousValue e + f.homogeneousValue d) := by ring
      _ = f.homogeneousValue e + f.homogeneousValue d := by rw [hcs]; ring
  rw [quadraticDefect, quadraticDefect]
  simp only [f.homogeneousValue_smul, Complex.norm_real, Real.norm_eq_abs,
    sq_abs]
  change _ = -_
  linarith

lemma FrameFunction.quadraticDefect_swap_complex_coefficients
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (f : FrameFunction H) {e d : H}
    (he : ‖e‖ = 1) (hd : ‖d‖ = 1) (hed : inner ℂ e d = 0)
    (a b : ℂ) (hab : ‖a‖ ^ 2 + ‖b‖ ^ 2 = 1) :
    quadraticDefect f.homogeneousValue (a • e) (b • d) =
      -quadraticDefect f.homogeneousValue
        ((starRingEnd ℂ b) • e) ((starRingEnd ℂ a) • d) := by
  have hplus := f.homogeneousValue_complex_rotation_pair_sum he hd hed a b hab
  have hminus :=
    f.homogeneousValue_complex_rotation_pair_sum he hd hed a (-b) (by simpa using hab)
  have hneg :
      f.homogeneousValue (-((starRingEnd ℂ b) • e) +
          (starRingEnd ℂ a) • d) =
        f.homogeneousValue ((starRingEnd ℂ b) • e -
          (starRingEnd ℂ a) • d) := by
    rw [show -((starRingEnd ℂ b) • e) + (starRingEnd ℂ a) • d =
      (-1 : ℂ) • ((starRingEnd ℂ b) • e -
        (starRingEnd ℂ a) • d) by module,
      f.homogeneousValue_smul]
    norm_num
  simp only [map_neg, neg_smul, neg_neg] at hminus
  have hminus' :
      f.homogeneousValue (a • e - b • d) +
          f.homogeneousValue ((starRingEnd ℂ b) • e +
            (starRingEnd ℂ a) • d) =
        f.homogeneousValue e + f.homogeneousValue d := by
    simpa only [sub_eq_add_neg] using hminus
  simp only [neg_smul] at hplus
  rw [hneg] at hplus
  have hnorma : ‖starRingEnd ℂ a‖ = ‖a‖ := by
    rw [starRingEnd_apply, norm_star]
  have hnormb : ‖starRingEnd ℂ b‖ = ‖b‖ := by
    rw [starRingEnd_apply, norm_star]
  have hbase :
      ‖a‖ ^ 2 * f.homogeneousValue e +
          ‖b‖ ^ 2 * f.homogeneousValue d +
          ‖b‖ ^ 2 * f.homogeneousValue e +
          ‖a‖ ^ 2 * f.homogeneousValue d =
        f.homogeneousValue e + f.homogeneousValue d := by
    calc
      _ = (‖a‖ ^ 2 + ‖b‖ ^ 2) *
          (f.homogeneousValue e + f.homogeneousValue d) := by ring
      _ = f.homogeneousValue e + f.homogeneousValue d := by rw [hab]; ring
  rw [quadraticDefect, quadraticDefect]
  simp only [f.homogeneousValue_smul]
  rw [hnorma, hnormb]
  linarith

lemma quadraticDefect_comm_of_even
    {H : Type*} [AddCommGroup H] (q : H → ℝ) (heven : ∀ x, q (-x) = q x)
    (x y : H) : quadraticDefect q x y = quadraticDefect q y x := by
  rw [quadraticDefect, quadraticDefect, add_comm y x]
  have hsub : q (y - x) = q (x - y) := by
    rw [show y - x = -(x - y) by abel, heven]
  rw [hsub]
  ring

lemma quadraticDefect_hadamard
    {H : Type*} [AddCommGroup H] (q : H → ℝ)
    (hdouble : ∀ x, q (x + x) = 4 * q x) (x y : H) :
    quadraticDefect q (x + y) (x - y) = -2 * quadraticDefect q x y := by
  rw [quadraticDefect, quadraticDefect]
  rw [show x + y + (x - y) = x + x by abel,
    show x + y - (x - y) = y + y by abel, hdouble, hdouble]
  ring

lemma FrameFunction.quadraticDefect_smul
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (c : ℂ) (x y : H) :
    quadraticDefect f.homogeneousValue (c • x) (c • y) =
      ‖c‖ ^ 2 * quadraticDefect f.homogeneousValue x y := by
  rw [quadraticDefect, quadraticDefect, ← smul_add, ← smul_sub]
  simp only [f.homogeneousValue_smul]
  ring

lemma FrameFunction.quadraticDefect_swap_real_scalars
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (f : FrameFunction H) {e d : H}
    (he : ‖e‖ = 1) (hd : ‖d‖ = 1) (hed : inner ℂ e d = 0)
    (a b : ℝ) :
    quadraticDefect f.homogeneousValue ((a : ℂ) • e) ((b : ℂ) • d) =
      -quadraticDefect f.homogeneousValue ((b : ℂ) • e) ((a : ℂ) • d) := by
  let r : ℝ := Real.sqrt (a ^ 2 + b ^ 2)
  by_cases hr : r = 0
  · have hab : a = 0 ∧ b = 0 := by
      have hsqrt : Real.sqrt (a ^ 2 + b ^ 2) = 0 := hr
      have hsquares : a ^ 2 + b ^ 2 = 0 := by
        nlinarith [Real.sq_sqrt (by positivity : 0 ≤ a ^ 2 + b ^ 2)]
      constructor <;> nlinarith [sq_nonneg a, sq_nonneg b]
    rcases hab with ⟨rfl, rfl⟩
    simp [quadraticDefect]
  · let c : ℝ := a / r
    let s : ℝ := b / r
    have hr_nonneg : 0 ≤ r := Real.sqrt_nonneg _
    have hr_sq : r ^ 2 = a ^ 2 + b ^ 2 := by
      exact Real.sq_sqrt (by positivity)
    have hcs : c ^ 2 + s ^ 2 = 1 := by
      dsimp [c, s]
      field_simp
      nlinarith
    have hrc : r * c = a := by
      dsimp [c]
      field_simp
    have hrs : r * s = b := by
      dsimp [s]
      field_simp
    have hswap := f.quadraticDefect_swap_real_coefficients he hd hed c s hcs
    have hce : (r : ℂ) • ((c : ℂ) • e) = (a : ℂ) • e := by
      rw [smul_smul]
      congr 1
      exact_mod_cast hrc
    have hsd : (r : ℂ) • ((s : ℂ) • d) = (b : ℂ) • d := by
      rw [smul_smul]
      congr 1
      exact_mod_cast hrs
    have hse : (r : ℂ) • ((s : ℂ) • e) = (b : ℂ) • e := by
      rw [smul_smul]
      congr 1
      exact_mod_cast hrs
    have hcd : (r : ℂ) • ((c : ℂ) • d) = (a : ℂ) • d := by
      rw [smul_smul]
      congr 1
      exact_mod_cast hrc
    have hleft := f.quadraticDefect_smul (r : ℂ)
      ((c : ℂ) • e) ((s : ℂ) • d)
    have hright := f.quadraticDefect_smul (r : ℂ)
      ((s : ℂ) • e) ((c : ℂ) • d)
    rw [hce, hsd] at hleft
    rw [hse, hcd] at hright
    rw [hleft, hright, hswap]
    ring

lemma FrameFunction.quadraticDefect_swap_complex_scalars
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (f : FrameFunction H) {e d : H}
    (he : ‖e‖ = 1) (hd : ‖d‖ = 1) (hed : inner ℂ e d = 0)
    (a b : ℂ) :
    quadraticDefect f.homogeneousValue (a • e) (b • d) =
      -quadraticDefect f.homogeneousValue
        ((starRingEnd ℂ b) • e) ((starRingEnd ℂ a) • d) := by
  let r : ℝ := Real.sqrt (‖a‖ ^ 2 + ‖b‖ ^ 2)
  by_cases hr : r = 0
  · have hab : a = 0 ∧ b = 0 := by
      have hsquares : ‖a‖ ^ 2 + ‖b‖ ^ 2 = 0 := by
        have hsqrt : Real.sqrt (‖a‖ ^ 2 + ‖b‖ ^ 2) = 0 := hr
        nlinarith [Real.sq_sqrt (by positivity : 0 ≤ ‖a‖ ^ 2 + ‖b‖ ^ 2)]
      constructor
      · exact norm_eq_zero.mp (by nlinarith [sq_nonneg ‖a‖, sq_nonneg ‖b‖])
      · exact norm_eq_zero.mp (by nlinarith [sq_nonneg ‖a‖, sq_nonneg ‖b‖])
    rcases hab with ⟨rfl, rfl⟩
    simp [quadraticDefect]
  · let c : ℂ := a / (r : ℂ)
    let s : ℂ := b / (r : ℂ)
    have hr_nonneg : 0 ≤ r := Real.sqrt_nonneg _
    have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr)
    have hr_sq : r ^ 2 = ‖a‖ ^ 2 + ‖b‖ ^ 2 := by
      exact Real.sq_sqrt (by positivity)
    have hcs : ‖c‖ ^ 2 + ‖s‖ ^ 2 = 1 := by
      simp only [c, s, norm_div, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hr_pos]
      field_simp
      nlinarith
    have hswap := f.quadraticDefect_swap_complex_coefficients he hd hed c s hcs
    have hrC : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr
    have hce : (r : ℂ) • (c • e) = a • e := by
      rw [smul_smul]
      congr 1
      dsimp [c]
      field_simp [hrC]
    have hsd : (r : ℂ) • (s • d) = b • d := by
      rw [smul_smul]
      congr 1
      dsimp [s]
      field_simp [hrC]
    have hse : (r : ℂ) • ((starRingEnd ℂ s) • e) = (starRingEnd ℂ b) • e := by
      rw [smul_smul]
      congr 1
      simp only [s, div_eq_mul_inv, map_mul, map_inv₀, Complex.conj_ofReal]
      field_simp [hrC]
    have hcd : (r : ℂ) • ((starRingEnd ℂ c) • d) = (starRingEnd ℂ a) • d := by
      rw [smul_smul]
      congr 1
      simp only [c, div_eq_mul_inv, map_mul, map_inv₀, Complex.conj_ofReal]
      field_simp [hrC]
    have hleft := f.quadraticDefect_smul (r : ℂ) (c • e) (s • d)
    have hright := f.quadraticDefect_smul (r : ℂ)
      ((starRingEnd ℂ s) • e) ((starRingEnd ℂ c) • d)
    rw [hce, hsd] at hleft
    rw [hse, hcd] at hright
    rw [hleft, hright, hswap]
    ring

lemma FrameFunction.quadraticDefect_hadamard
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x y : H) :
    quadraticDefect f.homogeneousValue (x + y) (x - y) =
      -2 * quadraticDefect f.homogeneousValue x y := by
  apply LeanEval.Analysis.quadraticDefect_hadamard f.homogeneousValue
  intro z
  rw [show z + z = (2 : ℂ) • z by module, f.homogeneousValue_smul]
  norm_num

lemma FrameFunction.abs_quadraticDefect_le
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x y : H) :
    |quadraticDefect f.homogeneousValue x y| ≤ 2 * (‖x‖ ^ 2 + ‖y‖ ^ 2) := by
  rw [abs_le]
  constructor
  · rw [quadraticDefect]
    nlinarith [f.homogeneousValue_nonneg (x + y),
      f.homogeneousValue_nonneg (x - y), f.homogeneousValue_le_norm_sq x,
      f.homogeneousValue_le_norm_sq y]
  · rw [quadraticDefect]
    have hnorm := parallelogram_law_with_norm ℂ x y
    nlinarith [f.homogeneousValue_le_norm_sq (x + y),
      f.homogeneousValue_le_norm_sq (x - y), f.homogeneousValue_nonneg x,
      f.homogeneousValue_nonneg y]

lemma quadraticDefect_fourthDifference
    {H : Type*} [AddCommGroup H] (q : H → ℝ) (heven : ∀ x, q (-x) = q x)
    (x y z : H) :
    quadraticDefect q (x + y) z + quadraticDefect q (x - y) z -
        2 * quadraticDefect q x z - 2 * quadraticDefect q y z =
      quadraticDefect q (x + z) y + quadraticDefect q (x - z) y -
        2 * quadraticDefect q x y - 2 * quadraticDefect q z y := by
  rw [quadraticDefect, quadraticDefect, quadraticDefect, quadraticDefect,
    quadraticDefect, quadraticDefect, quadraticDefect, quadraticDefect]
  have hzy : q (z - y) = q (y - z) := by
    rw [show z - y = -(y - z) by abel, heven]
  rw [hzy]
  congr 1 <;> abel_nf
  ring

lemma FrameFunction.quadraticDefect_orthogonal_norm_descent
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H) (hdim : 3 ≤ Module.finrank ℂ H) {x y : H}
    (hxy : inner ℂ x y = 0) (hnorm : ‖x‖ ≤ ‖y‖) :
    ∃ z : H,
      ‖z‖ ^ 2 = ‖y‖ ^ 2 - ‖x‖ ^ 2 ∧
      inner ℂ x z = 0 ∧ inner ℂ y z = 0 ∧
      quadraticDefect f.homogeneousValue (x + y) z +
          quadraticDefect f.homogeneousValue (x - y) z -
          2 * quadraticDefect f.homogeneousValue x z =
        -2 * quadraticDefect f.homogeneousValue x y := by
  have hsquare : 0 ≤ ‖y‖ ^ 2 - ‖x‖ ^ 2 := by
    nlinarith [norm_nonneg x, norm_nonneg y]
  obtain ⟨z, hz, hxz, hyz⟩ := exists_orthogonal_pair_with_norm hdim x y
    (Real.sqrt (‖y‖ ^ 2 - ‖x‖ ^ 2)) (Real.sqrt_nonneg _)
  have hzsquare : ‖z‖ ^ 2 = ‖y‖ ^ 2 - ‖x‖ ^ 2 := by
    rw [hz, Real.sq_sqrt hsquare]
  have hzy : inner ℂ z y = 0 := inner_eq_zero_symm.mp hyz
  have hplusOrth : inner ℂ (x + z) y = 0 := by
    rw [inner_add_left, hxy, hzy, add_zero]
  have hminusOrth : inner ℂ (x - z) y = 0 := by
    rw [inner_sub_left, hxy, hzy, sub_zero]
  have hplusSquare : ‖x + z‖ ^ 2 = ‖y‖ ^ 2 := by
    calc
      ‖x + z‖ ^ 2 = ‖x‖ ^ 2 + 2 * RCLike.re (inner ℂ x z) + ‖z‖ ^ 2 :=
        norm_add_sq (𝕜 := ℂ) x z
      _ = ‖x‖ ^ 2 + ‖z‖ ^ 2 := by rw [hxz]; norm_num
      _ = ‖y‖ ^ 2 := by linarith
  have hminusSquare : ‖x - z‖ ^ 2 = ‖y‖ ^ 2 := by
    calc
      ‖x - z‖ ^ 2 = ‖x‖ ^ 2 - 2 * RCLike.re (inner ℂ x z) + ‖z‖ ^ 2 :=
        norm_sub_sq (𝕜 := ℂ) x z
      _ = ‖x‖ ^ 2 + ‖z‖ ^ 2 := by rw [hxz]; norm_num
      _ = ‖y‖ ^ 2 := by linarith
  have hplusNorm : ‖x + z‖ = ‖y‖ := by
    nlinarith [norm_nonneg (x + z), norm_nonneg y]
  have hminusNorm : ‖x - z‖ = ‖y‖ := by
    nlinarith [norm_nonneg (x - z), norm_nonneg y]
  have hplusZero :=
    f.quadraticDefect_eq_zero_of_orthogonal_of_norm_eq hplusOrth hplusNorm
  have hminusZero :=
    f.quadraticDefect_eq_zero_of_orthogonal_of_norm_eq hminusOrth hminusNorm
  have heven (w : H) : f.homogeneousValue (-w) = f.homogeneousValue w := by
    rw [show -w = (-1 : ℂ) • w by simp, f.homogeneousValue_smul]
    norm_num
  have hcomm : quadraticDefect f.homogeneousValue y z =
      quadraticDefect f.homogeneousValue z y :=
    quadraticDefect_comm_of_even f.homogeneousValue heven y z
  have hfour := quadraticDefect_fourthDifference f.homogeneousValue
    heven x y z
  refine ⟨z, hzsquare, hxz, hyz, ?_⟩
  rw [hplusZero, hminusZero, hcomm] at hfour
  linarith

/-- Real polarization of a prospective quadratic function. -/
noncomputable def realPolar {H : Type*} [AddCommGroup H] (q : H → ℝ) (x y : H) : ℝ :=
  (q (x + y) - q (x - y)) / 4

lemma realPolar_add_left_of_parallelogram
    {H : Type*} [AddCommGroup H] (q : H → ℝ)
    (hpara : ∀ x y : H, q (x + y) + q (x - y) = 2 * q x + 2 * q y)
    (x y z : H) :
    realPolar q (x + y) z = realPolar q x z + realPolar q y z := by
  have hzero : q 0 = 0 := by
    have h := hpara 0 0
    simp only [zero_add, zero_sub, neg_zero] at h
    linarith
  have heven (w : H) : q (-w) = q w := by
    have h := hpara 0 w
    simp only [zero_add, zero_sub, hzero] at h
    linarith
  have hneg (a b : H) : realPolar q (-a) b = -realPolar q a b := by
    rw [realPolar, realPolar]
    have hp : -a + b = -(a - b) := by abel
    have hm : -a - b = -(a + b) := by abel
    rw [hp, hm, heven, heven]
    ring
  have hmid (a b c : H) :
      realPolar q (a + b) c + realPolar q (a - b) c = 2 * realPolar q a c := by
    have hp := hpara (a + c) b
    have hm := hpara (a - c) b
    rw [realPolar, realPolar, realPolar]
    abel_nf at hp hm ⊢
    linear_combination (hp - hm) / 4
  have hx := hmid x y z
  have hy := hmid y x z
  rw [add_comm y x, show y - x = -(x - y) by abel, hneg] at hy
  linarith

lemma realPolar_comm_of_even
    {H : Type*} [AddCommGroup H] (q : H → ℝ) (heven : ∀ x, q (-x) = q x)
    (x y : H) : realPolar q x y = realPolar q y x := by
  rw [realPolar, realPolar, add_comm]
  have hsub : y - x = -(x - y) := by abel
  rw [hsub, heven]

/-- The real polarization of the homogeneous extension of a frame function. -/
noncomputable def FrameFunction.polar
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x y : H) : ℝ :=
  realPolar f.homogeneousValue x y

lemma FrameFunction.homogeneousValue_neg
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x : H) : f.homogeneousValue (-x) = f.homogeneousValue x := by
  rw [show -x = (-1 : ℂ) • x by simp, f.homogeneousValue_smul]
  norm_num

/-- On an orthogonal pair, exchanging the norms along the two normalized rays negates the
quadratic defect. This is the coordinate-free form of complex coefficient swapping. -/
lemma FrameFunction.quadraticDefect_swap_orthogonal
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (f : FrameFunction H) {x y : H}
    (hxy : inner ℂ x y = 0) :
    quadraticDefect f.homogeneousValue x y =
      -quadraticDefect f.homogeneousValue
        ((‖y‖ : ℂ) • ((‖x‖ : ℂ)⁻¹ • x))
        ((‖x‖ : ℂ) • ((‖y‖ : ℂ)⁻¹ • y)) := by
  by_cases hx : x = 0
  · subst x
    simp only [norm_zero, Complex.ofReal_zero, inv_zero, zero_smul, smul_zero,
      quadraticDefect, zero_add, zero_sub, f.homogeneousValue_zero,
      f.homogeneousValue_neg, neg_zero]
    ring
  by_cases hy : y = 0
  · subst y
    simp only [norm_zero, Complex.ofReal_zero, inv_zero, zero_smul, smul_zero,
      quadraticDefect, add_zero, sub_zero, zero_sub, f.homogeneousValue_zero]
    ring
  let e : H := ((‖x‖ : ℂ)⁻¹) • x
  let d : H := ((‖y‖ : ℂ)⁻¹) • y
  have hxnorm : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
  have hynorm : ‖y‖ ≠ 0 := norm_ne_zero_iff.mpr hy
  have he : ‖e‖ = 1 := by simp [e, norm_smul, hxnorm]
  have hd : ‖d‖ = 1 := by simp [d, norm_smul, hynorm]
  have hed : inner ℂ e d = 0 := by simp [e, d, hxy]
  have hswap := f.quadraticDefect_swap_complex_scalars he hd hed
    (‖x‖ : ℂ) (‖y‖ : ℂ)
  have hxe : (‖x‖ : ℂ) • e = x := by simp [e, hxnorm]
  have hyd : (‖y‖ : ℂ) • d = y := by simp [d, hynorm]
  simpa only [hxe, hyd, map_ofNat, map_inv₀, Complex.conj_ofReal] using hswap

/-- Ratio notation for `quadraticDefect_swap_orthogonal`. -/
lemma FrameFunction.quadraticDefect_swap_orthogonal_ratio
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (f : FrameFunction H) {x y : H}
    (hxy : inner ℂ x y = 0) :
    quadraticDefect f.homogeneousValue x y =
      -quadraticDefect f.homogeneousValue
        (((‖y‖ : ℂ) / (‖x‖ : ℂ)) • x)
        (((‖x‖ : ℂ) / (‖y‖ : ℂ)) • y) := by
  simpa only [smul_smul, div_eq_mul_inv] using
    f.quadraticDefect_swap_orthogonal hxy

lemma FrameFunction.polar_comm
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x y : H) : f.polar x y = f.polar y x := by
  exact realPolar_comm_of_even f.homogeneousValue f.homogeneousValue_neg x y

lemma FrameFunction.polar_add_left
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y z : H) : f.polar (x + y) z = f.polar x z + f.polar y z := by
  exact realPolar_add_left_of_parallelogram f.homogeneousValue hpara x y z

lemma FrameFunction.polar_add_right
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y z : H) : f.polar x (y + z) = f.polar x y + f.polar x z := by
  rw [f.polar_comm x, f.polar_add_left hpara, f.polar_comm y, f.polar_comm z]

lemma FrameFunction.polar_zero_left
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (y : H) : f.polar 0 y = 0 := by
  have h := f.polar_add_left hpara 0 0 y
  simp only [zero_add] at h
  linarith

lemma FrameFunction.polar_self
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x : H) : f.polar x x = f.homogeneousValue x := by
  have htwo := f.homogeneousValue_smul (2 : ℂ) x
  rw [FrameFunction.polar, realPolar, sub_self, f.homogeneousValue_zero]
  rw [show x + x = (2 : ℂ) • x by module, htwo]
  norm_num

lemma FrameFunction.homogeneousValue_add_eq
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y : H) :
    f.homogeneousValue (x + y) =
      f.homogeneousValue x + f.homogeneousValue y + 2 * f.polar x y := by
  rw [FrameFunction.polar, realPolar]
  linarith [hpara x y]

lemma FrameFunction.abs_polar_le
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y : H) :
    |f.polar x y| ≤ (‖x‖ ^ 2 + ‖y‖ ^ 2) / 2 := by
  have hnonneg_add := f.homogeneousValue_nonneg (x + y)
  have hnonneg_sub := f.homogeneousValue_nonneg (x - y)
  have habs : |f.homogeneousValue (x + y) - f.homogeneousValue (x - y)| ≤
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) := by
    rw [abs_le]
    constructor <;> linarith
  rw [FrameFunction.polar, realPolar, abs_div]
  norm_num
  nlinarith [hpara x y, f.homogeneousValue_le_norm_sq x,
    f.homogeneousValue_le_norm_sq y]

noncomputable def FrameFunction.polarAddHom
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (y : H) : H →+ ℝ where
  toFun x := f.polar x y
  map_zero' := f.polar_zero_left hpara y
  map_add' x x' := f.polar_add_left hpara x x' y

lemma FrameFunction.continuous_polarAddHom
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (y : H) : Continuous (f.polarAddHom hpara y) := by
  apply AddMonoidHom.continuous_of_isBounded_nhds_zero
    (s := Metric.ball (0 : H) 1) (f.polarAddHom hpara y)
  · exact Metric.ball_mem_nhds _ zero_lt_one
  · rw [isBounded_iff_forall_norm_le]
    refine ⟨(1 + ‖y‖ ^ 2) / 2, ?_⟩
    rintro z ⟨x, hx, rfl⟩
    have hxnorm : ‖x‖ < 1 := by simpa [Metric.mem_ball, dist_zero_right] using hx
    change |f.polar x y| ≤ (1 + ‖y‖ ^ 2) / 2
    exact (f.abs_polar_le hpara x y).trans <| by
      nlinarith [sq_nonneg ‖x‖, norm_nonneg x]

noncomputable def FrameFunction.polarCLM
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (y : H) : H →L[ℝ] ℝ :=
  (f.polarAddHom hpara y).toRealLinearMap (f.continuous_polarAddHom hpara y)

@[simp] lemma FrameFunction.polarCLM_apply
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y : H) : f.polarCLM hpara y x = f.polar x y := rfl

lemma FrameFunction.polar_smul_real_left
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (r : ℝ) (x y : H) : f.polar (r • x) y = r * f.polar x y := by
  simpa only [FrameFunction.polarCLM_apply, smul_eq_mul] using
    (f.polarCLM hpara y).map_smul r x

lemma FrameFunction.polar_smul_real_right
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (r : ℝ) (x y : H) : f.polar x (r • y) = r * f.polar x y := by
  rw [f.polar_comm, f.polar_smul_real_left hpara, f.polar_comm]

lemma FrameFunction.polar_I_I
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x y : H) :
    f.polar (Complex.I • x) (Complex.I • y) = f.polar x y := by
  rw [FrameFunction.polar, realPolar]
  simp only [← smul_add, ← smul_sub, f.homogeneousValue_smul, Complex.norm_I]
  norm_num
  rfl

lemma FrameFunction.polar_I_left
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y : H) : f.polar (Complex.I • x) y = -f.polar x (Complex.I • y) := by
  have h := f.polar_I_I x (Complex.I • y)
  rw [smul_smul, Complex.I_mul_I, neg_one_smul] at h
  have hneg : f.polar (Complex.I • x) (-y) = -f.polar (Complex.I • x) y := by
    simpa using f.polar_smul_real_right hpara (-1) (Complex.I • x) y
  rw [hneg] at h
  linarith

lemma FrameFunction.polar_I_right
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y : H) : f.polar x (Complex.I • y) = -f.polar (Complex.I • x) y := by
  linarith [f.polar_I_left hpara x y]

lemma FrameFunction.polar_complex_combination_right
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (c : ℂ) (x y : H) :
    (f.polar y (c • x) : ℂ) + Complex.I * (f.polar (Complex.I • y) (c • x) : ℂ) =
      c * ((f.polar y x : ℂ) + Complex.I * (f.polar (Complex.I • y) x : ℂ)) := by
  have hcsmul : c • x = c.re • x + c.im • (Complex.I • x) := by
    calc
      c • x = ((c.re : ℂ) + (c.im : ℂ) * Complex.I) • x := by
        rw [Complex.re_add_im]
      _ = c.re • x + c.im • (Complex.I • x) := by
        rw [add_smul, mul_smul]
        exact congrArg₂ (· + ·)
          (RCLike.real_smul_eq_coe_smul (K := ℂ) c.re x).symm
          (RCLike.real_smul_eq_coe_smul (K := ℂ) c.im (Complex.I • x)).symm
  rw [hcsmul, f.polar_add_right hpara, f.polar_add_right hpara]
  rw [f.polar_smul_real_right hpara, f.polar_smul_real_right hpara,
    f.polar_smul_real_right hpara, f.polar_smul_real_right hpara]
  rw [f.polar_I_right hpara y x, f.polar_I_I]
  apply Complex.ext <;> simp
  all_goals ring

noncomputable def FrameFunction.complexPolar
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x y : H) : ℂ :=
  (f.polar x y : ℂ) + Complex.I * (f.polar (Complex.I • x) y : ℂ)

lemma FrameFunction.complexPolar_add_right
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y z : H) : f.complexPolar x (y + z) = f.complexPolar x y + f.complexPolar x z := by
  simp only [FrameFunction.complexPolar, f.polar_add_right hpara]
  push_cast
  ring

lemma FrameFunction.complexPolar_smul_right
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (c : ℂ) (x y : H) : f.complexPolar x (c • y) = c * f.complexPolar x y := by
  exact f.polar_complex_combination_right hpara c y x

lemma FrameFunction.star_complexPolar
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y : H) : starRingEnd ℂ (f.complexPolar x y) = f.complexPolar y x := by
  simp only [FrameFunction.complexPolar, map_add, map_mul, Complex.conj_ofReal,
    Complex.conj_I]
  rw [f.polar_comm x y, f.polar_comm (Complex.I • x) y,
    f.polar_I_right hpara y x]
  push_cast
  ring_nf

lemma FrameFunction.complexPolar_add_left
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y z : H) : f.complexPolar (x + y) z = f.complexPolar x z + f.complexPolar y z := by
  apply_fun starRingEnd ℂ
  simpa only [f.star_complexPolar hpara, map_add] using f.complexPolar_add_right hpara z x y

lemma FrameFunction.complexPolar_smul_left
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (c : ℂ) (x y : H) :
    f.complexPolar (c • x) y = starRingEnd ℂ c * f.complexPolar x y := by
  apply_fun starRingEnd ℂ
  simpa only [f.star_complexPolar hpara, map_mul, starRingEnd_self_apply] using
    f.complexPolar_smul_right hpara c y x

lemma FrameFunction.complexPolar_self
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) (x : H) :
    f.complexPolar x x = (f.homogeneousValue x : ℂ) := by
  rw [FrameFunction.complexPolar, f.polar_self]
  have hzero : f.polar (Complex.I • x) x = 0 := by
    rw [FrameFunction.polar, realPolar]
    have heq : f.homogeneousValue (Complex.I • x + x) =
        f.homogeneousValue (Complex.I • x - x) := by
      have hrotate : Complex.I • (Complex.I • x + x) = Complex.I • x - x := by
        rw [smul_add, smul_smul, Complex.I_mul_I, neg_one_smul]
        abel
      rw [← hrotate, f.homogeneousValue_smul]
      simp
    rw [heq, sub_self, zero_div]
  rw [hzero]
  simp

noncomputable def FrameFunction.complexPolarLM
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x : H) : H →ₗ[ℂ] ℂ where
  toFun y := f.complexPolar x y
  map_add' y z := f.complexPolar_add_right hpara x y z
  map_smul' c y := by
    rw [f.complexPolar_smul_right hpara]
    rfl

noncomputable def FrameFunction.complexPolarCLM
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x : H) : H →L[ℂ] ℂ :=
  (f.complexPolarLM hpara x).toContinuousLinearMap

@[simp] lemma FrameFunction.complexPolarCLM_apply
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y : H) : f.complexPolarCLM hpara x y = f.complexPolar x y := rfl

noncomputable def FrameFunction.quadraticOperatorAux
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x : H) : H :=
  (InnerProductSpace.toDual ℂ H).symm (f.complexPolarCLM hpara x)

@[simp] lemma FrameFunction.inner_quadraticOperatorAux
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y : H) : inner ℂ (f.quadraticOperatorAux hpara x) y = f.complexPolar x y := by
  exact InnerProductSpace.toDual_symm_apply

noncomputable def FrameFunction.quadraticOperatorLM
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y) : H →ₗ[ℂ] H where
  toFun x := f.quadraticOperatorAux hpara x
  map_add' x y := by
    apply ext_inner_right ℂ
    intro z
    rw [f.inner_quadraticOperatorAux, inner_add_left,
      f.inner_quadraticOperatorAux, f.inner_quadraticOperatorAux,
      f.complexPolar_add_left hpara]
  map_smul' c x := by
    apply ext_inner_right ℂ
    intro y
    rw [f.inner_quadraticOperatorAux, inner_smul_left,
      f.inner_quadraticOperatorAux, f.complexPolar_smul_left hpara]
    rfl

noncomputable def FrameFunction.quadraticOperator
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y) : H →L[ℂ] H :=
  (f.quadraticOperatorLM hpara).toContinuousLinearMap

@[simp] lemma FrameFunction.inner_quadraticOperator
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x y : H) : inner ℂ (f.quadraticOperator hpara x) y = f.complexPolar x y := by
  exact f.inner_quadraticOperatorAux hpara x y

lemma FrameFunction.quadraticOperator_isSymmetric
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y) :
    (f.quadraticOperator hpara).IsSymmetric := by
  intro x y
  change inner ℂ (f.quadraticOperator hpara x) y =
    inner ℂ x (f.quadraticOperator hpara y)
  rw [f.inner_quadraticOperator, ← inner_conj_symm,
    f.inner_quadraticOperator, f.star_complexPolar hpara]

lemma FrameFunction.map_sum
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (f : FrameFunction H) {ι : Type*} [Fintype ι]
    (P : ι → H →L[ℂ] H)
    (hP : ∀ i, IsOrthProj (P i))
    (horth : ∀ i j, i ≠ j → P i * P j = 0) :
    f.μ (∑ i, P i) = ∑ i, f.μ (P i) := by
  classical
  have hfinset : ∀ s : Finset ι,
      IsOrthProj (∑ i ∈ s, P i) ∧
        f.μ (∑ i ∈ s, P i) = ∑ i ∈ s, f.μ (P i) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
        simp only [Finset.sum_empty]
        exact ⟨isOrthProj_iff_isStarProjection.mpr
          (IsStarProjection.zero (H →L[ℂ] H)),
          f.map_zero⟩
    | @insert a s ha ih =>
        have hmul : P a * ∑ i ∈ s, P i = 0 := by
          rw [Finset.mul_sum]
          apply Finset.sum_eq_zero
          intro i hi
          rw [horth a i (by
            intro hai
            subst i
            exact ha hi)]
        have hsum : IsOrthProj (P a + ∑ i ∈ s, P i) :=
          isOrthProj_iff_isStarProjection.mpr <|
            (isOrthProj_iff_isStarProjection.mp (hP a)).add
              (isOrthProj_iff_isStarProjection.mp ih.1) hmul
        constructor
        · simpa [Finset.sum_insert, ha] using hsum
        · rw [Finset.sum_insert ha, Finset.sum_insert ha]
          rw [f.additive (P a) (∑ i ∈ s, P i) (hP a) ih.1 hmul, ih.2]
  simpa using (hfinset Finset.univ).2

lemma FrameFunction.sum_unitValue_orthonormalBasis
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H) {ι : Type*} [Fintype ι]
    (b : OrthonormalBasis ι ℂ H) :
    ∑ i, f.unitValue (b i) = 1 := by
  let P : ι → H →L[ℂ] H := fun i ↦ InnerProductSpace.rankOne ℂ (b i) (b i)
  have hP (i : ι) : IsOrthProj (P i) :=
    isOrthProj_iff_isStarProjection.mpr <|
      InnerProductSpace.isStarProjection_rankOne_self (b.orthonormal.norm_eq_one i)
  have horth (i j : ι) (hij : i ≠ j) : P i * P j = 0 := by
    rw [ContinuousLinearMap.mul_def, InnerProductSpace.rankOne_comp_rankOne]
    rw [b.inner_eq_zero hij, zero_smul]
  have hsum := f.map_sum P hP horth
  rw [show (∑ i, P i) = 1 by
    change (∑ i, P i) = ContinuousLinearMap.id ℂ H
    simpa [P] using b.sum_rankOne_eq_id] at hsum
  simpa [FrameFunction.unitValue, f.normalized, P] using hsum.symm

lemma reTr_mul_rankOne {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H] (T : H →L[ℂ] H) (x : H) :
    reTr (T * InnerProductSpace.rankOne ℂ x x) = (inner ℂ x (T x)).re := by
  have hcomp :
      T * InnerProductSpace.rankOne ℂ x x = InnerProductSpace.rankOne ℂ (T x) x := by
    rw [ContinuousLinearMap.mul_def]
    exact InnerProductSpace.comp_rankOne x x T
  rw [hcomp]
  exact congrArg Complex.re (InnerProductSpace.trace_rankOne (T x) x)

lemma FrameFunction.quadraticOperator_represents_unitValue
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y)
    (x : H) (hx : ‖x‖ = 1) :
    f.unitValue x = reTr (f.quadraticOperator hpara * InnerProductSpace.rankOne ℂ x x) := by
  rw [reTr_mul_rankOne]
  have hsym : inner ℂ x (f.quadraticOperator hpara x) =
      inner ℂ (f.quadraticOperator hpara x) x :=
    (f.quadraticOperator_isSymmetric hpara x x).symm
  rw [hsym, f.inner_quadraticOperator, f.complexPolar_self,
    f.homogeneousValue_of_norm_eq_one hx]
  simp

lemma isPositive_of_isSymmetric_of_represents_unitValue
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H) (T : H →L[ℂ] H) (hT : T.IsSymmetric)
    (hrep : ∀ x : H, ‖x‖ = 1 →
      f.unitValue x = reTr (T * InnerProductSpace.rankOne ℂ x x)) :
    T.IsPositive := by
  refine ⟨hT, fun x ↦ ?_⟩
  by_cases hx : x = 0
  · subst x
    rw [ContinuousLinearMap.reApplyInnerSelf_apply]
    simp
  · let u : H := ((‖x‖ : ℂ)⁻¹) • x
    have hnorm : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
    have hu : ‖u‖ = 1 := by simp [u, norm_smul, hnorm]
    have hre := hrep u hu
    rw [reTr_mul_rankOne] at hre
    have hunit_nonneg : 0 ≤ T.reApplyInnerSelf u := by
      rw [ContinuousLinearMap.reApplyInnerSelf_apply]
      change 0 ≤ (inner ℂ (T u) u).re
      have hsym_re : (inner ℂ (T u) u).re = (inner ℂ u (T u)).re :=
        congrArg Complex.re (hT u u)
      rw [hsym_re, ← hre]
      exact f.unitValue_nonneg hu
    have hxu : (‖x‖ : ℂ) • u = x := by simp [u, hnorm]
    rw [← hxu, T.reApplyInnerSelf_smul]
    positivity

lemma represents_all_projections_of_rankOne
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H) (T : H →L[ℂ] H)
    (hrep : ∀ x : H, ‖x‖ = 1 →
      f.μ (InnerProductSpace.rankOne ℂ x x) =
        reTr (T * InnerProductSpace.rankOne ℂ x x)) :
    ∀ P : H →L[ℂ] H, IsOrthProj P → f.μ P = reTr (T * P) := by
  classical
  intro P hP
  have hstar : IsStarProjection P := isOrthProj_iff_isStarProjection.mp hP
  obtain ⟨hrange, hPrange⟩ :=
    isStarProjection_iff_eq_starProjection_range.mp hstar
  letI : P.range.HasOrthogonalProjection := hrange
  let b : OrthonormalBasis (Fin (Module.finrank ℂ P.range)) ℂ P.range :=
    stdOrthonormalBasis ℂ P.range
  let R : Fin (Module.finrank ℂ P.range) → H →L[ℂ] H := fun i ↦
    InnerProductSpace.rankOne ℂ (b i : H) (b i : H)
  have hnorm (i : Fin (Module.finrank ℂ P.range)) : ‖(b i : H)‖ = 1 := by
    change ‖b i‖ = 1
    exact b.orthonormal.norm_eq_one i
  have hR (i : Fin (Module.finrank ℂ P.range)) : IsOrthProj (R i) := by
    exact isOrthProj_iff_isStarProjection.mpr <|
      InnerProductSpace.isStarProjection_rankOne_self (hnorm i)
  have horth (i j : Fin (Module.finrank ℂ P.range)) (hij : i ≠ j) :
      R i * R j = 0 := by
    rw [ContinuousLinearMap.mul_def]
    rw [show InnerProductSpace.rankOne ℂ (b i : H) (b i : H) ∘L
        InnerProductSpace.rankOne ℂ (b j : H) (b j : H) =
        inner ℂ (b i : H) (b j : H) •
          InnerProductSpace.rankOne ℂ (b i : H) (b j : H) by
      exact InnerProductSpace.rankOne_comp_rankOne (b i : H) (b i : H)
        (b j : H) (b j : H)]
    have hinner : inner ℂ (b i : H) (b j : H) = 0 := by
      change inner ℂ (b i) (b j) = 0
      exact b.inner_eq_zero hij
    rw [hinner, zero_smul]
  have hPsum : P = ∑ i, R i := by
    calc
      P = P.range.starProjection := hPrange
      _ = ∑ i, R i := by
        simpa [b, R] using b.starProjection_eq_sum_rankOne
  calc
    f.μ P = f.μ (∑ i, R i) := congrArg f.μ hPsum
    _ = ∑ i, f.μ (R i) :=
      f.map_sum R hR horth
    _ = ∑ i, reTr (T * R i) := by
      apply Finset.sum_congr rfl
      intro i _
      exact hrep (b i : H) (hnorm i)
    _ = reTr (T * ∑ i, R i) := by
      simp [reTr, Finset.mul_sum]
    _ = reTr (T * P) := by rw [← hPsum]

lemma positive_eq_of_reTr_mul_eq_on_projections
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    {T S : H →L[ℂ] H} (hT : T.IsPositive) (hS : S.IsPositive)
    (htrace : ∀ P : H →L[ℂ] H, IsOrthProj P → reTr (T * P) = reTr (S * P)) :
    T = S := by
  have hquad : ∀ x : H, inner ℂ (T x) x = inner ℂ (S x) x := by
    intro x
    by_cases hx : x = 0
    · simp [hx]
    · let u : H := ((‖x‖ : ℂ)⁻¹) • x
      have hnorm : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
      have hu : ‖u‖ = 1 := by
        simp [u, norm_smul, hnorm]
      have hstar : IsStarProjection (InnerProductSpace.rankOne ℂ u u) :=
        InnerProductSpace.isStarProjection_rankOne_self hu
      have hproj : IsOrthProj (InnerProductSpace.rankOne ℂ u u) :=
        ⟨hstar.isIdempotentElem, hstar.isSelfAdjoint⟩
      have hre := htrace (InnerProductSpace.rankOne ℂ u u) hproj
      rw [reTr_mul_rankOne, reTr_mul_rankOne] at hre
      have hquad_u : inner ℂ (T u) u = inner ℂ (S u) u := by
        calc
          inner ℂ (T u) u = inner ℂ u (T u) := hT.isSymmetric u u
          _ = ((inner ℂ u (T u)).re : ℂ) :=
            (hT.isSymmetric.coe_re_inner_self_apply u).symm
          _ = ((inner ℂ u (S u)).re : ℂ) := congrArg (fun r : ℝ ↦ (r : ℂ)) hre
          _ = inner ℂ u (S u) := hS.isSymmetric.coe_re_inner_self_apply u
          _ = inner ℂ (S u) u := (hS.isSymmetric u u).symm
      have hxu : (‖x‖ : ℂ) • u = x := by
        simp [u, hnorm]
      rw [← hxu]
      simp only [map_smul, inner_smul_left, inner_smul_right]
      rw [hquad_u]
  have hlinear : T.toLinearMap = S.toLinearMap :=
    (ext_inner_map T.toLinearMap S.toLinearMap).mp hquad
  ext x
  exact LinearMap.congr_fun hlinear x

lemma reTr_eq_one_of_represents_frameFunction
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H) (T : H →L[ℂ] H)
    (hrep : ∀ P : H →L[ℂ] H, IsOrthProj P → f.μ P = reTr (T * P)) :
    reTr T = 1 := by
  have hstar : IsStarProjection (1 : H →L[ℂ] H) :=
    IsStarProjection.one (H →L[ℂ] H)
  have hproj : IsOrthProj (1 : H →L[ℂ] H) :=
    ⟨hstar.isIdempotentElem, hstar.isSelfAdjoint⟩
  have h := hrep 1 hproj
  simpa [f.normalized] using h.symm

lemma existsUnique_density_of_exists_representation
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hex : ∃ T : H →L[ℂ] H,
      T.IsPositive ∧
      ∀ P : H →L[ℂ] H, IsOrthProj P → f.μ P = reTr (T * P)) :
    ∃! T : H →L[ℂ] H,
      T.IsPositive ∧
      reTr T = 1 ∧
      ∀ P : H →L[ℂ] H, IsOrthProj P → f.μ P = reTr (T * P) := by
  obtain ⟨T, hT, hrep⟩ := hex
  refine ⟨T, ⟨hT, reTr_eq_one_of_represents_frameFunction f T hrep, hrep⟩, ?_⟩
  intro S hS
  apply positive_eq_of_reTr_mul_eq_on_projections hS.1 hT
  intro P hP
  rw [← hS.2.2 P hP, hrep P hP]

lemma existsUnique_density_of_exists_symmetric_unit_representation
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hex : ∃ T : H →L[ℂ] H,
      T.IsSymmetric ∧
      ∀ x : H, ‖x‖ = 1 →
        f.unitValue x = reTr (T * InnerProductSpace.rankOne ℂ x x)) :
    ∃! T : H →L[ℂ] H,
      T.IsPositive ∧
      reTr T = 1 ∧
      ∀ P : H →L[ℂ] H, IsOrthProj P → f.μ P = reTr (T * P) := by
  obtain ⟨T, hT, hunit⟩ := hex
  apply existsUnique_density_of_exists_representation f
  refine ⟨T, isPositive_of_isSymmetric_of_represents_unitValue f T hT hunit, ?_⟩
  exact represents_all_projections_of_rankOne f T hunit

lemma existsUnique_density_of_parallelogram
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [FiniteDimensional ℂ H]
    (f : FrameFunction H)
    (hpara : ∀ x y : H,
      f.homogeneousValue (x + y) + f.homogeneousValue (x - y) =
        2 * f.homogeneousValue x + 2 * f.homogeneousValue y) :
    ∃! T : H →L[ℂ] H,
      T.IsPositive ∧
      reTr T = 1 ∧
      ∀ P : H →L[ℂ] H, IsOrthProj P → f.μ P = reTr (T * P) := by
  apply existsUnique_density_of_exists_symmetric_unit_representation f
  exact ⟨f.quadraticOperator hpara, f.quadraticOperator_isSymmetric hpara,
    f.quadraticOperator_represents_unitValue hpara⟩

end

end LeanEval.Analysis
