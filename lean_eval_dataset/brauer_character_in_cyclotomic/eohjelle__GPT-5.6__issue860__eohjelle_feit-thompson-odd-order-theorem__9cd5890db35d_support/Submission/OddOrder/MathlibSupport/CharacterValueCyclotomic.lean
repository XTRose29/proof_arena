import Mathlib.Algebra.DirectSum.Module
import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
import Submission.OddOrder.MathlibSupport.EigenbasisConjugationMatrix
import Submission.OddOrder.MathlibSupport.FiniteOrderPrimitiveRootEigenspaces
import Submission.OddOrder.PF.Section01.VirtualCharacter

/-!
# Cyclotomic control of finite-group character values

A finite-order operator is diagonalizable over an algebraically closed field
of characteristic zero.  Indexing its eigenspaces by powers of a primitive
root gives an explicit trace formula.  Consequently its trace lies in the
corresponding cyclotomic field, and an automorphism which raises the primitive
root to the `k`-th power sends the trace to the trace of the `k`-th power.

The final two theorems lift these facts from representation characters to the
integral lattice of virtual characters used by the Peterfalvi port.
-/

namespace Submission.OddOrder.MathlibSupport

noncomputable section

open Module
open scoped BigOperators

universe u v

/-- Trace of a power of a finite-order operator, grouped by the dimensions of
its primitive-root eigenspaces. -/
theorem trace_pow_eq_sum_primitiveRootUnitWeight
    {K : Type u} {V : Type v}
    [Field K] [IsAlgClosed K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {n : ℕ} [NeZero n] {omega : Kˣ}
    (homega : IsPrimitiveRoot omega n)
    (f : Module.End K V) (hpow : f ^ n = 1) (m : ℕ) :
    LinearMap.trace K V (f ^ m) =
      ∑ i : ZMod n,
        (Module.finrank K
            (Module.End.eigenspace f
              (primitiveRootUnitWeight homega i : K)) : K) *
          (primitiveRootUnitWeight homega i : K) ^ m := by
  let U : ZMod n → Submodule K V := fun i =>
    Module.End.eigenspace f
      (primitiveRootUnitWeight homega i : K)
  have hspan : ⨆ i, U i = ⊤ :=
    iSup_primitiveRootUnitWeight_eigenspace_eq_top homega f hpow
  have hindependent : iSupIndep U := by
    change iSupIndep
      (Module.End.eigenspace f ∘
        fun i : ZMod n => (primitiveRootUnitWeight homega i : K))
    exact (Module.End.eigenspaces_iSupIndep f).comp
      (Units.val_injective.comp (primitiveRootUnitWeight_injective homega))
  let hinternal : DirectSum.IsInternal U :=
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
      hindependent hspan
  let fiber : ZMod n → Type := fun i =>
    Fin (Module.finrank K (U i))
  let blockBasis : ∀ i, Basis (fiber i) K (U i) := fun i =>
    Module.finBasis K (U i)
  let b : Basis (Σ i, fiber i) K V :=
    hinternal.collectedBasis blockBasis
  let d : (Σ i, fiber i) → K := fun p =>
    (primitiveRootUnitWeight homega p.1 : K)
  have happly (p : Σ i, fiber i) :
      f (b p) = d p • b p := by
    exact Module.End.mem_eigenspace_iff.mp
      (hinternal.collectedBasis_mem blockBasis p)
  have happly_pow (p : Σ i, fiber i) :
      (f ^ m) (b p) = (d p) ^ m • b p := by
    induction m with
    | zero => simp
    | succ m ih =>
        rw [pow_succ', Module.End.mul_apply, ih, LinearMap.map_smul,
          happly, smul_smul, pow_succ']
        rw [mul_comm]
  rw [LinearMap.trace_eq_matrix_trace K b,
    toMatrix_eq_diagonal_of_apply_basis_eq_smul
      b (f ^ m) (fun p => (d p) ^ m) happly_pow,
    Matrix.trace_diagonal]
  simp only [d]
  calc
    (∑ p : Σ i, fiber i,
        (primitiveRootUnitWeight homega p.1 : K) ^ m) =
        ∑ i : ZMod n, ∑ _j : fiber i,
          (primitiveRootUnitWeight homega i : K) ^ m :=
      Fintype.sum_sigma'
        (fun i (_j : fiber i) =>
          (primitiveRootUnitWeight homega i : K) ^ m)
    _ = ∑ i : ZMod n,
          (Module.finrank K (U i) : K) *
            (primitiveRootUnitWeight homega i : K) ^ m := by
      apply Finset.sum_congr rfl
      intro i _
      simp [fiber, nsmul_eq_mul]
    _ = _ := rfl

/-- The trace of an operator whose order divides `n` is in the image of any
cyclotomic field generated by a primitive `n`-th root. -/
theorem exists_preimage_trace_of_primitiveRoot
    {Q : Type u} {K : Type v} {V : Type*}
    [Field Q] [Field K]
    [Algebra ℚ Q] [Algebra ℚ K]
    [IsAlgClosed K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (iota : Q →ₐ[ℚ] K)
    {n : ℕ} [NeZero n] {omegaQ : Q}
    (homegaQ : IsPrimitiveRoot omegaQ n)
    (f : Module.End K V) (hpow : f ^ n = 1) :
    ∃ q : Q, iota q = LinearMap.trace K V f := by
  let omegaQUnit : Qˣ :=
    Units.mk0 omegaQ (homegaQ.ne_zero (NeZero.ne n))
  have homegaQUnit : IsPrimitiveRoot omegaQUnit n := by
    apply IsPrimitiveRoot.coe_units_iff.mp
    simpa [omegaQUnit] using homegaQ
  let omegaKUnit : Kˣ := Units.map iota.toMonoidHom omegaQUnit
  have homegaKUnit : IsPrimitiveRoot omegaKUnit n := by
    apply IsPrimitiveRoot.coe_units_iff.mp
    simpa [omegaKUnit, omegaQUnit] using
      homegaQ.map_of_injective iota.injective
  have hweight (i : ZMod n) :
      (primitiveRootUnitWeight homegaKUnit i : K) =
        iota omegaQ ^ i.val := by
    rw [← ZMod.natCast_zmod_val i,
      primitiveRootUnitWeight_natCast]
    simp [omegaKUnit, omegaQUnit]
  let q : Q :=
    ∑ i : ZMod n,
      (Module.finrank K
          (Module.End.eigenspace f
            (primitiveRootUnitWeight homegaKUnit i : K)) : Q) *
        omegaQ ^ i.val
  refine ⟨q, ?_⟩
  have htrace :=
    trace_pow_eq_sum_primitiveRootUnitWeight homegaKUnit f hpow 1
  simp only [pow_one] at htrace
  rw [htrace]
  simp only [q, map_sum, map_mul, map_natCast, map_pow, hweight]

/-- An algebra automorphism acting by the `k`-th power on a primitive root
sends the trace of a finite-order operator to the trace of its `k`-th power. -/
theorem algEquiv_trace_eq_trace_pow_of_apply_primitiveRoot
    {K : Type u} {V : Type v}
    [Field K] [Algebra ℚ K] [IsAlgClosed K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {n : ℕ} [NeZero n] {omega : Kˣ}
    (homega : IsPrimitiveRoot omega n)
    (sigma : K ≃ₐ[ℚ] K) (k : ℕ)
    (hsigma : sigma (omega : K) = (omega : K) ^ k)
    (f : Module.End K V) (hpow : f ^ n = 1) :
    sigma (LinearMap.trace K V f) =
      LinearMap.trace K V (f ^ k) := by
  have hweight (i : ZMod n) :
      (primitiveRootUnitWeight homega i : K) =
        (omega : K) ^ i.val := by
    conv_lhs =>
      rw [← ZMod.natCast_zmod_val i,
        primitiveRootUnitWeight_natCast]
    rfl
  have htrace1 :=
    trace_pow_eq_sum_primitiveRootUnitWeight homega f hpow 1
  simp only [pow_one] at htrace1
  rw [htrace1,
    trace_pow_eq_sum_primitiveRootUnitWeight homega f hpow k,
    map_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [map_mul, map_natCast, hweight, map_pow, hsigma]
  congr 1
  rw [← pow_mul, ← pow_mul, Nat.mul_comm]

/-- A representation-character value at an element whose order divides `n`
comes from the `n`-th cyclotomic field. -/
theorem representation_character_exists_preimage
    {Q : Type u} {K : Type v}
    {G : Type*} {V : Type*}
    [Field Q] [Field K]
    [Algebra ℚ Q] [Algebra ℚ K] [IsAlgClosed K]
    [Group G]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (iota : Q →ₐ[ℚ] K)
    {n : ℕ} [NeZero n] {omegaQ : Q}
    (homegaQ : IsPrimitiveRoot omegaQ n)
    (rho : Representation K G V) (x : G)
    (hx : orderOf x ∣ n) :
    ∃ q : Q, iota q = rho.character x := by
  have hpow : (rho x) ^ n = 1 := by
    rw [← map_pow, orderOf_dvd_iff_pow_eq_one.mp hx, map_one]
  simpa only [Representation.character] using
    exists_preimage_trace_of_primitiveRoot iota homegaQ (rho x) hpow

/-- Galois power action on a representation-character value. -/
theorem algEquiv_representation_character_apply_eq_pow
    {K : Type u} {G : Type v} {V : Type*}
    [Field K] [Algebra ℚ K] [IsAlgClosed K]
    [Group G]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {n : ℕ} [NeZero n] {omega : Kˣ}
    (homega : IsPrimitiveRoot omega n)
    (sigma : K ≃ₐ[ℚ] K) (k : ℕ)
    (hsigma : sigma (omega : K) = (omega : K) ^ k)
    (rho : Representation K G V) (x : G)
    (hx : orderOf x ∣ n) :
    sigma (rho.character x) = rho.character (x ^ k) := by
  have hpow : (rho x) ^ n = 1 := by
    rw [← map_pow, orderOf_dvd_iff_pow_eq_one.mp hx, map_one]
  simpa only [Representation.character, map_pow] using
    algEquiv_trace_eq_trace_pow_of_apply_primitiveRoot
      homega sigma k hsigma (rho x) hpow

/-- An irreducible-character value at an element whose order divides `n`
comes from the `n`-th cyclotomic field. -/
theorem irreducibleCharacter_value_exists_preimage
    {Q : Type u} {K : Type v} {G : Type*}
    [Field Q] [Field K]
    [Algebra ℚ Q] [Algebra ℚ K] [IsAlgClosed K]
    [Group G]
    (iota : Q →ₐ[ℚ] K)
    {n : ℕ} [NeZero n] {omegaQ : Q}
    (homegaQ : IsPrimitiveRoot omegaQ n)
    (chi : Submission.OddOrder.PF.IrreducibleCharacter G K)
    (x : G) (hx : orderOf x ∣ n) :
    ∃ q : Q, iota q = chi x := by
  obtain ⟨q, hq⟩ :=
    representation_character_exists_preimage
      iota homegaQ chi.representation.ρ x hx
  exact ⟨q, hq.trans (chi.representation_character x)⟩

/-- Galois power action on an irreducible-character value. -/
theorem algEquiv_irreducibleCharacter_apply_eq_pow
    {K : Type u} {G : Type v}
    [Field K] [Algebra ℚ K] [IsAlgClosed K]
    [Group G]
    {n : ℕ} [NeZero n] {omega : Kˣ}
    (homega : IsPrimitiveRoot omega n)
    (sigma : K ≃ₐ[ℚ] K) (k : ℕ)
    (hsigma : sigma (omega : K) = (omega : K) ^ k)
    (chi : Submission.OddOrder.PF.IrreducibleCharacter G K)
    (x : G) (hx : orderOf x ∣ n) :
    sigma (chi x) = chi (x ^ k) := by
  calc
    sigma (chi x) = sigma (chi.representation.character x) := by
      rw [chi.representation_character]
    _ = chi.representation.character (x ^ k) :=
      algEquiv_representation_character_apply_eq_pow
        homega sigma k hsigma chi.representation.ρ x hx
    _ = chi (x ^ k) := chi.representation_character _

/-- A virtual-character value at an element whose order divides `n` comes
from the `n`-th cyclotomic field. -/
theorem virtualCharacter_value_exists_preimage
    {Q : Type u} {K : Type v} {G : Type*}
    [Field Q] [Field K]
    [Algebra ℚ Q] [Algebra ℚ K] [IsAlgClosed K]
    [Group G]
    (iota : Q →ₐ[ℚ] K)
    {n : ℕ} [NeZero n] {omegaQ : Q}
    (homegaQ : IsPrimitiveRoot omegaQ n)
    (chi : Submission.OddOrder.PF.VirtualCharacter G K)
    (x : G) (hx : orderOf x ∣ n) :
    ∃ q : Q, iota q =
      Submission.OddOrder.PF.VirtualCharacter.realize chi x := by
  induction chi using Finsupp.induction with
  | zero => exact ⟨0, by simp⟩
  | single_add psi z chi hpsi hz ih =>
      obtain ⟨q, hq⟩ :=
        irreducibleCharacter_value_exists_preimage
          iota homegaQ psi x hx
      obtain ⟨r, hr⟩ := ih
      refine ⟨(z : Q) * q + r, ?_⟩
      simp only [map_add, map_mul, map_intCast, hq, hr,
        Submission.OddOrder.PF.VirtualCharacter.realize_single,
        Submission.OddOrder.PF.ClassFunction.add_apply,
        Submission.OddOrder.PF.ClassFunction.smul_apply,
        smul_eq_mul]

/-- Galois power action on a virtual-character value. -/
theorem algEquiv_virtualCharacter_apply_eq_pow
    {K : Type u} {G : Type v}
    [Field K] [Algebra ℚ K] [IsAlgClosed K]
    [Group G]
    {n : ℕ} [NeZero n] {omega : Kˣ}
    (homega : IsPrimitiveRoot omega n)
    (sigma : K ≃ₐ[ℚ] K) (k : ℕ)
    (hsigma : sigma (omega : K) = (omega : K) ^ k)
    (chi : Submission.OddOrder.PF.VirtualCharacter G K)
    (x : G) (hx : orderOf x ∣ n) :
    sigma (Submission.OddOrder.PF.VirtualCharacter.realize chi x) =
      Submission.OddOrder.PF.VirtualCharacter.realize chi (x ^ k) := by
  induction chi using Finsupp.induction with
  | zero => simp
  | single_add psi z chi hpsi hz ih =>
      simp only [Submission.OddOrder.PF.VirtualCharacter.realize_single,
        Submission.OddOrder.PF.ClassFunction.add_apply,
        Submission.OddOrder.PF.ClassFunction.smul_apply,
        smul_eq_mul, map_add, map_mul, map_intCast, ih,
        algEquiv_irreducibleCharacter_apply_eq_pow
          homega sigma k hsigma psi x hx]

end

end Submission.OddOrder.MathlibSupport
