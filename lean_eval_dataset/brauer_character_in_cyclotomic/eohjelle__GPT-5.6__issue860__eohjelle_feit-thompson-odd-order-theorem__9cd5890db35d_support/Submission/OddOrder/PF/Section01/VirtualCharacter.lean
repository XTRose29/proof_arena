import Submission.OddOrder.PF.Section01.IntegralLattice
import Submission.OddOrder.PF.Section01.IrreducibleCharacter

/-!
Virtual characters as the free integral lattice on irreducible characters.

MathComp's `'Z[irr G]` is represented here by a `Finsupp` with integer
coefficients.  The realization map into class functions is injective by row
orthogonality; this gives later Peterfalvi sections a concrete coefficient API
without choosing representatives of representation isomorphism classes.
-/

namespace Submission.OddOrder.PF

noncomputable section

universe u v

variable (G : Type u) (k : Type v) [Group G] [Field k]

/-- The integral lattice generated by the irreducible characters of `G`. -/
abbrev VirtualCharacter := IntegralLattice (IrreducibleCharacter G k)

namespace VirtualCharacter

variable {G k}

/-- Cast the integral coefficients of a virtual character into the character
field. -/
def castCoefficients :
    VirtualCharacter G k →+ (IrreducibleCharacter G k →₀ k) :=
  Finsupp.mapRange.addMonoidHom (Int.castAddHom k)

@[simp]
theorem castCoefficients_apply (f : VirtualCharacter G k)
    (chi : IrreducibleCharacter G k) :
    castCoefficients f chi = (f chi : k) :=
  rfl

/-- Realize an integral combination of irreducible characters as a class
function. -/
def realize : VirtualCharacter G k →+ ClassFunction G k :=
  (Finsupp.linearCombination k
      (fun chi : IrreducibleCharacter G k ↦ (chi : ClassFunction G k))).toAddMonoidHom.comp
    castCoefficients

theorem realize_eq_linearCombination (f : VirtualCharacter G k) :
    realize f = Finsupp.linearCombination k
      (fun chi : IrreducibleCharacter G k ↦ (chi : ClassFunction G k))
      (castCoefficients f) :=
  rfl

@[simp]
theorem realize_zero : realize (0 : VirtualCharacter G k) = 0 :=
  map_zero realize

@[simp]
theorem realize_add (f g : VirtualCharacter G k) :
    realize (f + g) = realize f + realize g :=
  map_add realize f g

@[simp]
theorem realize_neg (f : VirtualCharacter G k) :
    realize (-f) = -realize f :=
  map_neg realize f

@[simp]
theorem realize_sub (f g : VirtualCharacter G k) :
    realize (f - g) = realize f - realize g :=
  map_sub realize f g

@[simp]
theorem realize_single (chi : IrreducibleCharacter G k) (z : ℤ) :
    realize (Finsupp.single chi z : VirtualCharacter G k) =
      (z : k) • (chi : ClassFunction G k) := by
  simp [realize, castCoefficients]

section Orthogonality

variable [Fintype G] [IsAlgClosed k] [CharZero k]

local instance : Invertible (Nat.card G : k) :=
  invertibleOfNonzero (Nat.cast_ne_zero.mpr (Nat.card_ne_zero.mpr ⟨inferInstance, inferInstance⟩))

/-- Realization is faithful: the coefficients of a virtual character can be
recovered by pairing with irreducible characters. -/
theorem realize_injective : Function.Injective (realize : VirtualCharacter G k → ClassFunction G k) := by
  intro f g hfg
  have hcoeff : castCoefficients f = castCoefficients g :=
    IrreducibleCharacter.linearIndependent.finsuppLinearCombination_injective hfg
  ext chi
  exact Int.cast_injective (congrArg (fun c : IrreducibleCharacter G k →₀ k ↦ c chi) hcoeff)

/-- The coefficient of `chi` is recovered by pairing `chi` with the realized
virtual character. -/
theorem characterPairing_irreducible_realize
    (chi : IrreducibleCharacter G k) (f : VirtualCharacter G k) :
    characterPairing (chi : ClassFunction G k) (realize f) = (f chi : k) := by
  classical
  induction f using Finsupp.induction with
  | zero => simp
  | single_add psi z f hpsi hz ih =>
      rw [map_add, realize_single, characterPairing_add_right,
        characterPairing_smul_right, ih,
        IrreducibleCharacter.characterPairing_eq_ite]
      by_cases h : chi = psi <;> simp [h]

/-- The character pairing on realized virtual characters is the scalar
extension of the standard coefficient pairing. -/
theorem characterPairing_realize (f g : VirtualCharacter G k) :
    characterPairing (realize f) (realize g) = (coeffDot f g : k) := by
  classical
  induction f using Finsupp.induction with
  | zero => simp
  | single_add chi z f hchi hz ih =>
      rw [map_add, realize_single, characterPairing_add_left,
        characterPairing_smul_left, ih,
        characterPairing_irreducible_realize,
        coeffDot_add_left, coeffDot_single_left]
      norm_cast

end Orthogonality

end VirtualCharacter

end

end Submission.OddOrder.PF
