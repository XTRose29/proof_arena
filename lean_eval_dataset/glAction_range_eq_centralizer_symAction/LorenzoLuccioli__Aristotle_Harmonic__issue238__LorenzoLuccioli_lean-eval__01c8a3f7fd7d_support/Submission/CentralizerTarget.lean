import ChallengeDeps
import Submission.Polarization
import Submission.MultilinearPol
import Submission.Spanning

set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

/-!
# Helper lemmas for the hard direction of Schur-Weyl duality

We prove that the centralizer of the symmetric group action on `M^⊗k`
is contained in the algebra generated by the GL action.
-/

open LeanEval.RepresentationTheory Finset
open scoped TensorProduct

namespace Submission.CentralizerTarget

variable {R : Type*} [Field R]
  {M : Type*} [AddCommGroup M] [Module R M] [FiniteDimensional R M]
  {k : ℕ} [Invertible (k.factorial : R)]

/-! ## Conjugation formula -/

/-- Conjugating a product map by symAction σ permutes the factors. -/
lemma conj_symAction_map (σ : Equiv.Perm (Fin k)) (f : Fin k → M →ₗ[R] M) :
    symAction R M k σ * PiTensorProduct.map f * symAction R M k σ⁻¹ =
    PiTensorProduct.map (fun i => f (σ.symm i)) := by
  have h1 : symAction R M k σ * PiTensorProduct.map f =
    PiTensorProduct.map (fun i => f (σ.symm i)) * symAction R M k σ := by
    ext v
    simp [symAction, PiTensorProduct.reindex_tprod, PiTensorProduct.map_tprod,
          Function.comp, Module.End.mul_apply]
  rw [h1, mul_assoc, ← MonoidHom.map_mul, mul_inv_cancel, MonoidHom.map_one, mul_one]

/-! ## Symmetrized product maps are in A -/

/-- The sum over permutations of product maps with `σ.symm` equals
the sum with `σ` (by relabeling via the inverse bijection). -/
lemma sum_perm_symm_eq (f : Fin k → M →ₗ[R] M) :
    ∑ σ : Equiv.Perm (Fin k), PiTensorProduct.map (fun i => f (σ.symm i)) =
    ∑ σ : Equiv.Perm (Fin k), PiTensorProduct.map (f ∘ ⇑σ) :=
  Fintype.sum_bijective (·⁻¹) inv_bijective _ _ (fun σ => by rfl)

/-- Symmetrized product maps are in the GL algebra, by multilinear polarization. -/
lemma symmetrize_product_mem_adjoin (f : Fin k → (M →ₗ[R] M)) :
    ∑ σ : Equiv.Perm (Fin k), PiTensorProduct.map (fun i => f (σ.symm i)) ∈
    Algebra.adjoin R (Set.range (glAction R M k)) := by
  rw [sum_perm_symm_eq, ← Submission.MultilinearPol.multilinear_polarization]
  exact Subalgebra.sum_mem _ fun S _ =>
    Subalgebra.smul_mem _ (Submission.Polarization.diag_map_mem_adjoin _) _

/-! ## Symmetrization operator -/

/-- The symmetrization operator: `sym(T) = Σ_σ σ T σ⁻¹`. -/
noncomputable def symmetrize (T : (⨂[R]^k M) →ₗ[R] (⨂[R]^k M)) :
    (⨂[R]^k M) →ₗ[R] (⨂[R]^k M) :=
  ∑ σ : Equiv.Perm (Fin k),
    symAction R M k σ * T * symAction R M k σ⁻¹

/-- For T in the centralizer, symmetrize(T) = |S_k| • T. -/
lemma symmetrize_centralizer (T : (⨂[R]^k M) →ₗ[R] (⨂[R]^k M))
    (hT : ∀ σ : Equiv.Perm (Fin k),
      symAction R M k σ * T = T * symAction R M k σ) :
    symmetrize T = (Fintype.card (Equiv.Perm (Fin k)) : R) • T := by
  simp only [symmetrize]
  have : ∀ σ : Equiv.Perm (Fin k),
      symAction R M k σ * T * symAction R M k σ⁻¹ = T := by
    intro σ
    rw [hT σ, mul_assoc, ← MonoidHom.map_mul, mul_inv_cancel, MonoidHom.map_one, mul_one]
  simp only [this, Finset.sum_const, Finset.card_univ]
  rw [Nat.cast_smul_eq_nsmul]

/-- For a product map, symmetrize gives the sum of permuted maps. -/
lemma symmetrize_product_map (f : Fin k → M →ₗ[R] M) :
    symmetrize (PiTensorProduct.map f) =
    ∑ σ : Equiv.Perm (Fin k), PiTensorProduct.map (fun i => f (σ.symm i)) := by
  simp only [symmetrize, conj_symAction_map]

/-! ## Symmetrize maps everything into A -/

/-- The symmetrization operator maps End(M^⊗k) into A. -/
lemma symmetrize_mem_adjoin (T : (⨂[R]^k M) →ₗ[R] (⨂[R]^k M)) :
    symmetrize T ∈ Algebra.adjoin R (Set.range (glAction R M k)) := by
  have hspan := Submission.Spanning.endomorphism_mem_span T
  have hmem : ∀ S ∈ Set.range (fun f : Fin k → (M →ₗ[R] M) => PiTensorProduct.map f),
      symmetrize S ∈ Algebra.adjoin R (Set.range (glAction R M k)) := by
    intro S ⟨f, hf⟩
    subst hf
    rw [symmetrize_product_map]
    exact symmetrize_product_mem_adjoin f
  have hzero : symmetrize 0 ∈ Algebra.adjoin R (Set.range (glAction R M k)) := by
    simp [symmetrize]
  have hadd : ∀ x y : (⨂[R]^k M) →ₗ[R] (⨂[R]^k M),
      symmetrize x ∈ Algebra.adjoin R (Set.range (glAction R M k)) →
      symmetrize y ∈ Algebra.adjoin R (Set.range (glAction R M k)) →
      symmetrize (x + y) ∈ Algebra.adjoin R (Set.range (glAction R M k)) := by
    intro x y hx hy
    have : symmetrize (x + y) = symmetrize x + symmetrize y := by
      simp [symmetrize, mul_add, add_mul, Finset.sum_add_distrib]
    rw [this]; exact Subalgebra.add_mem _ hx hy
  have hsmul : ∀ (c : R) (x : (⨂[R]^k M) →ₗ[R] (⨂[R]^k M)),
      symmetrize x ∈ Algebra.adjoin R (Set.range (glAction R M k)) →
      symmetrize (c • x) ∈ Algebra.adjoin R (Set.range (glAction R M k)) := by
    intro c x hx
    have : symmetrize (c • x) = c • symmetrize x := by
      simp [symmetrize, LinearMap.smul_comp, LinearMap.comp_smul,
            Finset.smul_sum, smul_mul_assoc, mul_smul_comm]
    rw [this]; exact Subalgebra.smul_mem _ hx c
  exact Submodule.span_induction hmem hzero (fun x y _ _ ↦ hadd x y) (fun c x _ ↦ hsmul c x) hspan

/-! ## Main result -/

/-- The centralizer of S_k is contained in the algebra generated by GL. -/
lemma centralizer_le_adjoin :
    Subalgebra.centralizer R (Set.range (symAction R M k)) ≤
      Algebra.adjoin R (Set.range (glAction R M k)) := by
  intro T hT
  have hcomm : ∀ σ : Equiv.Perm (Fin k),
      symAction R M k σ * T = T * symAction R M k σ := by
    intro σ
    exact hT (symAction R M k σ) ⟨σ, rfl⟩
  have hsym := symmetrize_centralizer T hcomm
  have hmem := symmetrize_mem_adjoin T
  rw [Fintype.card_perm, Fintype.card_fin] at hsym
  have hkT : (k.factorial : R) • T ∈ Algebra.adjoin R (Set.range (glAction R M k)) :=
    hsym ▸ hmem
  exact (show T = ⅟(k.factorial : R) • ((k.factorial : R) • T) by simp [← smul_assoc]) ▸
    Subalgebra.smul_mem _ hkT _

end Submission.CentralizerTarget
