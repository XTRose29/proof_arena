import ChallengeDeps
import Submission.Polarization
import Submission.CentralizerTarget

set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace Submission.Helpers

open LeanEval.RepresentationTheory
open scoped TensorProduct

variable {R : Type*} [Field R]
  {M : Type*} [AddCommGroup M] [Module R M] [FiniteDimensional R M]
  {k : ℕ} [Invertible (k.factorial : R)]

/-- The GL action and S_k action commute. -/
lemma commute_gl_sym (g : (M →ₗ[R] M)ˣ) (σ : Equiv.Perm (Fin k)) :
    glAction R M k g * symAction R M k σ = symAction R M k σ * glAction R M k g := by
  exact PiTensorProduct.ext rfl

/-- Easy direction: the algebra generated by GL is contained in the centralizer of S_k. -/
lemma adjoin_le_centralizer :
    Algebra.adjoin R (Set.range (glAction R M k)) ≤
      Subalgebra.centralizer R (Set.range (symAction R M k)) := by
  rw [Algebra.adjoin_le_iff]
  exact fun x hx => by
    rcases hx with ⟨g, rfl⟩
    exact fun y hy => by
      rcases hy with ⟨σ, rfl⟩
      exact commute_gl_sym g σ ▸ rfl

/-- Products of constant PiTensorProduct.maps compose. -/
lemma map_const_mul (f g : M →ₗ[R] M) :
    PiTensorProduct.map (fun (_ : Fin k) => f) * PiTensorProduct.map (fun (_ : Fin k) => g) =
    PiTensorProduct.map (fun (_ : Fin k) => f ∘ₗ g) := by
  ext; simp +decide [PiTensorProduct.map_tprod]

/-- Hard direction: the centralizer of S_k is contained in the algebra generated by GL.
This is the deep content of Schur-Weyl duality. -/
lemma centralizer_le_adjoin :
    Subalgebra.centralizer R (Set.range (symAction R M k)) ≤
      Algebra.adjoin R (Set.range (glAction R M k)) :=
  Submission.CentralizerTarget.centralizer_le_adjoin

end Submission.Helpers
