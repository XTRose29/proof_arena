import Mathlib
import Submission.Helpers

open SimpleGraph

namespace Submission

/-- For any walk `p : (mulCayley S).Walk u v`, the displacement `u⁻¹ * v` lies in
the subgroup generated by `S`. -/
private lemma walk_imp_mul_mem_closure {G : Type*} [Group G] {S : Set G} :
    ∀ {u v : G}, (SimpleGraph.mulCayley S).Walk u v → u⁻¹ * v ∈ Subgroup.closure S
  | _, _, .nil => by simp
  | u, v, .cons (v := w) h rest => by
      have hcons : u⁻¹ * w ∈ Subgroup.closure S := by
        rw [SimpleGraph.mulCayley_adj] at h
        rcases h.2 with hS | hS
        · exact Subgroup.subset_closure hS
        · have heq2 : u⁻¹ * w = (w⁻¹ * u)⁻¹ := by group
          rw [heq2]
          exact (Subgroup.closure S).inv_mem (Subgroup.subset_closure hS)
      have hrest : w⁻¹ * v ∈ Subgroup.closure S := walk_imp_mul_mem_closure rest
      have heq : u⁻¹ * v = (u⁻¹ * w) * (w⁻¹ * v) := by group
      rw [heq]
      exact (Subgroup.closure S).mul_mem hcons hrest

theorem mulCayley_connected_iff_closure_eq_top {G : Type*} [Group G]
    (S : Set G) :
    (SimpleGraph.mulCayley S).Connected ↔ Subgroup.closure S = ⊤ := by
  constructor
  · intro hconn
    rw [eq_top_iff]
    intro g _
    obtain ⟨walk⟩ := hconn.preconnected 1 g
    have := walk_imp_mul_mem_closure walk
    simpa using this
  · intro hclosure
    -- Reach every element from 1 by induction on closure membership.
    have key : ∀ (g x : G), x ∈ Subgroup.closure S →
        (SimpleGraph.mulCayley S).Reachable g (g * x) := by
      intro g x hx
      induction hx using Subgroup.closure_induction_right with
      | one => rw [mul_one]
      | mul_right x' _ y hy ih =>
        rw [← mul_assoc]
        refine ih.trans ?_
        by_cases hy1 : y = 1
        · subst hy1; rw [mul_one]
        · refine SimpleGraph.Adj.reachable ?_
          rw [SimpleGraph.mulCayley_adj]
          refine ⟨?_, .inl ?_⟩
          · intro heq
            have h1 : g * x' * 1 = g * x' * y := by rw [mul_one]; exact heq
            exact hy1 (mul_left_cancel h1).symm
          · rw [show (g * x')⁻¹ * (g * x' * y) = y from by group]
            exact hy
      | mul_inv_cancel x' _ y hy ih =>
        rw [← mul_assoc]
        refine ih.trans ?_
        by_cases hy1 : y = 1
        · subst hy1; simp
        · refine SimpleGraph.Adj.reachable ?_
          rw [SimpleGraph.mulCayley_adj]
          refine ⟨?_, .inr ?_⟩
          · intro heq
            have h1 : g * x' * 1 = g * x' * y⁻¹ := by rw [mul_one]; exact heq
            have h2 : (1 : G) = y⁻¹ := mul_left_cancel h1
            exact hy1 (by rw [← inv_inv y, ← h2, inv_one])
          · rw [show (g * x' * y⁻¹)⁻¹ * (g * x') = y from by group]
            exact hy
    refine ⟨?_⟩
    intro u v
    have hmem : u⁻¹ * v ∈ Subgroup.closure S := hclosure ▸ Subgroup.mem_top _
    have hk := key u (u⁻¹ * v) hmem
    rw [show u * (u⁻¹ * v) = v from by group] at hk
    exact hk

end Submission
