    have hmem : μ ∈ complexEigenvalues (fderiv ℝ f x₀) := by
      unfold complexEigenvalues
      apply (Polynomial.mem_roots
        ((LinearMap.charpoly_monic A).map (algebraMap ℝ ℂ) |>.ne_zero)).2
      exact hma
    have hmod : ‖μ‖ = (1:ℝ) := by
      -- Remaining spectral estimate, now only on the finite dimensional
      -- cyclic subspace.  We have acquired an eigenvalue of its
      -- complexification; `hbB` and `hbC` say that every real vector has
      -- bounded powers of the restriction and its inverse.  Splitting an
      -- eigenvector into real and imaginary coordinate vectors gives
      -- `‖μ‖ ≤ 1` and `1 ≤ ‖μ‖`, respectively.
      have hinjB : Function.Injective B :=
        (LinearMap.injective_iff_surjective).2 hB
      obtain ⟨p, hp⟩ := B.exists_leftInverse_of_injective
        ((LinearMap.ker_eq_bot).2 hinjB)
      have hp' : (LinearMap.baseChange ℂ p) ∘ₗ
            (LinearMap.baseChange ℂ B) = LinearMap.id := by
        rw [← LinearMap.baseChange_comp, hp]
        exact LinearMap.baseChange_id
      have hi' : Function.Injective (LinearMap.baseChange ℂ B) := by
        intro a b hab
        have hab' := congrArg (fun t => (LinearMap.baseChange ℂ p) t) hab
        calc
          a = (LinearMap.baseChange ℂ p) ((LinearMap.baseChange ℂ B) a) := by
            rw [← LinearMap.comp_apply, hp']; rfl
          _ = (LinearMap.baseChange ℂ p) ((LinearMap.baseChange ℂ B) b) := hab'
          _ = b := by rw [← LinearMap.comp_apply, hp']; rfl
      let B' : Module.End ℂ (TensorProduct ℝ ℂ W) :=
        LinearMap.baseChange ℂ B
      have heigen : B'.HasEigenvalue μ := by
        apply (Module.End.hasEigenvalue_iff_isRoot_charpoly B' _).2
        simpa [B', LinearMap.charpoly_baseChange] using hμ
      have hμzero : μ ≠ (0:ℂ) := by
        obtain ⟨w, hw⟩ := heigen.exists_hasEigenvector
        intro hm
        have hz : (LinearMap.baseChange ℂ B) w = 0 := by
          simpa [hm] using hw.apply_eq_smul
        have : w = 0 := hi' (by simpa using hz)
        exact hw.2 this
      have hμpos : (0:ℝ) < ‖μ‖ := (norm_pos_iff.mpr hμzero)
      have hCB : C ∘ₗ B = LinearMap.id := by
        -- `C` was defined to be the inverse of `B` on its orbit span.
        dsimp [C, StableSupport.inverseRestriction]
        -- Write the bijective restriction as a linear equivalence.
        let e : W ≃ₗ[ℝ] W :=
          LinearEquiv.ofBijective
            (StableSupport.orbitRestriction A v hs)
            ⟨(LinearMap.injective_iff_surjective).2
                (StableSupport.orbitRestriction_surjective A v hs),
              StableSupport.orbitRestriction_surjective A v hs⟩
        change e.symm.toLinearMap ∘ₗ e.toLinearMap = LinearMap.id
        ext w
        simp
      have he' : Module.End.HasEigenvalue
          (LinearMap.baseChange ℂ B : Module.End ℂ (TensorProduct ℝ ℂ W)) μ := by
        simpa [B'] using heigen
      exact StableSupport.norm_eigen_eq_one_of_inverse B C hCB hbB hbC he' 
    have hroot : ∃ μ : ℂ,
        μ ∈ complexEigenvalues (fderiv ℝ f x₀) ∧ ‖μ‖ = (1:ℝ) :=
      ⟨μ, hmem, hmod⟩
    rcases hroot with ⟨μ, hμ, hμone⟩
    exact (_hhyp μ hμ) hμone
  rcases StableSupport.isolate_of_noSmall hfd _hfix hlin with ⟨r, hr, hiso⟩
  refine ⟨Metric.ball x₀ r, Metric.isOpen_ball, Metric.mem_ball_self hr, ?_⟩
  refine ⟨{x | (∀ k : ℕ, f^[k] x ∈ Metric.ball x₀ r) ∧
                  Tendsto (fun k => f^[k] x) atTop (𝓝 x₀)},
           {x | ∃ y : ℕ → E n,
                    y 0 = x ∧
                    (∀ k : ℕ, y k ∈ Metric.ball x₀ r) ∧
                    (∀ k : ℕ, f (y (k + 1)) = y k) ∧
                    Tendsto y atTop (𝓝 x₀)}, rfl, rfl, ?_⟩
  ext x
  constructor
  · intro hx
    rcases hx with ⟨⟨hxU, hxlim⟩, hy⟩
    rcases hy with ⟨y, hy0, hyU, hystep, hylim⟩
    let z : ℤ → E n
      | Int.ofNat k => f^[k] x
      | Int.negSucc k => y (k+1)
    have hzU : ∀ i : ℤ, z i ∈ Metric.ball x₀ r := by
      intro i
      cases i with
      | ofNat k => exact hxU k
      | negSucc k => exact hyU (k+1)
    have hzstep : ∀ i : ℤ, z (i+1) = f (z i) := by
      intro i
      cases i with
      | ofNat k =>
          change f^[k+1] x = f (f^[k] x)
          simpa using (Function.iterate_succ_apply' f k x)
      | negSucc k =>
          cases k with
          | zero =>
              change f^[0] x = f (y (0+1))
              simpa [hy0] using (hystep 0).symm
          | succ k =>
              change y (k+1) = f (y ((k+1)+1))
              simpa using (hystep (k+1)).symm
    have hzpos : Tendsto (fun k : ℕ => z (Int.ofNat k)) atTop (𝓝 x₀) := by
      simpa [z] using hxlim
    have hzneg : Tendsto (fun k : ℕ => z (Int.negSucc k)) atTop (𝓝 x₀) := by
      -- this is the tail of the backwards orbit
      have ht : Tendsto (fun k : ℕ => y (k+1)) atTop (𝓝 x₀) :=
        hylim.comp (tendsto_add_atTop_nat 1)
      simpa [z] using ht
    have hz0 := hiso z hzU hzstep hzpos hzneg
    have hx0 : x = x₀ := by simpa [z] using hz0
    simpa [hx0]
  · intro hx
    have hx0 : x = x₀ := by simpa using hx
    subst x
    constructor
    · refine ⟨?_, ?_⟩
      · intro k
        simpa [Function.iterate_fixed _hfix] using (Metric.mem_ball_self (x:=x₀) hr)
      · have H : (fun k : ℕ => f^[k] x₀) = fun _ => x₀ := by
          funext k
          exact Function.iterate_fixed _hfix k
        rw [H]
        exact tendsto_const_nhds
    · refine ⟨(fun _ : ℕ => x₀), rfl, ?_, ?_, ?_⟩
      · intro k
        exact Metric.mem_ball_self hr
      · intro k
        exact _hfix
      · exact tendsto_const_nhds
