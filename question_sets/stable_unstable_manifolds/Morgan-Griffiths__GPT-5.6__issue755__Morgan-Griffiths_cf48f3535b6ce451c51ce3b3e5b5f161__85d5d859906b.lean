    apply (eq_inv_smul_iff₀ hμ0).2
    -- want μ • E' w = w
    have h := hEDw
    rw [hwD] at h
    simpa using h
  have heE : Module.End.HasEigenvalue E' (μ⁻¹) := by
    apply Module.End.hasEigenvalue_of_hasEigenvector
    refine ⟨(Module.End.mem_eigenspace_iff).2 hwE, hw0⟩
  have hle : ‖μ‖ ≤ (1:ℝ) := norm_eigen_le_one D hbD μ he
  have hle' : ‖(μ⁻¹)‖ ≤ (1:ℝ) := by
    exact norm_eigen_le_one E hbE (μ⁻¹) heE
  have hpos : (0:ℝ) < ‖μ‖ := norm_pos_iff.mpr hμ0
