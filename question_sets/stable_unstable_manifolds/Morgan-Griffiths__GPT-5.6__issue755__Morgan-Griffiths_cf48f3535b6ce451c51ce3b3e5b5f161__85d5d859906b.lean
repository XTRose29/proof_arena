  have hevpow : ∀ k : ℕ,
        ((LinearMap.baseChange ℂ D : Module.End ℂ (TensorProduct ℝ ℂ V))^k) w =
          (μ^k) • w := pow_eigenvector _ _ _ hwe
  have hbound : ∀ k : ℕ, (‖μ‖^k) * ‖c‖ ≤ R * Mx + R * My := by
    intro k
    have h := horb k
    rw [hevpow k] at h
    -- apply linearity of the observation
    change ‖complexCoord l ((μ^k) • w)‖ ≤ _ at h
    rw [LinearMap.map_smul] at h
    -- transform norm_smul
    simpa [norm_smul, Complex.norm_pow, c] using h
