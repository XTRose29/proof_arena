open Filter Asymptotics
open scoped Topology
namespace StableSupport

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- Conversion of the gap lemma to an isolating neighbourhood.  Only
finite-dimensional differentiability at the fixed point is used. -/
theorem isolate_of_noSmall {f : X → X} {x₀ : X} {T : X →L[ℝ] X}
    (hd : HasFDerivAt f T x₀)
    (hfix : f x₀ = x₀)
    (hgap : NoSmallBoundedPseudoOrbit T) :
    ∃ r : ℝ, 0 < r ∧
      ∀ z : ℤ → X, (∀ i, z i ∈ Metric.ball x₀ r) →
        (∀ i, z (i+1) = f (z i)) →
        Tendsto (fun k : ℕ => z (Int.ofNat k)) atTop (𝓝 x₀) →
        Tendsto (fun k : ℕ => z (Int.negSucc k)) atTop (𝓝 x₀) →
        z 0 = x₀ := by
  classical
  rcases hgap with ⟨ε, hε, hgap⟩
  have hevent : ∀ᶠ x in 𝓝 x₀,
      ‖f x - f x₀ - T (x-x₀)‖ ≤ ε * ‖x-x₀‖ :=
    hd.isLittleO.bound hε
  rcases (Metric.mem_nhds_iff.1 hevent) with ⟨r, hr, hball⟩
  refine ⟨r, hr, ?_⟩
  intro z hzall hzstep hzpos hzneg
  by_contra hne
  have hzero : 0 < ‖z 0 - x₀‖ := (norm_pos_iff.mpr (sub_ne_zero.mpr hne))
  -- both tails of the orbit have norm strictly smaller than this positive number
  rcases (Metric.tendsto_atTop.1 hzpos _ hzero) with ⟨Np, hNp⟩
  rcases (Metric.tendsto_atTop.1 hzneg _ hzero) with ⟨Nm, hNm⟩
  let I : Finset ℤ := Finset.Icc (- (Nm:ℤ)) (Np:ℤ)
  have h0I : (0:ℤ) ∈ I := by
    simp [I]
  obtain ⟨j, hjI, hjmax⟩ := Finset.exists_max_image I
      (fun i : ℤ => ‖z i - x₀‖) ⟨0, h0I⟩
  let R : ℝ := ‖z j - x₀‖
  have hj0 : ‖z 0 - x₀‖ ≤ R := hjmax 0 h0I
  have hR : 0 < R := lt_of_lt_of_le hzero hj0
  have hmax : ∀ i : ℤ, ‖z i - x₀‖ ≤ R := by
    intro i
    by_cases hi : i ∈ I
    · exact hjmax i hi
    · have hor : i < -(Nm:ℤ) ∨ (Np:ℤ) < i := by
        have hi' : ¬ (-(Nm:ℤ) ≤ i ∧ i ≤ (Np:ℤ)) := by
          simpa [I] using hi
        omega
      rcases i with k | k
      · have hik : Np ≤ k := by
          rcases hor with hh | hh
          · change (k:ℤ) < -(Nm:ℤ) at hh
            exfalso; omega
          · change (Np:ℤ) < (k:ℤ) at hh
            omega
        have small := hNp k hik
        have hnorm : ‖z (Int.ofNat k) - x₀‖ < ‖z 0 - x₀‖ := by
          simpa [dist_eq_norm] using small
        exact (le_of_lt (lt_of_lt_of_le hnorm hj0))
      · have hik : Nm ≤ k := by
          rcases hor with hh | hh
          · simp [Int.negSucc_eq] at hh
            omega
          · exfalso
            simp [Int.negSucc_eq] at hh
            omega
        have small := hNm k hik
        have hnorm : ‖z (Int.negSucc k) - x₀‖ < ‖z 0 - x₀‖ := by
          simpa [dist_eq_norm] using small
        exact (le_of_lt (lt_of_lt_of_le hnorm hj0))
  -- the normalized shifted orbit
  let u : ℤ → X := fun i => (R⁻¹ : ℝ) • (z (j+i) - x₀)
  have hu_bound : ∀ i, ‖u i‖ ≤ (1:ℝ) := by
    intro i
    dsimp [u]
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (by positivity : 0 ≤ R⁻¹)]
    have hi := hmax (j+i)
    -- elementary cancellation of the positive number R
    calc
      R⁻¹ * ‖z (j+i) - x₀‖ ≤ R⁻¹ * R :=
        (mul_le_mul_of_nonneg_left hi (by positivity))
      _ = 1 := by field_simp
  have hu_one : ‖u 0‖ = (1:ℝ) := by
    dsimp [u, R]
    rw [add_zero, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg (by positivity : 0 ≤ (‖z j - x₀‖)⁻¹)]
    have hn : ‖z j - x₀‖ ≠ 0 := by
      have := ne_of_gt hR
      simpa [R] using this
    exact inv_mul_cancel₀ hn
  have hu_err : ∀ i, ‖u (i+1) - T (u i)‖ ≤ ε := by
    intro i
    have hev := hball (hzall (j+i))
    -- the differentiability estimate at the source point
    have hev' : ‖f (z (j+i)) - f x₀ - T (z (j+i)-x₀)‖
          ≤ ε * ‖z (j+i)-x₀‖ := hev
    have hznext : z (j+(i+1)) = f (z (j+i)) := by
      have h := hzstep (j+i)
      simpa [add_assoc, add_left_comm, add_comm] using h
    -- unfold the normalized sequence and use linearity
    dsimp [u]
    rw [T.map_smul]
    rw [← smul_sub]
    rw [norm_smul, Real.norm_eq_abs,
       abs_of_nonneg (by positivity : 0 ≤ R⁻¹)]
    -- reduce the expression to the remainder estimate
    have heq : z (j + (i + 1)) - x₀ - T (z (j+i)-x₀) =
        f (z (j+i)) - f x₀ - T (z (j+i)-x₀) := by
      rw [hznext, hfix]
    rw [heq]
    calc
      R⁻¹ * ‖f (z (j+i)) - f x₀ - T (z (j+i) - x₀)‖
          ≤ R⁻¹ * (ε * ‖z (j+i)-x₀‖) :=
            mul_le_mul_of_nonneg_left hev' (by positivity)
      _ ≤ R⁻¹ * (ε * R) := by
            have hh := hmax (j+i)
            exact mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_left hh (le_of_lt hε)) (by positivity)
      _ = ε := by field_simp
  exact hgap u hu_bound hu_one hu_err

end StableSupport

