open Filter
open scoped Topology

/-! Compactness form of the elementary ``no almost orbit'' lemma.

This file is just some general (finite dimensional) real analysis; no reference to
the dynamical statement is made.  It is useful to formulate the conclusion with
`≤`: this avoids choices of operator norms later.
-/
namespace StableSupport

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- There is a definite error in any normalized bounded two sided pseudo orbit. -/
def NoSmallBoundedPseudoOrbit (T : X →L[ℝ] X) : Prop :=
  ∃ e : ℝ, 0 < e ∧
    ∀ u : ℤ → X, (∀ i, ‖u i‖ ≤ 1) → ‖u 0‖ = 1 →
      ¬ (∀ i, ‖u (i+1) - T (u i)‖ ≤ e)

variable [FiniteDimensional ℝ X]

/-- A compactness observation: if there is no (normalized bounded) exact
orbit, there is already no such orbit with arbitrarily small uniform errors.
This is at times a convenient substitute for choosing an adapted norm. -/
theorem noSmall_of_no_exact (T : X →L[ℝ] X)
    (h : ∀ u : ℤ → X, (∀ i, ‖u i‖ ≤ 1) → ‖u 0‖ = 1 →
      (∀ i, u (i+1) = T (u i)) → False) :
    NoSmallBoundedPseudoOrbit T := by
  classical
  by_contra hn
  -- Use the radii `1/(m+1)`; a failure of the assertion gives a pseudo orbit
  -- for every one of them.
  have hex : ∀ m : ℕ, ∃ u : ℤ → X,
        (∀ i, ‖u i‖ ≤ 1) ∧ ‖u 0‖ = 1 ∧
          (∀ i, ‖u (i+1) - T (u i)‖ ≤ (1 : ℝ) / (m+1)) := by
    intro m
    have hp : (0:ℝ) < (1:ℝ) / (m+1) := by
      exact one_div_pos.mpr (by exact_mod_cast (Nat.succ_pos m))
    have hh := hn
    -- negating the existential in the definition
    simp [NoSmallBoundedPseudoOrbit] at hh
    -- `hh` says none of the positive numbers works.
    have hh' := hh ((1:ℝ)/(m+1)) hp
    exact hh'
  choose u hu using hex
  -- all the orbits lie in the product of the closed unit balls
  let K : Set (ℤ → X) := {x | ∀ i, x i ∈ Metric.closedBall (0:X) 1}
  have hK : IsCompact K := by
    -- Tychonoff, and finite dimensional closed balls are compact
    have hc : ∀ i : ℤ, IsCompact (Metric.closedBall (0:X) 1) :=
      fun _ => isCompact_closedBall (0:X) 1
    simpa [K] using
      (isCompact_pi_infinite (X := fun _ : ℤ => X)
        (s := fun _ : ℤ => Metric.closedBall (0:X) 1) hc)
  have huK : ∀ m, u m ∈ K := by
    intro m i
    have hi := (hu m).1 i
    simpa [Metric.mem_closedBall, dist_zero_right] using hi
  obtain ⟨w, hwK, φ, hφ, hlim⟩ := hK.tendsto_subseq huK
  have hcoord (i : ℤ) :
      Tendsto (fun m : ℕ => u (φ m) i) atTop (𝓝 (w i)) := by
    have hh := (tendsto_pi_nhds.1 hlim i)
    exact hh
  have hwbound : ∀ i, ‖w i‖ ≤ 1 := by
    intro i
    have hi := hwK i
    simpa [Metric.mem_closedBall, dist_zero_right] using hi
  have hnorm0 : ‖w 0‖ = (1:ℝ) := by
    have ht : Tendsto (fun m : ℕ => ‖u (φ m) (0:ℤ)‖) atTop (𝓝 ‖w 0‖) :=
      (continuous_norm.tendsto _).comp (hcoord 0)
    have hconst : (fun m : ℕ => ‖u (φ m) (0:ℤ)‖) = fun _ => (1:ℝ) := by
      funext m
      exact (hu (φ m)).2.1
    rw [hconst] at ht
    exact tendsto_nhds_unique ht tendsto_const_nhds
  -- (The slightly pedantic proof of `hnorm0` above will be overwritten below.)
  have hstep : ∀ i : ℤ, w (i+1) = T (w i) := by
    intro i
    have hsub : Tendsto (fun m : ℕ => u (φ m) (i+1) - T (u (φ m) i)) atTop
        (𝓝 (w (i+1) - T (w i))) :=
      (hcoord (i+1)).sub (T.continuous.continuousAt.tendsto.comp (hcoord i))
    have hnorm : Tendsto
        (fun m : ℕ => ‖u (φ m) (i+1) - T (u (φ m) i)‖) atTop
        (𝓝 ‖w (i+1) - T (w i)‖) :=
      (continuous_norm.tendsto _).comp hsub
    have hzero : Tendsto (fun m : ℕ => (1:ℝ) / ((φ m)+1)) atTop (𝓝 0) := by
      exact tendsto_one_div_add_atTop_nhds_zero_nat.comp hφ.tendsto_atTop
    have hle : ∀ m : ℕ,
        ‖u (φ m) (i+1) - T (u (φ m) i)‖ ≤
          (1:ℝ) / ((φ m)+1) := by
      intro m
      exact (hu (φ m)).2.2 i
    have hnon : ∀ m : ℕ, 0 ≤
        ‖u (φ m) (i+1) - T (u (φ m) i)‖ := fun m => norm_nonneg _
    have hlimnorm : Tendsto
        (fun m : ℕ => ‖u (φ m) (i+1) - T (u (φ m) i)‖) atTop (𝓝 (0:ℝ)) :=
      squeeze_zero' (Filter.Eventually.of_forall hnon) (Filter.Eventually.of_forall hle) hzero
    have heq0 : ‖w (i+1) - T (w i)‖ = (0:ℝ) :=
      tendsto_nhds_unique hnorm hlimnorm
    exact sub_eq_zero.mp (norm_eq_zero.mp heq0)
  exact h w hwbound hnorm0 hstep

end StableSupport

