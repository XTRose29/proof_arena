lemma exists_real_linear_eval_ne_zero [FiniteDimensional ℝ V]
    {x : V} (hx : x ≠ 0) : ∃ l : V →ₗ[ℝ] ℝ, l x ≠ 0 := by
  classical
  let b := Module.finBasis ℝ V
  have hr : b.repr x ≠ 0 := by
    exact (b.repr.map_ne_zero_iff).2 hx
  obtain ⟨i, hi⟩ := (Finsupp.ne_iff.mp hr)
  have hi' : (b.repr x) i ≠ 0 := by
    simpa using hi
  refine ⟨b.coord i, ?_⟩
  simpa [Module.Basis.coord_apply] using hi'

lemma exists_coord_tensor_ne_zero [FiniteDimensional ℝ V]
    {w : TensorProduct ℝ ℂ V} (hw : w ≠ 0) :
    ∃ (x y : V) (l : V →ₗ[ℝ] ℝ),
       w = (1:ℂ) ⊗ₜ[ℝ] x + Complex.I ⊗ₜ[ℝ] y ∧ complexCoord l w ≠ 0 := by
  classical
  obtain ⟨x,y,hxy⟩ := tensor_complex_exists_pair w
  have hcase : x ≠ 0 ∨ y ≠ 0 := by
    by_contra h
    push_neg at h
    exact hw (by simp [hxy, h.1, h.2])
  rcases hcase with hx | hy
  · obtain ⟨l, hl⟩ := exists_real_linear_eval_ne_zero hx
    refine ⟨x,y,l,hxy, ?_⟩
    rw [hxy, complexCoord_tmul_one]
    intro hz
    -- compare real part
    have hr := congrArg Complex.re hz
    -- real part is l x
    have : l x = 0 := by
      simpa using hr
    exact hl this
  · obtain ⟨l, hl⟩ := exists_real_linear_eval_ne_zero hy
    refine ⟨x,y,l,hxy, ?_⟩
    rw [hxy, complexCoord_tmul_one]
    intro hz
    have hi := congrArg Complex.im hz
    have : l y = 0 := by
      simpa using hi
    exact hl this
