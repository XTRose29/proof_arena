namespace StableSupport

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- The subspace generated by all the translates of a two sided orbit. -/
def orbitSpan (u : ℤ → V) : Submodule ℝ V :=
  Submodule.span ℝ (Set.range u)

lemma orbit_mem_orbitSpan (u : ℤ → V) (i : ℤ) : u i ∈ orbitSpan u :=
  Submodule.subset_span (Set.mem_range_self i)

lemma orbitSpan_ne_bot (u : ℤ → V) (i : ℤ) (hi : u i ≠ 0) : orbitSpan u ≠ ⊥ := by
  intro h
  have hz : u i ∈ (⊥ : Submodule ℝ V) := h ▸ orbit_mem_orbitSpan u i
  simpa using hi (by simpa using hz)

lemma map_orbitSpan (A : V →ₗ[ℝ] V) (u : ℤ → V)
    (hu : ∀ i : ℤ, u (i+1) = A (u i)) :
    Submodule.map A (orbitSpan u) = orbitSpan u := by
  apply le_antisymm
  · -- it is invariant
    refine (Submodule.map_le_iff_le_comap).2 ?_
    -- It suffices to check the generators of the span.
    refine (Submodule.span_le).2 ?_
    intro x hx
    rcases hx with ⟨i, rfl⟩
    change A (u i) ∈ orbitSpan u
    rw [← hu i]
    exact orbit_mem_orbitSpan u (i+1)
  · -- every generator is itself an image, using the predecessor
    refine (Submodule.span_le).2 ?_
    intro x hx
    rcases hx with ⟨i, rfl⟩
    refine ⟨u (i-1), orbit_mem_orbitSpan u (i-1), ?_⟩
    have hh := hu (i-1)
    -- `(i-1)+1=i`
    simpa [sub_eq_add_neg, add_assoc] using hh.symm

/-- Restriction of an endomorphism to the span of an orbit. -/
noncomputable def orbitRestriction (A : V →ₗ[ℝ] V) (u : ℤ → V)
    (hu : ∀ i : ℤ, u (i+1) = A (u i)) :
    orbitSpan u →ₗ[ℝ] orbitSpan u :=
  A.restrict (p := orbitSpan u) (q := orbitSpan u) (by
    intro x hx
    have hm : Submodule.map A (orbitSpan u) = orbitSpan u :=
      map_orbitSpan A u hu
    have : A x ∈ Submodule.map A (orbitSpan u) :=
      ⟨x, hx, rfl⟩
    simpa [hm] using this)

lemma orbitRestriction_apply_coe (A : V →ₗ[ℝ] V) (u : ℤ → V)
    (hu : ∀ i : ℤ, u (i+1) = A (u i)) (x : orbitSpan u) :
    ((orbitRestriction A u hu x : orbitSpan u) : V) = A (x:V) := rfl

lemma orbitRestriction_surjective (A : V →ₗ[ℝ] V) (u : ℤ → V)
    (hu : ∀ i : ℤ, u (i+1) = A (u i)) :
    Function.Surjective (orbitRestriction A u hu) := by
  intro y
  have hm : Submodule.map A (orbitSpan u) = orbitSpan u :=
    map_orbitSpan A u hu
  have hy : (y:V) ∈ Submodule.map A (orbitSpan u) := by
    have : (y:V) ∈ orbitSpan u := y.property
    rwa [hm]
  rcases hy with ⟨x, hx, hxy⟩
  refine ⟨⟨x, hx⟩, ?_⟩
  apply Subtype.ext
  exact hxy

end StableSupport

