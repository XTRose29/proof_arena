/-- Pointwise bounded real powers force any complex eigenvalue (after scalar extension)
 to have modulus at most one. -/
lemma norm_eigen_le_one (D : V →ₗ[ℝ] V)
    (hb : boundedPowers D = ⊤) (μ : ℂ)
    (he : Module.End.HasEigenvalue (LinearMap.baseChange ℂ D : Module.End ℂ (TensorProduct ℝ ℂ V)) μ) :
    ‖μ‖ ≤ (1:ℝ) := by
  classical
  obtain ⟨w, hw⟩ := he.exists_hasEigenvector
  have hw0 : w ≠ 0 := hw.2
  have hwe : (LinearMap.baseChange ℂ D : Module.End ℂ (TensorProduct ℝ ℂ V)) w = μ • w :=
    hw.apply_eq_smul
  obtain ⟨x, y, l, hxy, hc⟩ := exists_coord_tensor_ne_zero (V:=V) hw0
  -- individual real iterates have bounds
  have hbx : x ∈ boundedPowers D := by
    rw [hb]; trivial
  have hby : y ∈ boundedPowers D := by
    rw [hb]; trivial
  rcases hbx with ⟨Mx, hMx⟩
  rcases hby with ⟨My, hMy⟩
  have Mx0 : 0 ≤ Mx := le_trans (norm_nonneg x) (by simpa using hMx 0)
  have My0 : 0 ≤ My := le_trans (norm_nonneg y) (by simpa using hMy 0)
  let lc : V →L[ℝ] ℝ := LinearMap.toContinuousLinearMap l
  let R : ℝ := ‖lc‖
  have R0 : 0 ≤ R := norm_nonneg _
  let c : ℂ := complexCoord l w
  have c0 : c ≠ 0 := hc
  have cn0 : 0 < ‖c‖ := norm_pos_iff.mpr c0
  have hcform : c = (l x : ℂ) + (l y : ℂ) * Complex.I := by
    dsimp [c]
    simpa [hxy] using (complexCoord_tmul_one l x y)
  have hrealx : ∀ k : ℕ, ‖l ((D^k) x)‖ ≤ R * Mx := by
    intro k
    calc
      ‖l ((D^k) x)‖ = ‖lc ((D^k) x)‖ := rfl
      _ ≤ R * ‖(D^k) x‖ := by
        dsimp [R]
        exact ContinuousLinearMap.le_opNorm lc _
      _ ≤ R * Mx := mul_le_mul_of_nonneg_left (hMx k) R0
  have hrealy : ∀ k : ℕ, ‖l ((D^k) y)‖ ≤ R * My := by
    intro k
    calc
      ‖l ((D^k) y)‖ = ‖lc ((D^k) y)‖ := rfl
      _ ≤ R * ‖(D^k) y‖ := by
        dsimp [R]
        exact ContinuousLinearMap.le_opNorm lc _
      _ ≤ R * My := mul_le_mul_of_nonneg_left (hMy k) R0
  -- uniform upper bound on the observed complex orbit
  have horb : ∀ k : ℕ,
      ‖complexCoord l
          (((LinearMap.baseChange ℂ D : Module.End ℂ (TensorProduct ℝ ℂ V))^k) w)‖
          ≤ R * Mx + R * My := by
    intro k
    have hpowform :
        (((LinearMap.baseChange ℂ D : Module.End ℂ (TensorProduct ℝ ℂ V))^k) w) =
          (1:ℂ) ⊗ₜ[ℝ] ((D^k) x) + Complex.I ⊗ₜ[ℝ] ((D^k) y) := by
      rw [hxy]
      rw [LinearMap.map_add]
      rw [baseChange_pow_tmul, baseChange_pow_tmul]
    rw [hpowform, complexCoord_tmul_one]
    calc
      ‖(l ((D ^ k) x) : ℂ) +
          (l ((D ^ k) y) : ℂ) * Complex.I‖
          ≤ ‖(l ((D ^ k) x) : ℂ)‖ +
              ‖(l ((D ^ k) y) : ℂ) * Complex.I‖ := norm_add_le _ _
      _ = ‖l ((D^k) x)‖ + ‖l ((D^k) y)‖ := by
        rw [norm_mul, Complex.norm_I]
        -- ofReal norm is real norm
        simp [Complex.norm_real]
      _ ≤ R * Mx + R * My := add_le_add (hrealx k) (hrealy k)
