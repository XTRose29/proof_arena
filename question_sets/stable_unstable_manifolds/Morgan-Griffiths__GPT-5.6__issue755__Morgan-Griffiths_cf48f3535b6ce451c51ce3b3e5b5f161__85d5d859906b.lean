    -- multiply hk by the positive norm
    have h := (mul_lt_mul_of_pos_right hk cn0)
    -- simplify division
    -- hk : (C / norm) < pow
    -- h : C/norm * norm < pow * norm
    have hn : ‖c‖ ≠ 0 := ne_of_gt cn0
    simpa [div_mul_eq_mul_div, hn] using h
  exact (not_lt_of_ge hm) hmul
end StableSupport
