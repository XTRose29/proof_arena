variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]

lemma tensor_complex_exists_pair (z : TensorProduct ℝ ℂ V) :
    ∃ x y : V, z = (1:ℂ) ⊗ₜ[ℝ] x + Complex.I ⊗ₜ[ℝ] y := by
  induction z using TensorProduct.induction_on with
  | zero =>
      refine ⟨0, 0, ?_⟩
      simp
  | tmul a x =>
      refine ⟨a.re • x, a.im • x, ?_⟩
      -- split a into real and imaginary parts
      rw [TensorProduct.tmul_smul, TensorProduct.tmul_smul]
      -- rhs involves real smuls on complex numbers
      -- simplify scalar action
      -- goals inspect
      have ha : a = (a.re : ℂ) + (a.im : ℂ) * Complex.I :=
        (Complex.re_add_im a).symm
      -- tensor is additive in the first argument
      calc
        a ⊗ₜ[ℝ] x = ((a.re • (1:ℂ)) + (a.im • Complex.I)) ⊗ₜ[ℝ] x := by
          congr 1
          simpa [Complex.real_smul, mul_comm] using ha
        _ = _ := TensorProduct.add_tmul _ _ _
  | add u v hu hv =>
      rcases hu with ⟨x,y,hxy⟩
      rcases hv with ⟨x',y',hxy'⟩
      refine ⟨x+x', y+y', ?_⟩
      rw [hxy, hxy']
      simp [TensorProduct.tmul_add, add_assoc, add_left_comm, add_comm]
end StableSupport

