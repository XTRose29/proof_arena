open scoped TensorProduct
open Polynomial

namespace StableSupport
variable {W : Type*} [AddCommGroup W] [Module ℝ W] [FiniteDimensional ℝ W]

/-- A nonzero finite-dimensional real space acquires an eigenvalue after
extending the scalars to the complexes. Kept in root form to avoid choices. -/
theorem exists_complex_root (hne : Nontrivial W) (D : W →ₗ[ℝ] W) :
    ∃ μ : ℂ, (D.charpoly.map (algebraMap ℝ ℂ)).IsRoot μ := by
  classical
  letI : Nontrivial W := hne
  let U := TensorProduct ℝ ℂ W
  have hd : Module.finrank ℂ U = Module.finrank ℝ W := by
    simpa [U] using (Module.finrank_baseChange (R:=ℂ) (S:=ℝ) (M':=W))
  have hp : 0 < Module.finrank ℂ U := by
    rw [hd]
    exact Module.finrank_pos
  letI : Nontrivial U := Module.finrank_pos_iff.mp hp
  let D' : Module.End ℂ U := LinearMap.baseChange ℂ D
  obtain ⟨μ, hμ⟩ := Module.End.exists_eigenvalue D'
  refine ⟨μ, ?_⟩
  rw [← LinearMap.charpoly_baseChange]
  exact (Module.End.hasEigenvalue_iff_isRoot_charpoly D' μ).1 hμ
end StableSupport

namespace StableSupport
open scoped TensorProduct
open Polynomial
variable {V : Type*} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
variable (A : V →ₗ[ℝ] V) (P : Submodule ℝ V) (D : P →ₗ[ℝ] P)

/-- Roots of the complexified restriction are roots of the complexified ambient
endomorphism. The intertwining hypothesis is often easier than matrices. -/
theorem ambient_root_of_restriction
    (hint : P.subtype ∘ₗ D = A ∘ₗ P.subtype)
    {μ : ℂ} (hμ : (D.charpoly.map (algebraMap ℝ ℂ)).IsRoot μ) :
    (A.charpoly.map (algebraMap ℝ ℂ)).IsRoot μ := by
  classical
  -- a left inverse to the inclusion remains a left inverse after base change
  obtain ⟨p, hp⟩ := P.subtype.exists_leftInverse_of_injective P.ker_subtype
  have hp' : (LinearMap.baseChange ℂ p) ∘ₗ
        (LinearMap.baseChange ℂ P.subtype) = LinearMap.id := by
    rw [← LinearMap.baseChange_comp]
    rw [hp]
    exact LinearMap.baseChange_id
  have hj : Function.Injective (LinearMap.baseChange ℂ P.subtype) := by
    intro x y hxy
    have := congrArg (fun t => (LinearMap.baseChange ℂ p) t) hxy
    calc
      x = (LinearMap.baseChange ℂ p) ((LinearMap.baseChange ℂ P.subtype) x) := by
        rw [← LinearMap.comp_apply, hp']
        rfl
      _ = (LinearMap.baseChange ℂ p) ((LinearMap.baseChange ℂ P.subtype) y) := this
      _ = y := by rw [← LinearMap.comp_apply, hp']; rfl
  let D' : Module.End ℂ (TensorProduct ℝ ℂ P) := LinearMap.baseChange ℂ D
  let A' : Module.End ℂ (TensorProduct ℝ ℂ V) := LinearMap.baseChange ℂ A
  let j : TensorProduct ℝ ℂ P →ₗ[ℂ] TensorProduct ℝ ℂ V :=
    LinearMap.baseChange ℂ P.subtype
  have hinter : j ∘ₗ D' = A' ∘ₗ j := by
    dsimp [j, D', A']
    rw [← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp, hint]
  have hev : D'.HasEigenvalue μ := by
    apply (Module.End.hasEigenvalue_iff_isRoot_charpoly D' μ).2
    simpa [D', LinearMap.charpoly_baseChange] using hμ
  obtain ⟨w, hw⟩ := hev.exists_hasEigenvector
  have hw0 : w ≠ 0 := hw.2
  have hjw : j w ≠ 0 := by
    intro hz; exact hw0 (hj (by simpa using hz))
  have heq : A' (j w) = μ • (j w) := by
    have he := hw.apply_eq_smul
    have he' := LinearMap.congr_fun hinter w
    -- intertwine, then the eigen equation
    simpa [LinearMap.comp_apply, he, map_smul] using he'.symm
  have heig : A'.HasEigenvalue μ :=
    Module.End.hasEigenvalue_of_hasEigenvector
      ⟨(Module.End.mem_eigenspace_iff).2 heq, hjw⟩
  have := (Module.End.hasEigenvalue_iff_isRoot_charpoly A' μ).1 heig
  simpa [A', LinearMap.charpoly_baseChange] using this
end StableSupport

