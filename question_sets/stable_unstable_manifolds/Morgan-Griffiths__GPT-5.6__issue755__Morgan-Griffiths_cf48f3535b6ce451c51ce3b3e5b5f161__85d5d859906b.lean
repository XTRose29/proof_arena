open Filter
namespace StableSupport

-- Vectors whose forward iterates by a linear map have a (point-dependent) bound.
-- No topology on the linear map is involved in this lemma.
variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]

def boundedPowers (D : V →ₗ[ℝ] V) : Submodule ℝ V where
  carrier := {x | ∃ c : ℝ, ∀ k : ℕ, ‖(D^k) x‖ ≤ c}
  zero_mem' := ⟨0, by intro k; simp⟩
  add_mem' := by
    intro x y hx hy
    rcases hx with ⟨a, ha⟩
    rcases hy with ⟨b, hb⟩
    refine ⟨a+b, ?_⟩
    intro k
    rw [LinearMap.map_add]
    exact le_trans (norm_add_le _ _) (add_le_add (ha k) (hb k))
  smul_mem' := by
    intro r x hx
    rcases hx with ⟨a, ha⟩
    refine ⟨‖r‖*a, ?_⟩
    intro k
    rw [LinearMap.map_smul, norm_smul]
    exact mul_le_mul_of_nonneg_left (ha k) (norm_nonneg _)

lemma mem_boundedPowers {D : V →ₗ[ℝ] V} {x : V} :
    x ∈ boundedPowers D ↔ ∃ c : ℝ, ∀ k : ℕ, ‖(D^k) x‖ ≤ c := Iff.rfl

variable {A : V →ₗ[ℝ] V} {q : ℤ → V}

lemma orbitRestriction_apply_point (h : ∀ i : ℤ, q (i+1) = A (q i)) (i : ℤ) :
    orbitRestriction A q h (⟨q i, orbit_mem_orbitSpan q i⟩ : orbitSpan q) =
      (⟨q (i+1), orbit_mem_orbitSpan q (i+1)⟩ : orbitSpan q) := by
  apply Subtype.ext
  exact (h i).symm

lemma pow_orbitRestriction_point (h : ∀ i : ℤ, q (i+1) = A (q i)) :
    ∀ (i : ℤ) (k : ℕ),
    (orbitRestriction A q h ^ k)
        (⟨q i, orbit_mem_orbitSpan q i⟩ : orbitSpan q) =
      (⟨q (i + k), orbit_mem_orbitSpan q (i+k)⟩ : orbitSpan q) := by
  intro i k
  induction k with
  | zero => simp
  | succ k ih =>
    -- `(D^(k+1)) x = D (D^k x)`
    rw [pow_succ', Module.End.mul_apply, ih,
      orbitRestriction_apply_point h]
    congr 2
    push_cast
    omega

/-- On the cyclic subspace, every vector has bounded forward iterates whenever the
orbit itself is bounded.  Bounds are allowed to depend on the vector. -/
lemma orbitRestriction_all_bounded
    (h : ∀ i : ℤ, q (i+1) = A (q i)) (hb : ∀ i : ℤ, ‖q i‖ ≤ (1:ℝ)) :
    boundedPowers (orbitRestriction A q h) = ⊤ := by
  apply top_unique
  -- it suffices that all orbit points belong to this submodule
  intro x hx
  -- show by span induction on the ambient representative
  change (x : orbitSpan q) ∈ boundedPowers (orbitRestriction A q h)
  refine Submodule.span_induction (s:= Set.range q)
    (p := fun y hy =>
      (⟨y, hy⟩ : orbitSpan q) ∈
        boundedPowers (orbitRestriction A q h)) ?_ ?_ ?_ ?_ x.property
  · intro y hy
    rcases hy with ⟨i, rfl⟩
    refine ⟨1, ?_⟩
    intro k
