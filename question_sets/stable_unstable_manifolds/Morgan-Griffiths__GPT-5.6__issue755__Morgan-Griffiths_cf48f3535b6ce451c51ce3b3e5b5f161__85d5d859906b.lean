noncomputable def complexCoord (l : V →ₗ[ℝ] ℝ) :
    TensorProduct ℝ ℂ V →ₗ[ℂ] ℂ :=
  (TensorProduct.AlgebraTensorModule.rid ℝ ℂ ℂ).toLinearMap ∘ₗ
    (LinearMap.baseChange ℂ l)

@[simp] lemma complexCoord_tmul (l : V →ₗ[ℝ] ℝ) (a : ℂ) (x : V) :
    complexCoord l (a ⊗ₜ[ℝ] x) = (l x) • a := by
  simp [complexCoord, LinearMap.comp_apply, TensorProduct.AlgebraTensorModule.rid_tmul]

@[simp] lemma complexCoord_tmul_one (l : V →ₗ[ℝ] ℝ) (x y : V) :
    complexCoord l ((1:ℂ) ⊗ₜ[ℝ] x + Complex.I ⊗ₜ[ℝ] y) =
      (l x : ℂ) + (l y : ℂ) * Complex.I := by
  simp [complexCoord_tmul, Complex.real_smul]
