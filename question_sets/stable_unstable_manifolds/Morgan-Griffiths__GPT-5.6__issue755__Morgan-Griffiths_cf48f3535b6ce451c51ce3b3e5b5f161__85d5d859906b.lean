  have hcomp : E' ∘ₗ D' = LinearMap.id := by
    dsimp [E', D']
    rw [← LinearMap.baseChange_comp, hED]
    exact LinearMap.baseChange_id
  obtain ⟨w, hw⟩ := he.exists_hasEigenvector
  have hw0 : w ≠ 0 := hw.2
